# ASK2 KASAN debug build (opt-in): generic KASAN with inline instrumentation
# and vmalloc coverage, so board test runs catch use-after-free and
# out-of-bounds accesses in ask.ko and the FMan/DPAA drivers (the vendor
# requires KASAN for every DUT run). Merged by ci-setup-kernel.sh only when
# the workflow input `kasan` is true; production builds never apply it.
# Expect a large slowdown and memory overhead on the 4x A72: not for
# throughput measurements.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KASAN_VMALLOC=y

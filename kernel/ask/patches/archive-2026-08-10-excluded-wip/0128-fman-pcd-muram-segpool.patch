+/*
+ * Segregated-fit MURAM allocator pools. The 64 KiB reserved partition is
+ * split into power-of-two arenas. Allocations are made from the smallest
+ * pool that fits the request. This minimizes fragmentation from
+ * variable-sized header-manip command descriptors, the primary cause of
+ * Risk #13 (-ENOMEM on contiguous chain_create).
+ */
+#define FMAN_PCD_MURAM_POOL_COUNT	4
+#define FMAN_PCD_MURAM_POOL_MAX_IDX	(FMAN_PCD_MURAM_POOL_COUNT - 1)
+
+/* Pool sizes: 16K, 16K, 16K, 16K */
+static const size_t fman_pcd_muram_pool_sizes[FMAN_PCD_MURAM_POOL_COUNT] = {
+	SZ_16K, SZ_16K, SZ_16K, SZ_16K
+};
+
+/* Size classes: <=256, <=512, <=1K, >1K */
+static const size_t fman_pcd_muram_pool_classes[FMAN_PCD_MURAM_POOL_COUNT] = {
+	SZ_256, SZ_512, SZ_1K, 0
+};
 

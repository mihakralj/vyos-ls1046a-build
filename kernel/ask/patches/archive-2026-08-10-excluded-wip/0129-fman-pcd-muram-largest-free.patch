@@ -211,6 +211,21 @@
 }
 EXPORT_SYMBOL(fman_pcd_muram_free);
 
+size_t fman_pcd_muram_get_largest_free(struct fman_pcd *pcd)
+{
+	size_t largest_free = 0;
+	int i;
+
+	if (WARN_ON(!pcd))
+		return 0;
+
+	mutex_lock(&pcd->lock);
+	for (i = 0; i < FMAN_PCD_MURAM_POOL_COUNT; i++)
+		largest_free = max(largest_free,
+				   gen_pool_avail(pcd->muram_pools[i]));
+	mutex_unlock(&pcd->lock);
+
+	return largest_free;
+}

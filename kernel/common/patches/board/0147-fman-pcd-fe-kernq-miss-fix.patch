+/* --- fe_miss: MISS-path kernel-return + link rewriter --- */
+
+
+
+static int fman_pcd_fe_kernq_build(struct fman_pcd *pcd, u32 fqid)
+
+{
+
+	struct fman_pcd_fe_obj *obj;
+
+	int ret;
+
+
+
+	ret = fman_pcd_fe_enq_build(pcd, fqid, 0);
+
+	if (ret)
+
+		return ret;
+
+	obj = list_last_entry(&pcd->fe_enq, struct fman_pcd_fe_obj, node);
+
+	pcd->fe_kernq_off = obj->muram_off;
+
+	pr_info("fman_pcd: fe_kernq at 0x%lx FQID 0x%x\n", obj->muram_off, fqid);
+
+	return 0;
+
+}
+
+
+
+static int fman_pcd_fe_miss_set(struct fman_pcd *pcd, u32 miss_off)
+
+{
+
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+
+	void __iomem *fe;
+
+
+
+	if (!pcd->fe_hashfe_off || !muram)
+
+		return -EINVAL;
+
+	fe = fman_muram_offset_to_vbase(muram, pcd->fe_hashfe_off);
+
+	iowrite32be(miss_off, (u32 __iomem *)fe + 6);
+
+	pr_info("fman_pcd: t_ExtHashFe w6 (MISS) -> 0x%x\n", miss_off);
+
+	return 0;
+
+}
+
+
+
+static ssize_t fman_pcd_fe_miss_write(struct file *filp,
+
+	const char __user *buf, size_t count, loff_t *pos)
+
+{
+
+	struct fman_pcd *pcd = filp->private_data;
+
+	char cmd[64];
+
+	u32 val;
+
+
+
+	if (count >= sizeof(cmd))
+
+		return -EINVAL;
+
+	if (copy_from_user(cmd, buf, count))
+
+		return -EFAULT;
+
+	cmd[count] = '\0';
+
+
+
+	if (sscanf(cmd, "kernq %x", &val) == 1)
+
+		return fman_pcd_fe_kernq_build(pcd, val) ?: (ssize_t)count;
+
+	if (sscanf(cmd, "set %x", &val) == 1)
+
+		return fman_pcd_fe_miss_set(pcd, val) ?: (ssize_t)count;
+
+	return -EINVAL;
+
+}
+
+
+
+static int fman_pcd_fe_miss_show(struct seq_file *s, void *v)
+
+{
+
+	struct fman_pcd *pcd = s->private;
+
+	seq_printf(s, "kernq_off=0x%lx hashfe_off=0x%lx\n",
+
+		   pcd->fe_kernq_off, pcd->fe_hashfe_off);
+
+	if (pcd->fe_kernq_off)
+
+		seq_printf(s, "  MISS -> fe_kernq @0x%lx\n", pcd->fe_kernq_off);
+
+	else
+
+		seq_puts(s, "  MISS -> Exit (dealloc)\n");
+
+	return 0;
+
+}
+
+
+
+static int fman_pcd_fe_miss_open(struct inode *inode, struct file *file)
+
+{
+
+	return single_open(file, fman_pcd_fe_miss_show, inode->i_private);
+
+}
+
+
+
+static const struct file_operations fman_pcd_fe_miss_fops = {
+
+	.open		= fman_pcd_fe_miss_open,
+
+	.read		= seq_read,
+
+	.write		= fman_pcd_fe_miss_write,
+
+	.llseek		= seq_lseek,
+
+	.release	= single_release,
+
 };
 

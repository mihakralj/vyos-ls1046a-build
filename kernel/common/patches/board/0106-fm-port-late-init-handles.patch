+/*
+ * KILO-FIX: delayed work to initialize SDK port handles for ports that
+ * were probed by the mainline DPAA driver instead of the SDK fm_port_driver.
+ *
+ * Must run AFTER the mainline DPAA port probe completes (~T+55s).
+ * late_initcall would fire too early (T+1s) when the hardware isn't
+ * fully set up by the mainline driver.
+ */
+static struct delayed_work fm_port_late_work;
+static void fm_port_init_handles_workfn(struct work_struct *work)
+{
+	struct device_node *fman_np;
+	int i;
+
+	fman_np = of_find_compatible_node(NULL, NULL, "fsl,fman");
+	if (!fman_np)
+		return;
+
+	for_each_compatible_node(fman_np, NULL, "fsl,fman") {
+		t_LnxWrpFmDev *p_LnxWrpFmDev;
+		struct platform_device *pdev;
+
+		pdev = of_find_device_by_node(fman_np);
+		if (!pdev)
+			continue;
+
+		p_LnxWrpFmDev = (t_LnxWrpFmDev *)fm_bind(&pdev->dev);
+		if (!p_LnxWrpFmDev) {
+			put_device(&pdev->dev);
+			continue;
+		}
+
+		/* Initialize RX ports that have a device but no handle */
+		for (i = 0; i < FM_MAX_NUM_OF_RX_PORTS; i++) {
+			if (p_LnxWrpFmDev->rxPorts[i].dev &&
+			    !p_LnxWrpFmDev->rxPorts[i].h_Dev) {
+				pr_info("fm_port: delayed-init rx port %d\n", i);
+				InitFmPortDev(&p_LnxWrpFmDev->rxPorts[i]);
+			}
+		}
+
+		/* Initialize TX ports that have a device but no handle */
+		for (i = 0; i < FM_MAX_NUM_OF_TX_PORTS; i++) {
+			if (p_LnxWrpFmDev->txPorts[i].dev &&
+			    !p_LnxWrpFmDev->txPorts[i].h_Dev) {
+				pr_info("fm_port: delayed-init tx port %d\n", i);
+				InitFmPortDev(&p_LnxWrpFmDev->txPorts[i]);
+			}
+		}
+
+		/* OP ports */
+		for (i = 0; i < FM_MAX_NUM_OF_OH_PORTS - 1; i++) {
+			if (p_LnxWrpFmDev->opPorts[i].dev &&
+			    !p_LnxWrpFmDev->opPorts[i].h_Dev) {
+				pr_info("fm_port: delayed-init op port %d\n", i);
+				InitFmPortDev(&p_LnxWrpFmDev->opPorts[i]);
+			}
+		}
+
+		fm_unbind((struct fm *)p_LnxWrpFmDev);
+		put_device(&pdev->dev);
+	}
+}
+
 static void __exit __cold fm_port_unload(void)
 {

diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd_kg.c b/drivers/net/ethernet/freescale/fman/fman_pcd_kg.c
index f2ebd79d3..0758c6792 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd_kg.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd_kg.c
@@ -882,6 +882,140 @@ int fman_pcd_kg_port_arm_fe(struct fman_pcd *pcd, u8 hw_port_id,
 	 * fman_port_set_cc_base() wrote (0x00480200) stays unmodified.
 	 */
 
+	/* F-211(v6-scheme-arm): productize the 2026-08-19 exp-apply recipe.
+	 * GATED PER PORT (F-219): fman_pcd_port_wants_v6() = the global master
+	 * (fsl_dpaa_fman.v6_enable) AND this port's v6 intent bit that ask.ko
+	 * set from the netdev's IPv6 addresses. So eth3 can arm v4+v6 while
+	 * eth4 stays v4-only; ports engage independently, never a forced
+	 * simultaneous dual re-arm. v4 byte-identical when OFF (v4 slot
+	 * keeps match_vector=0, no second scheme). With v6 on: give v4 its own
+	 * match-vector bit, clone it into a free slot as the v6 scheme with
+	 * CCOBASE=1 + V6 match-vector + EKFC 0x801C0006, bind it into the
+	 * port, and commit the v6 node's miss FQID. F-183 already removed
+	 * KG-direct so the SI/match-vector walk is live; F-212 splits the
+	 * parser LCV so QLCV carries V4BIT for v4 frames and V6BIT for v6.
+	 */
+	if (fman_pcd_port_wants_v6(pcd, hw_port_id)) {
+		struct keygen_scheme *v4slot, *v6slot;
+		u8 v4id = 0, v6id = 0;
+		int i, verr;
+
+		/* QUIESCE (vendor configure-before-enable): drain THIS port's BMI
+		 * before narrowing its v4 scheme + arming v6/catch-all + the F-212
+		 * parser LCV split, so no frame is mid-parse/mid-classify through a
+		 * half-programmed scheme table or during the PMDA commit's parser
+		 * stop. Root fix for the dual-port v6 wedge: the LCV split + scheme
+		 * rewrite ran on a LIVE port (board 0353 wedged both ports). Per-port
+		 * only (PCAC + BMI are per-port); the sibling stays up. Re-enabled at
+		 * every exit below and after the F-212 split. fman_port_disable()
+		 * returns 0 even on drain timeout ('forced down'), so treat any
+		 * return as quiesced. */
+		(void)fman_port_disable(rxport);
+
+		mutex_lock(lock);
+		v4slot = kg_find_port_scheme(keygen, hw_port_id, &v4id);
+		if (!v4slot) {
+			mutex_unlock(lock);
+			fman_port_enable(rxport);
+			pr_warn("fman_pcd fe_arm: F-211 v4 slot vanished; v6 arm skipped\n");
+			return 0;
+		}
+
+		/* find a free scheme slot for v6 (first-fit under the lock) */
+		v6slot = NULL;
+		for (i = 0; i < FM_KG_MAX_NUM_OF_SCHEMES; i++) {
+			if (!keygen->schemes[i].used) {
+				v6id = (u8)i;
+				v6slot = &keygen->schemes[i];
+				break;
+			}
+		}
+		if (!v6slot) {
+			mutex_unlock(lock);
+			fman_port_enable(rxport);
+			pr_warn("fman_pcd fe_arm: F-211 no free scheme slot for v6; v6 arm skipped\n");
+			return 0;
+		}
+
+		/* 1) v4 scheme: match only IPv4 frames now (was mv=0 = match-all) */
+		v4slot->match_vector = 0x40000000U;
+		v4slot->used = false;
+		(void)keygen_scheme_setup(keygen, v4id, true);
+
+		/* 2) v6 scheme: clone the v4 slot, then override for IPv6 */
+		*v6slot = *v4slot;
+		v6slot->hw_port_id    = hw_port_id;
+		v6slot->next_engine   = 3;		/* AC_CC */
+		v6slot->cc_base_offset = 1;		/* CCOBASE=1 -> table1 node (F-210) */
+		v6slot->cc_bits_sel   = 0;
+		v6slot->match_vector  = 0x80000000U;
+		v6slot->ekfc          = 0x801C0006U;	/* PORT_ID|SIP|DIP|PROTO|SPORT|DPORT */
+		v6slot->used          = false;
+		verr = keygen_scheme_setup(keygen, v6id, true);
+		if (verr) {
+			v6slot->used = false;
+			mutex_unlock(lock);
+			fman_port_enable(rxport);
+			pr_warn("fman_pcd fe_arm: F-211 v6 scheme_setup failed (%d); v6 arm skipped\n", verr);
+			return 0;
+		}
+
+		/* 3) bind the v6 scheme into this port's scheme partition */
+		(void)keygen_bind_port_to_schemes(keygen, v6id, true);
+
+		/* 4) CATCH-ALL scheme: without it, frames that are neither IPv4 nor
+		 * IPv6 (ARP, IPv6 ND, multicast, L2) match no scheme -> NO_SCHEME
+		 * storm -> deaf port (2026-08-19 board result). Every frame confirms
+		 * the ETH HXS (slot 0), so a scheme with mv=CATCHALLBIT (the slot-0
+		 * bit set by F-212) matches ALL frames. It MUST have a higher scheme
+		 * id than v4/v6 so the ascending SI-walk hits v4/v6 first for IP
+		 * frames (which carry CATCHALLBIT too) and only falls through to the
+		 * catch-all for non-IP frames. Clone the v4 slot (AC_CC, CCOBASE=0,
+		 * table0, own-port miss FQID) so a non-IP frame does table0 ehash
+		 * MISS -> own-port RX FQ -> kernel, exactly as today's mv=0 scheme.
+		 */
+		{
+			struct keygen_scheme *caslot = NULL;
+			u8 caid = 0;
+			int cerr, j;
+
+			for (j = 0; j < FM_KG_MAX_NUM_OF_SCHEMES; j++) {
+				if (!keygen->schemes[j].used) {
+					caid = (u8)j;
+					caslot = &keygen->schemes[j];
+					break;
+				}
+			}
+			if (caslot) {
+				*caslot = *v4slot;		/* AC_CC, CCOBASE=0, table0, own fqid */
+				caslot->hw_port_id   = hw_port_id;
+				caslot->match_vector = 0x20000000U;
+				caslot->used         = false;
+				cerr = keygen_scheme_setup(keygen, caid, true);
+				if (cerr) {
+					caslot->used = false;
+					pr_warn("fman_pcd fe_arm: F-211 catch-all scheme_setup failed (%d)\n", cerr);
+				} else {
+					(void)keygen_bind_port_to_schemes(keygen, caid, true);
+					pr_info("fman_pcd fe_arm: F-211 catch-all scheme %u armed on port 0x%02x (mv=%#x)\n",
+						caid, hw_port_id, 0x20000000U);
+				}
+			} else {
+				pr_warn("fman_pcd fe_arm: F-211 no free slot for catch-all; non-IP frames will NO_SCHEME\n");
+			}
+		}
+		mutex_unlock(lock);
+
+		/* 5) v6 node word3 = the v6 scheme's own base FQID (same port/pool
+		 * as v4 per E25). The node lives at gro+16 (F-210).
+		 */
+		fman_pcd_fe_v6node_set_miss_nia(pcd, fe_enter_off, miss_fqid);
+		/* Resume this port only after all scheme/LCV/node state is coherent. */
+		fman_port_enable(rxport);
+		pr_info("fman_pcd fe_arm: F-211 v6 scheme %u armed on port 0x%02x (v4 scheme %u mv=%#x, v6 mv=%#x, CCOBASE=1)\n",
+			v6id, hw_port_id, v4id, 0x40000000U, 0x80000000U);
+	}
+
 	return 0;
 }
 EXPORT_SYMBOL_GPL(fman_pcd_kg_port_arm_fe);

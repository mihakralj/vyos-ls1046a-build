+/* F-210(v6-enable-gate): IPv6 FE offload master switch. 2026-08-21:
+ * DEFAULT ON. IPv6 now uses the SAME dual-lane match-all scheme + per-
+ * port 46-byte table as IPv4 (F-224/F-225); the old v6-only machinery
+ * this gate once armed (gro+16 node, CCOBASE=1 second scheme, parser
+ * LCV split) is dead code via F-226, so enabling v6 is safe and makes
+ * v6 behave exactly like v4 (offloaded whenever ASK is engaged and the
+ * frame is routed TCP/UDP). Kept as a param only so an operator can
+ * force v6 OFF for debugging.
+ */
+static bool fman_pcd_v6_enable = true;
+/* 0644: runtime-writable via
+ * /sys/module/fsl_dpaa_fman/parameters/v6_enable (fman_pcd.c compiles
+ * into the built-in fsl_dpaa_fman module — the cmdline form is
+ * fsl_dpaa_fman.v6_enable=0 to disable, NOT fman_pcd.v6_enable). Read
+ * at each engage/disengage, so a change takes effect on the next
+ * re-arm.
+ */
+module_param_named(v6_enable, fman_pcd_v6_enable, bool, 0644);
+MODULE_PARM_DESC(v6_enable,
+		 "IPv6 FE offload (default 1, same as IPv4; set 0 to force "
+		 "v6 flows to software for debugging, then re-engage ASK)");
+
+bool fman_pcd_v6_enabled(void)
+{
+	return fman_pcd_v6_enable;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_v6_enabled);
+
+/* F-219: per-port IPv6 arm intent, keyed by hw_port_id (file-scope so
+ * no struct fman_pcd deref is needed at this point in the file). One
+ * FMan on this board; hw_port_id is unique within it. */
+static DECLARE_BITMAP(fman_pcd_fe_port_v6, 64);
+
+/* Set/clear one RX port's v6-arm intent. ask.ko calls this immediately
+ * before fman_pcd_fe_engage(); no hardware is touched. */
+void fman_pcd_fe_set_port_v6(struct fman *fm, u8 hw_port_id, bool enable)
+{
+	(void)fm;
+	if (hw_port_id >= 64)
+		return;
+	if (enable)
+		set_bit(hw_port_id, fman_pcd_fe_port_v6);
+	else
+		clear_bit(hw_port_id, fman_pcd_fe_port_v6);
+	pr_info("fman_pcd: F-219 port 0x%02x v6 intent=%u\n",
+		hw_port_id, enable ? 1 : 0);
+}
+EXPORT_SYMBOL_GPL(fman_pcd_fe_set_port_v6);
+
+/* True when v6 should arm on this port: global master AND per-port bit. */
+bool fman_pcd_port_wants_v6(struct fman_pcd *pcd, u8 hw_port_id)
+{
+	(void)pcd;
+	(void)hw_port_id;
+	/* F-226(no-lcv): the dual-lane 46-byte key (F-224) carries both
+	 * families in ONE match-all scheme + ONE per-port table, so the v6
+	 * scheme-clone / parser LCV-split / catch-all machinery (F-211/F-212/
+	 * F-214, gated solely by this predicate) must NEVER run -- it is the
+	 * D-1-proven dual-v6 PRS_HDR_ERR|CLS_DISCARD wedge. v6 admission is
+	 * gated separately by fman_pcd_v6_enabled() + ask.v6_offload. */
+	return false;
+}
 

+	/* All real interfaces need their ports initialized.
+	 *
+	 * For proxy children, the proxy already enabled the FMan port
+	 * during its probe. Disable it first so our PCD callbacks (set
+	 * via fm_port_pcd_bind() inside dpaa_eth_init_ports()) take
+	 * effect when the port is re-enabled by dpa_start().
+	 */
+	if (of_device_is_compatible(dpa_node->parent, "fsl,dpa-ethernet-init")) {

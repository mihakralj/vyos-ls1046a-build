From: vyos-ls1046a-build CI <ci@local>
Date: Wed, 26 Aug 2026 00:00:00 +0000
Subject: [PATCH] dpaa: AF_XDP qmap debugfs/channels, RX eligibility, NAPI refill, TX ZC backpressure

Consolidates 0082 (qmap-debugfs-dedicated-channels) + 0083
(rx-xsk-branch-eligibility-probe) + 0084 (napi-hooked-bman-refill) +
0085 (tx-zc-and-inflight-backpressure) into one patch: the tail four
patches of this file's own "0079-0085: ethtool counters, NAPI
distribution, XSK datapath" section, authored 2026-05-27/28, applied in
strict sequence with nothing else interleaved.

Verified against the real CI checkpoint commits in the persistent
kernel-git-cache (run 34560348600, checkpoints b8a864c4cbea "applied:
0081..." to d4be276f6f9f "applied: 0085..."), round-trip verified
byte-identical via `patch -p1`.

Touches: af_xdp_pool_main.c, dpaa_eth.{c,h}, dpaa_ethtool.c,
dpaa_flavor.h.

Signed-off-by: vyos-ls1046a-build CI <ci@local>
---
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
@@ -166,8 +166,6 @@
 #define DPAA_RX_PRIV_DATA_SIZE DPAA_RX_PRIV_DATA_DEFAULT_SIZE
 #endif
 
-#define DPAA_ETH_PCD_RXQ_NUM	128
-
 #define DPAA_ENQUEUE_RETRIES	100000
 
 enum port_type {RX, TX};
@@ -981,12 +979,66 @@
 		case FQ_TYPE_RX_ERROR:
 			dpaa_setup_ingress(priv, fq, &fq_cbs->rx_errq);
 			break;
-		case FQ_TYPE_RX_PCD:
+		case FQ_TYPE_RX_PCD: {
+			u16 band_idx;
+			u16 band_size;
+
 			if (!num_portals)
 				continue;
 			dpaa_setup_ingress(priv, fq, &fq_cbs->rx_defq);
-			fq->channel = channels[portal_cnt++ % num_portals];
+
+			/* M3-3 step 2c: dedicated banding.
+			 *
+			 * Replace round-robin PCD-FQ -> portal mapping with
+			 * contiguous-banding mapping. Round-robin
+			 * (channels[portal_cnt % num_portals]) scatters
+			 * consecutive PCD FQs across every CPU portal; with
+			 * FMan KeyGen output landing on FQ index =
+			 * hash % DPAA_ETH_PCD_RXQ_NUM, back-to-back frames
+			 * of the same flow can hit different portals when
+			 * their KG hashes fall on adjacent indices.
+			 *
+			 * Banding instead pins each contiguous
+			 *   band_size = DPAA_ETH_PCD_RXQ_NUM / num_portals
+			 * block of FQs to one portal, so a flow stays on
+			 * one CPU as long as its hash stays in the same
+			 * band.
+			 *
+			 * Concretely on LS1046A (num_portals=4,
+			 * DPAA_ETH_PCD_RXQ_NUM=128):
+			 *   band 0: FQs   0..31  -> channels[0] -> CPU 0
+			 *   band 1: FQs  32..63  -> channels[1] -> CPU 1
+			 *   band 2: FQs  64..95  -> channels[2] -> CPU 2
+			 *   band 3: FQs  96..127 -> channels[3] -> CPU 3
+			 *
+			 * Eliminates HOLDACTIVE arbitration: each band's
+			 * 32 FQs now resolve on ONE portal/CPU rather than
+			 * arbitrating across all four. This also populates
+			 * priv->qmap[band].fqid_base / swp_id so the
+			 * af_xdp_pool flavor module (patch 0082) can find
+			 * the right channel for an XSK-bound qband without
+			 * re-deriving it, and so the qmap debugfs node
+			 * starts showing non-zero columns.
+			 *
+			 * Spec: specs/dpaa1-afxdp-modernization-spec.md
+			 * sec 5.2.
+			 */
+			band_size = max_t(u16, 1u,
+					  DPAA_ETH_PCD_RXQ_NUM /
+					  (u16)num_portals);
+			band_idx = portal_cnt / band_size;
+			if (band_idx >= num_portals)
+				band_idx = num_portals - 1;
+			fq->channel = channels[band_idx];
+
+			if (band_idx < priv->xsk_max_qbands &&
+			    priv->qmap[band_idx].fqid_base == 0) {
+				priv->qmap[band_idx].fqid_base = fq->fqid;
+				priv->qmap[band_idx].swp_id    = fq->channel;
+			}
+			portal_cnt++;
 			break;
+		}
 		case FQ_TYPE_TX:
 			dpaa_setup_egress(priv, fq, tx_port,
 					  &fq_cbs->egress_ern);
@@ -2454,11 +2506,35 @@
 		 * a single NULL deref under RCU, no behaviour change.
 		 * Spec sec 5.4 RX path step 5.
 		 */
-		rcu_read_lock();
-		ops = rcu_dereference(priv->qmgmt_ops);
-		if (ops && ops->xsk_set_rx_need_wakeup)
-			ops->xsk_set_rx_need_wakeup(priv, np);
-		rcu_read_unlock();
+rcu_read_lock();
+ops = rcu_dereference(priv->qmgmt_ops);
+if (ops && ops->xsk_set_rx_need_wakeup)
+ops->xsk_set_rx_need_wakeup(priv, np);
+
+/* M3-3 step 4 (patch 0084): NAPI-hooked BMan refill from the
+ * XSK fill ring. Reuses the local `ops` (no second
+ * rcu_dereference), folded into the same RCU read-section as
+ * xsk_set_rx_need_wakeup. With no XSK pool bound the callback
+ * walks zero bound qbands and returns immediately. Spec sec
+ * 6.1.3.
+ */
+if (ops && ops->napi_refill)
+ops->napi_refill(priv);
+
+/* M3-3 step 5 (patch 0085): NAPI-hooked TX ZC submission and
+ * tx-need-wakeup arming. Same RCU read-section, reuses the
+ * local `ops`. napi_tx_zc drains the XSK Tx ring into the
+ * DPAA1 egress FQs (xsk_tx_peek_release_desc_batch ->
+ * qman_enqueue) honouring the software xsk_tx_inflight budget.
+ * xsk_set_tx_need_wakeup arms tx-need-wakeup when the budget
+ * is exhausted OR the Tx ring drained. Spec sec 6.1.4.
+ */
+if (ops && ops->napi_tx_zc)
+ops->napi_tx_zc(priv);
+if (ops && ops->xsk_set_tx_need_wakeup)
+ops->xsk_set_tx_need_wakeup(priv, np);
+
+rcu_read_unlock();
 
 		qman_p_irqsource_add(np->p, QM_PIRQ_DQRI);
 	} else if (np->down) {
@@ -2476,6 +2552,31 @@
 {
 	struct sk_buff	*skb;
 
+	/* M3-3 step 5 (patch 0085): give the flavor module first crack
+	 * at the TxConf FD. If it returns true, the FD belonged to an
+	 * XSK qband (bpid matched priv->xsk_bpid[q]); the flavor has
+	 * called xsk_tx_completed() and atomic_dec'd xsk_tx_inflight;
+	 * we MUST NOT run dpaa_cleanup_tx_fd() on it (no skb backing
+	 * -- the FD's DMA address is an XSK UMEM chunk still owned by
+	 * the pool). Strictly NAPI-context. With no flavor module
+	 * loaded (default flavor) ops is NULL and the fast path falls
+	 * through to the existing skb cleanup verbatim. Spec sec 6.1.4
+	 * round-trip closure.
+	 */
+	{
+		const struct dpaa_qmgmt_ops *ops;
+
+		rcu_read_lock();
+		ops = rcu_dereference(priv->qmgmt_ops);
+		if (ops && ops->tx_conf_zc &&
+		    ops->tx_conf_zc((struct dpaa_priv *)priv, fd)) {
+			rcu_read_unlock();
+			percpu_priv->tx_confirm++;
+			return;
+		}
+		rcu_read_unlock();
+	}
+
 	if (unlikely(be32_to_cpu(fd->status) & FM_FD_STAT_TX_ERRORS)) {
 		if (net_ratelimit())
 			netif_warn(priv, hw, net_dev, "FD status = 0x%08x\n",
@@ -2733,6 +2834,27 @@
 	if (!dpaa_bp)
 		return qman_cb_dqrr_consume;
 
+	/* M3-3 step 3 (patch 0083): observational xsk-RX branch-eligibility
+	 * probe. Map the FD's FQID to a qband via the qmap[] populated by
+	 * dpaa_fq_setup() (patch 0082b), then RCU-deref priv->xsk_pool[band].
+	 * If a pool is bound, bump priv->xsk_rx_branch. Strictly diagnostic --
+	 * no change to packet handling. The actual ZC redirect (xdp_buff
+	 * recovery + bpf_prog_run_xdp + xdp_do_redirect into the XSK RX ring)
+	 * lands in patch 0084+. With no XSK pool ever bound (default flavor)
+	 * the rcu_dereference returns NULL on every FD and this branch is
+	 * effectively dead code, preserving byte-identical mainline behaviour.
+	 */
+	{
+		u16 _band = dpaa_fq_to_qband(priv, fq->fqid);
+		struct xsk_buff_pool *_xp;
+
+		rcu_read_lock();
+		_xp = rcu_dereference(priv->xsk_pool[_band]);
+		if (_xp)
+			priv->xsk_rx_branch++;
+		rcu_read_unlock();
+	}
+
 	/* Trace the Rx fd */
 	trace_dpaa_rx_fd(net_dev, fq, &dq->fd);
 
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
@@ -133,6 +133,13 @@
 
 /* AF_XDP zerocopy constants (Phase 2). See spec sec 5.3. */
 #define DPAA1_XSK_MAX_QBANDS        4
+
+/* PCD RX FQ count per netdev (shared with dpaa_eth.c).
+ * FMan KeyGen distributes ingress across this many FQs via
+ * 5-tuple hash mod DPAA_ETH_PCD_RXQ_NUM. Used by dpaa_fq_to_qband()
+ * (below) and by dpaa_fq_setup() FQ allocation in dpaa_eth.c.
+ */
+#define DPAA_ETH_PCD_RXQ_NUM        128
 #define DPAA1_XSK_INITIAL_SEED      8192
 #define DPAA1_XSK_REFILL_THRESHOLD  256
 #define DPAA1_XSK_MIN_DEPTH         64
@@ -249,7 +256,39 @@
 	u64 xsk_mtu_reject;
 	u64 xsk_pamu_window_fail;
 
-	/* M3 (Phase 3a): qband -> { FQ base, SWP, CPU, NAPI } resource map.
+	/* M3-3 step 3 (patch 0083): per-FD observation that an FD
+	 * arrived on a qband with a bound XSK pool. Bumped from the
+	 * rx_default_dqrr branch-eligibility probe. Currently strictly
+ * observational -- the actual ZC redirect lands in 0084+.
+ */
+u64 xsk_rx_branch;
+
+/* M3-3 step 4 (patch 0084): bumped once per non-empty
+ * xsk_buff_alloc_batch() -> bman_release() round-trip inside
+ * the NAPI-hooked BMan refill callback. Observability for
+ * spec sec 6.1.3 "refill discipline".
+ */
+u64 xsk_bman_refill_batches;
+
+/* M3-3 step 5 (patch 0085): bumped once per non-empty
+ * xsk_tx_peek_release_desc_batch() -> qman_enqueue() round-trip
+ * inside the NAPI-hooked TX ZC submission callback. Pairs with
+ * xsk_tx_backpressure (already exposed since 0079) for spec sec
+ * 6.1.4 "Strict Tx backpressure" observability. Counts FDs
+ * actually submitted to QMan, NOT FDs the XSK ring offered.
+ */
+u64 xsk_tx_zc_submit;
+
+/* M3-3 step 5 (patch 0085): bumped once per XSK-bpid FD claimed
+ * by the flavor module's tx_conf_zc hook in the dpaa_tx_conf()
+ * path. Pairs with xsk_tx_zc_submit; under steady state the two
+ * counters track within the in-flight budget (DPAA1_XSK_TX_MAX_INFLIGHT
+ * = 1024). xsk_tx_zc_submit - xsk_tx_conf_zc == current inflight
+ * across all qbands (summed). Spec sec 6.1.4 round-trip closure.
+ */
+u64 xsk_tx_conf_zc;
+
+/* M3 (Phase 3a): qband -> { FQ base, SWP, CPU, NAPI } resource map.
 	 * Populated by the flavor module's pcd_ops->install. With no flavor
 	 * module loaded the array stays zeroed and the spec's "qmap[]
 	 * empty" branch is taken (single-queue mainline behaviour).
@@ -275,12 +314,36 @@
  */
 static inline u16 dpaa_fq_to_qband(struct dpaa_priv *priv, u32 fqid)
 {
-	/* Phase 3a: until the flavor module wires up the PCD FQID base
-	 * and per-qband distribution stride, every FQID maps to qband 0
-	 * (kernel-domain default). The flavor module replaces this
-	 * inline at runtime via the qmgmt_ops dispatch (spec sec 5.4).
-	 */
-	(void)fqid;
+	/* M3-3 step 3 (patch 0083): real PCD-FQID -> qband mapping using
+	 * the contiguous-banding qmap[].fqid_base populated by dpaa_fq_setup()
+	 * at probe time (patch 0082b). Each band owns DPAA_ETH_PCD_RXQ_NUM /
+	 * priv->xsk_max_qbands contiguous FQIDs starting at qmap[band].fqid_base.
+	 * For LS1046A defaults (DPAA_ETH_PCD_RXQ_NUM=128, xsk_max_qbands=4):
+	 *   band 0 = [base0 .. base0+31]
+	 *   band 1 = [base1 .. base1+31]
+	 *   band 2 = [base2 .. base2+31]
+	 *   band 3 = [base3 .. base3+31]
+	 * FQIDs outside every band's range (kernel-domain default FQs etc.)
+	 * map to band 0 -- the kernel-domain default -- so callers can safely
+	 * use the result as an array index into priv->xsk_pool[].
+	 */
+	unsigned int n = priv->xsk_max_qbands;
+	u32 stride;
+	u16 b;
+
+	if (!n || n > DPAA1_XSK_MAX_QBANDS)
+		return 0;
+	stride = DPAA_ETH_PCD_RXQ_NUM / n;
+	if (!stride)
+		return 0;
+	for (b = 0; b < n; b++) {
+		u32 base = priv->qmap[b].fqid_base;
+
+		if (!base)
+			continue;
+		if (fqid >= base && fqid < base + stride)
+			return b;
+	}
 	return 0;
 }
 
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c b/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
@@ -67,6 +67,10 @@
 	"xsk_headroom_reject",
 	"xsk_mtu_reject",
 	"xsk_pamu_window_fail",
+	"xsk_rx_branch",
+"xsk_bman_refill_batches",
+"xsk_tx_zc_submit",
+"xsk_tx_conf_zc",
 };
 
 #define DPAA_STATS_PERCPU_LEN ARRAY_SIZE(dpaa_stats_percpu)

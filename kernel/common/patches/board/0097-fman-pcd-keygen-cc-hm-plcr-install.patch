diff --git a/drivers/net/ethernet/freescale/fman/fman_keygen.c b/drivers/net/ethernet/freescale/fman/fman_keygen.c
--- a/drivers/net/ethernet/freescale/fman/fman_keygen.c
+++ b/drivers/net/ethernet/freescale/fman/fman_keygen.c
@@ -8,6 +8,7 @@
 #include <linux/slab.h>
 
 #include "fman_keygen.h"
+#include "fman_keygen_internal.h"
 
 /* Maximum number of HW Ports */
 #define FMAN_MAX_NUM_OF_HW_PORTS		64
@@ -90,9 +91,36 @@
 
 /* NIA values */
 #define NIA_ENG_BMI			0x00500000
+#define NIA_ENG_PLCR			0x004C0000
+/* KGSE_MODE NIA action bit: select the policer profile id in the low bits of
+ * the mode NIA as an ABSOLUTE (global) profile slot rather than a per-port
+ * relative index resolved through the (unprogrammed) FMPL_PMR window. Matches
+ * the SDK CC/keygen->policer path (fm_plcr.c: nia |= NIA_ENG_PLCR |
+ * NIA_PLCR_ABSOLUTE | absoluteProfileId). RM 8.7.4. Fits KG_NIA_AC_MASK.
+ */
+#define NIA_PLCR_ABSOLUTE		0x00008000
 #define NIA_BMI_AC_ENQ_FRAME		0x00000002
 #define ENQUEUE_KG_DFLT_NIA		(NIA_ENG_BMI | NIA_BMI_AC_ENQ_FRAME)
 
+/* KGSE_MODE next-action selector: when set, the scheme's next engine is the
+ * Policer (the mode NIA points at NIA_ENG_PLCR and KGSE_PPC carries the
+ * absolute profile id). When clear, the default BMI-enqueue path is used.
+ * RM 8.7.4 (KGSE_MODE). 0xC04C0000 = EN | NIA_PLCR_SELECT | NIA_ENG_PLCR.
+ */
+#define KG_SCH_MODE_NIA_PLCR		0x40000000
+
+/* KGSE_MODE next-action selector for Coarse Classification (CC): the mode NIA
+ * points at the FMan-controller CC action (NIA_ENG_FM_CTL | NIA_FM_CTL_AC_CC)
+ * and the CCOBASE field (bits 27:24) carries the CC group-table base index.
+ * KGSE_CCBS carries the hash-bit selection. RM 8.7.4 (KGSE_MODE).
+ * For the static single-group/single-entry CC tree (board patch 0098) both
+ * CCOBASE and CCBS are 0, so KGSE_MODE(CC) = EN | NIA_ENG_FM_CTL |
+ * NIA_FM_CTL_AC_CC = 0x80000006 and KGSE_CCBS = 0.
+ */
+#define NIA_ENG_FM_CTL			0x00000000
+#define NIA_FM_CTL_AC_CC		0x00000006
+#define KG_SCH_MODE_CCOBASE_SHIFT	24
+
 /* Hard-coded configuration:
  * These values are used as hard-coded values for KeyGen configuration
  * and they replace user selections for this hard-coded version
@@ -193,44 +221,6 @@
 	u32 fmkg_ar;	/* 0x1FC: KeyGen Action Register */
 };
 
-/* KeyGen Scheme data */
-struct keygen_scheme {
-	bool used;	/* Specifies if this scheme is used */
-	u8 hw_port_id;
-		/* Hardware port ID
-		 * schemes sharing between multiple ports is not
-		 * currently supported
-		 * so we have only one port id bound to a scheme
-		 */
-	u32 base_fqid;
-		/* Base FQID:
-		 * Must be between 1 and 2^24-1
-		 * If hash is used and an even distribution is
-		 * expected according to hash_fqid_count,
-		 * base_fqid must be aligned to hash_fqid_count

-	u32 hash_fqid_count;
-		/* FQ range for hash distribution:
-		 * Must be a power of 2
-		 * Represents the range of queues for spreading
-		 */
-	bool use_hashing;	/* Usage of Hashing and spreading over FQ */
-	bool symmetric_hash;	/* Symmetric Hash option usage */
-	u8 hashShift;
-		/* Hash result right shift.
-		 * Select the 24 bits out of the 64 hash result.
-		 * 0 means using the 24 LSB's, otherwise
-		 * use the 24 LSB's after shifting right
-		 */
-	u32 match_vector;	/* Match Vector */
-};
-
-/* KeyGen driver data */
-struct fman_keygen {
-	struct keygen_scheme schemes[FM_KG_MAX_NUM_OF_SCHEMES];
-				/* Array of schemes */
-	struct fman_kg_regs __iomem *keygen_regs;	/* KeyGen registers */
-};
 
 /* keygen_write_ar_wait
  *
@@ -455,7 +445,7 @@
  *
  * Return: Zero for success or error code in case of failure
  */
-static int keygen_bind_port_to_schemes(struct fman_keygen *keygen,
+int keygen_bind_port_to_schemes(struct fman_keygen *keygen,
 				       u8 scheme_id,
 					bool bind)
 {
@@ -495,6 +485,7 @@
 
 	return 0;
 }
+EXPORT_SYMBOL_GPL(keygen_bind_port_to_schemes);
 
 /* keygen_scheme_setup
  *
@@ -506,7 +497,7 @@
  *
  * Return: Zero for success or error code in case of failure
  */
-static int keygen_scheme_setup(struct fman_keygen *keygen, u8 scheme_id,
+int keygen_scheme_setup(struct fman_keygen *keygen, u8 scheme_id,
 			       bool enable)
 {
 	struct fman_kg_regs __iomem *keygen_regs = keygen->keygen_regs;
@@ -534,12 +525,67 @@
 	if (enable) {
 		/* Enable Scheme */
 		tmp_reg |= KG_SCH_MODE_EN;
-		/* Enqueue frame NIA */
-		tmp_reg |= ENQUEUE_KG_DFLT_NIA;
+		if (scheme->next_engine == 1) {
+			/* Next engine = Policer: route the frame to the
+			 * policer profile in scheme->policer_profile_id. The
+			 * profile's own per-colour NIA (programmed by
+			 * fman_pcd_plcr) then decides enqueue vs drop. The
+			 * destination FQID still comes from kgse_fqb below.
+			 *
+			 * The profile id is RELATIVE (NIA_PLCR_ABSOLUTE clear,
+			 * mode 0xc04c0000): KGSE_PPC carries the id with
+			 * shift=0/mask=0, and the KeyGen resolves it through the
+			 * RX port's relative->absolute policer-profile window
+			 * FMPL_PMR[hwPortId-1], which plcr_set_port_window() in
+			 * fman_pcd_plcr programs at policer-attach (BASE=
+			 * profile_id, NUM=1, VALID).  The SDK uses relative
+			 * addressing for private per-port profiles and reserves
+			 * NIA_PLCR_ABSOLUTE for the PLCR->PLCR shared-profile
+			 * chaining case only.  Without the window programmed the
+			 * BMI has no valid profile for the port and drops every
+			 * frame *before* metering (BUG 3a: counters frozen at 0).
+			 * 2026-06-09
+			 */
+			tmp_reg |= KG_SCH_MODE_NIA_PLCR | NIA_ENG_PLCR;
+			scheme_regs.kgse_ppc = scheme->policer_profile_id;
+		} else if (scheme->next_engine == 2) {
+			/* Next engine = Coarse Classification: route the
+			 * frame into the installed CC group table. CCOBASE
+			 * (bits 27:24) selects the CC group; CCBS (kgse_ccbs
+			 * below) selects which hash bits index the entry. The
+			 * CC tree-root MURAM base is programmed separately at
+			 * the BMI RX port (FMBM_RCCB) via
+			 * fman_port_set_cc_base().
+			 */
+			tmp_reg |= NIA_ENG_FM_CTL | NIA_FM_CTL_AC_CC |
+				(scheme->cc_base_offset <<
+				 KG_SCH_MODE_CCOBASE_SHIFT);

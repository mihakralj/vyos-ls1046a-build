From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VyOS LS1046A CI <ci@vyos-ls1046a>
Date: Tue, 10 Jun 2026 01:20:00 +0000
Subject: [PATCH] fman: add debugfs CC steering test harness (M3-3b
 DUT-validation trigger)

The fman_cc_tree_install() consumer API (0098 + 0106) has no in-tree
caller yet, so the M3-3b acceptance gate (spec sec 5.4: tree installs,
KGSE_CCBS grafts, exact-match key steers, miss falls through, detach
restores) cannot be exercised on the DUT.  Add a per-FMan debugfs node

  /sys/kernel/debug/fman_pcd/<N>/cc_test

whose write handler drives the EXACT 0106 productive sequence:

  install <hwport> <qband> <proto> <src_ip> <dst_ip> <dport>
    -> fman_pcd_cc_static_install()   (one IPv4 exact-match key)
    -> fman_pcd_cc_static_get_base()
    -> fman_pcd_kg_port_attach_cc()   (the KGSE_CCBS graft)
  clear <hwport>
    -> fman_pcd_kg_port_detach_cc()   (detach FIRST)
    -> fman_pcd_cc_static_destroy()

and whose read handler prints one line per installed tree including the
group-table MURAM offset (== the value grafted into KGSE_CCBS, for
cross-checking against an ask-pcd-regdump.py scheme dump).

New TU fman_pcd_cc_test.c links into fsl_dpaa_fman.ko alongside the
other PCD TUs; the tree-walk lives in a new intra-module
fman_pcd_cc_seq_dump() helper in fman_pcd_cc.c so struct
fman_pcd_cc_tree stays private to that TU (no fragile shadow-struct).
Hooked from fman_pcd_init()'s existing per-instance debugfs dir.
Debug/bring-up surface only - 0600 root-only node, zero datapath cost
when unused, no new EXPORT_SYMBOLs.

Native arm64 compile of fman/: 0 warnings, 0 errors;
fman_pcd_cc_test.o links into built-in.a.
---

patch-series-cleanup (2026-09-11): split. New file(s) below moved to
kernel/common/files/ as plain tracked source (a 'new file mode' hunk IS
the file's content, so tracking it directly carries no diff-drift risk
vs upstream); copied into place by ci-setup-kernel.sh before this
(now much smaller) patch applies. New files that moved:
  drivers/net/ethernet/freescale/fman/fman_pcd_cc_test.c
---
diff --git a/drivers/net/ethernet/freescale/fman/Makefile b/drivers/net/ethernet/freescale/fman/Makefile
--- a/drivers/net/ethernet/freescale/fman/Makefile
+++ b/drivers/net/ethernet/freescale/fman/Makefile
@@ -6,6 +6,6 @@
 obj-$(CONFIG_FSL_FMAN) += fsl_dpaa_mac.o
 
 fsl_dpaa_fman-objs	:= fman_muram.o fman.o fman_sp.o fman_keygen.o
-fsl_dpaa_fman-$(CONFIG_FSL_FMAN_PCD) += fman_pcd.o fman_pcd_kg.o fman_pcd_cc.o fman_pcd_manip.o fman_pcd_plcr.o
+fsl_dpaa_fman-$(CONFIG_FSL_FMAN_PCD) += fman_pcd.o fman_pcd_kg.o fman_pcd_cc.o fman_pcd_manip.o fman_pcd_plcr.o fman_pcd_cc_test.o
 fsl_dpaa_fman_port-objs := fman_port.o
 fsl_dpaa_mac-objs:= mac.o fman_dtsec.o fman_memac.o fman_tgec.o
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -275,10 +275,12 @@
 		snprintf(name, sizeof(name), "%d", fman_get_id(fman));
 		pcd->debugfs_dir = debugfs_create_dir(name,
 						      fman_pcd_debugfs_root);
-		if (!IS_ERR_OR_NULL(pcd->debugfs_dir))
+		if (!IS_ERR_OR_NULL(pcd->debugfs_dir)) {
 			debugfs_create_file("muram_budget", 0444,
 					    pcd->debugfs_dir, pcd,
 					    &fman_pcd_muram_budget_fops);
+			fman_pcd_cc_test_debugfs_init(pcd->debugfs_dir, pcd);
+		}
 	}
 
 	dev_info(fman_get_dev(fman),
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd_cc.c b/drivers/net/ethernet/freescale/fman/fman_pcd_cc.c
--- a/drivers/net/ethernet/freescale/fman/fman_pcd_cc.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd_cc.c
@@ -55,6 +55,7 @@
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/slab.h>
+#include <linux/seq_file.h>
 #include <linux/types.h>
 
 #include <linux/fsl/fman_pcd.h>
@@ -403,6 +404,32 @@
 }
 
 /*
+ * fman_pcd_cc_seq_dump() - one summary line per installed CC tree.
+ * Debug helper for the cc_test debugfs node (fman_pcd_cc_test.c); keeps
+ * struct fman_pcd_cc_tree private to this TU.  Intra-module, not exported.
+ */
+void fman_pcd_cc_seq_dump(struct fman_pcd *pcd, struct seq_file *m)
+{
+	struct fman_pcd_cc_tree *t;
+	struct list_head *head;
+
+	head = fman_pcd_get_cc_list(pcd);
+	if (!head)
+		return;
+
+	mutex_lock(fman_pcd_get_lock(pcd));
+	if (list_empty(head))
+		seq_puts(m, "(no CC trees installed)\n");
+	else
+		list_for_each_entry(t, head, node)
+			seq_printf(m,
+				   "port 0x%02x: %u keys, group=0x%lx match=0x%lx ad=0x%lx\n",
+				   t->port_id, t->num_keys, t->group_off,
+				   t->match_off, t->ad_off);
+	mutex_unlock(fman_pcd_get_lock(pcd));
+}
+
+/*
  * fman_pcd_cc_static_get_base() - fetch the MURAM byte offset of a port's
  * installed static CC tree root (its group table).
  *
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h b/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
--- a/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
@@ -48,4 +48,11 @@
 struct fman_pcd_cc_tree;
 u32 fman_pcd_cc_tree_group_table_off(const struct fman_pcd_cc_tree *t);
 
+/* Debug helpers (fman_pcd_cc.c / fman_pcd_cc_test.c).  Intra-module. */
+struct seq_file;
+struct dentry;
+void fman_pcd_cc_seq_dump(struct fman_pcd *pcd, struct seq_file *m);
+void fman_pcd_cc_test_debugfs_init(struct dentry *parent,
+				   struct fman_pcd *pcd);
+
 #endif /* __FMAN_PCD_INTERNAL_H */

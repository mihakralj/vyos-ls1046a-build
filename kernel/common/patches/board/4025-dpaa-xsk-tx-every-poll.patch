@@ -3273,6 +3273,16 @@ static int dpaa_eth_poll(struct napi_struct *napi, int budget)
 	if (np->xdp_act & XDP_REDIRECT)
 		xdp_do_flush();
 
+	/* Flavor Tx drain and confirmation completion run on every poll, not

+/*
+ * Build the full FE-VM descriptor chain for hardware flow dispatch.
+ * Composes the debugfs-proven verbs in bring-up order.  Non-fatal:
+ * returns 0 or -errno; caller decides whether to roll back.
+ */
+static int __fman_pcd_fe_build_vm_chain(struct fman_pcd *pcd)
+{
+	int err;
+
+	/* Defaults: 5-tuple IPv4, CRC-64, 13-byte key, 32K buckets */
+	const u32 ehash_mask    = 0x7FFF;
+	const u8  ehash_key_sz  = 13;
+	const u8  ehash_shift   = 0;
+	const u32 tx_fqid       = 0x200;  /* TODO: dedicated offload TX FQ */
+
+	err = fman_pcd_fe_pool_get(pcd);
+	if (err)
+		return err;
+
+	err = fman_pcd_fe_singletons_build(pcd);
+	if (err)
+		return err;
+
+	err = fman_pcd_ehash_table_set(pcd, ehash_mask,
+				       ehash_key_sz, ehash_shift);
+	if (err)
+		return err;
+
+	err = fman_pcd_fe_hash_build(pcd);
+	if (err)
+		return err;
+
+	err = fman_pcd_fe_enq_build(pcd, tx_fqid, 0);
+	if (err)
+		return err;
+
+	/*
+	 * FE_ENTER root AD links the classifier to the FE chain.
+	 * Use the first ENQ FE's MURAM offset as the chain head.
+	 * TODO: store enq_off for future flow_add() use.
+	 */
+	{
+		struct fman_pcd_fe_obj *e;
+
+		if (list_empty(&pcd->fe_enq))
+			return -ENOENT;
+
+		e = list_first_entry(&pcd->fe_enq,
+				     struct fman_pcd_fe_obj, node);
+		err = fman_pcd_fe_enter_build(pcd, e->muram_off);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}

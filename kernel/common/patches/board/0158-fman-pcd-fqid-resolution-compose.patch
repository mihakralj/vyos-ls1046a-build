+/*
+ * Resolve the port's default RX frame-queue ID from its FM_CTL params
+ * page (+0x0C).  Falls back to 0x200 if the page is not set up.
+ * Rule T8: FQID from authoritative source, never hardcoded.
+ */
+static unsigned int fman_pcd_resolve_miss_fqid(struct fman_pcd *pcd,
+					       u8 hw_port_id)
+{
+	struct fman *fman = fman_pcd_get_fman(pcd);
+	struct fman_port *port;
+	u32 params_off;
+	struct muram_info *muram;
+	void __iomem *page;
+
+	if (!fman)
+		return 0x200;
+
+	port = fman_port_lookup_rx(fman, hw_port_id);
+	if (!port)
+		return 0x200;
+
+	params_off = fman_port_get_params_page(port);
+	if (!params_off)
+		return 0x200;
+
+	muram = fman_get_muram(fman);
+	if (!muram)
+		return 0x200;
+
+	page = fman_muram_offset_to_vbase(muram, params_off);
+	if (!page)
+		return 0x200;
+
+	return ioread32be((u32 __iomem *)((u8 __iomem *)page +
+					  FMAN_PP_RX_DEFAULT_FQID_OFF));
+}

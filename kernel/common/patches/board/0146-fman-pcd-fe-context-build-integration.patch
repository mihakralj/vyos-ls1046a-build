From: ASK2 Phase 2 integration v2
Subject: [PATCH] fman_pcd: FE-VM context builder call during fe_arm engage (0146)

Patch 0135 defines fman_pcd_fe_context_build() but never calls it.
The FE-VM cannot dispatch flow lookups without runtime context
programmed into the VM's working store.  This patch:

1. Adds fman_pcd_fe_build_contexts() — builds ENQ/MUX/Transition
   contexts in one pass over the dormant chain's FE objects.
2. Calls it from fman_pcd_fe_arm_engage() immediately before the
   pr_info() that logs "ENGAGED", so context build + arm are a
   single atomic operation.

The additive function sits right after fman_pcd_fe_hashfe_fops (the
stable anchor point 0132 uses), so git apply --3way lands it cleanly
regardless of later patch context drift.

v2: void* pointer arithmetic fix: ioread32be((u32 __iomem *)fe + 1)
    not ioread32be(fe + 1).

Signed-off-by: ASK2 Phase 2
---
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -2106,6 +2106,118 @@ static const struct file_operations fman_pcd_fe_hashfe_fops = {
 	.llseek		= seq_lseek,
 	.release	= single_release,
 };
+
+/*
+ * Build FE-VM runtime contexts after the full dormant chain is assembled.
+ * Called by fe_arm engage before reprogramming KeyGen/BMI.
+ * Contexts live in each FE object's MURAM working-store area.
+ */
+static void fman_pcd_fe_build_contexts(struct fman_pcd *pcd)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_obj *enq;
+	struct fman_pcd_fe_context_params p = {};
+	void __iomem *fe;
+	u32 fqid;
+
+	if (!muram)
+		return;
+
+	/* ENQ context: read FQID from the built ENQ FE descriptor. */
+	enq = list_first_entry_or_null(&pcd->fe_enq,
+				       struct fman_pcd_fe_obj, node);
+	if (enq) {
+		fe = fman_muram_offset_to_vbase(muram, enq->muram_off);
+		fqid = ioread32be((u32 __iomem *)fe + 1) & 0x00FFFFFFu;
+		if (fqid) {
+			p.type = FMAN_FE_TYPE_ENQ;
+			p.u.enq.fqid = fqid;
+			fman_pcd_fe_context_build(fe,
+				FMAN_FE_ENQ_CTX_OFF, &p);
+		}
+	}
+
+	/* MUX context: HIT -> ENQ */
+	if (pcd->fe_mux_off && enq) {
+		fe = fman_muram_offset_to_vbase(muram, pcd->fe_mux_off);
+		memset(&p, 0, sizeof(p));
+		p.type = FMAN_FE_TYPE_MUX;
+		p.u.mux.next_fe_off = enq->muram_off;
+		fman_pcd_fe_context_build(fe, FMAN_FE_MUX_CTX_OFF, &p);
+	}
+
+	/* Transition: MISS -> Exit (deallocate) */
+	if (pcd->fe_transition_off && pcd->fe_exit_off) {
+		fe = fman_muram_offset_to_vbase(muram,
+					pcd->fe_transition_off);
+		memset(&p, 0, sizeof(p));
+		p.type = FMAN_FE_TYPE_TRANSITION;
+		p.u.transition.next_ad_off = pcd->fe_exit_off;
+		fman_pcd_fe_context_build(fe, FMAN_FE_TRANSITION_CTX_OFF, &p);
+	}
+}
+
+/* ---- FE-VM engage/flow API for ask.ko (board 0150, Phase 2) ---- */
+int fman_pcd_fe_engage(struct fman *fm, u8 hw_port_id)
+{
+	struct fman_pcd *pcd; unsigned long enter_off; u8 saved_engine; int err;
+	if (!fm || hw_port_id < 0x08 || hw_port_id >= 0x28) return -EINVAL;
+	pcd = fman_get_pcd(fm); if (!pcd) return -ENXIO;
+	mutex_lock(&pcd->fe_lock);
+	if (pcd->fe_refcount > 0) { mutex_unlock(&pcd->fe_lock); return -EBUSY; }
+	err = fman_pcd_fe_pool_alloc(pcd); if (err) goto out_unlock;
+	err = fman_pcd_fe_singletons_build(pcd); if (err) goto rollback_pool;
+	err = fman_pcd_ehash_table_set(pcd, 0x7FFF, 12, 0); if (err) goto rollback_singletons;
+	err = fman_pcd_fe_hash_build(pcd); if (err) goto rollback_ehash;
+	err = fman_pcd_fe_enq_build(pcd, 0x200, 0); if (err) goto rollback_hashfe;
+	err = fman_pcd_fe_enter_build(pcd, 0); if (err) goto rollback_enq;
+	pcd->fe_refcount = 1; enter_off = pcd->fe_root_ad_off; mutex_unlock(&pcd->fe_lock);
+	fman_pcd_fe_build_contexts(pcd);
+	err = fman_pcd_kg_port_arm_fe(pcd, hw_port_id, (u32)enter_off, &saved_engine);
+	if (err) { pr_err("fman_pcd: AC_CC arm failed port 0x%02x: %d\n", hw_port_id, err); mutex_lock(&pcd->fe_lock); goto rollback_enter; }
+	pr_info("fman_pcd: FE engage port 0x%02x ENTER=0x%lx (AC_CC)\n", hw_port_id, enter_off);
+	return 0;
+rollback_enter: fman_pcd_fe_enter_free(pcd);
+rollback_enq: fman_pcd_fe_enq_free(pcd);
+rollback_hashfe: fman_pcd_fe_hash_free(pcd);
+rollback_ehash: fman_pcd_ehash_drain(pcd);
+rollback_singletons: fman_pcd_fe_singletons_free(pcd);
+rollback_pool: fman_pcd_fe_pool_free(pcd); pcd->fe_refcount = 0;
+out_unlock: mutex_unlock(&pcd->fe_lock); return err;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_fe_engage);
+
+void fman_pcd_fe_disengage(struct fman *fm, u8 hw_port_id)
+{
+	struct fman_pcd *pcd = fman_get_pcd(fm);
+	if (!pcd) return;
+	mutex_lock(&pcd->fe_lock); if (pcd->fe_refcount == 0) { mutex_unlock(&pcd->fe_lock); return; }
+	fman_pcd_kg_port_disarm_fe(pcd, hw_port_id, 0);
+	fman_pcd_fe_enter_free(pcd); fman_pcd_fe_enq_free(pcd); fman_pcd_fe_hash_free(pcd);
+	fman_pcd_ehash_drain(pcd); fman_pcd_fe_singletons_free(pcd); fman_pcd_fe_pool_free(pcd);
+	pcd->fe_refcount = 0; mutex_unlock(&pcd->fe_lock);
+	pr_info("fman_pcd: FE disengage port 0x%02x\n", hw_port_id);
+}
+EXPORT_SYMBOL_GPL(fman_pcd_fe_disengage);
+
+int fman_pcd_fe_flow_add(struct fman *fm, u8 hw_port_id, const u8 *key, u8 key_size, unsigned long enq_off)
+{ return -EOPNOTSUPP; }
+EXPORT_SYMBOL_GPL(fman_pcd_fe_flow_add);
+
+int fman_pcd_fe_flow_del(struct fman *fm, u8 hw_port_id, const u8 *key, u8 key_size)
+{ return -EOPNOTSUPP; }
+EXPORT_SYMBOL_GPL(fman_pcd_fe_flow_del);
+
 
 /*
  * fe_arm - arm the FE-VM datapath on a single FMan RX port (Phase 1
@@ -2132,6 +2132,9 @@
+ 	if (err)
+ 		return err;
+ 
++	/* Build FE-VM runtime contexts before logging ENGAGED (0146). */
++	fman_pcd_fe_build_contexts(pcd);
++
+ 	pr_info("fman_pcd fe_arm: port 0x%02x ENGAGED FE_ENTER=0x%lx (AC_CC)\n",
+ 		port_id, fe_enter_off);
+ 	return 0;

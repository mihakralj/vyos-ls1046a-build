From: Claude Sonnet 5 <noreply@anthropic.com>
Subject: [PATCH] ask2(T-M6-2 B1): add the bridge FDB CC key packer

Adds cc_pack_key_l2() and CC_KEY_SIZE_L2 (15 bytes: PORT_ID + DST_MAC +
SRC_MAC + ETHERTYPE), the leaf-level building block for T-M6-2 B1
(plans/ASK2-BRIDGE-OFFLOAD-PLAN.md). Requires patch 0204 (adds the
src_mac/ethertype_be struct fields this depends on).

Byte layout is silicon-confirmed: see 0204's changelog for the .106
scheme-11 register readback (keysize=15). Field order (DA before SA
before ETYPE) follows this project's consistent "PORT_ID|DA|SA|ETYPE"
documentation convention; not independently byte-order-verified since
B1 is dormant (readback-only, no live install) -- re-derive before B2
arms this on silicon if it turns out to matter.

Scope, deliberately bounded, mirroring T-M6-T3's own delivery: this is
the packer + KUnit pin only (B1's own stated gate: "KUnit vectors for
DA-only and PORT_ID|DA|SA|ETYPE keys; spec byte-exact vs a golden
vector" -- exactly what this delivers). Marked __maybe_unused. NOT
wired into fman_pcd_cc_bridge_key_add/remove (B1's host-shadow-to-spec
assembly layer, a separate follow-on), not armed via any KeyGen
scheme-attach path, not reachable from ask.ko's bridge switchdev stub
(still B0's dormant lifecycle-only stub, unfilled per B3).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GooC2zFmzRBYLikPbwekuH
---
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd_cc.c b/drivers/net/ethernet/freescale/fman/fman_pcd_cc.c
--- a/drivers/net/ethernet/freescale/fman/fman_pcd_cc.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd_cc.c
@@ -653,8 +908,66 @@
 	row = (u8 __force *)match + (size_t)idx * 2 * CC_KEY_SIZE_3TUPLE;
 	memcpy_toio((void __iomem *)row, key, CC_KEY_SIZE_3TUPLE);
 	memcpy_toio((void __iomem *)(row + CC_KEY_SIZE_3TUPLE), msk, CC_KEY_SIZE_3TUPLE);
 }
 
+#define CC_KEY_SIZE_L2	15U
+
+/*
+ * T-M6-2 B1 bridge FDB match key: PORT_ID + DST_MAC + SRC_MAC + ETHERTYPE.
+ * Board-confirmed byte-exact against the vendor's own L2/bridge KeyGen
+ * scheme on .106 (scheme 11, EKFC 0xe4000000 = PORT_ID|MACDST|MACSRC|
+ * ETYPE, by far the highest live-traffic scheme observed -- 1,225,734
+ * packets): live group-table row (CCOBASE=0) keysize field = 15,
+ * matching this layout exactly. Resolves the "open silicon question"
+ * patch 0202's comment flagged for the match-key byte layout. PORT_ID
+ * is byte 0, deterministically 0x00 on this ucode (same finding as
+ * cc_pack_key_dual_pid()/cc_pack_key_3tuple() above). Field order
+ * (DA before SA before ETYPE) follows this project's consistent
+ * "PORT_ID|DA|SA|ETYPE" documentation convention -- not independently
+ * byte-order-verified beyond the aggregate keysize match, since B1 is
+ * dormant (readback-only, no live install); re-derive before B2 arms
+ * this on silicon if the order turns out to matter differently.
+ *
+ * Any DA/SA/ETYPE field left absent in @k->present leaves its key/mask
+ * bytes zero (wildcard), per B1's stated gate: "KUnit vectors for
+ * DA-only and PORT_ID|DA|SA|ETYPE keys."
+ *
+ * __maybe_unused: not yet wired into fman_pcd_cc_bridge_key_add/remove
+ * (B1's host-shadow-to-spec assembly layer, not built by this patch) or
+ * any live install path. Pinned by tests/fman_pcd_cc_l2_key_test.c.
+ */
+static void __maybe_unused cc_pack_key_l2(void __iomem *match, u16 idx,
+					  const struct fman_pcd_cc_hw_key *k)
+{
+	u8 key[CC_KEY_SIZE_L2];
+	u8 msk[CC_KEY_SIZE_L2];
+	u8 *row;
+
+	memset(key, 0, sizeof(key));
+	memset(msk, 0, sizeof(msk));
+
+	/* byte 0: PORT_ID, deterministically 0x00 on this ucode. */
+	msk[0] = 0xff;
+
+	if (k->present & FMAN_PCD_CC_HW_F_MAC_DST) {
+		memcpy(&key[1], k->dst_mac, 6);
+		memset(&msk[1], 0xff, 6);
+	}
+	if (k->present & FMAN_PCD_CC_HW_F_MAC_SRC) {
+		memcpy(&key[7], k->src_mac, 6);
+		memset(&msk[7], 0xff, 6);
+	}
+	if (k->present & FMAN_PCD_CC_HW_F_ETHERTYPE) {
+		key[13] = (u8)(k->ethertype_be & 0xff);
+		key[14] = (u8)(k->ethertype_be >> 8);
+		msk[13] = msk[14] = 0xff;
+	}
+
+	row = (u8 __force *)match + (size_t)idx * 2 * CC_KEY_SIZE_L2;
+	memcpy_toio((void __iomem *)row, key, CC_KEY_SIZE_L2);
+	memcpy_toio((void __iomem *)(row + CC_KEY_SIZE_L2), msk, CC_KEY_SIZE_L2);
+}
+
 /*
  * Encode one leaf (result) action descriptor at AD row @idx - SDK-convergent
  * RESULT AD (0115; SDK FillAdOfTypeResult, sdk_fm_cc.c:2227-2343).
@@ -909,4 +966,5 @@
 #if IS_ENABLED(CONFIG_FSL_FMAN_PCD_KUNIT_TEST)
 #include "tests/fman_pcd_cc_dual_key_test.c"
 #include "tests/fman_pcd_cc_3tuple_key_test.c"
+#include "tests/fman_pcd_cc_l2_key_test.c"
 #endif /* CONFIG_FSL_FMAN_PCD_KUNIT_TEST */

+/* Bad-page hunt (plans/ASK2-WIREGUARD-FASTPATH-PLAN.md, 2026-11-09): FMan RX
+ * DMA'd a received frame into a live page table, so a BMan pool held the
+ * address of a page the kernel had already freed.  Pool buffers are order-0
+ * pages the driver holds a reference on: a buffer page with no reference, or
+ * with a page type (buddy, page table, slab), is a stale pool entry.  Checked
+ * where software returns buffers to BMan and where an RX frame is dequeued;
+ * a stale buffer is reported and leaked, never handed on.
+ * fsl_dpa.buf_check=0 turns the check off.
+ */
+static bool buf_check = true;
+module_param(buf_check, bool, 0644);
+MODULE_PARM_DESC(buf_check, "Report and leak BMan buffers whose page the driver does not own");
+static atomic64_t dpaa_buf_stale = ATOMIC64_INIT(0);
+
+bool dpaa_buf_stale_check(dma_addr_t addr, u8 bpid, const char *where);
+bool dpaa_buf_stale_check(dma_addr_t addr, u8 bpid, const char *where)
+{
+	static DEFINE_RATELIMIT_STATE(rs, 5 * HZ, 8);
+	unsigned long pfn = PHYS_PFN(addr);
+	struct page *page;
+	u64 n;
+
+	if (!READ_ONCE(buf_check))
+		return false;
+	page = pfn_valid(pfn) ? pfn_to_page(pfn) : NULL;
+	if (likely(page && page_ref_count(page) > 0 && !page_has_type(page)))
+		return false;
+	n = atomic64_inc_return(&dpaa_buf_stale);
+	WARN_ONCE(1, "dpaa: stale BMan buffer %pad bpid %u at %s\n",
+		  &addr, bpid, where);
+	if (__ratelimit(&rs)) {
+		pr_err("dpaa: stale BMan buffer %pad bpid %u at %s: ref %d type 0x%x (%llu so far)\n",
+		       &addr, bpid, where, page ? page_ref_count(page) : -1,
+		       page ? data_race(page->page_type) : 0, n);
+		if (page)
+			dump_page(page, "dpaa stale BMan buffer");
+	}
+	return true;
+}

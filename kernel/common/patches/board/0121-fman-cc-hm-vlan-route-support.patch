+ * gap (VLAN_STRIP-only) before the ask.ko rewire (R4c).
+ *   POP+route : VLAN_STRIP, RMV_ETHERNET, INSRT_GENERIC(L2), IPV4_FORWARD
+ *   PUSH+route: RMV_ETHERNET, INSRT_GENERIC(L2), IPV4_FORWARD, VLAN_INSERT
+ */
+static int cc_test_install_vlanr(struct fman_pcd *pcd, const char *args)
+{
+	struct fman_pcd_cc_hw_spec *spec = NULL;
+	struct fman_pcd_hm_hw_spec hm;
+	struct fman_pcd_hm_hw_op *op;
+	struct fman_port *rxport;
+	struct fman *fm;
+	char src_str[40], dst_str[40], dir[8], dmac[24], smac[24];
+	u32 src_ip, dst_ip, fqid, cc_base, hm_handle = 0;
+	u32 fe_miss_off = 0, ad_off;
+	unsigned int tpid = 0x8100, pcp = 0, i;
+	struct muram_info *muram;
+	void __iomem *group, *ad, *fe;
+	u8 port_id, proto, dmb[ETH_ALEN], smb[ETH_ALEN];
+	u16 sport, dport, vid;
+	bool is_push;
+	int n, err;
+
+	n = sscanf(args,
+		   "install_vlanr %hhi %hhu %39s %39s %hu %hu %x %7s %hu %23s %23s %x %u %x",
+		   &port_id, &proto, src_str, dst_str, &sport, &dport, &fqid,
+		   dir, &vid, dmac, smac, &tpid, &pcp, &fe_miss_off);
+	if (n < 11 || n > 14 || port_id >= ARRAY_SIZE(cc_test_vlan_hm) ||
+	    !(proto == 6 || proto == 17) || !fqid)
+		return -EINVAL;
+	is_push = !strcmp(dir, "push");
+	if (!is_push && strcmp(dir, "pop"))
+		return -EINVAL;
+	if (is_push && (vid == 0 || vid > 4094 || tpid > 0xffff || pcp > 7))
+		return -EINVAL;
+	if (!in4_pton(src_str, -1, (u8 *)&src_ip, -1, NULL) ||
+	    !in4_pton(dst_str, -1, (u8 *)&dst_ip, -1, NULL))
+		return -EINVAL;
+	if (!mac_pton(dmac, dmb) || !mac_pton(smac, smb))
+		return -EINVAL;
+
+	fm = fman_pcd_get_fman(pcd);
+	if (!fm)
+		return -ENODEV;
+	if (cc_test_vlan_hm[port_id])
+		return -EBUSY;
+
+	memset(&hm, 0, sizeof(hm));
+	if (is_push) {
+		hm.ops[0].type = FMAN_PCD_HM_HW_OP_RMV_ETHERNET;
+		op = &hm.ops[1];
+		op->type = FMAN_PCD_HM_HW_OP_INSRT_GENERIC;
+		op->insrt_generic.size = 2 * ETH_ALEN + 2;
+		memcpy(&op->insrt_generic.hdr[0], dmb, ETH_ALEN);
+		memcpy(&op->insrt_generic.hdr[ETH_ALEN], smb, ETH_ALEN);
+		op->insrt_generic.hdr[2 * ETH_ALEN]     = 0x08;
+		op->insrt_generic.hdr[2 * ETH_ALEN + 1] = 0x00;
+		op = &hm.ops[2];
+		op->type = FMAN_PCD_HM_HW_OP_IPV4_FORWARD;
+		op->ipv4_forward.dec_ttl = 1;
+		op->ipv4_forward.l4_csum = 1;
+		op = &hm.ops[3];
+		op->type = FMAN_PCD_HM_HW_OP_VLAN_INSERT;
+		op->vlan_insert.tpid_be = (u16)tpid;
+		op->vlan_insert.vid = vid;
+		op->vlan_insert.pcp = (u8)pcp;
+		hm.num_ops = 4;
+	} else {
+		hm.ops[0].type = FMAN_PCD_HM_HW_OP_VLAN_STRIP;
+		hm.ops[1].type = FMAN_PCD_HM_HW_OP_RMV_ETHERNET;
+		op = &hm.ops[2];
+		op->type = FMAN_PCD_HM_HW_OP_INSRT_GENERIC;
+		op->insrt_generic.size = 2 * ETH_ALEN + 2;
+		memcpy(&op->insrt_generic.hdr[0], dmb, ETH_ALEN);
+		memcpy(&op->insrt_generic.hdr[ETH_ALEN], smb, ETH_ALEN);
+		op->insrt_generic.hdr[2 * ETH_ALEN]     = 0x08;
+		op->insrt_generic.hdr[2 * ETH_ALEN + 1] = 0x00;
+		op = &hm.ops[3];
+		op->type = FMAN_PCD_HM_HW_OP_IPV4_FORWARD;
+		op->ipv4_forward.dec_ttl = 1;
+		op->ipv4_forward.l4_csum = 1;
+		hm.num_ops = 4;
+	}
+
+	err = fman_pcd_hm_install(pcd, port_id, &hm, &hm_handle);
+	if (err)
+		return err;
+
+	spec = kzalloc(sizeof(*spec), GFP_KERNEL);
+	if (!spec) {
+		err = -ENOMEM;
+		goto out_put_hm;
+	}
+	spec->num_keys = 1;
+	spec->keys[0].present = FMAN_PCD_CC_HW_F_ETHERTYPE |
+			       FMAN_PCD_CC_HW_F_PROTO |
+			       FMAN_PCD_CC_HW_F_SRC_IP |
+			       FMAN_PCD_CC_HW_F_DST_IP |
+			       FMAN_PCD_CC_HW_F_SRC_PORT |
+			       FMAN_PCD_CC_HW_F_DST_PORT;
+	spec->keys[0].ethertype_be = cpu_to_be16(ETH_P_IP);
+	spec->keys[0].proto = proto;
+	spec->keys[0].src_ip_be = src_ip;
+	spec->keys[0].dst_ip_be = dst_ip;
+	spec->keys[0].src_port_be = cpu_to_be16(sport);
+	spec->keys[0].dst_port_be = cpu_to_be16(dport);
+	spec->keys[0].target_fqid = fqid;
+	spec->keys[0].hm_handle = hm_handle;
+
+	err = fman_pcd_cc_static_install(pcd, port_id, spec);
+	kfree(spec);
+	spec = NULL;
+	if (err)
+		goto out_put_hm;
+
+	err = fman_pcd_cc_static_get_base(pcd, port_id, &cc_base);
+	if (err)
+		goto out_destroy_cc;
+
+	/*
+	 * R4c-pre coexistence gate: when @fe_miss_off is supplied, overwrite the
+	 * trailing CC MISS AD row (row num_keys == 1) with the FE_ENTER AD's four
+	 * words BEFORE the tree is attached. Topology:
+	 *   RCCB -> CC tree -- VLAN key HIT -> NADEN VLANR HMTD -> TX FQ
+	 *                   `- MISS -> FE_ENTER -> ehash routed/NAT
+	 * F-182 pre-live AD-copy applied to the miss row; a post-attach overwrite
+	 * faults the FMan controller (RM 5.12.14.1 FMFP_EXTC sync).
+	 */
+	if (fe_miss_off) {
+		muram = fman_get_muram(fm);
+		if (!muram) {
+			err = -ENXIO;
+			goto out_destroy_cc;
+		}
+		group = (void __iomem *)fman_muram_offset_to_vbase(muram,
+								   cc_base);
+		ad_off = ioread32be((u32 __iomem *)group) & 0xFFFFFF;
+		if (!ad_off) {
+			err = -EINVAL;
+			goto out_destroy_cc;
+		}
+		ad = (void __iomem *)fman_muram_offset_to_vbase(muram, ad_off);
+		fe = (void __iomem *)fman_muram_offset_to_vbase(muram,
+								fe_miss_off);
+		/* one key => miss row is row 1; each AD row is 16 bytes */
+		ad = (void __iomem *)((u8 __iomem *)ad + 16);
+		for (i = 0; i < 4; i++)
+			iowrite32be(ioread32be((u32 __iomem *)((u8 __iomem *)fe +
+								 4 * i)),
+				    (u32 __iomem *)((u8 __iomem *)ad + 4 * i));
+	}
+
+	rxport = fman_port_lookup_rx(fm, port_id);
+	if (!rxport) {
+		err = -ENODEV;
+		goto out_destroy_cc;
+	}
+	err = fman_pcd_port_ensure_params_page(pcd, rxport);
+	if (err)
+		goto out_destroy_cc;
+	err = fman_port_set_cc_base(rxport, cc_base);
+	if (err)
+		goto out_destroy_cc;
+	err = fman_pcd_kg_port_attach_cc(pcd, port_id, cc_base);
+	if (err) {
+		(void)fman_port_set_cc_base(rxport, 0);
+		goto out_destroy_cc;
+	}
+
+	cc_test_vlan_hm[port_id] = hm_handle;
+	pr_info("fman_pcd cc_test: VLANR-%s port 0x%02x CC base 0x%x HMTD 0x%x -> fqid 0x%x dst %pM src %pM%s\n",
+		is_push ? "PUSH" : "POP", port_id, cc_base, hm_handle, fqid,
+		dmb, smb, fe_miss_off ? " miss->FE coexist" : "");
+	return 0;
+
+out_destroy_cc:
+	(void)fman_pcd_kg_port_detach_cc(pcd, port_id);
+	fman_pcd_cc_static_destroy(pcd, port_id);
+out_put_hm:
+	(void)fman_pcd_hm_destroy(pcd, port_id, hm_handle);
+	return err;
+}

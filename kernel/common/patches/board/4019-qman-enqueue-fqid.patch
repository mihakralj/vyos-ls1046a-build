 static void update_eqcr_ci(struct qman_portal *p, u8 avail)
 {
 	if (avail)
 		qm_eqcr_cce_prefetch(&p->p);
 	else
 		qm_eqcr_cce_update(&p->p);
 }
 
 int qman_enqueue(struct qman_fq *fq, const struct qm_fd *fd)
 {
 	struct qman_portal *p;
 	struct qm_eqcr_entry *eq;
 	unsigned long irqflags;
 	u8 avail;
 
 	p = get_affine_portal();
 	local_irq_save(irqflags);
 
 	if (p->use_eqcr_ci_stashing) {
 		/*
 		 * The stashing case is easy, only update if we need to in
 		 * order to try and liberate ring entries.
 		 */
 		eq = qm_eqcr_start_stash(&p->p);
 	} else {
 		/*
 		 * The non-stashing case is harder, need to prefetch ahead of
 		 * time.
 		 */
 		avail = qm_eqcr_get_avail(&p->p);
 		if (avail < 2)
 			update_eqcr_ci(p, avail);
 		eq = qm_eqcr_start_no_stash(&p->p);
 	}
 
 	if (unlikely(!eq))
 		goto out;
 
 	qm_fqid_set(eq, fq->fqid);
 	eq->tag = cpu_to_be32(fq_to_tag(fq));
 	eq->fd = *fd;
 
 	qm_eqcr_pvb_commit(&p->p, QM_EQCR_VERB_CMD_ENQUEUE);
 out:
 	local_irq_restore(irqflags);
 	put_affine_portal();
 	return 0;
 }
 EXPORT_SYMBOL(qman_enqueue);
 
+/*
+ * Keep the legacy enqueue path unchanged until its callers' full-ring
+ * ownership is audited. This variant reports backpressure and permits a
+ * separately registered software-ERN callback.
+ */
+int qman_enqueue_fqid(struct qman_fq *tag_fq, u32 fqid,
+		      const struct qm_fd *fd)
+{
+	struct qman_portal *p;
+	struct qm_eqcr_entry *eq;
+	unsigned long irqflags;
+	u8 avail;
+
+	p = get_affine_portal();
+	local_irq_save(irqflags);
+
+	if (p->use_eqcr_ci_stashing) {
+		eq = qm_eqcr_start_stash(&p->p);
+	} else {
+		avail = qm_eqcr_get_avail(&p->p);
+		if (avail < 2)
+			update_eqcr_ci(p, avail);
+		eq = qm_eqcr_start_no_stash(&p->p);
+	}
+
+	if (unlikely(!eq))
+		goto out;
+
+	qm_fqid_set(eq, fqid);
+	eq->tag = cpu_to_be32(fq_to_tag(tag_fq));
+	eq->fd = *fd;
+
+	qm_eqcr_pvb_commit(&p->p, QM_EQCR_VERB_CMD_ENQUEUE);
+out:
+	local_irq_restore(irqflags);
+	put_affine_portal();
+	return eq ? 0 : -EBUSY;
+}
+EXPORT_SYMBOL_GPL(qman_enqueue_fqid);

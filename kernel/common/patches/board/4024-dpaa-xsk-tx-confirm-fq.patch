+/* A zero-copy XSK Tx frame on an error path is not an skb: the flavor module
+ * completes its chunk to the XSK ring instead.
+ */
+static bool dpaa_tx_zc_fail(const struct dpaa_priv *priv,
+			    const struct qm_fd *fd)
+{
+	const struct dpaa_qmgmt_ops *ops;
+	bool claimed = false;
+
+	rcu_read_lock();
+	ops = rcu_dereference(priv->qmgmt_ops);
+	if (ops && ops->tx_err_zc)
+		claimed = ops->tx_err_zc((struct dpaa_priv *)priv, fd);
+	rcu_read_unlock();
+	return claimed;
+}
+
 static void dpaa_tx_error(struct net_device *net_dev,
 			  const struct dpaa_priv *priv,
 			  struct dpaa_percpu_priv *percpu_priv,
@@ -3232,6 +3249,9 @@ static void dpaa_tx_error(struct net_device *net_dev,
 
 	percpu_priv->stats.tx_errors++;
 
+	if (dpaa_tx_zc_fail(priv, fd))
+		return;
+
 	skb = dpaa_cleanup_tx_fd(priv, fd, false);
 	dev_kfree_skb(skb);
 }

+/* ── fe_hash_probe: E2 workspace KG-hash readback (§11 Step 3) ── */
+
+#define FMAN_FE_IC_KG_HASH_OFF 0x48
+
+static int fman_pcd_fe_hash_probe_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct fman *fman = fman_pcd_get_fman(pcd);
+	struct muram_info *muram;
+	void __iomem *pool_base = NULL;
+	u64 hw_hash = 0;
+	unsigned long pool_raw_off = 0;
+
+	if (!fman || !(muram = fman_get_muram(fman))) {
+		seq_puts(s, "MURAM not available\n");
+		return 0;
+	}
+
+	mutex_lock(&pcd->fe_lock);
+	if (!list_empty(&pcd->fe_ports)) {
+		struct fman_pcd_fe_port *fp;
+		fp = list_first_entry(&pcd->fe_ports, struct fman_pcd_fe_port, node);
+		pool_raw_off = fp->pool_raw_off;
+		pool_base = (void __iomem *)fman_muram_offset_to_vbase(muram, fp->pool_raw_off);
+	}
+	mutex_unlock(&pcd->fe_lock);
+
+	seq_printf(s, "pool_raw_off:   0x%lx\n", pool_raw_off);
+
+	if (!pool_base) {
+		seq_puts(s, "hw_hash:    (none — fe_port set first)\n");
+	} else {
+		hw_hash  = ((u64)ioread32be((u32 __iomem *)((u8 __iomem *)pool_base + FMAN_FE_IC_KG_HASH_OFF + 0)) << 32);
+		hw_hash |= ((u64)ioread32be((u32 __iomem *)((u8 __iomem *)pool_base + FMAN_FE_IC_KG_HASH_OFF + 4)));
+		seq_printf(s, "hw_hash:    0x%016llx\n", hw_hash);
+	}
+
+	if (pcd->fe_probe_key_len > 0) {
+		u64 sw = fman_pcd_crc64(pcd->fe_probe_key, pcd->fe_probe_key_len);
+		seq_printf(s, "probe_key:  %*phN\n", pcd->fe_probe_key_len, pcd->fe_probe_key);
+		seq_printf(s, "sw_crc:     0x%016llx\n", sw);
+		seq_printf(s, "match:      %s\n",
+			   (pool_base && hw_hash == sw) ? "YES" : "NO (or no hw_hash)");
+	} else {
+		seq_puts(s, "probe_key:  (none — echo hex bytes)\n");
+	}
+
+	return 0;
+}
+
+static int fman_pcd_fe_hash_probe_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_hash_probe_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_hash_probe_write(struct file *file,
+					    const char __user *ubuf,
+					    size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	char raw[64];
+	u8 bytes[32];
+	int i, nb = 0;
+
+	if (count >= sizeof(raw))
+		return -EINVAL;
+	if (copy_from_user(raw, ubuf, count))
+		return -EFAULT;
+	raw[count] = '\0';
+
+	for (i = 0; i < (int)count && nb < 32; i++) {
+		char c = raw[i];
+		u8 v;
+		if (c >= '0' && c <= '9')      v = c - '0';
+		else if (c >= 'a' && c <= 'f') v = c - 'a' + 10;
+		else if (c >= 'A' && c <= 'F') v = c - 'A' + 10;
+		else if (c == ' ' || c == '\n' || c == '\r') continue;
+		else return -EINVAL;
+
+		if (i + 1 < (int)count) {
+			char c2 = raw[i+1];
+			u8 v2;
+			if (c2 >= '0' && c2 <= '9')      v2 = c2 - '0';
+			else if (c2 >= 'a' && c2 <= 'f') v2 = c2 - 'a' + 10;
+			else if (c2 >= 'A' && c2 <= 'F') v2 = c2 - 'A' + 10;
+			else return -EINVAL;
+			bytes[nb++] = (v << 4) | v2;
+			i++;
+		} else {
+			return -EINVAL;
+		}
+	}
+
+	memcpy(pcd->fe_probe_key, bytes, nb);
+	pcd->fe_probe_key_len = nb;
+	return count;
+}
+
+static const struct file_operations fman_pcd_fe_hash_probe_fops = {

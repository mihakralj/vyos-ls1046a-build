From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VyOS LS1046A CI <ci@vyos-ls1046a>
Date: Fri, 18 Jul 2026 01:25:00 +0000
Subject: [PATCH] fman_pcd: port recovery — rebuild FE buffer free-list after
 BMI stall

Adds fman_pcd_port_recover() to recover a stalled/deaf RX port from
FE-VM workspace corruption without requiring a cold boot.  The function
rebuilds the per-port internal FE buffer free-list (FmPortSetFESupport
pool) by zeroing the MURAM pool memory and re-initialising the
management index, then zeroing the depletion counter at params page
+0x58.

Recovery sequence:
 1. Look up the RX port and ensure params page is valid
 2. Read +0x54 (internalFEBufferManagementIndexAddr) and +0x58
 3. If +0x54 is zero, the pool was never armed — nothing to rebuild
 4. Compute pool offset (idx_off - tnums * 512, 256-aligned)
 5. Zero the entire pool memory (tnums * 512 bytes)
 6. Zero the management index (5 + tnums bytes — marks all slots free)
 7. Write +0x58 = 0 (zero depletion counter)
 8. Read-back verify: confirm +0x58 == 0 and +0x54 unchanged
 9. Return 0 on success, -EAGAIN if readback fails, -ENODEV on bad port

Signed-off-by: VyOS LS1046A CI <ci@vyos-ls1046a>
---
 drivers/net/ethernet/freescale/fman/fman_pcd.c | 69 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ ... @@ static const struct file_operations fman_pcd_fe_flow_fops = {
 	.release	= single_release,
 };
 
+/**
+ * fman_pcd_port_recover - rebuild FE buffer free-list after BMI stall
+ * @pcd: FMan PCD instance
+ * @port_id: hardware RX port number (e.g. 0x11 for eth4)
+ *
+ * Port-scoped software de-wedge per dpaa1-afxdp-modernization-spec §5.9.
+ * Rebuilds the internal FE buffer free-list by zeroing the MURAM pool
+ * memory and re-initialising the management index, then zeroing the
+ * depletion counter at params page +0x58.  Returns 0 on success,
+ * -EAGAIN if readback fails (cold boot may be needed).
+ */
+int fman_pcd_port_recover(struct fman_pcd *pcd, u8 port_id)
+{
+	struct fman_port *port;
+	void __iomem *pp, *pool, *idx;
+	u32 pp_off, idx_off, pool_off, v54, v58;
+	u8 tnums;
+	unsigned long pool_sz, idx_sz;
+	struct muram_info *muram;
+	int ret = 0;
+
+	if (!pcd)
+		return -EINVAL;
+	port = fman_port_lookup_rx(pcd->fman, port_id);
+	if (!port)
+		return -ENODEV;
+	pp_off = fman_port_get_params_page(port);
+	if (IS_ERR_VALUE(pp_off))
+		return (int)pp_off;
+	muram = fman_get_muram(pcd->fman);
+	if (!muram)
+		return -EIO;
+	pp = fman_muram_offset_to_vbase(muram, pp_off);
+	if (!pp)
+		return -EIO;
+	v54 = ioread32be((void __iomem *)((u8 __iomem *)pp + 0x54));
+	v58 = ioread32be((void __iomem *)((u8 __iomem *)pp + 0x58));
+	tnums = fman_port_get_total_tnums(port);
+	if (!v54 || !tnums)
+		return 0;
+	idx_off = v54;
+	pool_sz = (unsigned long)tnums * 0x100 * 2;
+	idx_sz = 5UL + tnums;
+	pool_off = (idx_off - pool_sz) & ~0xFFUL;
+	pool = fman_muram_offset_to_vbase(muram, pool_off);
+	if (!pool)
+		return -EIO;
+	memset_io(pool, 0, pool_sz);
+	idx = fman_muram_offset_to_vbase(muram, idx_off);
+	if (!idx)
+		return -EIO;
+	memset_io(idx, 0, idx_sz);
+	iowrite32be(0, (void __iomem *)((u8 __iomem *)pp + 0x58));
+	v58 = ioread32be((void __iomem *)((u8 __iomem *)pp + 0x58));
+	if (v58 != 0)
+		ret = -EAGAIN;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_port_recover);
+
 /**
  * fman_pcd_init() - initialise the PCD subsystem for an FMan instance.
  */
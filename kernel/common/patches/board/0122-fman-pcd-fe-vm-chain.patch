+/*
+ * FE-object pool - arch/fman-fe-ehash.md section 3 (AllocFEObjs).
+ *
+ * Fork B scaffold: a fixed pool of FMAN_PCD_FE_POOL_COUNT fixed-element
+ * (FE) records, each FMAN_PCD_FE_MAX_SIZE bytes, carved from FMan MURAM at
+ * the FMAN_PCD_FE_ALIGN boundary the FE virtual machine requires.  This
+ * step ONLY proves the MURAM allocate/zero/free lifecycle reverts cleanly
+ * (the pcd-snapshot gen_pool "used" gate); it does NOT program the FE
+ * records (no FmPcdCcBuildFE) and does NOT flow traffic - that needs the
+ * FE virtual-machine core in a later sub-step.  Lazy plus refcounted so a
+ * pristine S0 keeps the pool empty.
+ */
+#define FMAN_PCD_FE_ALIGN	8
+#define FMAN_PCD_FE_MAX_SIZE	28
+#define FMAN_PCD_FE_POOL_COUNT	100
+#define FMAN_FE_ROOT_AD_SIZE	16	/* FE_ENTER root AD: 4 words (sec.5) */
+
+struct fman_pcd_fe_obj {
+	struct list_head node;
+	unsigned long muram_off;
+};
+
+static void fman_pcd_fe_pool_free(struct fman_pcd *pcd)
+{
+	struct fman_pcd_fe_obj *obj, *tmp;
+
+	/* sec.5 FE singletons share the pool's MURAM - free them too. */
+	list_for_each_entry_safe(obj, tmp, &pcd->fe_singletons, node) {
+		list_del(&obj->node);
+		fman_pcd_muram_free(pcd, obj->muram_off, FMAN_PCD_FE_MAX_SIZE);
+		kfree(obj);
+	}
+	pcd->fe_mux_off = 0;
+	pcd->fe_transition_off = 0;
+	pcd->fe_exit_off = 0;
+	pcd->fe_hash_off = 0;
+
+	/* sec.5 FE_ENTER root AD is a separate MURAM alloc - free it too. */
+	if (pcd->fe_root_ad_off) {
+		fman_pcd_muram_free(pcd, pcd->fe_root_ad_off,
+				    FMAN_FE_ROOT_AD_SIZE);
+		pcd->fe_root_ad_off = 0;
+	}
+
+	list_for_each_entry_safe(obj, tmp, &pcd->fe_enq, node) {
+		list_del(&obj->node);
+		fman_pcd_muram_free(pcd, obj->muram_off, FMAN_PCD_FE_MAX_SIZE);
+		kfree(obj);
+	}
+	list_for_each_entry_safe(obj, tmp, &pcd->fe_available, node) {
+		list_del(&obj->node);
+		fman_pcd_muram_free(pcd, obj->muram_off, FMAN_PCD_FE_MAX_SIZE);
+		kfree(obj);
+	}
+}
+
+static int fman_pcd_fe_pool_alloc(struct fman_pcd *pcd)
+{
+	struct muram_info *muram;
+	int i, err;
+
+	muram = fman_get_muram(pcd->fman);
+	if (!muram)
+		return -ENXIO;
+
+	for (i = 0; i < FMAN_PCD_FE_POOL_COUNT; i++) {
+		struct fman_pcd_fe_obj *obj;
+		unsigned long off;
+
+		obj = kzalloc(sizeof(*obj), GFP_KERNEL);
+		if (!obj) {
+			err = -ENOMEM;
+			goto unwind;
+		}
+
+		off = fman_pcd_muram_alloc(pcd, FMAN_PCD_FE_MAX_SIZE);
+		if (IS_ERR_VALUE(off)) {
+			kfree(obj);
+			err = (int)off;
+			goto unwind;
+		}
+
+		/* MURAM is iomem and gen_pool does not zero - memset_io. */
+		memset_io((void __iomem *)
+			  fman_muram_offset_to_vbase(muram, off),
+			  0, FMAN_PCD_FE_MAX_SIZE);
+
+		obj->muram_off = off;
+		list_add_tail(&obj->node, &pcd->fe_available);
+	}
+
+	return 0;
+
+unwind:
+	fman_pcd_fe_pool_free(pcd);
+	return err;
+}
+
+/*
+ * Reference-counted engage/disengage.  The first get() builds the pool;
+ * the last put() tears it down.  fe_lock serialises the refcount and is
+ * taken OUTSIDE the muram wrappers' pcd->lock (order: fe_lock ->
+ * pcd->lock), so the pool loops never re-enter pcd->lock on themselves.
+ */
+static int fman_pcd_fe_pool_get(struct fman_pcd *pcd)
+{
+	int err = 0;
+
+	mutex_lock(&pcd->fe_lock);
+	if (pcd->fe_refcount == 0) {
+		err = fman_pcd_fe_pool_alloc(pcd);
+		if (err)
+			goto out;
+	}
+	pcd->fe_refcount++;
+out:
+	mutex_unlock(&pcd->fe_lock);
+	return err;
+}
+
+static void fman_pcd_fe_pool_put(struct fman_pcd *pcd)
+{
+	mutex_lock(&pcd->fe_lock);
+	if (WARN_ON(pcd->fe_refcount == 0)) {
+		mutex_unlock(&pcd->fe_lock);
+		return;
+	}
+	if (--pcd->fe_refcount == 0)
+		fman_pcd_fe_pool_free(pcd);
+	mutex_unlock(&pcd->fe_lock);
+}
+
+static int fman_pcd_fe_pool_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	unsigned int avail = 0, enq = 0;
+	struct list_head *p;
+	int refcount;
+
+	mutex_lock(&pcd->fe_lock);
+	refcount = pcd->fe_refcount;
+	list_for_each(p, &pcd->fe_available)
+		avail++;
+	list_for_each(p, &pcd->fe_enq)
+		enq++;
+	mutex_unlock(&pcd->fe_lock);
+
+	seq_printf(s, "refcount   %10d\n", refcount);
+	seq_printf(s, "available  %10u\n", avail);
+	seq_printf(s, "enqueued   %10u\n", enq);
+	seq_printf(s, "fe_size    %10d bytes\n", FMAN_PCD_FE_MAX_SIZE);
+	seq_printf(s, "pool_bytes %10d bytes\n",
+		   FMAN_PCD_FE_POOL_COUNT * FMAN_PCD_FE_MAX_SIZE);
+	return 0;
+}
+
+static int fman_pcd_fe_pool_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_pool_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_pool_write(struct file *file,
+				      const char __user *ubuf,
+				      size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	char buf[16];
+	char *cmd;
+	int err;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+	cmd = strim(buf);
+
+	if (!strcmp(cmd, "get")) {
+		err = fman_pcd_fe_pool_get(pcd);
+		if (err)
+			return err;
+	} else if (!strcmp(cmd, "put")) {
+		fman_pcd_fe_pool_put(pcd);
+	} else {
+		return -EINVAL;
+	}
+
+	return count;
+}
+
+static const struct file_operations fman_pcd_fe_pool_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_fe_pool_open,
+	.read		= seq_read,
+	.write		= fman_pcd_fe_pool_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/* FM_CTL ctrl-params page FE fields (SDK t_FmPcdCtrlParamsPage). */
+#define FMAN_PP_FE_MGMT_IDX_OFF	0x54
+#define FMAN_PP_FE_DEPL_CNT_OFF	0x58
+/* BMI FIFO unit; FE internal-buffer pool size unit and alignment. */
+#define FMAN_PCD_BMI_FIFO_UNITS	0x100
+
+/*
+ * Per-port FE (frame-engine) internal-buffer support - see
+ * arch/fman-fe-ehash.md section 4 (FmPortSetFESupport).  Each engaged RX
+ * port gets an FE internal-buffer pool in MURAM (total_tnums *
+ * BMI_FIFO_UNITS * 2 bytes, 256-byte aligned) plus a management free-list
+ * (5 + total_tnums bytes) whose MURAM offset is written to the port's
+ * FM_CTL ctrl-params page at +0x54, with the depletion counter (+0x58)
+ * cleared.  Allocate-only scaffold: ships dormant, proves a clean MURAM
+ * lifecycle (pcd-snapshot gen_pool "used" returns to baseline on del).
+ * fe_lock is held across set/del; the muram wrappers take pcd->lock
+ * inside (order fe_lock -> pcd->lock, matching fe_pool).
+ */
+struct fman_pcd_fe_port {
+	struct list_head node;
+	u8 port_id;
+	unsigned long pool_raw_off;	/* unaligned off handed to free() */
+	size_t pool_raw_size;
+	unsigned long mgmt_off;
+	size_t mgmt_size;
+};
+
+static struct fman_pcd_fe_port *
+fman_pcd_fe_port_find(struct fman_pcd *pcd, u8 port_id)
+{
+	struct fman_pcd_fe_port *fp;
+
+	list_for_each_entry(fp, &pcd->fe_ports, node)
+		if (fp->port_id == port_id)
+			return fp;
+	return NULL;
+}
+
+static int fman_pcd_fe_port_set(struct fman_pcd *pcd, u8 port_id)
+{
+	struct fman *fman = fman_pcd_get_fman(pcd);
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_port *fp;
+	struct fman_port *port;
+	unsigned long pool_raw_off, aligned_off, mgmt_off;
+	size_t pool_size, pool_raw_size, mgmt_size;
+	void __iomem *pool_v, *mgmt_v, *page_v;
+	u32 params_off;
+	u8 total_tnums, i;
+	int err;
+
+	if (!muram)
+		return -ENXIO;
+	if (fman_pcd_fe_port_find(pcd, port_id))
+		return -EEXIST;
+
+	port = fman_port_lookup_rx(fman, port_id);
+	if (!port)
+		return -ENODEV;
+
+	/*
+	 * The FM_CTL ctrl-params page is created once per port by a prior
+	 * CC install (fman_pcd_port_ensure_params_page, 0116) and kept for
+	 * the port lifetime.  FE support REQUIRES it - do NOT allocate it
+	 * here (that would leak +256 B that del() never returns, breaking
+	 * the pcd-snapshot reversibility gate).
+	 */
+	params_off = fman_port_get_params_page(port);
+	if (!params_off)
+		return -ENXIO;
+
+	total_tnums = fman_port_get_total_tnums(port);
+	if (!total_tnums)
+		return -EINVAL;
+
+	fp = kzalloc(sizeof(*fp), GFP_KERNEL);
+	if (!fp)
+		return -ENOMEM;
+
+	/*
+	 * (a) FE internal-buffer pool: total_tnums * BMI_FIFO_UNITS * 2
+	 * bytes, 256-byte aligned.  The muram gen_pool only guarantees
+	 * 64-byte alignment, so over-allocate by one BMI_FIFO_UNITS and
+	 * round the offset up; the gap (0/64/128/192 < 256) leaves room.
+	 * free() uses the raw offset/size so muram_used stays symmetric.
+	 */
+	pool_size = (size_t)total_tnums * FMAN_PCD_BMI_FIFO_UNITS * 2;
+	pool_raw_size = pool_size + FMAN_PCD_BMI_FIFO_UNITS;
+	pool_raw_off = fman_pcd_muram_alloc(pcd, pool_raw_size);
+	if (IS_ERR_VALUE(pool_raw_off)) {
+		err = (int)pool_raw_off;
+		goto err_fp;
+	}
+	aligned_off = (pool_raw_off + (FMAN_PCD_BMI_FIFO_UNITS - 1)) &
+		      ~(unsigned long)(FMAN_PCD_BMI_FIFO_UNITS - 1);
+	pool_v = (void __iomem *)fman_muram_offset_to_vbase(muram, aligned_off);
+	memset_io(pool_v, 0, pool_size);
+
+	/*
+	 * (b) management free-list: a 4-byte big-endian pool MURAM offset
+	 * whose MSB byte is then overwritten with the read index (4),
+	 * total_tnums tnum-slot bytes (0..N-1), and a 0xFF terminator.
+	 * This byte layout is the FE silicon ABI - keep it verbatim
+	 * (arch/fman-fe-ehash.md section 4).
+	 */
+	mgmt_size = 5 + total_tnums;
+	mgmt_off = fman_pcd_muram_alloc(pcd, mgmt_size);
+	if (IS_ERR_VALUE(mgmt_off)) {
+		err = (int)mgmt_off;
+		goto err_pool;
+	}
+	mgmt_v = (void __iomem *)fman_muram_offset_to_vbase(muram, mgmt_off);
+	iowrite32be((u32)aligned_off, mgmt_v);		/* [0..3] pool off (BE) */
+	iowrite8(4, mgmt_v);				/* [0] read index = 4 */
+	for (i = 0; i < total_tnums; i++)
+		iowrite8(i, (u8 __iomem *)mgmt_v + 4 + i);
+	iowrite8(0xFF, (u8 __iomem *)mgmt_v + 4 + total_tnums);
+
+	/*
+	 * (c) ctrl-params page: clear the depletion counter (+0x58), then
+	 * publish the management free-list MURAM offset (+0x54).  gen_pool
+	 * offsets are MURAM-relative already (no XX_VirtToPhys like the
+	 * SDK), so the raw mgmt_off is what the FE ucode expects.
+	 */
+	page_v = (void __iomem *)fman_muram_offset_to_vbase(muram, params_off);
+	iowrite32be(0, (u8 __iomem *)page_v + FMAN_PP_FE_DEPL_CNT_OFF);
+	iowrite32be((u32)mgmt_off, (u8 __iomem *)page_v + FMAN_PP_FE_MGMT_IDX_OFF);
+
+	fp->port_id = port_id;
+	fp->pool_raw_off = pool_raw_off;
+	fp->pool_raw_size = pool_raw_size;
+	fp->mgmt_off = mgmt_off;
+	fp->mgmt_size = mgmt_size;
+	list_add_tail(&fp->node, &pcd->fe_ports);
+
+	dev_info(fman_get_dev(pcd->fman),
+		 "fman_pcd: FE support on port 0x%x (tnums %u, pool 0x%lx/%zu B, mgmt 0x%lx/%zu B)\n",
+		 port_id, total_tnums, aligned_off, pool_size,
+		 mgmt_off, mgmt_size);
+	return 0;
+
+err_pool:
+	fman_pcd_muram_free(pcd, pool_raw_off, pool_raw_size);
+err_fp:
+	kfree(fp);
+	return err;
+}
+
+static int fman_pcd_fe_port_del(struct fman_pcd *pcd, u8 port_id)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman *fman = fman_pcd_get_fman(pcd);
+	struct fman_pcd_fe_port *fp;
+	struct fman_port *port;
+	u32 params_off;
+
+	fp = fman_pcd_fe_port_find(pcd, port_id);
+	if (!fp)
+		return -ENOENT;
+
+	/*
+	 * Inverse of set(): unhook the ctrl-params page management index
+	 * (+0x54 = 0) FIRST so the FE stops dereferencing the free-list,
+	 * then free mgmt, then the pool.  Never free silicon-referenced
+	 * MURAM before unpublishing it from the page.
+	 */
+	port = fman_port_lookup_rx(fman, port_id);
+	if (port) {
+		params_off = fman_port_get_params_page(port);
+		if (params_off && muram) {
+			void __iomem *page_v = (void __iomem *)
+				fman_muram_offset_to_vbase(muram, params_off);
+
+			iowrite32be(0, (u8 __iomem *)page_v + FMAN_PP_FE_MGMT_IDX_OFF);
+			iowrite32be(0, (u8 __iomem *)page_v + FMAN_PP_FE_DEPL_CNT_OFF);
+		}
+	}
+
+	fman_pcd_muram_free(pcd, fp->mgmt_off, fp->mgmt_size);
+	fman_pcd_muram_free(pcd, fp->pool_raw_off, fp->pool_raw_size);
+	list_del(&fp->node);
+	dev_info(fman_get_dev(pcd->fman),
+		 "fman_pcd: FE support removed on port 0x%x\n", port_id);
+	kfree(fp);
+	return 0;
+}
+
+static void fman_pcd_fe_port_drain(struct fman_pcd *pcd)
+{
+	struct fman_pcd_fe_port *fp, *tmp;
+
+	list_for_each_entry_safe(fp, tmp, &pcd->fe_ports, node) {
+		fman_pcd_muram_free(pcd, fp->mgmt_off, fp->mgmt_size);
+		fman_pcd_muram_free(pcd, fp->pool_raw_off, fp->pool_raw_size);
+		list_del(&fp->node);
+		kfree(fp);
+	}
+}
+
+static int fman_pcd_fe_port_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct fman_pcd_fe_port *fp;
+
+	mutex_lock(&pcd->fe_lock);
+	if (list_empty(&pcd->fe_ports)) {
+		seq_puts(s, "no FE-support ports\n");
+	} else {
+		list_for_each_entry(fp, &pcd->fe_ports, node)
+			seq_printf(s,
+				   "port 0x%02x pool 0x%lx/%zu B mgmt 0x%lx/%zu B\n",
+				   fp->port_id, fp->pool_raw_off,
+				   fp->pool_raw_size, fp->mgmt_off,
+				   fp->mgmt_size);
+	}
+	mutex_unlock(&pcd->fe_lock);
+	return 0;
+}
+
+static int fman_pcd_fe_port_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_port_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_port_write(struct file *file,
+				      const char __user *ubuf,
+				      size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	char buf[32];
+	u8 port_id;
+	int err;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	mutex_lock(&pcd->fe_lock);
+	if (sscanf(buf, "set %hhx", &port_id) == 1)
+		err = fman_pcd_fe_port_set(pcd, port_id);
+	else if (sscanf(buf, "del %hhx", &port_id) == 1)
+		err = fman_pcd_fe_port_del(pcd, port_id);
+	else
+		err = -EINVAL;
+	mutex_unlock(&pcd->fe_lock);
+
+	return err ? err : count;
+}
+
+static const struct file_operations fman_pcd_fe_port_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_fe_port_open,
+	.read		= seq_read,
+	.write		= fman_pcd_fe_port_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * Flow-Entry (FE) virtual-machine descriptor builder - arch/fman-fe-ehash.md
+ * section 5 FE-VM core, increment 1: descriptor encoding plus the three core
+ * MUX / Transition / Exit singletons.
+ *
+ * Transcribed from the NXP lf-5.4 SDK FmPcdCcBuildFE() and the FM_PCD_Init()
+ * FE-singleton setup, adapted to mainline gen_pool MURAM.  The SDK next-FE
+ * pointer (XX_VirtToPhys(h_NextFE) - physicalMuramBase) is exactly the
+ * gen_pool MURAM offset that fman_pcd_muram_alloc() already returns, so a
+ * next-FE reference stores that offset directly.  Descriptor words are
+ * big-endian MURAM image words (iowrite32be), matching the CC/AD accessor
+ * convention used elsewhere in this driver.
+ *
+ * Ships DORMANT: it PROGRAMS the three core FE singletons into pool slots and
+ * exposes them for byte-level verification (fe_singletons debugfs), but
+ * nothing dispatches into the FE machine until the external-hash table
+ * (section 5), the per-flow ENQ FE, and the AC_CC root-AD FE_ENTER wiring
+ * land in later increments.  Forward (build) and inverse (clear) ship in this
+ * one patch; the inverse restores the exact pre-build pool state, so
+ * pcd-snapshot stays reversible (section 8.6 defensive-coding contract).
+ * ---------------------------------------------------------------------------
+ */
+
+/* FE descriptor type codes (word0 bits 24-29) - SDK fm_pcd.h. */
+#define FMAN_FE_TYPE_HM			0x01000000
+#define FMAN_FE_TYPE_ENQ		0x02000000
+#define FMAN_FE_TYPE_EXIT		0x03000000
+#define FMAN_FE_TYPE_MUX		0x04000000
+#define FMAN_FE_TYPE_TRANSITION		0x05000000
+#define FMAN_FE_TYPE_EXT_HASH		0x06000000
+
+/* FE word0 flag bits. */
+#define FMAN_FE_HM_PAHM			0x00800000
+#define FMAN_FE_ENQ_MPPN		0x00800000
+#define FMAN_FE_ENQ_FQID		0x00010000
+#define FMAN_FE_ENQ_PP			0x00040000
+#define FMAN_FE_ENQ_SP			0x00020000
+#define FMAN_FE_EXIT_DEALLOCATE		0x00800000
+#define FMAN_FE_TRANSITION_AD_FROM_WS	0x00400000
+
+/* FE descriptor sizes (bytes); written word count = size / 4. */
+#define FMAN_FE_HM_SIZE			16
+#define FMAN_FE_ENQ_SIZE		16
+#define FMAN_FE_MUX_SIZE		4
+#define FMAN_FE_EXIT_SIZE		4
+#define FMAN_FE_TRANSITION_SIZE		8
+#define FMAN_FE_MAX_WORDS		(FMAN_PCD_FE_MAX_SIZE / 4)
+
+/* Singleton context working-store offsets (FM_PCD_Init). */
+#define FMAN_FE_MUX_CTX_OFF		0
+#define FMAN_FE_TRANSITION_CTX_OFF	4
+
+struct fman_pcd_fe_params {
+	u32 type;			/* FMAN_FE_TYPE_* */
+	u32 ws_offset;			/* context working-store offset (word0) */
+	u32 flags;			/* extra word0 flag bits */
+	u32 nia;			/* ENQ next-invoked-action (word1) */
+	unsigned long next_fe_off;	/* next-FE MURAM offset */
+	bool next_from_ws;		/* TRANSITION: next-AD from work store */
+};
+
+/*
+ * Encode one FE descriptor into its MURAM slot.  Mirrors FmPcdCcBuildFE():
+ * word0 = wsOffset | type | flags; ENQ carries the NIA in word1; HM and ENQ
+ * put the next-FE offset in word3, TRANSITION in word2 (and only when the
+ * next-AD is not taken from the working store).  Only the first feSize/4
+ * words are written, so the TRANSITION next-FE word is emitted only for that
+ * 2-word descriptor when !next_from_ws, exactly as the SDK does.
+ */
+static void fman_pcd_fe_build(struct muram_info *muram, unsigned long fe_off,
+			      const struct fman_pcd_fe_params *p)
+{
+	u32 __iomem *fe = (u32 __iomem *)
+		fman_muram_offset_to_vbase(muram, fe_off);
+	u32 w[FMAN_FE_MAX_WORDS] = { 0 };
+	unsigned int size = 0, i;
+
+	w[0] = p->ws_offset | p->type | p->flags;
+	switch (p->type) {
+	case FMAN_FE_TYPE_HM:
+		size = FMAN_FE_HM_SIZE;
+		w[3] = (u32)p->next_fe_off;
+		break;
+	case FMAN_FE_TYPE_ENQ:
+		size = FMAN_FE_ENQ_SIZE;
+		w[1] = p->nia;
+		w[3] = (u32)p->next_fe_off;
+		break;
+	case FMAN_FE_TYPE_MUX:
+		size = FMAN_FE_MUX_SIZE;
+		break;
+	case FMAN_FE_TYPE_EXIT:
+		size = FMAN_FE_EXIT_SIZE;
+		break;
+	case FMAN_FE_TYPE_TRANSITION:
+		size = FMAN_FE_TRANSITION_SIZE;
+		if (!p->next_from_ws)
+			w[2] = (u32)p->next_fe_off;
+		break;
+	default:
+		return;
+	}
+
+	for (i = 0; i < size / 4; i++)
+		iowrite32be(w[i], fe + i);
+}
+
+/* Dequeue one pool slot, program it, and park it on the singleton list. */
+static int fman_pcd_fe_singleton_one(struct fman_pcd *pcd,
+				     struct muram_info *muram,
+				     const struct fman_pcd_fe_params *p,
+				     unsigned long *out_off)
+{
+	struct fman_pcd_fe_obj *obj;
+
+	obj = list_first_entry_or_null(&pcd->fe_available,
+				       struct fman_pcd_fe_obj, node);
+	if (!obj)
+		return -ENOSPC;
+
+	list_del(&obj->node);
+	fman_pcd_fe_build(muram, obj->muram_off, p);
+	*out_off = obj->muram_off;
+	list_add_tail(&obj->node, &pcd->fe_singletons);
+	return 0;
+}
+
+/* Inverse of the singleton build: re-zero MURAM, return slots to the pool. */
+static void fman_pcd_fe_singletons_free(struct fman_pcd *pcd)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_obj *obj, *tmp;
+
+	list_for_each_entry_safe(obj, tmp, &pcd->fe_singletons, node) {
+		list_del(&obj->node);
+		if (muram)
+			memset_io((void __iomem *)
+				  fman_muram_offset_to_vbase(muram,
+							     obj->muram_off),
+				  0, FMAN_PCD_FE_MAX_SIZE);
+		list_add_tail(&obj->node, &pcd->fe_available);
+	}
+	pcd->fe_mux_off = 0;
+	pcd->fe_transition_off = 0;
+	pcd->fe_exit_off = 0;
+	pcd->fe_hash_off = 0;
+}
+
+/*
+ * Build the three core FE singletons (MUX, Transition, Exit) into pool slots
+ * in FM_PCD_Init() order.  Requires the pool to be engaged.  On any shortfall
+ * every slot already taken is restored, so the silicon is never left
+ * half-programmed (section 8.6 defensive-coding contract).
+ */
+static int fman_pcd_fe_singletons_build(struct fman_pcd *pcd)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_params p;
+	int err;
+
+	if (!muram)
+		return -ENXIO;
+	if (pcd->fe_refcount == 0)
+		return -ENXIO;		/* engage the pool first */
+	if (!list_empty(&pcd->fe_singletons))
+		return -EEXIST;
+
+	/* MUX: working-store offset 0, no flags, no next-FE. */
+	memset(&p, 0, sizeof(p));
+	p.type = FMAN_FE_TYPE_MUX;
+	p.ws_offset = FMAN_FE_MUX_CTX_OFF;
+	err = fman_pcd_fe_singleton_one(pcd, muram, &p, &pcd->fe_mux_off);
+	if (err)
+		goto fail;
+
+	/* Transition: deallocate buffer, next-AD from working store. */
+	memset(&p, 0, sizeof(p));
+	p.type = FMAN_FE_TYPE_TRANSITION;
+	p.ws_offset = FMAN_FE_TRANSITION_CTX_OFF;
+	p.flags = FMAN_FE_EXIT_DEALLOCATE | FMAN_FE_TRANSITION_AD_FROM_WS;
+	p.next_from_ws = true;
+	err = fman_pcd_fe_singleton_one(pcd, muram, &p, &pcd->fe_transition_off);
+	if (err)
+		goto fail;
+
+	/* Exit: deallocate buffer. */
+	memset(&p, 0, sizeof(p));
+	p.type = FMAN_FE_TYPE_EXIT;
+	p.flags = FMAN_FE_EXIT_DEALLOCATE;
+	err = fman_pcd_fe_singleton_one(pcd, muram, &p, &pcd->fe_exit_off);
+	if (err)
+		goto fail;
+
+	return 0;
+
+fail:
+	fman_pcd_fe_singletons_free(pcd);
+	return err;
+}
+
+static void fman_pcd_fe_dump_one(struct seq_file *s, struct muram_info *muram,
+				 const char *name, unsigned long off,
+				 unsigned int words)
+{
+	u32 __iomem *fe;
+	unsigned int i;
+
+	if (!off) {
+		seq_printf(s, "%-10s (not built)\n", name);
+		return;
+	}
+	fe = (u32 __iomem *)fman_muram_offset_to_vbase(muram, off);
+	seq_printf(s, "%-10s off=0x%05lx ", name, off);
+	for (i = 0; i < words; i++)
+		seq_printf(s, "%08x ", ioread32be(fe + i));
+	seq_puts(s, "\n");
+}
+
+static int fman_pcd_fe_singletons_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+
+	mutex_lock(&pcd->fe_lock);
+	if (!muram || pcd->fe_refcount == 0) {
+		seq_puts(s, "fe pool not engaged\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	fman_pcd_fe_dump_one(s, muram, "mux", pcd->fe_mux_off,
+			     FMAN_FE_MUX_SIZE / 4);
+	fman_pcd_fe_dump_one(s, muram, "transition", pcd->fe_transition_off,
+			     FMAN_FE_TRANSITION_SIZE / 4);
+	fman_pcd_fe_dump_one(s, muram, "exit", pcd->fe_exit_off,
+			     FMAN_FE_EXIT_SIZE / 4);
+	mutex_unlock(&pcd->fe_lock);
+	return 0;
+}
+
+static int fman_pcd_fe_singletons_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_singletons_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_singletons_write(struct file *file,
+					    const char __user *ubuf,
+					    size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	char buf[16];
+	char *cmd;
+	int err = 0;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+	cmd = strim(buf);
+
+	mutex_lock(&pcd->fe_lock);
+	if (!strcmp(cmd, "build"))
+		err = fman_pcd_fe_singletons_build(pcd);
+	else if (!strcmp(cmd, "clear"))
+		fman_pcd_fe_singletons_free(pcd);
+	else
+		err = -EINVAL;
+	mutex_unlock(&pcd->fe_lock);
+
+	return err ? err : count;
+}
+
+static const struct file_operations fman_pcd_fe_singletons_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_fe_singletons_open,
+	.read		= seq_read,
+	.write		= fman_pcd_fe_singletons_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * FE-VM core, increment 2 - arch/fman-fe-ehash.md section 5: the per-flow
+ * ENQ Flow-Entry and the AC_CC root action-descriptor FE_ENTER wiring.
+ *
+ * Together these give a classified frame a terminal BMI-FIFO disposition:
+ *
+ *   - the per-flow ENQ FE (SDK FmPcdCcBuildContextByFE) is an ENQ-type FE
+ *     descriptor carrying the 24-bit target FQID in word1, so the frame is
+ *     enqueued to its RX frame queue;
+ *   - the FE_ENTER root AD (SDK FillAdOfTypeContLookup external-hash branch)
+ *     is a CONT_LOOKUP action descriptor whose ccAdBase carries the
+ *     FE_ENTER_ALLOCATE bit, pcAndOffsets the FE_ENTER opcode (0xf6), and
+ *     gmask the MURAM offset of the FE to enter - this makes the coarse
+ *     classifier dispatch INTO the FE machine instead of walking a match
+ *     table.
+ *
+ * Encodings are authoritative (NXP SDK fm_cc.[ch]):
+ *   FM_PCD_AD_CONT_LOOKUP_TYPE 0x40000000, FM_PCD_AD_FE_ENTER_ALLOCATE
+ *   0x00800000, FM_PCD_AD_FE_ENTER_OPCODE 0x000000f6; the ENQ word1 FQID is
+ *   the low 24 bits (FM_PCD_FE_T_ENQ_NIA_MASK).
+ *
+ * Ships DORMANT: it PROGRAMS the descriptors into pool / MURAM slots and
+ * exposes them for byte-level verification (fe_enq, fe_enter debugfs), but
+ * nothing dispatches into the FE machine until the external-hash bucket
+ * indexer that links a classified flow to its ENQ FE lands in a later
+ * increment.  Forward (build) and inverse (clear) ship in this one patch;
+ * each inverse restores the exact pre-build MURAM state, so pcd-snapshot
+ * stays reversible (section 8.6 defensive-coding contract).
+ * ---------------------------------------------------------------------------
+ */
+
+/* ENQ FE word1 holds the 24-bit target FQID when FMAN_FE_ENQ_FQID is set. */
+#define FMAN_FE_ENQ_NIA_MASK		0x00ffffff
+
+/* FE_ENTER root action-descriptor (SDK t_AdOfTypeContLookup) field bits. */
+#define FMAN_AD_CONT_LOOKUP_TYPE	0x40000000	/* word0 ccAdBase type */
+#define FMAN_AD_FE_ENTER_ALLOCATE	0x00800000	/* word0 alloc buffer  */
+#define FMAN_AD_FE_ENTER_OPCODE		0x000000f6	/* word2 pcAndOffsets  */
+
+/*
+ * Build one per-flow ENQ FE into a pool slot.  Mirrors the ENQ branch of the
+ * SDK FmPcdCcBuildContextByFE(): an ENQ-type descriptor with the FQID flag,
+ * the 24-bit target FQID in word1 and the next-FE offset in word3 (0 = the FE
+ * chain terminates at the enqueue).  Requires the pool engaged.  On any
+ * shortfall nothing is committed, so silicon is never half-programmed.
+ * Caller holds pcd->fe_lock.
+ */
+static int fman_pcd_fe_enq_build(struct fman_pcd *pcd, u32 fqid,
+				 unsigned long next_fe_off)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_params p;
+	struct fman_pcd_fe_obj *obj;
+
+	if (!muram)
+		return -ENXIO;
+	if (pcd->fe_refcount == 0)
+		return -ENXIO;		/* engage the pool first */
+	if (fqid & ~FMAN_FE_ENQ_NIA_MASK)
+		return -EINVAL;		/* FQIDs are 24-bit */
+
+	obj = list_first_entry_or_null(&pcd->fe_available,
+				       struct fman_pcd_fe_obj, node);
+	if (!obj)
+		return -ENOSPC;
+
+	memset(&p, 0, sizeof(p));
+	p.type = FMAN_FE_TYPE_ENQ;
+	p.flags = FMAN_FE_ENQ_FQID;
+	p.nia = fqid;
+	p.next_fe_off = pcd->fe_exit_off;	/* F-073D: chain to EXIT(DEALLOCATE) */
+
+	list_del(&obj->node);
+	fman_pcd_fe_build(muram, obj->muram_off, &p);
+	list_add_tail(&obj->node, &pcd->fe_enq);
+	return 0;
+}
+
+/* Inverse: re-zero each ENQ FE's MURAM and return its slot to the pool. */
+static void fman_pcd_fe_enq_free(struct fman_pcd *pcd)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_obj *obj, *tmp;
+
+	list_for_each_entry_safe(obj, tmp, &pcd->fe_enq, node) {
+		list_del(&obj->node);
+		if (muram)
+			memset_io((void __iomem *)
+				  fman_muram_offset_to_vbase(muram,
+							     obj->muram_off),
+				  0, FMAN_PCD_FE_MAX_SIZE);
+		list_add_tail(&obj->node, &pcd->fe_available);
+	}
+}
+
+static int fman_pcd_fe_enq_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_obj *obj;
+	unsigned int n = 0, i;
+
+	mutex_lock(&pcd->fe_lock);
+	if (!muram || pcd->fe_refcount == 0) {
+		seq_puts(s, "fe pool not engaged\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	list_for_each_entry(obj, &pcd->fe_enq, node) {
+		u32 __iomem *fe = (u32 __iomem *)
+			fman_muram_offset_to_vbase(muram, obj->muram_off);
+
+		seq_printf(s, "enq[%u]     off=0x%05lx ", n++, obj->muram_off);
+		for (i = 0; i < FMAN_FE_ENQ_SIZE / 4; i++)
+			seq_printf(s, "%08x ", ioread32be(fe + i));
+		seq_puts(s, "\n");
+	}
+	if (!n)
+		seq_puts(s, "(no enq FEs built)\n");
+	mutex_unlock(&pcd->fe_lock);
+	return 0;
+}
+
+static int fman_pcd_fe_enq_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_enq_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_enq_write(struct file *file,
+				     const char __user *ubuf,
+				     size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	unsigned long next_fe_off;
+	unsigned int fqid;
+	char buf[48];
+	int err;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	mutex_lock(&pcd->fe_lock);
+	if (sscanf(buf, "build %x %lx", &fqid, &next_fe_off) == 2) {
+		err = fman_pcd_fe_enq_build(pcd, fqid, next_fe_off);
+	} else if (sscanf(buf, "build %x", &fqid) == 1) {
+		err = fman_pcd_fe_enq_build(pcd, fqid, 0);
+	} else if (!strncmp(buf, "clear", 5)) {
+		fman_pcd_fe_enq_free(pcd);
+		err = 0;
+	} else {
+		err = -EINVAL;
+	}
+	mutex_unlock(&pcd->fe_lock);
+
+	return err ? err : count;
+}
+
+static const struct file_operations fman_pcd_fe_enq_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_fe_enq_open,
+	.read		= seq_read,
+	.write		= fman_pcd_fe_enq_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/*
+ * Build the AC_CC root action-descriptor that enters the FE machine.  Mirrors
+ * the external-hash branch of the SDK FillAdOfTypeContLookup(): a CONT_LOOKUP
+ * AD whose ccAdBase carries the FE_ENTER_ALLOCATE bit, matchTblPtr is 0,
+ * pcAndOffsets is the FE_ENTER opcode, and gmask holds the MURAM offset of the
+ * FE to enter.  The default target is the MUX singleton (the FE-VM entry point
+ * built in increment 1).  Allocated from the reserved MURAM partition; the
+ * inverse re-zeros and frees it.  Caller holds pcd->fe_lock.
+ */
+static int fman_pcd_fe_enter_build(struct fman_pcd *pcd, unsigned long fe_off)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	u32 __iomem *ad;
+	unsigned long off;
+
+	if (!muram)
+		return -ENXIO;
+	if (pcd->fe_refcount == 0)
+		return -ENXIO;		/* engage the pool first */
+	if (pcd->fe_root_ad_off)
+		return -EEXIST;
+	if (!fe_off) {
+		/*
+		 * Default FE-VM entry: the t_ExtHashFe FE-hash object once it
+		 * has been built (the genuine external-hash path), else the
+		 * MUX singleton (0127 default, kept for the bare-chain gate).
+		 */
+		fe_off = pcd->fe_hash_off ? pcd->fe_hash_off : pcd->fe_mux_off;
+	}
+	if (!fe_off)
+		return -EINVAL;			/* no target FE built yet */
+
+	off = fman_pcd_muram_alloc(pcd, FMAN_FE_ROOT_AD_SIZE);
+	if (IS_ERR_VALUE(off))
+		return (int)off;
+
+	ad = (u32 __iomem *)fman_muram_offset_to_vbase(muram, off);
+	iowrite32be(FMAN_AD_CONT_LOOKUP_TYPE | FMAN_AD_FE_ENTER_ALLOCATE,
+		    ad + 0);				/* ccAdBase          */
+	iowrite32be(0, ad + 1);				/* matchTblPtr       */
+	iowrite32be(FMAN_AD_FE_ENTER_OPCODE, ad + 2);	/* pcAndOffsets      */
+	iowrite32be((u32)fe_off, ad + 3);		/* gmask = FE offset */
+
+	pcd->fe_root_ad_off = off;
+	return 0;
+}
+
+/* Inverse: re-zero the root AD's MURAM and return it to the pool. */
+static void fman_pcd_fe_enter_free(struct fman_pcd *pcd)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+
+	if (!pcd->fe_root_ad_off)
+		return;
+	if (muram)
+		memset_io((void __iomem *)
+			  fman_muram_offset_to_vbase(muram,
+						     pcd->fe_root_ad_off),
+			  0, FMAN_FE_ROOT_AD_SIZE);
+	fman_pcd_muram_free(pcd, pcd->fe_root_ad_off, FMAN_FE_ROOT_AD_SIZE);
+	pcd->fe_root_ad_off = 0;
+}
+
+static int fman_pcd_fe_enter_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	u32 __iomem *ad;
+	unsigned int i;
+
+	mutex_lock(&pcd->fe_lock);
+	if (!muram || pcd->fe_refcount == 0) {
+		seq_puts(s, "fe pool not engaged\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	if (!pcd->fe_root_ad_off) {
+		seq_puts(s, "root_ad    (not built)\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	ad = (u32 __iomem *)fman_muram_offset_to_vbase(muram,
+						       pcd->fe_root_ad_off);
+	seq_printf(s, "root_ad    off=0x%05lx ", pcd->fe_root_ad_off);
+	for (i = 0; i < FMAN_FE_ROOT_AD_SIZE / 4; i++)
+		seq_printf(s, "%08x ", ioread32be(ad + i));
+	seq_puts(s, "\n");
+	mutex_unlock(&pcd->fe_lock);
+	return 0;
+}
+
+static int fman_pcd_fe_enter_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_enter_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_enter_write(struct file *file,
+				       const char __user *ubuf,
+				       size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	unsigned long fe_off;
+	char buf[32];
+	int err;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	mutex_lock(&pcd->fe_lock);
+	if (sscanf(buf, "build %lx", &fe_off) == 1)
+		err = fman_pcd_fe_enter_build(pcd, fe_off);
+	else if (!strncmp(buf, "build", 5))
+		err = fman_pcd_fe_enter_build(pcd, 0);
+	else if (!strncmp(buf, "clear", 5)) {
+		fman_pcd_fe_enter_free(pcd);
+		err = 0;
+	} else {
+		err = -EINVAL;
+	}
+	mutex_unlock(&pcd->fe_lock);
+
+	return err ? err : count;
+}
+
+static const struct file_operations fman_pcd_fe_enter_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_fe_enter_open,
+	.read		= seq_read,
+	.write		= fman_pcd_fe_enter_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * External-hash flow store - arch/fman-fe-ehash.md section 5
+ * (ExternalHashTableSet), the vendor enhanced-ehash path - the only config
+ * proven to FLOW on the 210.10.1 ucode (section 8).  Two resources:
+ *
+ *   (a) a per-PCD internal-buffer-management pool in MURAM (32 KiB pool +
+ *       256 B global-mem singleton, 256-byte aligned), lazily reserved on
+ *       the first table, refcounted, freed with the last.  This is the
+ *       single largest FE/ehash MURAM consumer (section 6 budget) and the
+ *       dominant pcd-snapshot reversibility signal.
+ *
+ *   (b) per-table DDR bucket arrays (kzalloc, 16 B/bucket * (mask + 1)) plus
+ *       an en_exthash_node descriptor template.  Buckets live in DDR by
+ *       design (section 6 anti-pattern: never let them fall to MURAM - that
+ *       is the 327x-ENOMEM wall the vendor hit).
+ *
+ * Transcribed from the lf-5.4 LSDK ExternalHashTableSet() (Pcd/fm_ehash.c).
+ * The standalone function builds the node TEMPLATE in DDR (inside its info
+ * struct); the MURAM AD placement + AC_CC root-AD FE_ENTER wiring is the next
+ * increment (the fm_cc.c FmPcdExternalHashTableSet wrapper).  Ships DORMANT:
+ * it allocates + encodes, nothing dispatches into the hash store until that
+ * wiring and the FE-VM core (FmPcdCcBuildContextByFE) land.  Forward (set)
+ * and inverse (clear/drain) ship together; clear returns gen_pool "used" to
+ * baseline (section 8.6 reversibility contract).
+ *
+ * The en_exthash_node bit layout is the lf-5.4 native little-endian struct
+ * packing for the DDR template.  Before a frame is ever dispatched into the
+ * FE, that packing AND the 16-vs-8 byte bucket size MUST be confirmed against
+ * a 210.10.1 hardware dump (section 8.6 item 6); neither affects this dormant
+ * increment's safety or reversibility.
+ * ---------------------------------------------------------------------------
+ */
+#define FMAN_EHASH_INT_BUF_POOL_SIZE	(256 * 128)	/* EN_INTERNAL_BUFF_POOL_SIZE */
+#define FMAN_EHASH_GLOBAL_MEM_SIZE	256		/* en_exthash_global_mem */
+#define FMAN_EHASH_INT_BUF_TOTAL \
+	(FMAN_EHASH_INT_BUF_POOL_SIZE + FMAN_EHASH_GLOBAL_MEM_SIZE)
+#define FMAN_EHASH_ALIGN		256		/* EN_EXTHASH_TBL_ALIGNMENT */
+#define FMAN_EHASH_BUCKET_SIZE		16		/* lf-5.4 {u64 h; u64 pad} */
+#define FMAN_EHASH_MASK_MAX		0x7fff		/* hash_mask_bits: 4-bit field */
+
+struct fman_pcd_ehash_table {
+	struct list_head node;
+	void *table_base;		/* DDR bucket array (dma_alloc_coherent) */
+	dma_addr_t table_dma;		/* bus address of table_base (FE VM reads) */
+	struct device *dev;		/* DMA device (fman_get_dev), for record alloc */
+	size_t table_size;
+	u32 hash_mask;
+	u8 key_size;
+	u8 hash_shift;
+	u8 hash_mask_bits;		/* ii = log2(mask + 1) */
+	u32 ad[4];			/* en_exthash_node DDR template */
+	struct list_head flows;		/* sec.5 inserted flow records (DDR) */
+};
+
+/* Table teardown cascades to its inserted flow records (defined below). */
+static void fman_pcd_ehash_flow_drain(struct fman_pcd_ehash_table *t);
+
+/* Lazily reserve the per-PCD internal-buffer-management MURAM pool. */
+static int fman_pcd_ehash_int_buf_get(struct fman_pcd *pcd)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	unsigned long raw_off, aligned_off;
+	size_t raw_size, avail;
+	void __iomem *v;
+
+	if (!muram)
+		return -ENXIO;
+	if (pcd->fe_int_buf_refcount > 0) {
+		pcd->fe_int_buf_refcount++;
+		return 0;
+	}
+
+	/* Bounds-check before reserving (section 8.6 item 2). */
+	raw_size = FMAN_EHASH_INT_BUF_TOTAL + FMAN_EHASH_ALIGN;
+	mutex_lock(&pcd->lock);
+	avail = pcd->muram_reserved - pcd->muram_used;
+	mutex_unlock(&pcd->lock);
+	if (avail < raw_size)
+		return -ENOMEM;
+
+	raw_off = fman_pcd_muram_alloc(pcd, raw_size);
+	if (IS_ERR_VALUE(raw_off))
+		return (int)raw_off;
+	aligned_off = (raw_off + (FMAN_EHASH_ALIGN - 1)) &
+		      ~(unsigned long)(FMAN_EHASH_ALIGN - 1);
+	v = (void __iomem *)fman_muram_offset_to_vbase(muram, aligned_off);
+	memset_io(v, 0, FMAN_EHASH_INT_BUF_TOTAL);
+
+	pcd->fe_int_buf_raw_off = raw_off;
+	pcd->fe_int_buf_raw_size = raw_size;
+	pcd->fe_int_buf_off = aligned_off;
+	pcd->fe_int_buf_refcount = 1;
+	return 0;
+}
+
+static void fman_pcd_ehash_int_buf_put(struct fman_pcd *pcd)
+{
+	if (WARN_ON(pcd->fe_int_buf_refcount <= 0))
+		return;
+	if (--pcd->fe_int_buf_refcount > 0)
+		return;
+	fman_pcd_muram_free(pcd, pcd->fe_int_buf_raw_off,
+			    pcd->fe_int_buf_raw_size);
+	pcd->fe_int_buf_raw_off = 0;
+	pcd->fe_int_buf_raw_size = 0;
+	pcd->fe_int_buf_off = 0;
+}
+
+/*
+ * Encode the en_exthash_node DDR template in the lf-5.4 native little-endian
+ * bitfield order (first field in the least-significant bits):
+ *   word0: table_base_hi:16 | hash_bytes_offset:2 | rsv:6 | key_size:6 |
+ *          miss_action_type:2
+ *   word1: table_base_lo (full 32 bits)
+ *   word2: global_mem_offset:12 | hash_mask_bits:4 | int_buf_pool_addr:16
+ *   word3: miss NIA (deferred to the FE_ENTER increment)
+ */
+static void fman_pcd_ehash_encode_node(struct fman_pcd_ehash_table *t,
+				       dma_addr_t tblphys,
+				       unsigned long int_buf_off)
+{
+	u32 base_hi = (u32)(((u64)tblphys >> 32) & 0xffff);
+	u32 ibp = (u32)((int_buf_off >> 8) & 0xffff);
+	u32 gmo = (FMAN_EHASH_INT_BUF_POOL_SIZE >> 8) & 0xfff;
+
+	t->ad[0] = base_hi |
+		   ((u32)(t->hash_shift & 0x3) << 16) |
+		   ((u32)(t->key_size & 0x3f) << 24);
+		   /* miss_action_type (bits 30-31) = 0, deferred */
+	t->ad[1] = (u32)((u64)tblphys & 0xffffffff);
+	t->ad[2] = gmo |
+		   ((u32)(t->hash_mask_bits & 0xf) << 12) |
+		   (ibp << 16);
+	t->ad[3] = 0;
+}
+
+static int fman_pcd_ehash_table_set(struct fman_pcd *pcd, u32 mask,
+				    u8 key_size, u8 hash_shift)
+{
+	struct device *dev = fman_get_dev(pcd->fman);
+	struct fman_pcd_ehash_table *t;
+	dma_addr_t tblphys;
+	size_t tablesize;
+	int ii, err;
+
+	if (mask == 0 || mask > FMAN_EHASH_MASK_MAX)
+		return -EINVAL;
+	ii = fls(mask);				/* 1-based MSB position */
+	if ((1u << ii) != mask + 1)		/* (mask + 1) must be 2^ii */
+		return -EINVAL;
+	if (key_size == 0 || key_size > 0x3f || hash_shift > 0x3)
+		return -EINVAL;
+
+	tablesize = (size_t)FMAN_EHASH_BUCKET_SIZE << ii;
+
+	t = kzalloc(sizeof(*t), GFP_KERNEL);
+	if (!t)
+		return -ENOMEM;
+
+	err = fman_pcd_ehash_int_buf_get(pcd);
+	if (err)
+		goto err_free_t;
+
+	t->table_base = dma_alloc_coherent(dev, tablesize, &t->table_dma,
+					   GFP_KERNEL);
+	if (!t->table_base) {
+		err = -ENOMEM;
+		goto err_put_buf;
+	}
+	t->dev = dev;
+	t->table_size = tablesize;
+	t->hash_mask = mask;
+	t->key_size = key_size;
+	t->hash_shift = hash_shift;
+	t->hash_mask_bits = (u8)ii;
+	INIT_LIST_HEAD(&t->flows);
+
+	tblphys = t->table_dma;
+	fman_pcd_ehash_encode_node(t, tblphys, pcd->fe_int_buf_off);
+
+	list_add_tail(&t->node, &pcd->fe_ehash_tables);
+	dev_info(fman_get_dev(pcd->fman),
+		 "fman_pcd: ehash table mask 0x%x keysize %u ii %d size %zu DDR %pad\n",
+		 mask, key_size, ii, tablesize, &tblphys);
+	return 0;
+
+err_put_buf:
+	fman_pcd_ehash_int_buf_put(pcd);
+err_free_t:
+	kfree(t);
+	return err;
+}
+
+static void fman_pcd_ehash_table_free(struct fman_pcd *pcd,
+				      struct fman_pcd_ehash_table *t)
+{
+	list_del(&t->node);
+	fman_pcd_ehash_flow_drain(t);
+	dma_free_coherent(t->dev, t->table_size, t->table_base, t->table_dma);
+	kfree(t);
+	fman_pcd_ehash_int_buf_put(pcd);
+}
+
+static void fman_pcd_ehash_drain(struct fman_pcd *pcd)
+{
+	struct fman_pcd_ehash_table *t, *tmp;
+
+	list_for_each_entry_safe(t, tmp, &pcd->fe_ehash_tables, node)
+		fman_pcd_ehash_table_free(pcd, t);
+}
+
+static int fman_pcd_ehash_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct fman_pcd_ehash_table *t;
+
+	mutex_lock(&pcd->fe_lock);
+	seq_printf(s,
+		   "int_buf refcount=%d off=0x%05lx raw_size=%zu pool=%d global=%d\n",
+		   pcd->fe_int_buf_refcount, pcd->fe_int_buf_off,
+		   pcd->fe_int_buf_raw_size, FMAN_EHASH_INT_BUF_POOL_SIZE,
+		   FMAN_EHASH_GLOBAL_MEM_SIZE);
+	if (list_empty(&pcd->fe_ehash_tables)) {
+		seq_puts(s, "no ehash tables\n");
+	} else {
+		list_for_each_entry(t, &pcd->fe_ehash_tables, node) {
+			dma_addr_t p = t->table_dma;
+
+			seq_printf(s,
+				   "table mask=0x%04x keysize=%u ii=%u size=%zu DDR=%pad\n",
+				   t->hash_mask, t->key_size,
+				   t->hash_mask_bits, t->table_size, &p);
+			seq_printf(s, "  node %08x %08x %08x %08x\n",
+				   t->ad[0], t->ad[1], t->ad[2], t->ad[3]);
+		}
+	}
+	mutex_unlock(&pcd->fe_lock);
+	return 0;
+}
+
+static int fman_pcd_ehash_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_ehash_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_ehash_write(struct file *file, const char __user *ubuf,
+				    size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	unsigned int mask, key_size, hash_shift;
+	char buf[48];
+	int err;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	mutex_lock(&pcd->fe_lock);
+	if (sscanf(buf, "set %x %u %u", &mask, &key_size, &hash_shift) == 3)
+		err = fman_pcd_ehash_table_set(pcd, mask, (u8)key_size,
+					       (u8)hash_shift);
+	else if (!strncmp(buf, "clear", 5)) {
+		fman_pcd_ehash_drain(pcd);
+		err = 0;
+	} else {
+		err = -EINVAL;
+	}
+	mutex_unlock(&pcd->fe_lock);
+
+	return err ? err : count;
+}
+
+static const struct file_operations fman_pcd_ehash_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_ehash_open,
+	.read		= seq_read,
+	.write		= fman_pcd_ehash_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * FE-VM core, increment 3 - arch/fman-fe-ehash.md section 5: the per-flow
+ * insertion that links a classified 5-tuple to its ENQ Flow-Entry.  This is
+ * the SDK get_indexed_hash_bucket() CRC64 bucket indexer + ExternalHashTableAddKey()
+ * head-insert, transcribed from the lf-5.4 LSDK (Pcd/fm_ehash.c) - the only
+ * source where both functions are real (lf-6.6.y stubs the indexer; lf-6.12
+ * carries the indexer but stubs the FE-context builder).
+ *
+ * For each inserted flow:
+ *   - CRC64 the key, byte-shift + mask to a bucket index (get_indexed_hash_bucket);
+ *   - allocate a 256-byte DDR flow record (en_ehash_entry, EN_EHASH_ENTRY_ALIGN
+ *     256) and write the en_ehash_entry header (flags, next_entry chain pointer
+ *     to the previous bucket head), the key, and the next-FE pointer (the ENQ
+ *     FE MURAM offset built in increment 2);
+ *   - head-insert into the collision chain: bucket->h = swab64(phys(record)).
+ *
+ * Buckets and records live in DDR by design (section 6 anti-pattern: never let
+ * the flow store fall to MURAM - that is the 327x-ENOMEM wall).  gen_pool
+ * "used" is therefore UNCHANGED by this increment; the reversibility signal is
+ * (a) every DDR record freed, (b) every bucket head restored to its exact
+ * pre-insert value.  Forward (add) and inverse (drain) ship together; drain is
+ * LIFO so the collision chain unwinds in reverse insert order, restoring each
+ * bucket head byte-exactly (section 8.6 reversibility contract).
+ *
+ * Ships DORMANT: it writes DDR flow records and links bucket heads, but
+ * nothing dispatches into the store until the AC_CC root-AD FE_ENTER (built in
+ * increment 2) is wired to a live KeyGen->AC_CC scheme on a port AND a real
+ * key/FQID is programmed.  While dormant the records are inert DDR.
+ *
+ * SECTION 8.6 ITEM 6 CAVEATS (must be confirmed against a 210.10.1 hardware
+ * dump before ANY frame is dispatched - none affect dormant reversibility):
+ *   - the CRC64 below is transcribed verbatim from the genuine NXP crc64.h
+ *     (reflected poly 0xC96C5795D7870F42); the (6 - shift) byte-select + mask
+ *     follow the SDK get_indexed_hash_bucket idiom but need a HW-dump confirm;
+ *   - the en_ehash_entry header field offsets and the next-FE pointer
+ *     placement after the key;
+ *   - DONE (this patch, 0130): DDR records/buckets use dma_alloc_coherent
+ *     (the XX_MallocSmart equivalent) so the FE VM reads true bus addresses;
+ *     a dma_pool would avoid per-record page rounding (future optimization).
+ * ---------------------------------------------------------------------------
+ */
+#define FMAN_EHASH_FLOW_REC_SIZE	256	/* MAX_EN_EHASH_ENTRY_SIZE */
+#define FMAN_EHASH_FLOW_KEY_OFF		8	/* en_ehash_entry.key[0] */
+#define FMAN_EHASH_FLOW_KEY_MAX		56	/* fits rec - header - fe ptr */
+#define FMAN_EHASH_CRC64_POLY		0xC96C5795D7870F42ULL	/* ECMA-182, reflected */
+
+struct fman_pcd_ehash_flow {
+	struct list_head node;
+	void *record;			/* DDR 256-B flow record (dma_alloc_coherent) */
+	dma_addr_t record_dma;		/* bus address of record (bucket head holds it) */
+	u64 *bucket_h;			/* the bucket head u64 it links into */
+	u64 prev_head;			/* old bucket->h, for byte-exact undo */
+	u16 index;			/* bucket index (for the show node) */
+	u8 key_size;
+};
+
+static inline int fman_pcd_hexval(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+/*
+ * Reflected (LSB-first) CRC64, transcribed from the genuine NXP crc64.h
+ * (CRC64_ECMA_182): reflected poly 0xC96C5795D7870F42, seed ~0ULL
+ * (CRC64_DEFAULT_INITVAL).  Provably identical to crc64.h's table-driven
+ * crc64_compute() - the reflected poly regenerates the genuine 256-entry
+ * table and matches crc64_compute byte-for-byte over all keys (verified).
+ */
+static u64 fman_pcd_crc64(const u8 *p, size_t len)
+{
+	u64 crc = ~0ULL;
+	size_t i;
+	int b;
+
+	for (i = 0; i < len; i++) {
+		crc ^= (u64)p[i];
+		for (b = 0; b < 8; b++)
+			crc = (crc & 1ULL) ?
+			      (crc >> 1) ^ FMAN_EHASH_CRC64_POLY :
+			      (crc >> 1);
+	}
+	return crc;
+}
+
+/* lf-5.4 get_indexed_hash_bucket(): byte-granular right shift, then mask. */
+static u16 fman_pcd_ehash_bucket_index(const u8 *key, u8 key_size,
+				       u8 hash_shift, u32 mask)
+{
+	u64 crc = fman_pcd_crc64(key, key_size);
+
+	crc >>= ((6 - (hash_shift & 0x7)) << 3);
+	return (u16)crc & (u16)mask;
+}
+
+static struct fman_pcd_ehash_table *
+fman_pcd_ehash_table_by_index(struct fman_pcd *pcd, unsigned int idx)
+{
+	struct fman_pcd_ehash_table *t;
+	unsigned int i = 0;
+
+	list_for_each_entry(t, &pcd->fe_ehash_tables, node)
+		if (i++ == idx)
+			return t;
+	return NULL;
+}
+
+/*
+ * Insert one flow: CRC64 the key to a bucket, allocate a DDR flow record, link
+ * it into the collision chain head-first.  Mirrors the simple (non-cumulative)
+ * ExternalHashTableAddKey() path.  On any shortfall nothing is committed.
+ * Caller holds pcd->fe_lock.
+ */
+static int fman_pcd_ehash_add_key(struct fman_pcd_ehash_table *t,
+				  const u8 *key, u8 key_size,
+				  unsigned long enq_fe_off)
+{
+	struct fman_pcd_ehash_flow *flow;
+	u64 prev_head, old_native, rec_phys;
+	dma_addr_t rdma;
+	u8 *r;
+	u16 index;
+	size_t fe_ptr_off;
+
+		if (key_size == 0 || key_size != t->key_size)
+		return -EINVAL;
+	if (key_size > FMAN_EHASH_FLOW_KEY_MAX)
+		return -EINVAL;
+
+	index = fman_pcd_ehash_bucket_index(key, key_size, t->hash_shift,
+					    t->hash_mask);
+
+	flow = kzalloc(sizeof(*flow), GFP_KERNEL);
+	if (!flow)
+		return -ENOMEM;
+
+	/* dma_alloc_coherent returns page-aligned, zeroed coherent DDR. */
+	r = dma_alloc_coherent(t->dev, FMAN_EHASH_FLOW_REC_SIZE, &rdma,
+			       GFP_KERNEL);
+	if (!r) {
+		kfree(flow);
+		return -ENOMEM;
+	}
+
+	flow->bucket_h = (u64 *)((u8 *)t->table_base +
+				 (size_t)index * FMAN_EHASH_BUCKET_SIZE);
+	prev_head = *flow->bucket_h;		/* swab'd phys of old head */
+	old_native = swab64(prev_head);		/* unswap to native phys */
+
+	/* en_ehash_entry header: chain THIS record to the previous head. */
+	*(__be16 *)(r + 0) = cpu_to_be16(0);				/* flags */
+	*(__be16 *)(r + 2) = cpu_to_be16((u16)((old_native >> 32) & 0xffff));
+	*(__be32 *)(r + 4) = cpu_to_be32((u32)(old_native & 0xffffffff));
+	memcpy(r + FMAN_EHASH_FLOW_KEY_OFF, key, key_size);
+
+	fe_ptr_off = FMAN_EHASH_FLOW_KEY_OFF + ((key_size + 7U) & ~7U);
+	*(__be32 *)(r + fe_ptr_off) = cpu_to_be32((u32)enq_fe_off);
+
+	/* Head-insert: bucket head = swab64(dma_addr(record)). */
+	rec_phys = (u64)rdma;
+	*flow->bucket_h = swab64(rec_phys);
+
+	flow->record = r;
+	flow->record_dma = rdma;
+	flow->prev_head = prev_head;
+	flow->index = index;
+	flow->key_size = key_size;
+	list_add(&flow->node, &t->flows);	/* head-add => LIFO drain */
+	return 0;
+}
+
+/*
+ * Inverse: LIFO restore.  Flows are head-added, so walking the list head-first
+ * unwinds the collision chain in reverse insert order, restoring each bucket
+ * head to its exact pre-insert value (byte-exact reversibility, section 8.6).
+ */
+static void fman_pcd_ehash_flow_drain(struct fman_pcd_ehash_table *t)
+{
+	struct fman_pcd_ehash_flow *flow, *tmp;
+
+	list_for_each_entry_safe(flow, tmp, &t->flows, node) {
+		*flow->bucket_h = flow->prev_head;
+		list_del(&flow->node);
+		dma_free_coherent(t->dev, FMAN_EHASH_FLOW_REC_SIZE,
+				  flow->record, flow->record_dma);
+		kfree(flow);
+	}
+}
+
+static void fman_pcd_ehash_flow_clear_all(struct fman_pcd *pcd)
+{
+	struct fman_pcd_ehash_table *t;
+
+	list_for_each_entry(t, &pcd->fe_ehash_tables, node)
+		fman_pcd_ehash_flow_drain(t);
+}
+
+static int fman_pcd_fe_flow_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct fman_pcd_ehash_table *t;
+	struct fman_pcd_ehash_flow *flow;
+	unsigned int ti = 0, total = 0;
+
+	mutex_lock(&pcd->fe_lock);
+	if (list_empty(&pcd->fe_ehash_tables)) {
+		seq_puts(s, "no ehash tables (set one via fe_ehash first)\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	list_for_each_entry(t, &pcd->fe_ehash_tables, node) {
+		unsigned int n = 0;
+
+		list_for_each_entry(flow, &t->flows, node) {
+			u64 rec_phys = (u64)flow->record_dma;
+			const u8 *r = flow->record;
+			unsigned int i;
+
+			seq_printf(s,
+				   "tbl[%u] flow[%u] bucket=0x%04x rec=0x%llx ",
+				   ti, n++, flow->index,
+				   (unsigned long long)rec_phys);
+			for (i = 0; i < 16; i++)
+				seq_printf(s, "%02x", r[i]);
+			seq_puts(s, "\n");
+			total++;
+		}
+		if (!n)
+			seq_printf(s, "tbl[%u] (no flows)\n", ti);
+		ti++;
+	}
+	seq_printf(s, "total flows: %u\n", total);
+	mutex_unlock(&pcd->fe_lock);
+	return 0;
+}
+
+static int fman_pcd_fe_flow_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_flow_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_flow_write(struct file *file,
+				      const char __user *ubuf,
+				      size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	struct fman_pcd_ehash_table *t;
+	unsigned long enq_fe_off = 0;
+	unsigned int tbl_idx;
+	char buf[160], keytok[2 * FMAN_EHASH_FLOW_KEY_MAX + 2];
+	u8 key[FMAN_EHASH_FLOW_KEY_MAX];
+	u8 key_size = 0;
+	int nf, err;
+	const char *k;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	mutex_lock(&pcd->fe_lock);
+	if (!strncmp(buf, "clear", 5)) {
+		fman_pcd_ehash_flow_clear_all(pcd);
+		mutex_unlock(&pcd->fe_lock);
+		return count;
+	}
+
+	nf = sscanf(buf, "add %u %113s %lx", &tbl_idx, keytok, &enq_fe_off);
+	if (nf < 2) {
+		mutex_unlock(&pcd->fe_lock);
+		return -EINVAL;
+	}
+
+	/* Parse the hex key string into bytes. */
+	for (k = keytok; k[0] && k[1]; k += 2) {
+		int hi = fman_pcd_hexval(k[0]);
+		int lo = fman_pcd_hexval(k[1]);
+
+		if (hi < 0 || lo < 0 || key_size >= FMAN_EHASH_FLOW_KEY_MAX) {
+			mutex_unlock(&pcd->fe_lock);
+			return -EINVAL;
+		}
+		key[key_size++] = (u8)((hi << 4) | lo);
+	}
+	if (key_size == 0 || keytok[2 * key_size] != '\0') {
+		mutex_unlock(&pcd->fe_lock);
+		return -EINVAL;		/* odd-length or trailing junk */
+	}
+
+	t = fman_pcd_ehash_table_by_index(pcd, tbl_idx);
+	if (!t) {
+		mutex_unlock(&pcd->fe_lock);
+		return -ENODEV;
+	}
+
+	err = fman_pcd_ehash_add_key(t, key, key_size, enq_fe_off);
+	mutex_unlock(&pcd->fe_lock);
+
+	return err ? err : count;
+}
+
+static const struct file_operations fman_pcd_fe_flow_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_fe_flow_open,
+	.read		= seq_read,
+	.write		= fman_pcd_fe_flow_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * FE-VM core, increment 3 - arch/fman-fe-ehash.md section 5: the EXT_HASH
+ * Flow-Entry object (SDK t_ExtHashFe, FmPcdExternalHashTableSet builder).
+ *
+ * This is the genuine 28-byte external-hash FE that the FE_ENTER root AD
+ * dispatches into.  On a hit it hands control to the MUX singleton (which
+ * reads the per-flow head FE from the matched record's working store); on a
+ * miss it hands control to the Exit singleton (dealloc).  It binds the DDR
+ * bucket array (section 5 ehash table) to the FE VM:
+ *
+ *   word0 misc        = EXT_HASH type | contextOffsetInWS(0) [| aging | stats]
+ *   word1             = hashMask:16 | (contextSize-1):8 | hashShift:8
+ *   word2             = table bus-addr hi 16 [| LIODN, armed only]
+ *   word3             = table bus-addr lo 32
+ *   word4 missResult  = miss-result context MURAM offset (0 while dormant)
+ *   word5 nextFEPtr   = HIT  link -> MUX singleton MURAM offset
+ *   word6 missNextFE  = MISS link -> Exit singleton MURAM offset
+ *
+ * Ships DORMANT: the object is assembled and byte-verifiable against the M0
+ * oracle (arch/fman-fe-ehash.md section 8.6 item 6) while the port is still
+ * quiescent, but nothing dispatches a frame into it until the KeyGen scheme
+ * is switched to AC_CC and the BMI CC root is pointed at the FE_ENTER root AD
+ * (the M2 arm, D9-B, a separate explicitly-approved experiment).  word4
+ * (missResult context) and the word2 LIODN are arming-time fields, zero here.
+ * ---------------------------------------------------------------------------
+ */
+#define FMAN_FE_HASH_SIZE		28	/* t_ExtHashFe: 7 words */
+#define FMAN_FE_HASH_CONTEXT_SIZE	256	/* FE_MAX_CONTEXT_SIZE */
+/* word0 optional flags - 0 while dormant (no aging, no stats). */
+#define FMAN_FE_HASH_UPDATE_TS		0x00020000
+#define FMAN_FE_HASH_UPDATE_STATS	0x00010000
+
+/*
+ * Encode the t_ExtHashFe image into its MURAM slot (big-endian words).  The
+ * table pointer (word2/word3) is the DDR bucket-array bus address - a full
+ * physical address, NOT a MURAM offset - because the FE VM DMA-reads the
+ * bucket array from DDR.  nextFEPtr/missNextFEPtr ARE MURAM offsets (gen_pool
+ * offsets), matching the SDK "phys(FE) - physicalMuramBase" convention.
+ */
+static void fman_pcd_fe_hash_encode(struct muram_info *muram,
+				    unsigned long fe_off,
+				    const struct fman_pcd_ehash_table *t,
+				    unsigned long mux_off,
+				    unsigned long miss_off)
+{
+	u32 __iomem *fe = (u32 __iomem *)
+		fman_muram_offset_to_vbase(muram, fe_off);
+	u64 tblphys = (u64)t->table_dma;
+
+	iowrite32be(FMAN_FE_TYPE_EXT_HASH, fe + 0);		/* misc       */
+	/* word1 = hashMask:16 | (contextSize-1):8 | hashShift:8, per
+	 * arch/fman-microcode-210-programming-reference.md sec 7.2 (line
+	 * 358 formula, line 638 worked example: word1=0x7fff0c00 decodes
+	 * as hashMask=0x7fff, contextSize-1=0x0c, hashShift=0x00). A
+	 * same-session hashShift<<24|contextSize<<16|hashMask "fix" was
+	 * tried and reverted after checking this reference -- the
+	 * original layout below is correct as written.
+	 */
+	iowrite32be(((u32)(t->hash_mask & 0xffff) << 16) |
+		    ((u32)((t->key_size - 1) & 0xff) << 8) |
+		    (u32)(t->hash_shift & 0xff), fe + 1);
+	iowrite32be((u32)((tblphys >> 32) & 0xffff), fe + 2);	/* tbl hi     */
+	iowrite32be((u32)(tblphys & 0xffffffff), fe + 3);	/* tbl lo     */
+	iowrite32be(0, fe + 4);					/* missResult */
+	iowrite32be((u32)mux_off, fe + 5);			/* HIT  -> MUX  */
+	iowrite32be((u32)miss_off, fe + 6);			/* MISS -> Exit */
+}
+
+/*
+ * Build the EXT_HASH FE object from a FE-pool slot.  Requires the pool to be
+ * engaged, the MUX/Exit singletons built, and at least one section-5 ehash
+ * table set (the table the FE binds to).  Parked on the singletons list so
+ * fe_pool teardown reclaims it; the dedicated _free returns the slot and
+ * re-zeros the MURAM so pcd-snapshot gen_pool "used" returns to baseline.
+ */
+static int fman_pcd_fe_hash_build(struct fman_pcd *pcd)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_ehash_table *t;
+	struct fman_pcd_fe_obj *obj;
+
+	if (!muram)
+		return -ENXIO;
+	if (pcd->fe_refcount == 0)
+		return -ENXIO;			/* engage the pool first */
+	if (pcd->fe_hash_off)
+		return -EEXIST;
+	if (!pcd->fe_mux_off || !pcd->fe_exit_off)
+		return -ENXIO;			/* build the singletons first */
+	t = list_last_entry_or_null(&pcd->fe_ehash_tables,
+				     struct fman_pcd_ehash_table, node);
+	if (!t)
+		return -ENXIO;			/* set an ehash table first */
+
+	obj = list_first_entry_or_null(&pcd->fe_available,
+				       struct fman_pcd_fe_obj, node);
+	if (!obj)
+		return -ENOSPC;
+
+	list_del(&obj->node);
+	fman_pcd_fe_hash_encode(muram, obj->muram_off, t,
+				pcd->fe_mux_off, pcd->fe_exit_off);
+	pcd->fe_hash_off = obj->muram_off;
+	list_add_tail(&obj->node, &pcd->fe_singletons);
+	return 0;
+}
+
+/* Inverse: re-zero the FE-hash MURAM and return its slot to the pool. */
+static void fman_pcd_fe_hash_free(struct fman_pcd *pcd)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_obj *obj, *tmp;
+
+	if (!pcd->fe_hash_off)
+		return;
+	list_for_each_entry_safe(obj, tmp, &pcd->fe_singletons, node) {
+		if (obj->muram_off != pcd->fe_hash_off)
+			continue;
+		list_del(&obj->node);
+		if (muram)
+			memset_io((void __iomem *)
+				  fman_muram_offset_to_vbase(muram,
+							     obj->muram_off),
+				  0, FMAN_PCD_FE_MAX_SIZE);
+		list_add_tail(&obj->node, &pcd->fe_available);
+		break;
+	}
+	pcd->fe_hash_off = 0;
+}
+
+static int fman_pcd_fe_hashfe_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	u32 __iomem *fe;
+	unsigned int i;
+
+	mutex_lock(&pcd->fe_lock);
+	if (!muram || pcd->fe_refcount == 0) {
+		seq_puts(s, "fe pool not engaged\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	if (!pcd->fe_hash_off) {
+		seq_puts(s, "hash_fe    (not built)\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	fe = (u32 __iomem *)fman_muram_offset_to_vbase(muram, pcd->fe_hash_off);
+	seq_printf(s, "hash_fe    off=0x%05lx ", pcd->fe_hash_off);
+	for (i = 0; i < FMAN_FE_HASH_SIZE / 4; i++)
+		seq_printf(s, "%08x ", ioread32be(fe + i));
+	seq_puts(s, "\n");
+	mutex_unlock(&pcd->fe_lock);
+	return 0;
+}
+
+static int fman_pcd_fe_hashfe_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_hashfe_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_hashfe_write(struct file *file,
+					const char __user *ubuf,
+					size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	char buf[16];
+	char *cmd;
+	int err = 0;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+	cmd = strim(buf);
+
+	mutex_lock(&pcd->fe_lock);
+	if (!strcmp(cmd, "build"))
+		err = fman_pcd_fe_hash_build(pcd);
+	else if (!strcmp(cmd, "clear"))
+		fman_pcd_fe_hash_free(pcd);
+	else
+		err = -EINVAL;
+	mutex_unlock(&pcd->fe_lock);
+
+	return err ? err : count;
+}
+
+static const struct file_operations fman_pcd_fe_hashfe_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_fe_hashfe_open,
+	.read		= seq_read,
+	.write		= fman_pcd_fe_hashfe_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/*
+ * fe_arm - arm the FE-VM datapath on a single FMan RX port (Phase 1
+ * D9-B, patch 0132).  Reprograms the port's KGSE scheme to next_engine=CC
+ * with KGSE_CCBS = FE_ENTER root-AD offset and sets the BMI fmbm_rccb, via
+ * the KeyGen helpers in fman_pcd_kg.c (HW-proven KGSE_CCBS approach, 0118).
+ * eth3 / hw port 0x10 only in practice.  The node lives here (not in a
+ * separate TU) so it can read pcd->fe_refcount / pcd->fe_root_ad_off
+ * directly - struct fman_pcd is private to this file.
+ *
+ * Verbs:  engage <port_hex> <fe_enter_off_hex> [miss_fqid_hex]  |  disengage <port_hex>
+ */
+static int fman_pcd_fe_arm_engage(struct fman_pcd *pcd, const char *args)
+{
+	unsigned int port_id;
+	unsigned long fe_enter_off;
+	unsigned int miss_fqid = 0;  /* F-079-R4 optional 3rd arg */
+	u8 saved_engine = 0;
+	int err;
+
+	if (sscanf(args, "engage %x %lx %x", &port_id, &fe_enter_off, &miss_fqid) < 2)
+		return -EINVAL;
+	if (miss_fqid == 0)
+		miss_fqid = 0x200;  /* backward compat: eth3 default */
+	if (port_id < 0x08 || port_id >= 0x28 || fe_enter_off == 0)
+		return -EINVAL;
+
+	mutex_lock(&pcd->fe_lock);
+	if (fe_enter_off != 0 && (pcd->fe_refcount == 0 || pcd->fe_root_ad_off != fe_enter_off)) {
+		mutex_unlock(&pcd->fe_lock);
+		return -EINVAL;
+	}
+	mutex_unlock(&pcd->fe_lock);
+
+	/* F-079: CONT_LOOKUP pass-through scaffold (RM 8.7.4.1).
+	 * AC_CC dispatch (next_engine=3) with RCCB→group_table.
+	 * numKeys=0 → all frames miss → miss-AD → kernel FQ (dynamic per port).
+	 * 7.37 Gbps proven at M2 gate, 0% CPU, zero QMan errors.
+	 * MURAM: 256+16+32 = 304B. FE-VM chain dormant (future HIT).
+	 */
+	{
+		struct muram_info *muram = fman_get_muram(pcd->fman);
+		unsigned long gro, mto, ato;
+		if (muram) {
+			gro = fman_pcd_muram_alloc(pcd, 256);
+			mto = fman_pcd_muram_alloc(pcd, 16);
+			ato = fman_pcd_muram_alloc(pcd, 32);
+			if (!IS_ERR_VALUE(gro) && !IS_ERR_VALUE(mto) && !IS_ERR_VALUE(ato)) {
+				void __iomem *c;
+				c = (void __iomem *)fman_muram_offset_to_vbase(muram, gro);
+				iowrite32be((0u << 24) | (mto & 0xFFFFFF), c + 0);	/* F-079-R3: numKeys=0, matchTableAddr=mto */
+				iowrite32be((ato & 0xFFFFFF), c + 4);  /* M2-proven: AD-table ptr */
+				iowrite32be(0x4F000000  /* M2-proven: keySize=16 */, c + 8);	/* M2-proven: w2=0x4F000000 */
+				iowrite32be(0, c + 12);
+				c = (void __iomem *)fman_muram_offset_to_vbase(muram, ato);
+				iowrite32be((u32)miss_fqid, c + 0);
+				iowrite32be(0, c + 4);
+				iowrite32be(0, c + 8);  /* w2: RESULT_CF (M2-proven) */
+				iowrite32be(0, c + 12);
+				iowrite32be((u32)miss_fqid, c + 16);
+				iowrite32be(0, c + 20);
+				iowrite32be(0, c + 24); /* w2: RESULT_CF (M2-proven) */
+				iowrite32be(0, c + 28);
+				fe_enter_off = gro;
+			}
+		}
+	}
+
+	err = fman_pcd_kg_port_arm_fe(pcd, (u8)port_id,
+				      (u32)fe_enter_off, &saved_engine);
+	if (err)
+		return err;
+
+		pcd->fe_armed_port = (u8)port_id;
+		pcd->fe_miss_fqid = miss_fqid;
+		pr_info("fman_pcd fe_arm: port 0x%02x ENGAGED FE_ENTER=0x%lx (AC_CC)\n",
+		port_id, fe_enter_off);
+	return 0;
+}
+
+static int fman_pcd_fe_arm_disengage(struct fman_pcd *pcd, const char *args)
+{
+	unsigned int port_id;
+
+	if (sscanf(args, "disengage %x", &port_id) != 1)
+		return -EINVAL;
+	if (port_id < 0x08 || port_id >= 0x28)
+		return -EINVAL;
+
+	fman_pcd_kg_port_disarm_fe(pcd, (u8)port_id, 0);
+	pr_info("fman_pcd fe_arm: port 0x%02x DISENGAGED\n", port_id);
+	return 0;
+}
+
+static int fman_pcd_fe_arm_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+
+	mutex_lock(&pcd->fe_lock);
+	seq_printf(s, "fe_pool engaged:  %s\n",
+		   pcd->fe_refcount ? "YES" : "NO");
+	seq_printf(s, "FE_ENTER root AD: 0x%lx\n", pcd->fe_root_ad_off);
+	seq_printf(s, "MISS FQID: 0x%x (port 0x%02x)\n", pcd->fe_miss_fqid, pcd->fe_armed_port);
+	mutex_unlock(&pcd->fe_lock);
+	seq_puts(s,
+		 "verbs: engage <port_hex> <off_hex> [fqid_hex] | disengage <port_hex>\n");
+	return 0;
+}
+
+static int fman_pcd_fe_arm_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_arm_show, inode->i_private);
+}
+
+static ssize_t fman_pcd_fe_arm_write(struct file *file,
+				     const char __user *ubuf,
+				     size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman_pcd *pcd = s->private;
+	char buf[64];
+	int ret;
+
+	if (!pcd || count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	if (!strncmp(buf, "engage ", 7))
+		ret = fman_pcd_fe_arm_engage(pcd, buf);
+	else if (!strncmp(buf, "disengage ", 10))
+		ret = fman_pcd_fe_arm_disengage(pcd, buf);
+	else
+		ret = -EINVAL;
+
+	return ret ? ret : count;
+}

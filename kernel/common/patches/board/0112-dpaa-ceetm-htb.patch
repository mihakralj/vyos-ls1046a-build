---
diff --git a/drivers/net/ethernet/freescale/dpaa/Kconfig b/drivers/net/ethernet/freescale/dpaa/Kconfig
--- a/drivers/net/ethernet/freescale/dpaa/Kconfig
+++ b/drivers/net/ethernet/freescale/dpaa/Kconfig
@@ -81,32 +81,27 @@
 	  Safe to leave on: zero runtime cost without FMAN_CAP_POLICER_TRTCM.
 
 config DPAA_HW_CEETM
-	bool "DPAA: QMan CEETM egress-shaper scaffold (M3-3e)"
-	depends on DPAA_HW_CC_STEERING
+	bool "DPAA: QMan CEETM hierarchical egress shaper (HTB offload)"
+	depends on FSL_DPAA_ETH && FSL_QMAN_CEETM
 	default y
 	help
-	  Compile in the QMan CEETM egress-shaper scaffold API
-	  (dpaa_ceetm_qdisc_install / dpaa_ceetm_qdisc_destroy /
-	  dpaa_ceetm_supported) per
-	  specs/dpaa1-afxdp-modernization-spec.md sec 5.7.
+	  Offload the kernel TC_SETUP_QDISC_HTB contract (stock "tc qdisc add
+	  dev ethX root handle 1: htb offload" + "tc class add ... htb rate ...
+	  ceil ...") onto the QMan CEETM hierarchical egress traffic manager.
 
-	  CEETM is QMan's hierarchical egress traffic manager: a class
-	  queue channel tree with strict-priority + weighted-fair
-	  sub-queues and per-channel/per-CQ CR/ER token-bucket shaping,
-	  optionally with colour-aware CGR tail-drop. It backs the VyOS
-	  `tc qdisc` CEETM offload (HTB / strict-priority -> hardware).
+	  Each HTB leaf class is mapped to its own CEETM class-queue channel on
+	  a shared logical network interface (LNI): the channel dual-rate shaper
+	  is programmed with commit-rate = class rate and excess-rate =
+	  ceil - rate, plus a single strict-priority class queue with a
+	  byte-mode CCG tail-drop. An extra unshaped default channel carries
+	  unclassified traffic.
 
-	  Unlike the FMan PCD stubs, CEETM lives in QMan silicon and is
-	  NOT ucode-gated -- it works on any FMan microcode. This symbol
-	  controls only the scaffold: dpaa_ceetm_supported() returns
-	  false and install() returns -ENOTSUPP until the productive
-	  QMan CEETM core + ndo_setup_tc forward-port lands. The API is
-	  pinned now so the VyOS CLI consumer can compile against a
-	  stable contract. Safe to leave on: zero runtime cost.
-
-	  Depends on DPAA_HW_CC_STEERING because the scaffold object
-	  (dpaa_fman_caps.o) is gated by CONFIG_DPAA_HW_CC_STEERING in
-	  the Makefile; selecting CEETM without it would leave the
-	  exported symbols undefined at link time.
+	  Mapping a sub-portal to an LNI enables CEETM mode on the FMan Tx port,
+	  after which the conventional work-queue egress FQs are no longer
+	  dequeued; the driver therefore steers ALL egress (including the XDP Tx
+	  path) through the CEETM hierarchy until the HTB qdisc is destroyed.
 
+	  Only a flat root->leaf class structure is supported; deeper
+	  hierarchies are rejected with -EOPNOTSUPP. Safe to leave on: with no
+	  HTB offload qdisc installed there is zero datapath cost.
 source "drivers/net/ethernet/freescale/dpaa/af_xdp_pool/Kconfig"
diff --git a/drivers/net/ethernet/freescale/dpaa/Makefile b/drivers/net/ethernet/freescale/dpaa/Makefile
--- a/drivers/net/ethernet/freescale/dpaa/Makefile
+++ b/drivers/net/ethernet/freescale/dpaa/Makefile
@@ -12,6 +12,7 @@
 fsl_dpa-objs += dpaa_eth.o dpaa_ethtool.o dpaa_eth_sysfs.o
 fsl_dpa-$(CONFIG_DPAA_FLAVOR_OPS) += dpaa_flavor.o
 fsl_dpa-$(CONFIG_DPAA_HW_CC_STEERING) += dpaa_fman_caps.o
+fsl_dpa-$(CONFIG_DPAA_HW_CEETM) += dpaa_ceetm.o
 CFLAGS_dpaa_eth.o := -I$(src)
 
 obj-$(CONFIG_DPAA_AF_XDP_POOL) += af_xdp_pool/
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
@@ -48,6 +48,7 @@
  */
 #define CREATE_TRACE_POINTS
 #include "dpaa_eth_trace.h"
+#include "dpaa_ceetm.h"
 
 static int debug = -1;
 module_param(debug, int, 0444);
@@ -172,7 +173,6 @@
 
 #define DPAA_ENQUEUE_RETRIES	100000
 
-enum port_type {RX, TX};
 
 struct fm_port_fqs {
 	struct dpaa_fq *tx_defq;
@@ -407,6 +407,14 @@
 	mqprio->hw = TC_MQPRIO_HW_OFFLOAD_TCS;
 	num_tc = mqprio->num_tc;
 
+#if IS_ENABLED(CONFIG_DPAA_HW_CEETM)
+	if (priv->ceetm) {
+		netdev_err(net_dev,
+			   "remove the HTB offload qdisc before configuring mqprio\n");
+		return -EBUSY;
+	}
+#endif
+
 	if (num_tc == priv->num_tc)
 		return 0;
 
@@ -722,6 +730,8 @@
 		return dpaa_setup_tc_mqprio(net_dev, type_data);
 	case TC_SETUP_BLOCK:
 		return dpaa_setup_tc_block(net_dev, type_data);
+	case TC_SETUP_QDISC_HTB:
+		return dpaa_ceetm_setup_htb(net_dev, type_data);
 	default:
 		return -EOPNOTSUPP;
 	}
@@ -1802,7 +1812,7 @@
 	dpaa_bman_release(dpaa_bp, &bmb, 1);
 }
 
-static void count_ern(struct dpaa_percpu_priv *percpu_priv,
+void count_ern(struct dpaa_percpu_priv *percpu_priv,
 		      const union qm_mr_entry *msg)
 {
 	switch (msg->ern.rc & QM_MR_RC_MASK) {
@@ -2049,7 +2059,7 @@
  * No skb backpointer is set when transmitting XDP frames. Cleanup the buffer
  * and return NULL in this case.
  */
-static struct sk_buff *dpaa_cleanup_tx_fd(const struct dpaa_priv *priv,
+struct sk_buff *dpaa_cleanup_tx_fd(const struct dpaa_priv *priv,
 					  const struct qm_fd *fd, bool ts)
 {
 	const enum dma_data_direction dma_dir = DMA_TO_DEVICE;
@@ -2482,9 +2492,35 @@
 	struct qman_fq *egress_fq;
 	int err, i;
 
+#if IS_ENABLED(CONFIG_DPAA_HW_CEETM)
+	{
+		/* While an HTB offload qdisc is installed the FMan no longer
+		 * dequeues the conventional WQ egress FQs, so steer every
+		 * frame through the CEETM hierarchy instead.
+		 */
+		struct dpaa_ceetm *ceetm = smp_load_acquire(&priv->ceetm);
+
+		if (unlikely(ceetm)) {
+			egress_fq = dpaa_ceetm_egress_fq(ceetm, queue);
+			if (unlikely(!egress_fq))
+				egress_fq = priv->egress_fqs[queue];
+		} else {
+			egress_fq = priv->egress_fqs[queue];
+		}
+	}
+#else
 	egress_fq = priv->egress_fqs[queue];
-	if (fd->bpid == FSL_DPAA_BPID_INV)
-		fd->cmd |= cpu_to_be32(qman_fq_fqid(priv->conf_fqs[queue]));
+#endif
+	if (fd->bpid == FSL_DPAA_BPID_INV) {
+		unsigned int cq = queue;
+
+		/* CEETM leaf Tx queues live above the conf_fqs range; fold
+		 * them back to a valid confirmation FQ for this port.
+		 */
+		if (unlikely(cq >= dpaa_max_num_txqs()))
+			cq %= dpaa_max_num_txqs();
+		fd->cmd |= cpu_to_be32(qman_fq_fqid(priv->conf_fqs[cq]));
+	}
 
 	/* Trace this Tx fd */
 	trace_dpaa_tx_fd(priv->net_dev, egress_fq, fd);
@@ -3905,6 +3941,9 @@
 .ndo_set_features = dpaa_set_features,
 	.ndo_hwtstamp_get = dpaa_hwtstamp_get,
 	.ndo_hwtstamp_set = dpaa_hwtstamp_set,
+#if IS_ENABLED(CONFIG_DPAA_HW_CEETM)
+	.ndo_select_queue = dpaa_ceetm_select_queue,
+#endif
 };
 
 static int dpaa_napi_add(struct net_device *net_dev)
@@ -4095,7 +4134,8 @@
 	/* Allocate this early, so we can store relevant information in
 	 * the private area
 	 */
-	net_dev = alloc_etherdev_mq(sizeof(*priv), dpaa_max_num_txqs());
+	net_dev = alloc_etherdev_mq(sizeof(*priv),
+				    dpaa_max_num_txqs() + DPAA_CEETM_MAX_TXQS);
 	if (!net_dev) {
 		dev_err(dev, "alloc_etherdev_mq() failed\n");
 		return -ENOMEM;
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
@@ -20,6 +20,9 @@
 /* Number of prioritised traffic classes */
 #define DPAA_TC_NUM		4
 
+/* FMan port direction; indexes mac_device->port[] */
+enum port_type {RX, TX};
+
 /* Opaque KeyGen scheme handle (full type in <linux/fsl/fman_pcd.h>); held by
  * struct dpaa_priv for the ingress-policer catch-all scheme.
  */
@@ -58,6 +61,7 @@
 };
 
 struct dpaa_priv;
+struct dpaa_ceetm;
 
 struct dpaa_bp {
 	/* used in the DMA mapping operations */
@@ -511,6 +515,14 @@
 	 */
 	struct dpaa_qmap_entry qmap[DPAA1_XSK_MAX_QBANDS];
 	atomic_t               xsk_tx_inflight[DPAA1_XSK_MAX_QBANDS];
+#if IS_ENABLED(CONFIG_DPAA_HW_CEETM)
+	/* QMan CEETM HTB-offload state (patch 0112). NULL when no HTB
+	 * offload qdisc is installed; published with smp_store_release()
+	 * before the default channel is built, read with smp_load_acquire()
+	 * on the dpaa_xmit() steering fast path.
+	 */
+	struct dpaa_ceetm *ceetm;
+#endif
 };
 
 /**
@@ -575,6 +587,12 @@
 	return num_possible_cpus();
 }
 
+/* Shared with dpaa_ceetm.c: software-ERN frame cleanup helpers. */
+void count_ern(struct dpaa_percpu_priv *percpu_priv,
+	       const union qm_mr_entry *msg);
+struct sk_buff *dpaa_cleanup_tx_fd(const struct dpaa_priv *priv,
+				   const struct qm_fd *fd, bool ts);
+
 /* Total number of Tx queues */
 static inline size_t dpaa_max_num_txqs(void)
 {
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c b/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c
@@ -574,39 +574,5 @@
 }
 EXPORT_SYMBOL_GPL(fman_policer_caps_supported);
 
-/*
- * CEETM (Customer Edge Egress Traffic Management) -- M3-3e scaffold.
- *
- * Stub entry points for the QMan egress hierarchical shaper. CEETM is
- * ucode-independent QMan silicon, so unlike the FMan PCD stubs above
- * these do NOT consult dpaa_fman_get_caps(); they gate purely on
- * whether the productive datapath has been compiled in. Until the
- * QMan CEETM core + dpaa_eth ndo_setup_tc forward-port lands,
- * dpaa_ceetm_supported() reports false and install() returns -ENOTSUPP,
- * so the VyOS CLI consumer cleanly degrades to software qdiscs.
- *
- * Spec sec 5.7: CEETM API.
- */
-int dpaa_ceetm_qdisc_install(struct net_device *dev,
-			     const struct dpaa_ceetm_config *cfg)
-{
-if (!dev || !cfg)
-return -EINVAL;
-return -ENOTSUPP;
-}
-EXPORT_SYMBOL_GPL(dpaa_ceetm_qdisc_install);
-
-void dpaa_ceetm_qdisc_destroy(struct net_device *dev)
-{
-/* No productive hierarchy to release in the scaffold; no-op. */
-}
-EXPORT_SYMBOL_GPL(dpaa_ceetm_qdisc_destroy);
-
-bool dpaa_ceetm_supported(void)
-{
-return false;
-}
-EXPORT_SYMBOL_GPL(dpaa_ceetm_supported);
-

+/* F-061 v6: fe_probe debugfs - scan FE workspace for KG key
+ * Reads 64 u32 words (256B), past the 246B ALLOCATE workspace.
+ * Shows only non-zero words to find the key wherever it lands.
+ */
+/* F-069b v23: page-boundary-aware scan from frame-data vaddr, BOTH directions.
+ * vaddr = phys_to_virt(fd.addr) = frame-data address.
+ * IC is at vaddr - data_offset (data_offset typically 64-256).
+ * Safe backward scan: only up to the page boundary of vaddr.
+ * v23: v22 bounded the backward scan to the page boundary but left the
+ * forward scan fixed at +512 with no check against the page/mapping
+ * extent -- a forward-direction read past the mapped page causes a
+ * level-1 translation fault (board-reproduced 2026-07-31, PC in
+ * fman_pcd_ic_probe_show).  v23 bounds the forward scan symmetrically:
+ * stop 16 bytes (one scan block) before the page end so the last
+ * 4-word read never crosses into the next (possibly unmapped) page.
+ */
+extern void *fman_pcd_ic_vaddr;
+extern void *fman_pcd_ic_buf_base;
+
+static int fman_pcd_hash_probe_show(struct seq_file *m, void *v)
+{
+	if (!fman_pcd_hash_off) {
+		seq_puts(m, "idle (no eth4 frame captured)\n");
+		return 0;
+	}
+	seq_printf(m, "hash_off=%u captured=%016llx\n",
+		fman_pcd_hash_off, fman_pcd_kg_hash);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(fman_pcd_hash_probe);
+
+
+static int fman_pcd_ic_probe_show(struct seq_file *s, void *unused)
+{
+	void *vaddr;
+	long page_off;
+	int off, max_back, max_fwd;
+	unsigned int i, v, nonzero;
+
+	smp_rmb();
+	vaddr = fman_pcd_ic_vaddr;
+	if (!vaddr) {
+		seq_puts(s, "no frame captured\n");
+		return 0;
+	}
+	page_off = (unsigned long)vaddr & 0xFFF;
+	max_back = page_off < 256 ? page_off : 256;
+	/* v23: cap forward scan to stay within vaddr's page, minus one
+	 * 16-byte block so the last read (off..off+15) never crosses the
+	 * page boundary into unmapped memory.
+	 */
+	max_fwd = 4096 - (int)page_off - 16;
+	if (max_fwd > 512)
+		max_fwd = 512;
+	if (max_fwd < 0)
+		max_fwd = 0;
+	seq_printf(s, "vaddr=%px page_off=0x%03lx max_back=%d max_fwd=%d\n",
+		   vaddr, page_off, max_back, max_fwd);
+	/* Scan -max_back .. +max_fwd around vaddr (covers IC + frame start),
+	 * bounded on both ends by vaddr's containing page.
+	 */
+	for (off = -max_back; off < max_fwd; off += 16) {
+		nonzero = 0;
+		for (i = 0; i < 4; i++) {
+			if (((u32 *)vaddr)[off/4 + i]) nonzero++;
+		}
+		if (nonzero) {
+			seq_printf(s, "%+05d:", off);
+			for (i = 0; i < 4; i++) {
+				v = be32_to_cpu(((u32 *)vaddr)[off/4 + i]);
+				seq_printf(s, " %08x", v);
+			}
+			seq_puts(s, "\n");
+		}
+	}
+	return 0;
+}
+
+static int fman_pcd_ic_probe_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_ic_probe_show, inode->i_private);
+}
+
+static const struct file_operations fman_pcd_ic_probe_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_ic_probe_open,
+	.read		= seq_read,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+static int fman_pcd_fe_probe_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	void __iomem *ws_base;
+	unsigned int i;
+	u32 v;
+
+	mutex_lock(&pcd->fe_lock);
+	if (!muram || pcd->fe_refcount == 0) {
+		seq_puts(s, "fe pool not engaged\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	if (!pcd->fe_pool_off) {
+		seq_puts(s, "fe pool not allocated\n");
+		mutex_unlock(&pcd->fe_lock);
+		return 0;
+	}
+	ws_base = (void *)fman_muram_offset_to_vbase(muram, pcd->fe_pool_off);
+	seq_printf(s, "pool=0x%05lx\n", pcd->fe_pool_off);
+	for (i = 0; i < 64; i++) {
+		v = ioread32be((u32 __iomem *)ws_base + i);
+		if (v)
+			seq_printf(s, " [%02d]=%08x", i, v);
+	}
+	seq_puts(s, "\n");
+	mutex_unlock(&pcd->fe_lock);
+	return 0;
+}
+
+static int fman_pcd_fe_probe_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_fe_probe_show, inode->i_private);
+}

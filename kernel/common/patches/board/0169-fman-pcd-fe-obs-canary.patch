+/* F-158: ground-truth dump of the CC CONT_LOOKUP scaffold MURAM.
+ * STRICT_DEVMEM blocks /dev/mem, so this kernel node is the only way
+ * to see what F-148 actually wrote vs what the CC comparator reads.
+ */
+static void fman_pcd_fe_dump_bytes(struct seq_file *s, void __iomem *base,
+				  int len)
+{
+	int i;
+
+	for (i = 0; i < len; i++) {
+		if (i % 16 == 0)
+			seq_printf(s, "\n  %04x:", i);
+		seq_printf(s, " %02x", ioread8((u8 __iomem *)base + i));
+	}
+	seq_puts(s, "\n");
+}
+
+static int fman_pcd_fe_scaffold_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct fman_pcd_fe_port *fp;
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+
+	if (!muram)
+		return 0;
+
+	seq_puts(s, "fe_scaffold dump (per armed port)\n");
+	list_for_each_entry(fp, &pcd->fe_ports, node) {
+		if (!fp->scaffold_gro && !fp->scaffold_mto && !fp->scaffold_ato)
+			continue;
+
+		seq_printf(s, "\nport 0x%02x\n", fp->port_id);
+		seq_printf(s, "  gro=0x%lx mto=0x%lx ato=0x%lx root_ad=0x%lx\n",
+			   fp->scaffold_gro, fp->scaffold_mto, fp->scaffold_ato,
+			   pcd->fe_root_ad_off);
+
+		/* group table: 4 words */
+		if (fp->scaffold_gro) {
+			void __iomem *gt = (void __iomem *)
+				fman_muram_offset_to_vbase(muram, fp->scaffold_gro);
+			u32 w0 = ioread32be(gt + 0);
+			u32 w1 = ioread32be(gt + 4);
+			u32 w2 = ioread32be(gt + 8);
+			u32 w3 = ioread32be(gt + 12);
+
+			seq_printf(s, "  group: w0=%08x w1=%08x w2=%08x w3=%08x\n",
+				   w0, w1, w2, w3);
+			seq_printf(s, "    numKeys=%u matchTableAddr=0x%06x "
+				   "adTableAddr=0x%06x keySize8=%u\n",
+				   (w0 >> 24) & 0xff, w0 & 0xffffff, w1 & 0xffffff,
+				   ((w2 >> 24) & 0xff) + 1);
+		}
+
+		/* match table: 2 rows x 32B (key16+mask16), 64 B */
+		if (fp->scaffold_mto) {
+			void __iomem *mt = (void __iomem *)
+				fman_muram_offset_to_vbase(muram, fp->scaffold_mto);
+			seq_puts(s, "  match table (64 B = row0 key+mask, row1 key+mask):");
+			fman_pcd_fe_dump_bytes(s, mt, 64);
+			/* decode row0 key bytes 0..12 as the likely EKFC 5-tuple */
+			{
+				u8 k[16];
+				int j;
+				for (j = 0; j < 16; j++)
+					k[j] = ioread8((u8 __iomem *)mt + j);
+				seq_printf(s, "    row0.key: %02x%02x%02x%02x %02x%02x%02x%02x "
+					   "%02x %02x%02x %02x%02x [%02x%02x%02x]\n",
+					   k[0],k[1],k[2],k[3], k[4],k[5],k[6],k[7], k[8],
+					   k[9],k[10], k[11],k[12], k[13],k[14],k[15]);
+				seq_printf(s, "    row0.mask: %02x%02x%02x%02x %02x%02x%02x%02x "
+					   "%02x %02x%02x %02x%02x [%02x%02x%02x]\n",
+					   ioread8((u8 __iomem *)mt+16), ioread8((u8 __iomem *)mt+17),
+					   ioread8((u8 __iomem *)mt+18), ioread8((u8 __iomem *)mt+19),
+					   ioread8((u8 __iomem *)mt+20), ioread8((u8 __iomem *)mt+21),
+					   ioread8((u8 __iomem *)mt+22), ioread8((u8 __iomem *)mt+23),
+					   ioread8((u8 __iomem *)mt+24), ioread8((u8 __iomem *)mt+25),
+					   ioread8((u8 __iomem *)mt+26), ioread8((u8 __iomem *)mt+27),
+					   ioread8((u8 __iomem *)mt+28), ioread8((u8 __iomem *)mt+29),
+					   ioread8((u8 __iomem *)mt+30), ioread8((u8 __iomem *)mt+31));
+			}
+		}
+
+		/* AD table: 2 x 16B AD entries */
+		if (fp->scaffold_ato) {
+			void __iomem *at = (void __iomem *)
+				fman_muram_offset_to_vbase(muram, fp->scaffold_ato);
+			seq_puts(s, "  AD table (32 B):");
+			fman_pcd_fe_dump_bytes(s, at, 32);
+		}
+	}
+	return 0;
+}

+/* Inverse: re-zero the canary FE's MURAM and return its slot to the pool. */
+static void fman_pcd_fe_obs_free_one(struct fman_pcd *pcd,
+				     unsigned long off)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	struct fman_pcd_fe_obj *obj, *tmp;
+
+	list_for_each_entry_safe(obj, tmp, &pcd->fe_singletons, node) {
+		if (obj->muram_off != off)
+			continue;
+		list_del(&obj->node);
+		if (muram)
+			memset_io((void __iomem *)
+				  (void *)fman_muram_offset_to_vbase(muram, off),
+				  0, FMAN_PCD_FE_MAX_SIZE);
+		list_add_tail(&obj->node, &pcd->fe_available);
+		break;
+	}
+}

+static int fman_pcd_fe_buffer_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	int port_id;
+	void __iomem *pp;
+	u32 v54, v58;
+
+	for (port_id = 0x08; port_id <= 0x11; port_id++) {
+		struct fman_port *port = fman_port_lookup_rx(pcd->fman, port_id);
+		u32 pp_off;
+		if (!port)
+			continue;
+		pp_off = fman_port_get_params_page(port);
+		if (IS_ERR_VALUE(pp_off))
+			continue;
+		pp = fman_muram_offset_to_vbase(muram, pp_off);
+		v54 = ioread32be((void __iomem *)((u8 __iomem *)pp + 0x54));
+		v58 = ioread32be((void __iomem *)((u8 __iomem *)pp + 0x58));
+		seq_printf(s, "port 0x%02x: +0x54=%#010x +0x58=%#010x tnums=%u\n",
+			   port_id, v54, v58, fman_port_get_total_tnums(port));
+	}
+	return 0;
+}

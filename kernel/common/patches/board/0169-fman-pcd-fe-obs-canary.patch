+	 * fman_pcd_ehash_flow_drain() does, NOT kfree (which trips
+	 * free_large_kmalloc and corrupts the coherent allocator). */
+	dma_free_coherent(t->dev, FMAN_EHASH_FLOW_REC_SIZE,
+			  x->record, x->record_dma);
+	kfree(x);
+	return 0;

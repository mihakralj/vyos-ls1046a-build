+ * any frame can reach it).  This catches the F-072…F-079 silent-write
+ * defect class in milliseconds instead of hours of board probing.
+ */
+static int fman_pcd_fe_verify_internal(struct fman_pcd *pcd, u8 hw_port_id)
+{
+	struct muram_info *muram = fman_get_muram(pcd->fman);
+	int errs = 0;
+
+	if (!muram)
+		return -ENODEV;
+
+	/* ── Step 1: CC root node ────────────────────────────────── */
+	if (pcd->fe_root_ad_off) {
+		void __iomem *fe = fman_muram_offset_to_vbase(muram, pcd->fe_root_ad_off);
+		u32 w0 = ioread32be(fe);
+
+		/* F-186/F-190: the CC root AD is now the vendor en_exthash_node
+		 * (miss_action_type 0b10 = ENQUE, E25-verified loop-free), which
+		 * supersedes the old FE_ENTER CONT_LOOKUP (ALLOCATE bit 23).
+		 * Accept either form so the gate does not false-fail on the
+		 * vendor node (w0 e.g. 0x8e400000 has no ALLOCATE bit).
+		 */
+		if ((w0 & 0xC0000000) != 0x80000000 &&
+		    !(w0 & 0x00800000)) {
+			pr_warn("fman_pcd: verify 0x%02x: CC root w0=0x%08x (neither vendor node nor FE_ENTER ALLOCATE)\n",
+				hw_port_id, w0);
+			errs++;
+		}
+	}
+
+	/* ── Step 2: EXT_HASH FE ─────────────────────────────────── */
+	if (pcd->fe_hash_off) {
+		void __iomem *fe = fman_muram_offset_to_vbase(muram, pcd->fe_hash_off);
+		u32 w0 = ioread32be(fe);
+
+		/* type must be 0x06 */
+		if ((w0 & 0xFF000000) != 0x06000000) {
+			pr_warn("fman_pcd: verify 0x%02x: EXT_HASH type 0x%02x != 0x06\n",
+				hw_port_id, (w0 >> 24) & 0xFF);
+			errs++;
+		}
+
+		/* w5 (HIT nextFE) and w6 (MISS nextFE) must be non-zero */
+		if (!ioread32be(fe + 20)) {
+			pr_warn("fman_pcd: verify 0x%02x: EXT_HASH HIT nextFE == 0\n", hw_port_id);
+			errs++;
+		}
+		if (!ioread32be(fe + 24)) {
+			pr_warn("fman_pcd: verify 0x%02x: EXT_HASH MISS nextFE == 0\n", hw_port_id);
+			errs++;
+		}
+	}
+
+	/* ── Step 3: MUX singleton ────────────────────────────────── */
+	if (pcd->fe_mux_off) {
+		void __iomem *fe = fman_muram_offset_to_vbase(muram, pcd->fe_mux_off);
+		if ((ioread32be(fe) & 0xFF000000) != 0x04000000) {
+			pr_warn("fman_pcd: verify 0x%02x: MUX type mismatch\n", hw_port_id);
+			errs++;
+		}
+	}
+
+	/* ── Step 4: EXIT singleton ───────────────────────────────── */
+	if (pcd->fe_exit_off) {
+		void __iomem *fe = fman_muram_offset_to_vbase(muram, pcd->fe_exit_off);
+		u32 w0 = ioread32be(fe);
+		if ((w0 & 0xFF800000) != 0x03800000) {
+			pr_warn("fman_pcd: verify 0x%02x: EXIT w0=0x%08x (DEALLOCATE missing?)\n",
+				hw_port_id, w0);
+			errs++;
+		}
+	}
+
+	if (errs == 0)
+		pr_debug("fman_pcd: verify 0x%02x PASSED\n", hw_port_id);
+	else
+		pr_err("fman_pcd: verify 0x%02x FAILED (%d errors)\n", hw_port_id, errs);
+
+	return errs ? -EPROTO : 0;
+}

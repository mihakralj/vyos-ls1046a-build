+	 * lib/list_debug.c:35, panicking the kernel on every fe_obs arm.
+	 * Reproduced twice on .185 (2026-08-12): trace
+	 * fman_pcd_fe_obs_enq_one -> __list_add_valid_or_report, panic=60
+	 * reboot both times.
+	 */
+	list_del(&obj->node);
+	list_add_tail(&obj->node, &pcd->fe_singletons);
+	return 0;

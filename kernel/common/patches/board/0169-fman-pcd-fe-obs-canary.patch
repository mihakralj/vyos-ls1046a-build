+/* F-072 v3: Port FmPortSetFESupport. Internal FE buffer pool + mgmt index in MURAM.
+ * SDK 999-patch ~L14545. tnums*512B pool (256-align auto via gen_pool granule),
+ * (5+tnums) byte index. Params page +0x54=index MURAM off, +0x58=0.
+ * port_id is u8 hw port number (not port->port_id — struct fman_port is opaque).
+ */
+static int fman_pcd_fe_buffer_setup(struct fman_pcd *pcd,
+                                    struct fman_port *port, u8 port_id)
+{
+    struct muram_info *muram = fman_get_muram(pcd->fman);
+    u8 tnums;
+    unsigned long pool_off, idx_off;
+    u32 pp_off;
+    void __iomem *pp, *idx;
+    int i;
+
+    static const unsigned int BMI_FIFO_UNITS = 0x100;
+
+    if (!muram || !port)
+        return -EINVAL;
+
+    tnums = fman_port_get_total_tnums(port);
+    if (!tnums)
+        return -EINVAL;
+
+    pp_off = fman_port_get_params_page(port);
+    if (IS_ERR_VALUE(pp_off))
+        return (int)pp_off;
+
+    /* gen_pool MURAM granule is 256 (MURAM_ORDER=8), so alloc is 256-aligned */
+    pool_off = fman_pcd_muram_alloc(pcd, tnums * BMI_FIFO_UNITS * 2);
+    if (IS_ERR_VALUE(pool_off))
+        return (int)pool_off;
+
+    memset_io((void *)fman_muram_offset_to_vbase(muram, pool_off), 0,
+              tnums * BMI_FIFO_UNITS * 2);
+
+    idx_off = fman_pcd_muram_alloc(pcd, 5 + tnums);
+    if (IS_ERR_VALUE(idx_off)) {
+        fman_pcd_muram_free(pcd, pool_off, tnums * BMI_FIFO_UNITS * 2);
+        return (int)idx_off;
+    }
+
+    idx = (void *)fman_muram_offset_to_vbase(muram, idx_off);
+    iowrite32be(pool_off, idx);
+    iowrite8(4, idx);
+    for (i = 0; i < tnums; i++)
+        iowrite8(i, (void __iomem *)((u8 __iomem *)idx + 4 + i));
+    iowrite8(0xFF, (void __iomem *)((u8 __iomem *)idx + 4 + tnums));
+
+    pp = (void *)fman_muram_offset_to_vbase(muram, pp_off);
+    iowrite32be((u32)idx_off, (void __iomem *)((u8 __iomem *)pp + 0x54));
+    iowrite32be(0,          (void __iomem *)((u8 __iomem *)pp + 0x58));
+
+    pr_info("fman_pcd: F-072 port 0x%02x FE buffer pool=%#lx idx=%#lx tnums=%u\n",
+            port_id, pool_off, idx_off, tnums);
+    return 0;
+}

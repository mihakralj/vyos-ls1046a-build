 		seq_printf(s, "%08x ", ioread32be(fe + i));
@@ -1155,6 +1313,21 @@ static const struct file_operations fman_pcd_fe_singletons_fops = {
 
 /* ENQ FE word1 holds the 24-bit target FQID when FMAN_FE_ENQ_FQID is set. */
 #define FMAN_FE_ENQ_NIA_MASK		0x00ffffff
+/* F-175: vendor-correct ENQ encoding (board-tested, F-073B, 2026-07-16).
+ * word1 carries a genuine NIA, not a raw FQID; the FQID is read from
+ * the per-frame workspace at ws_offset 8 (FE_ENQUEUE_CONTEXT_OFFSET).
+ */
+#define FMAN_FE_ENQ_CONTEXT_OFFSET	8
+#define FMAN_NIA_BMI_AC_ENQ_FRAME	0x00500002
+/* F-175: per-flow FE context buffer (SDK: separately allocated, NEVER

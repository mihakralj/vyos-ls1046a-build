From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VyOS LS1046A <ask20@vyos-ls1046a-build>
Date: Mon, 10 Aug 2026 06:00:00 +0000
Subject: [PATCH] fman_pcd: FE-VM observation canary - hashfe HIT/MISS disposition redirect (0169)

Make the EXT_HASH comparator's execution observable from the host.  The
2026-08-10 comparator-input audit (decomp/experiments.md) verified the
hash, bucket, record and chain are byte-perfect yet pkt_count=0 - the
remaining gap is FE dispatch / comparator execution, which is engine
internal and not host-observable via any existing signal (the record
counters can never move: flow records are 256 B while the SDK stores
stats at +256, and hashfe word0 carries no UPDATE_STATS flag).

New debugfs node fe_obs redirects the hashfe's own dispositions -
nextFEPtr (w5, HIT) and missNextFEPtr (w6, MISS) - at two freshly
built ENQ FEs targeting caller-supplied FQIDs, saving the originals
(MUX/EXIT singletons) for a byte-exact restore.  Counting frames at
each canary FQ yields the 3-way verdict:

  miss-canary count > 0  -> frame REACHED the hashfe and took MISS
                            (comparator ran, no match)
  hit-canary  count > 0  -> comparator HIT
  both 0, rx tracks spc  -> frame never dispatched to the FE chain

Verbs:  arm <port_hex> <hit_fqid_hex> <miss_fqid_hex> | disarm <port_hex>

The canary FEs are pool slots parked on fe_singletons (teardown
reclaims them); arm/disarm are readback-verified per S6 Sec 10.2 and
restore hashfe w5/w6 byte-exact on mismatch.  Statistics-mode flags are
deliberately NOT touched (no UPDATE_TS: missing timestamp_counter; no
UPDATE_STATS: would write past the 256-B record).  Driver note: the
209-patch "hitResult" field does not exist in t_ExtHashFe - HIT
disposition is the descriptor nextFEPtr, which is what this redirects.

Reference: 999-layerscape-ask-kernel_linux_5_4_3_00_0.patch
  t_ExtHashFe (L10318): nextFEPtr/missNextFEPtr are the only dispositions
  MAX_EN_EHASH_EXT_ENTRY_SIZE=320 (L15457): stats at +256, record is 576 B
  FmPcdCcBuildContextByFE (L8954): ENQ context encoding (rspid/fqid/ppid)
F-107 compatibility: the per-port armed check originally used
pcd->fe_armed_port (u8), but the Layer-2 F-107 fixup rewrites that field
to DECLARE_BITMAP(fe_port_armed, 32) AFTER the patch stack.  The check is
therefore dropped from arm/disarm (pool-engaged + fe_hash_off are the
authoritative guards) and the show() port line removed, so the patch is
valid in both the pre-fixup and post-fixup trees.

Signed-off-by: VyOS LS1046A <ask20@vyos-ls1046a-build>
---
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
index bb7659c..37faf01 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -144,7 +144,24 @@ struct fman_pcd {
 	/* E2 workspace hash probe (0159) */
 	u8  fe_probe_key[32];
 	int fe_probe_key_len;
-	unsigned long fe_hash_off;	/* sec.5 t_ExtHashFe FE-hash object */
+	unsigned long fe_hash_off;
+	u32 fe_enq_fqid;	/* F-157: FE-VM ENQ target on HIT (dedicated TX FQ) */	/* sec.5 t_ExtHashFe FE-hash object */
+
+	void *miss_ctx;			/* F-069: 256B DDR miss context */
+	dma_addr_t miss_ctx_phys;		/* F-069: physical addr */
+	unsigned long miss_res_off;		/* F-069: MURAM result */
+	/* FE-VM observation canary (0169): redirect the hashfe HIT/MISS
+	 * dispositions (w5/w6) at two countable ENQ FEs so a probe can
+	 * discriminate "frame reached the EXT_HASH comparator and MISSed"
+	 * from "frame never dispatched to the FE chain".  fe_obs_saved_*
+	 * hold the w5/w6 values restored by disarm (MUX/EXIT singletons). */
+	unsigned long fe_obs_hit_off;
+	unsigned long fe_obs_miss_off;
+	u32 fe_obs_saved_hit;
+	u32 fe_obs_saved_miss;
+	u32 fe_obs_hit_fqid;
+	u32 fe_obs_miss_fqid;
+	bool fe_obs_armed;
 
 	struct dentry *debugfs_dir;
 };
@@ -1155,6 +1172,21 @@ static const struct file_operations fman_pcd_fe_singletons_fops = {
 
 /* ENQ FE word1 holds the 24-bit target FQID when FMAN_FE_ENQ_FQID is set. */
 #define FMAN_FE_ENQ_NIA_MASK		0x00ffffff
+/* F-175: vendor-correct ENQ encoding (board-tested, F-073B, 2026-07-16).
+ * word1 carries a genuine NIA, not a raw FQID; the FQID is read from
+ * the per-frame workspace at ws_offset 8 (FE_ENQUEUE_CONTEXT_OFFSET).
+ */
+#define FMAN_FE_ENQ_CONTEXT_OFFSET	8
+#define FMAN_NIA_BMI_AC_ENQ_FRAME	0x00500002
+/* F-175: per-flow FE context buffer (SDK: separately allocated, NEVER
+ * inline in the ehash record -- see FmPcdCcBuildContextByFE). Only
+ * MUX (offset 0, ENQ's own MURAM offset) and ENQ (offset 8/12,
+ * (rspid<<24)|fqid and ppid<<16) are needed -- this branch has no
+ * header-manipulation/replication chain, so Transition/HM are unused.
+ */
+#define FMAN_FE_CTX_SIZE		16
+#define FMAN_FE_CTX_MUX_OFF		0
+#define FMAN_FE_CTX_ENQ_OFF		8
 
 /* FE_ENTER root action-descriptor (SDK t_AdOfTypeContLookup) field bits. */
 #define FMAN_AD_CONT_LOOKUP_TYPE	0x40000000	/* word0 ccAdBase type */
@@ -1169,8 +1201,7 @@ static const struct file_operations fman_pcd_fe_singletons_fops = {
  * shortfall nothing is committed, so silicon is never half-programmed.
  * Caller holds pcd->fe_lock.
  */
-static int fman_pcd_fe_enq_build(struct fman_pcd *pcd, u32 fqid,
-				 unsigned long next_fe_off)
+static int fman_pcd_fe_enq_build(struct fman_pcd *pcd)
 {
 	struct muram_info *muram = fman_get_muram(pcd->fman);
 	struct fman_pcd_fe_params p;
@@ -1180,19 +1211,26 @@ static int fman_pcd_fe_enq_build(struct fman_pcd *pcd, u32 fqid,
 		return -ENXIO;
 	if (pcd->fe_refcount == 0)
 		return -ENXIO;		/* engage the pool first */
-	if (fqid & ~FMAN_FE_ENQ_NIA_MASK)
-		return -EINVAL;		/* FQIDs are 24-bit */
+	if (!pcd->fe_exit_off)
+		return -ENOENT;	/* F-175: fe_singletons build first */
 
 	obj = list_first_entry_or_null(&pcd->fe_available,
 				       struct fman_pcd_fe_obj, node);
 	if (!obj)
 		return -ENOSPC;
 
+	/* F-175: vendor-correct ENQ (board-tested, F-073B) -- word1 is a
+	 * genuine NIA (BMI enqueue action), not a raw FQID; the target FQID
+	 * is read from the per-frame workspace at ws+8, populated by
+	 * hardware from the matched flow record's context buffer on a
+	 * genuine HIT. ENQ always chains to EXIT (SDK: never terminal).
+	 */
 	memset(&p, 0, sizeof(p));
 	p.type = FMAN_FE_TYPE_ENQ;
+	p.ws_offset = FMAN_FE_ENQ_CONTEXT_OFFSET;
 	p.flags = FMAN_FE_ENQ_FQID;
-	p.nia = fqid;
-	p.next_fe_off = pcd->fe_exit_off;	/* F-073D: chain to EXIT(DEALLOCATE) */
+	p.nia = FMAN_NIA_BMI_AC_ENQ_FRAME;
+	p.next_fe_off = pcd->fe_exit_off;
 
 	list_del(&obj->node);
 	fman_pcd_fe_build(muram, obj->muram_off, &p);
@@ -1256,8 +1294,6 @@ static ssize_t fman_pcd_fe_enq_write(struct file *file,
 {
 	struct seq_file *s = file->private_data;
 	struct fman_pcd *pcd = s->private;
-	unsigned long next_fe_off;
-	unsigned int fqid;
 	char buf[48];
 	int err;
 
@@ -1268,10 +1304,12 @@ static ssize_t fman_pcd_fe_enq_write(struct file *file,
 	buf[count] = '\0';
 
 	mutex_lock(&pcd->fe_lock);
-	if (sscanf(buf, "build %x %lx", &fqid, &next_fe_off) == 2) {
-		err = fman_pcd_fe_enq_build(pcd, fqid, next_fe_off);
-	} else if (sscanf(buf, "build %x", &fqid) == 1) {
-		err = fman_pcd_fe_enq_build(pcd, fqid, 0);
+	if (!strncmp(buf, "build", 5)) {
+		/* F-175: no fqid argument -- ENQ is a plain singleton now;
+		 * the per-flow FQID lives in the flow record's own context
+		 * buffer (see fe_flow), not this shared FE descriptor.
+		 */
+		err = fman_pcd_fe_enq_build(pcd);
 	} else if (!strncmp(buf, "clear", 5)) {
 		fman_pcd_fe_enq_free(pcd);
 		err = 0;
@@ -1467,6 +1505,7 @@ static const struct file_operations fman_pcd_fe_enter_fops = {
 #define FMAN_EHASH_INT_BUF_TOTAL \
 	(FMAN_EHASH_INT_BUF_POOL_SIZE + FMAN_EHASH_GLOBAL_MEM_SIZE)
 #define FMAN_EHASH_ALIGN		256		/* EN_EXTHASH_TBL_ALIGNMENT */
+#define FMAN_EHASH_NODE_SIZE		16	/* en_exthash_node descriptor */
 #define FMAN_EHASH_BUCKET_SIZE		16		/* lf-5.4 {u64 h; u64 pad} */
 #define FMAN_EHASH_MASK_MAX		0x7fff		/* hash_mask_bits: 4-bit field */
 
@@ -1475,6 +1514,7 @@ struct fman_pcd_ehash_table {
 	void *table_base;		/* DDR bucket array (dma_alloc_coherent) */
 	dma_addr_t table_dma;		/* bus address of table_base (FE VM reads) */
 	struct device *dev;		/* DMA device (fman_get_dev), for record alloc */
+	struct fman_pcd *pcd;		/* F-148: back-pointer for CC match table */
 	size_t table_size;
 	u32 hash_mask;
 	u8 key_size;
@@ -1600,16 +1640,23 @@ static int fman_pcd_ehash_table_set(struct fman_pcd *pcd, u32 mask,
 		goto err_put_buf;
 	}
 	t->dev = dev;
+	t->pcd = pcd;	/* F-148 */
 	t->table_size = tablesize;
 	t->hash_mask = mask;
 	t->key_size = key_size;
 	t->hash_shift = hash_shift;
 	t->hash_mask_bits = (u8)ii;
 	INIT_LIST_HEAD(&t->flows);
+	t->dev = fman_get_dev(pcd->fman);	/* F-142 */
 
 	tblphys = t->table_dma;
 	fman_pcd_ehash_encode_node(t, tblphys, pcd->fe_int_buf_off);
 
+	/* F-143: Write en_exthash_node descriptor to first 16 bytes of DDR allocation.
+	 * The FE-VM reads this to get hash_bytes_offset, key_size, hash_mask_bits, etc.
+	 */
+	memcpy(t->table_base, t->ad, FMAN_EHASH_NODE_SIZE);
+
 	list_add_tail(&t->node, &pcd->fe_ehash_tables);
 	dev_info(fman_get_dev(pcd->fman),
 		 "fman_pcd: ehash table mask 0x%x keysize %u ii %d size %zu DDR %pad\n",
@@ -1756,7 +1803,7 @@ static const struct file_operations fman_pcd_ehash_fops = {
  *     a dma_pool would avoid per-record page rounding (future optimization).
  * ---------------------------------------------------------------------------
  */
-#define FMAN_EHASH_FLOW_REC_SIZE	256	/* MAX_EN_EHASH_ENTRY_SIZE */
+#define FMAN_EHASH_FLOW_REC_SIZE	320	/* MAX_EN_EHASH_ENTRY_SIZE */	/* F-176: 320B = MAX_EN_EHASH_EXT_ENTRY_SIZE, room for stats */
 #define FMAN_EHASH_FLOW_KEY_OFF		8	/* en_ehash_entry.key[0] */
 #define FMAN_EHASH_FLOW_KEY_MAX		56	/* fits rec - header - fe ptr */
 #define FMAN_EHASH_CRC64_POLY		0xC96C5795D7870F42ULL	/* ECMA-182, reflected */
@@ -1765,6 +1812,8 @@ struct fman_pcd_ehash_flow {
 	struct list_head node;
 	void *record;			/* DDR 256-B flow record (dma_alloc_coherent) */
 	dma_addr_t record_dma;		/* bus address of record (bucket head holds it) */
+	void *ctx;			/* F-175: separate 16B FE context buffer */
+	dma_addr_t ctx_dma;		/* F-175: bus address of ctx (stored in record) */
 	u64 *bucket_h;			/* the bucket head u64 it links into */
 	u64 prev_head;			/* old bucket->h, for byte-exact undo */
 	u16 index;			/* bucket index (for the show node) */
@@ -1835,7 +1884,7 @@ fman_pcd_ehash_table_by_index(struct fman_pcd *pcd, unsigned int idx)
  */
 static int fman_pcd_ehash_add_key(struct fman_pcd_ehash_table *t,
 				  const u8 *key, u8 key_size,
-				  unsigned long enq_fe_off)
+				  u32 enq_off, u32 fqid)
 {
 	struct fman_pcd_ehash_flow *flow;
 	u64 prev_head, old_native, rec_phys;
@@ -1867,15 +1916,103 @@ static int fman_pcd_ehash_add_key(struct fman_pcd_ehash_table *t,
 	prev_head = *flow->bucket_h;		/* swab'd phys of old head */
 	old_native = swab64(prev_head);		/* unswap to native phys */
 
+	/* F-181: vendor opcode ENQUEUE_PKT (vendor #define ENQUEUE_PKT 0x01). */
+	#define FMAN_EHASH_OPC_ENQUEUE_PKT	0x01
 	/* en_ehash_entry header: chain THIS record to the previous head. */
-	*(__be16 *)(r + 0) = cpu_to_be16(0);				/* flags */
-	*(__be16 *)(r + 2) = cpu_to_be16((u16)((old_native >> 32) & 0xffff));
-	*(__be32 *)(r + 4) = cpu_to_be32((u32)(old_native & 0xffffffff));
-	memcpy(r + FMAN_EHASH_FLOW_KEY_OFF, key, key_size);
+	/* F-181: vendor opcode-script record -- flags carry opc/param offsets
+	 * (SET_OPC_OFFSET/SET_PARAM_OFFSET).  The FE-VM reads opc_offset on a
+	 * HIT, walks the opcode list, and ENQUEUEs to enqueue_param.fqid --
+	 * without this there is no action script to walk and the comparator
+	 * can never complete a HIT.
+	 * F-182: STATS_EN cleared -- vendor sets it only with the 320B ext
+	 * entry (stats at +256) plus UPDATE_STATS in the hashfe word; we have
+	 * neither, and pkt_count was never a valid discriminator anyway (E20
+	 * confound #3; the M3 gate is the fe_obs canary, patch 0169).
+	 */
+	{
+		size_t opc_off = FMAN_EHASH_FLOW_KEY_OFF + ALIGN(key_size, sizeof(u32));
+		size_t param_off = opc_off + 16;	/* MAX_OPCODES */
+		u16 flags = 0;	/* F-182: no STATS_EN (256B record) */
+
+		/* vendor SET_OPC_OFFSET / SET_PARAM_OFFSET (hi: 5-bit opc, lo: 6-bit param, word>>2) */
+		flags |= (u16)(((u16)(opc_off >> 2)) << 6);
+		flags |= (u16)((u16)(param_off >> 2) & 0x3f);
+		*(__be16 *)(r + 0) = cpu_to_be16(flags);
+		*(__be16 *)(r + 2) = cpu_to_be16((u16)((old_native >> 32) & 0xffff));
+		*(__be32 *)(r + 4) = cpu_to_be32((u32)(old_native & 0xffffffff));
+		memcpy(r + FMAN_EHASH_FLOW_KEY_OFF, key, key_size);
+
+		/* opcode list: terminal ENQUEUE_PKT (0x01) -- the action the FE-VM runs. */
+		r[opc_off] = FMAN_EHASH_OPC_ENQUEUE_PKT;
+
+		/* en_ehash_enqueue_param (packed): mtu u16@0 | hdr u8@2 | bpid u8@3 |
+		 * fqid u32@4 | word u32@8 | word2 u32@12.  fqid = this record's ENQ
+		 * target (24-bit TX FQ); all BE.  mtu=1500, hdr/bpid/word/word2=0.
+		 */
+		*(__be16 *)(r + param_off + 0) = cpu_to_be16(1500);	/* mtu */
+		*(r + param_off + 2) = 0;	/* hdr_xpnd_sz */
+		*(r + param_off + 3) = 0;	/* bpid */
+		/* F-182: param.fqid = the flow's target FQID (vendor cdx
+		 * create_enque_hm: param->fqid = cpu_to_be32(l2_info.fqid)) --
+		 * NOT the ENQ FE MURAM offset F-181 v1 wrote here by mistake.
+		 */
+		*(__be32 *)(r + param_off + 4) = cpu_to_be32((u32)fqid & 0x00ffffff);	/* fqid */
+		*(__be32 *)(r + param_off + 8) = cpu_to_be32(0);	/* stats word */
+		*(__be32 *)(r + param_off + 12) = cpu_to_be32(0);	/* dscp word */
+	}
+
+	/* F-175: separate per-flow FE context buffer (SDK
+	 * FmPcdCcBuildContextByFE, ~line 8954 of the real oracle) --
+	 * NEVER inline in the ehash record (F-057 correctly found that
+	 * corrupts it). MUX's context (offset 0) points at the ENQ FE
+	 * directly (no Transition -- this branch has no HM/replication
+	 * chain); ENQ's context (offset 8/12) carries (rspid<<24)|fqid
+	 * and ppid<<16, byte-exact to the SDK's real encoder. rspid and
+	 * ppid are both 0 in this branch's design.
+	 */
+	{
+		/* F-182: relocate the ctx pointer past F-181's opcode slot
+		 * (ALIGN(keysize,4) after the key) + the 16B opcode area + the
+		 * 16B param block. The old 8+align8(keysize) offset EQUALLED
+		 * opc_off for keysize 14 (both 24) and this be64 write clobbered
+		 * the ENQUEUE_PKT opcode byte (E20 DDR dump: opcode[24]=0x00,
+		 * [24..31]=ctx_dma). New home (56 for keysize 14, 80 for the
+		 * 37B IPv6 key) stays inside the 256B record, past everything
+		 * the FE-VM walks.
+		 */
+		size_t fe_ptr_off = FMAN_EHASH_FLOW_KEY_OFF +
+				     ALIGN(key_size, sizeof(u32)) + 16 + 16;
+		dma_addr_t ctx_dma;
+		u8 *ctx = dma_alloc_coherent(t->dev, FMAN_FE_CTX_SIZE, &ctx_dma,
+					     GFP_KERNEL);
+
+		if (!ctx) {
+			dma_free_coherent(t->dev, FMAN_EHASH_FLOW_REC_SIZE, r, rdma);
+			kfree(flow);
+			return -ENOMEM;
+		}
+		*(__be32 *)(ctx + FMAN_FE_CTX_MUX_OFF) = cpu_to_be32(enq_off);
+		*(__be32 *)(ctx + FMAN_FE_CTX_ENQ_OFF) = cpu_to_be32(fqid & 0x00ffffff);
+		*(__be32 *)(ctx + FMAN_FE_CTX_ENQ_OFF + 4) = cpu_to_be32(0);	/* ppid<<16 */
+		flow->ctx = ctx;
+		flow->ctx_dma = ctx_dma;
+
+		*(__be64 *)(r + fe_ptr_off) = cpu_to_be64((u64)ctx_dma);
+	}
 
 
 	/* Head-insert: bucket head = swab64(dma_addr(record)). */
 	rec_phys = (u64)rdma;
+
+	/* F-173: order the record's field writes above (header, key,
+	 * next-FE pointer) before this bucket-head publish becomes
+	 * visible to FMan's independent DMA-capable hash-table walker.
+	 * Without this, a weak-ordered CPU can let the pointer write
+	 * reach visibility before the pointee's field writes do, so
+	 * FMan dereferences a still-stale record -- same bug class and
+	 * fix as vendor's own we-are-mono/ASK commit cb8fc275.
+	 */
+	wmb();
 	*flow->bucket_h = swab64(rec_phys);
 
 	flow->record = r;
@@ -1883,6 +2020,108 @@ static int fman_pcd_ehash_add_key(struct fman_pcd_ehash_table *t,
 	flow->prev_head = prev_head;
 	flow->index = index;
 	flow->key_size = key_size;
+	/* F-148 v6: Write key + mask to CC match table so the CC engine can dispatch
+	 * matching frames to FE_ENTER.  Without this, numKeys=0 routes ALL
+	 * frames to the miss-AD and the FE-VM ehash is never consulted.
+	 *
+	 * v5 FIX (2026-07-31): capped at nkeys<1 (single-key only).  mto is
+	 * allocated as bare 16 bytes (F-091) -- room for exactly ONE 16-byte
+	 * key row.  ato is allocated as 32 bytes -- room for exactly one
+	 * key's HIT-AD plus one miss-AD (RM 8.7.4.3's (numKeys+1)*16 for the
+	 * 0->1 transition only).  v4's "nkeys < 32" guard borrowed the name
+	 * FMAN_CC_MAX_STATIC_KEYS from an unrelated subsystem (patch 0086b's
+	 * official fman_cc_tree, which has its own properly sized storage)
+	 * without the scaffold here ever actually being sized for more than
+	 * one key.  A second key insert wrote to mt + 1*16, 16 bytes past
+	 * mto's allocation -- a real MURAM overflow reachable via ordinary
+	 * multi-flow use, not just test-only paths.  Supporting more than
+	 * one key correctly needs a bigger redesign (enlarge mto/ato AND
+	 * slide the miss-AD to the new top slot on every insert, matching
+	 * the official ask20/patch-0050 CC implementation) -- out of scope
+	 * here; this fix only prevents the overflow.
+	 *
+	 * v4 fixes bug (a): the HIT-AD slot must contain a COPY of the four
+	 * words already at pcd->fe_root_ad_off (the standalone FE_ENTER AD:
+	 * w0=0x40800000 CONT_LOOKUP|NIA_ORDER_RESTOR, w1=0, w2=0x000000F6
+	 * OPC_FE_ENTER, w3=EXT_HASH offset -- microcode reference Sec 7.7),
+	 * NOT the raw offset NUMBER written as word0.  A bare word0 with a
+	 * zero top byte decodes as an enqueue-AD to FQID=that number (RM
+	 * 8.7.4.3), which is a nonexistent FQ -- v3's bug.
+	 */
+	if (t->pcd) {
+		struct fman_pcd_fe_port *fp;
+		unsigned long mto = 0, gro = 0, ato = 0;
+
+		/* Find the armed port's per-port scaffold (F-139). */
+		list_for_each_entry(fp, &t->pcd->fe_ports, node) {
+			if (fp->scaffold_gro) {
+				gro = fp->scaffold_gro;
+				mto = fp->scaffold_mto;
+				ato = fp->scaffold_ato;
+				break;
+			}
+		}
+		if (mto && gro) {
+			struct muram_info *muram = fman_get_muram(t->pcd->fman);
+			void __iomem *mt = (void __iomem *)fman_muram_offset_to_vbase(muram, mto);
+			void __iomem *gt = (void __iomem *)fman_muram_offset_to_vbase(muram, gro);
+			u32 gw0 = ioread32be(gt);
+			u32 nkeys = (gw0 >> 24) & 0xFF;
+			int i;
+
+			if (nkeys < 1) {
+				/* F-148 v6 (2026-07-31): correct CC match-row format per RM
+				 * 8.7.4.2 / in-tree cc_pack_key (patch 0098).  Each match row
+				 * is key(16B) followed by mask(16B) = 32 bytes per row; row
+				 * base = idx * 32.  v5 wrote ONLY the key at idx*16 and never
+				 * wrote the mask, so the CC engine read uninitialized MURAM as
+				 * the mask and could never match -- the confirmed reason HIT
+				 * dispatch has never worked.  (16/32 are the CC_KEY_SIZE /
+				 * row-stride literals resolved earlier in fman_pcd_cc.c; not
+				 * referenced by symbol here because that TU defines them.)
+				 *
+				 * Key: bytes 0..key_size-1 = real extracted key (13B for v4,
+				 * MSB-first SIP DIP PROTO SPORT DPORT), bytes ..15 = 0 pad.
+				 * Mask mirrored on the 16B-aligned mask half: 0xff = participate
+				 * (exact match) for the key bytes, 0x00 = wildcard for bytes

+int fman_pcd_kg_scheme_set_ekfc(struct fman_pcd_kg_scheme *scheme, u32 ekfc)
+{
+	struct fman_keygen *keygen; struct fman *fman; struct mutex *lock; int err = 0;
+	if (!scheme) return -EINVAL;
+	fman = fman_pcd_get_fman(scheme->pcd);
+	if (!fman || !fman->keygen) return -ENXIO;
+	keygen = fman->keygen; lock = fman_pcd_get_lock(scheme->pcd);
+	mutex_lock(lock);
+	scheme->ekfc = ekfc; keygen->schemes[scheme->id].ekfc = ekfc;
+	if (scheme->bound) err = keygen_scheme_setup(keygen, scheme->id, true);
+	mutex_unlock(lock); return err;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_kg_scheme_set_ekfc);

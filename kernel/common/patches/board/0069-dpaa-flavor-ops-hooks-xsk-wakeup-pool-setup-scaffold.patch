+/* M2 (Phase 2): AF_XDP zerocopy pool setup/teardown dispatch.
+ *
+ * XDP_SETUP_XSK_POOL is delivered by the kernel XSK core when userspace
+ * calls bind() on an XDP socket with XDP_USE_NEED_WAKEUP (or any time
+ * an XSK is created/destroyed against this netdev,queue_id pair).
+ * xdp->xsk.pool != NULL is "attach"; xdp->xsk.pool == NULL is "detach".
+ *
+ * The core driver does not own the BMan-pool / PAMU / dma-map plumbing —
+ * the optional flavor module does. We dispatch under RCU to
+ * qmgmt_ops->xsk_pool_attach / xsk_pool_detach. With no flavor module
+ * loaded the dereferences are NULL and we return -EOPNOTSUPP, which the
+ * kernel XSK core translates into copy-mode fallback.
+ *
+ * Spec: specs/dpaa1-afxdp-modernization-spec.md sec 5.3 (Phase 2).
+ */
+static int dpaa_setup_xsk_pool(struct net_device *net_dev,
+       struct netdev_bpf *xdp)
+{
+struct dpaa_priv *priv = netdev_priv(net_dev);
+const struct dpaa_qmgmt_ops *ops;
+u16 queue_id = xdp->xsk.queue_id;
+int (*attach_fn)(struct dpaa_priv *, struct xsk_buff_pool *, u16);
+int (*detach_fn)(struct dpaa_priv *, u16);
+struct xsk_buff_pool *pool = xdp->xsk.pool;
+
+/*
+ * Capture the callback function pointers under RCU then drop the
+ * read lock BEFORE invoking the (potentially sleeping) flavor
+ * callback.  ops->xsk_pool_attach() calls bman_new_pool() and
+ * xsk_pool_dma_map() under GFP_KERNEL; ops->xsk_pool_detach()
+ * calls synchronize_net().  Both schedule, and a voluntary
+ * schedule inside rcu_read_lock() trips PREEMPT_RCU's
+ * tree_plugin.h:332 WARN ("Voluntary context switch within RCU
+ * read-side critical section!") followed by an indefinite RCU
+ * stall in the xp_release_deferred kworker (the grace period
+ * waits for the very kworker that is blocked on it) - then the
+ * watchdog reboots.  Reproduced on the DUT 2026-05-27.
+ *
+ * Lifetime safety after rcu_read_unlock(): the af_xdp_pool flavor
+ * module installs its ops table with rcu_assign_pointer() and
+ * cannot return from module_exit() until dpaa_unregister_flavor_ops()
+ * has cleared the slot AND a subsequent synchronize_rcu() has
+ * drained all in-flight readers.  XDP_SETUP_XSK_POOL is invoked
+ * from process context with RTNL held, so the ops table and the
+ * function pointers we captured remain valid for the duration of
+ * the call.
+ */
+rcu_read_lock();
+ops = rcu_dereference(priv->qmgmt_ops);
+if (!ops) {
+rcu_read_unlock();
+return -EOPNOTSUPP;
+}
+attach_fn = ops->xsk_pool_attach;
+detach_fn = ops->xsk_pool_detach;
+rcu_read_unlock();
+
+if (pool) {
+if (!attach_fn)
+return -EOPNOTSUPP;
+return attach_fn(priv, pool, queue_id);
+}
+if (!detach_fn)
+return -EOPNOTSUPP;
+return detach_fn(priv, queue_id);
+}
+
 static int dpaa_xdp(struct net_device *net_dev, struct netdev_bpf *xdp)
 {
 	switch (xdp->command) {
 	case XDP_SETUP_PROG:
 		return dpaa_setup_xdp(net_dev, xdp);
+	case XDP_SETUP_XSK_POOL:
+		return dpaa_setup_xsk_pool(net_dev, xdp);
 	default:
 		return -EINVAL;
 	}
@@ -3143,6 +3232,46 @@
 	return phylink_mii_ioctl(priv->mac_dev->phylink, rq, cmd);
 }
 
+/* M1 (Phase 1): ndo_xsk_wakeup trampoline.
+ *
+ * Mainline DPAA1 has no AF_XDP wakeup path. Without it, a userspace XSK
+ * application must busy-poll the rings (VPP af_xdp plugin in copy mode
+ * pegs the worker thread at 100% even when idle, blocking thermal
+ * recovery on the LS1046A's passively/lightly-cooled 4xA72 cluster).
+ *
+ * The trampoline dereferences priv->qmgmt_ops under RCU and dispatches
+ * to the flavor module's wakeup callback. With no flavor module loaded
+ * (FLAVOR=default), qmgmt_ops is NULL and the syscall returns
+ * -EOPNOTSUPP, which userspace treats as "no wakeup support, fall back
+ * to busy-poll" — identical to mainline behaviour.
+ *
+ * Phase 1 only advertises NETDEV_XDP_ACT_XSK_ZEROCOPY and wires the
+ * trampoline. The NAPI-side xsk_set_rx_need_wakeup() / TX completion
+ * kick is harmless without a bound xsk_pool[] (introduced in Phase 2)
+ * and is wired in patch 0072 (Phase 3) when the ZC datapath lands.
+ *
+ * Spec: specs/dpaa1-afxdp-modernization-spec.md sec 5.2.
+ */
+static int dpaa_xsk_wakeup(struct net_device *ndev, u32 queue_id, u32 flags)
+{
+	struct dpaa_priv *priv = netdev_priv(ndev);
+	const struct dpaa_qmgmt_ops *ops;
+	int ret;
+
+	if (unlikely(!netif_running(ndev)))
+		return -ENETDOWN;
+
+	rcu_read_lock();
+	ops = rcu_dereference(priv->qmgmt_ops);
+	if (!ops || !ops->xsk_wakeup) {
+		rcu_read_unlock();
+		return -EOPNOTSUPP;
+	}
+	ret = ops->xsk_wakeup(priv, queue_id, flags);
+	rcu_read_unlock();
+	return ret;
+}
+

patch-series-cleanup (2026-09-11): split. New file(s) below moved to
kernel/common/files/ as plain tracked source (a 'new file mode' hunk IS
the file's content, so tracking it directly carries no diff-drift risk
vs upstream); copied into place by ci-setup-kernel.sh before this
(now much smaller) patch applies. New files that moved:
  drivers/net/ethernet/freescale/fman/fman_keygen_internal.h
  drivers/net/ethernet/freescale/fman/fman_pcd_kg.c
---
diff --git a/drivers/net/ethernet/freescale/fman/Makefile b/drivers/net/ethernet/freescale/fman/Makefile
--- a/drivers/net/ethernet/freescale/fman/Makefile
+++ b/drivers/net/ethernet/freescale/fman/Makefile
@@ -6,6 +6,6 @@
 obj-$(CONFIG_FSL_FMAN) += fsl_dpaa_mac.o
 
 fsl_dpaa_fman-objs	:= fman_muram.o fman.o fman_sp.o fman_keygen.o
-fsl_dpaa_fman-$(CONFIG_FSL_FMAN_PCD) += fman_pcd.o
+fsl_dpaa_fman-$(CONFIG_FSL_FMAN_PCD) += fman_pcd.o fman_pcd_kg.o
 fsl_dpaa_fman_port-objs := fman_port.o
 fsl_dpaa_mac-objs:= mac.o fman_dtsec.o fman_memac.o fman_tgec.o
diff --git a/drivers/net/ethernet/freescale/fman/fman_keygen.c b/drivers/net/ethernet/freescale/fman/fman_keygen.c
--- a/drivers/net/ethernet/freescale/fman/fman_keygen.c
+++ b/drivers/net/ethernet/freescale/fman/fman_keygen.c
@@ -8,6 +8,7 @@
 #include <linux/slab.h>
 
 #include "fman_keygen.h"
+#include "fman_keygen_internal.h"
 
 /* Maximum number of HW Ports */
 #define FMAN_MAX_NUM_OF_HW_PORTS		64
@@ -90,9 +91,36 @@
 
 /* NIA values */
 #define NIA_ENG_BMI			0x00500000
+#define NIA_ENG_PLCR			0x004C0000
+/* KGSE_MODE NIA action bit: select the policer profile id in the low bits of
+ * the mode NIA as an ABSOLUTE (global) profile slot rather than a per-port
+ * relative index resolved through the (unprogrammed) FMPL_PMR window. Matches
+ * the SDK CC/keygen->policer path (fm_plcr.c: nia |= NIA_ENG_PLCR |
+ * NIA_PLCR_ABSOLUTE | absoluteProfileId). RM 8.7.4. Fits KG_NIA_AC_MASK.
+ */
+#define NIA_PLCR_ABSOLUTE		0x00008000
 #define NIA_BMI_AC_ENQ_FRAME		0x00000002
 #define ENQUEUE_KG_DFLT_NIA		(NIA_ENG_BMI | NIA_BMI_AC_ENQ_FRAME)
 
+/* KGSE_MODE next-action selector: when set, the scheme's next engine is the
+ * Policer (the mode NIA points at NIA_ENG_PLCR and KGSE_PPC carries the
+ * absolute profile id). When clear, the default BMI-enqueue path is used.
+ * RM 8.7.4 (KGSE_MODE). 0xC04C0000 = EN | NIA_PLCR_SELECT | NIA_ENG_PLCR.
+ */
+#define KG_SCH_MODE_NIA_PLCR		0x40000000
+
+/* KGSE_MODE next-action selector for Coarse Classification (CC): the mode NIA
+ * points at the FMan-controller CC action (NIA_ENG_FM_CTL | NIA_FM_CTL_AC_CC)
+ * and the CCOBASE field (bits 27:24) carries the CC group-table base index.
+ * KGSE_CCBS carries the hash-bit selection. RM 8.7.4 (KGSE_MODE).
+ * For the static single-group/single-entry CC tree (board patch 0098) both
+ * CCOBASE and CCBS are 0, so KGSE_MODE(CC) = EN | NIA_ENG_FM_CTL |
+ * NIA_FM_CTL_AC_CC = 0x80000006 and KGSE_CCBS = 0.
+ */
+#define NIA_ENG_FM_CTL			0x00000000
+#define NIA_FM_CTL_AC_CC		0x00000006
+#define KG_SCH_MODE_CCOBASE_SHIFT	24
+
 /* Hard-coded configuration:
  * These values are used as hard-coded values for KeyGen configuration
  * and they replace user selections for this hard-coded version
@@ -193,44 +221,6 @@
 	u32 fmkg_ar;	/* 0x1FC: KeyGen Action Register */
 };
 
-/* KeyGen Scheme data */
-struct keygen_scheme {
-	bool used;	/* Specifies if this scheme is used */
-	u8 hw_port_id;
-		/* Hardware port ID
-		 * schemes sharing between multiple ports is not
-		 * currently supported
-		 * so we have only one port id bound to a scheme
-		 */
-	u32 base_fqid;
-		/* Base FQID:
-		 * Must be between 1 and 2^24-1
-		 * If hash is used and an even distribution is
-		 * expected according to hash_fqid_count,
-		 * base_fqid must be aligned to hash_fqid_count
-		 */
-	u32 hash_fqid_count;
-		/* FQ range for hash distribution:
-		 * Must be a power of 2
-		 * Represents the range of queues for spreading
-		 */
-	bool use_hashing;	/* Usage of Hashing and spreading over FQ */
-	bool symmetric_hash;	/* Symmetric Hash option usage */
-	u8 hashShift;
-		/* Hash result right shift.
-		 * Select the 24 bits out of the 64 hash result.
-		 * 0 means using the 24 LSB's, otherwise
-		 * use the 24 LSB's after shifting right
-		 */
-	u32 match_vector;	/* Match Vector */
-};
-
-/* KeyGen driver data */
-struct fman_keygen {
-	struct keygen_scheme schemes[FM_KG_MAX_NUM_OF_SCHEMES];
-				/* Array of schemes */
-	struct fman_kg_regs __iomem *keygen_regs;	/* KeyGen registers */
-};
 
 /* keygen_write_ar_wait
  *
@@ -455,7 +445,7 @@
  *
  * Return: Zero for success or error code in case of failure
  */
-static int keygen_bind_port_to_schemes(struct fman_keygen *keygen,
+int keygen_bind_port_to_schemes(struct fman_keygen *keygen,
 				       u8 scheme_id,
 					bool bind)
 {
@@ -495,6 +485,7 @@
 
 	return 0;
 }
+EXPORT_SYMBOL_GPL(keygen_bind_port_to_schemes);
 
 /* keygen_scheme_setup
  *
@@ -506,7 +497,7 @@
  *
  * Return: Zero for success or error code in case of failure
  */
-static int keygen_scheme_setup(struct fman_keygen *keygen, u8 scheme_id,
+int keygen_scheme_setup(struct fman_keygen *keygen, u8 scheme_id,
 			       bool enable)
 {
 	struct fman_kg_regs __iomem *keygen_regs = keygen->keygen_regs;
@@ -534,12 +525,67 @@
 	if (enable) {
 		/* Enable Scheme */
 		tmp_reg |= KG_SCH_MODE_EN;
-		/* Enqueue frame NIA */
-		tmp_reg |= ENQUEUE_KG_DFLT_NIA;
+		if (scheme->next_engine == 1) {
+			/* Next engine = Policer: route the frame to the
+			 * policer profile in scheme->policer_profile_id. The
+			 * profile's own per-colour NIA (programmed by
+			 * fman_pcd_plcr) then decides enqueue vs drop. The
+			 * destination FQID still comes from kgse_fqb below.
+			 *
+			 * The profile id is RELATIVE (NIA_PLCR_ABSOLUTE clear,
+			 * mode 0xc04c0000): KGSE_PPC carries the id with
+			 * shift=0/mask=0, and the KeyGen resolves it through the
+			 * RX port's relative->absolute policer-profile window
+			 * FMPL_PMR[hwPortId-1], which plcr_set_port_window() in
+			 * fman_pcd_plcr programs at policer-attach (BASE=
+			 * profile_id, NUM=1, VALID).  The SDK uses relative
+			 * addressing for private per-port profiles and reserves
+			 * NIA_PLCR_ABSOLUTE for the PLCR->PLCR shared-profile
+			 * chaining case only.  Without the window programmed the
+			 * BMI has no valid profile for the port and drops every
+			 * frame *before* metering (BUG 3a: counters frozen at 0).
+			 * 2026-06-09
+			 */
+			tmp_reg |= KG_SCH_MODE_NIA_PLCR | NIA_ENG_PLCR;
+			scheme_regs.kgse_ppc = scheme->policer_profile_id;
+		} else if (scheme->next_engine == 2) {
+			/* Next engine = Coarse Classification: route the
+			 * frame into the installed CC group table. CCOBASE
+			 * (bits 27:24) selects the CC group; CCBS (kgse_ccbs
+			 * below) selects which hash bits index the entry. The
+			 * CC tree-root MURAM base is programmed separately at
+			 * the BMI RX port (FMBM_RCCB) via
+			 * fman_port_set_cc_base().
+			 */
+			tmp_reg |= NIA_ENG_FM_CTL | NIA_FM_CTL_AC_CC |
+				(scheme->cc_base_offset <<
+				 KG_SCH_MODE_CCOBASE_SHIFT);
+		} else {
+			/* Enqueue frame NIA */
+			tmp_reg |= ENQUEUE_KG_DFLT_NIA;
+		}
 	}
 
 	scheme_regs.kgse_mode = tmp_reg;
 
+	/* Policer Profile Command (KGSE_PPC): the profile-generation register
+	 * (base/shift/mask). For the policer path KGSE_PPC is set in the
+	 * next_engine==1 branch above to policer_profile_id with shift=0 and
+	 * mask=0, so the generated profile equals the id. The mode's
+	 * mode's NIA_PLCR_ABSOLUTE bit is left CLEAR, so the id is
+	 * RELATIVE; the KeyGen resolves it via the RX port's
+	 * FMPL_PMR window that plcr_set_port_window() programs at
+	 * policer-attach (see BUG 3a above). For the non-policer paths PPC stays 0
+	 * from the memset above.
+	 */
+	/* Coarse Classification Bits Select (KGSE_CCBS): which hash bits index
+	 * the CC group entry. Only meaningful when the mode NIA points at CC;
+	 * left at 0 (from the memset above) otherwise. For the static
+	 * single-entry tree this is 0.
+	 */
+	if (enable && scheme->next_engine == 2)
+		scheme_regs.kgse_ccbs = scheme->cc_bits_sel;
+
 	scheme_regs.kgse_mv = scheme->match_vector;
 
 	/* Scheme don't override StorageProfile:
@@ -611,6 +657,7 @@
 
 	return 0;
 }
+EXPORT_SYMBOL_GPL(keygen_scheme_setup);
 
 /* keygen_init
  *
diff --git a/include/linux/fsl/fman_pcd.h b/include/linux/fsl/fman_pcd.h
--- a/include/linux/fsl/fman_pcd.h
+++ b/include/linux/fsl/fman_pcd.h
@@ -74,4 +74,186 @@
 void fman_pcd_release(struct fman_pcd *pcd);
 struct fman_pcd_muram_budget fman_pcd_get_muram_budget(struct fman_pcd *pcd);
 
+/*
+ * KeyGen (KG) API.
+ *
+ * The KeyGen engine extracts a configurable byte-mask out of every
+ * incoming frame and feeds it to a hash that selects one of N
+ * Classifier-Continue (CC) targets, a direct frame queue, or a default
+ * policer profile.  The hardware programming lives in fman_pcd_kg.c.
+ *
+ * Reference: LS1046A RM 8.7.4 (KeyGen scheme registers), 8.7.5 (KG
+ * extract record format).  All extract offsets are in bytes from the
+ * start of the parse result described in RM 8.7.3.
+ */
+
+/**
+ * enum fman_pcd_kg_extract_from - source for one extract slot.
+ * @FMAN_PCD_KG_EXTRACT_FROM_FRAME:        raw byte at fixed frame offset
+ * @FMAN_PCD_KG_EXTRACT_FROM_PARSE_RESULT: byte at offset inside parse result
+ * @FMAN_PCD_KG_EXTRACT_FROM_DEFAULT:      use the per-port default value
+ *
+ * Mirrors the KGSE_EKDV (KeyGen Scheme Extract Definition - Value) field
+ * documented in RM 8.7.5 Table 8-105.
+ */
+enum fman_pcd_kg_extract_from {
+	FMAN_PCD_KG_EXTRACT_FROM_FRAME = 0,
+	FMAN_PCD_KG_EXTRACT_FROM_PARSE_RESULT,
+	FMAN_PCD_KG_EXTRACT_FROM_DEFAULT,
+};
+
+/**
+ * enum fman_pcd_kg_next_engine - post-KeyGen dispatch target for a scheme.
+ * @FMAN_PCD_KG_NEXT_ENGINE_ENQUEUE: enqueue the frame directly via BMI to the
+ *                                   scheme's FQID (the historical default).
+ * @FMAN_PCD_KG_NEXT_ENGINE_PLCR:    hand the frame to the policer profile in
+ *                                   @policer_profile_id (KGSE_PPC) before the
+ *                                   profile's own green/yellow/red NIA decides
+ *                                   enqueue-vs-drop. The destination FQID is
+ *                                   still taken from the scheme (@default_fqid).
+ *
+ * Mirrors the KGSE_MODE next-action-NIA encoding (RM 8.7.4): ENQUEUE selects
+ * NIA_ENG_BMI|ENQ_FRAME; PLCR selects the policer-engine NIA with the
+ * scheme's KGSE_PPC carrying the absolute profile id.
+ */
+enum fman_pcd_kg_next_engine {
+	FMAN_PCD_KG_NEXT_ENGINE_ENQUEUE = 0,
+	FMAN_PCD_KG_NEXT_ENGINE_PLCR,
+};
+
+/**
+ * struct fman_pcd_kg_extract_spec - one extract slot inside a scheme.
+ * @src:    where the byte run comes from (frame / parse result / default)
+ * @offset: starting byte offset (0..63 for parse result, 0..127 for frame)
+ * @size:   number of bytes to extract (1..16); total across all slots must
+ *          not exceed the FMan KG generic extract buffer of 36 bytes
+ * @mask:   per-byte AND-mask applied before hashing (0xff = no mask)
+ *
+ * Used to build the IPv4/IPv6 5-tuple key (typical flow: SIP, DIP, proto,
+ * SPORT, DPORT - all sourced from FMAN_PCD_KG_EXTRACT_FROM_PARSE_RESULT
+ * with the standard FMan parser offsets).
+ */
+struct fman_pcd_kg_extract_spec {
+	enum fman_pcd_kg_extract_from src;
+	u8 offset;
+	u8 size;
+	u8 mask;
+};
+
+/**
+ * struct fman_pcd_kg_scheme_params - immutable scheme description.
+ * @id:         requested scheme id (0..31 on FMan v3); -1 = first free
+ * @num_extracts:  count of populated entries in @extracts (1..8)
+ * @extracts:   per-slot extract specs
+ * @default_fqid: fallback FQID when CC chaining is not used
+ * @use_hash:   true = hash extracts and select target via CC; false = direct
+ *              FQID via @default_fqid only
+ * @next_engine: post-KeyGen dispatch target (enqueue vs policer). Defaults to
+ *              FMAN_PCD_KG_NEXT_ENGINE_ENQUEUE (value 0) for callers that
+ *              zero-initialise this struct, preserving the historical
+ *              enqueue-only behaviour.
+ * @policer_profile_id: absolute FMan policer profile id to route through when
+ *              @next_engine == FMAN_PCD_KG_NEXT_ENGINE_PLCR; ignored otherwise.
+ *
+ * Mainline LS1046A FMan v3 silicon has 32 KG schemes (8 per netcfg
+ * partition).  Each scheme is single-attach to a port.
+ */
+struct fman_pcd_kg_scheme_params {
+	int id;
+	u8 num_extracts;
+	struct fman_pcd_kg_extract_spec extracts[8];
+	u32 default_fqid;
+	bool use_hash;
+	enum fman_pcd_kg_next_engine next_engine;
+	u8 policer_profile_id;
+};
+
+/**
+ * fman_pcd_kg_scheme_create() - allocate and program a new KG scheme.
+ * @pcd:    PCD subsystem handle from fman_pcd_init()
+ * @params: scheme parameters; not retained after the call returns
+ *
+ * Programs the FMan KGSE_* registers for the chosen scheme id, attaches
+ * the scheme to @pcd->kg_schemes, and returns a handle that can be passed
+ * to fman_pcd_kg_bind_port() / fman_pcd_kg_attach_cc().
+ *
+ * Return: handle on success, ERR_PTR(-EBUSY) if @params->id is already in
+ * use, ERR_PTR(-EOPNOTSUPP) for an unsupported extract shape.
+ */
+struct fman_pcd_kg_scheme *
+fman_pcd_kg_scheme_create(struct fman_pcd *pcd,
+			  const struct fman_pcd_kg_scheme_params *params);
+
+/**
+ * fman_pcd_kg_bind_port() - bind a scheme to an FMan ingress port.
+ * @scheme:  handle from fman_pcd_kg_scheme_create()
+ * @port_id: FMan hardware BMI RX port id from fman_port_get_id() (0x08..0x27)
+ *
+ * Writes the scheme's match-vector bit for @port_id and updates the
+ * port's PCD configuration so that frames classified to this scheme
+ * enter the KG hash pipeline.
+ *
+ * Return: 0 on success, -EINVAL on bad args, -EBUSY if already bound.
+ */
+int fman_pcd_kg_bind_port(struct fman_pcd_kg_scheme *scheme, u8 port_id);
+
+/**
+ * fman_pcd_kg_port_attach_policer() - route an RX port's existing RSS
+ *                                     scheme through a policer profile.
+ * @pcd:        PCD handle for the owning FMan (fman_get_pcd()).
+ * @hw_port_id: BMI hardware RX port id (0x08-0x0d 1G, 0x10-0x11 10G).
+ * @profile_id: relative policer profile id to dispatch frames to.
+ *
+ * Every FMan RX port is initialised with a single hard-coded RSS-hashing
+ * KeyGen scheme (keygen_port_hashing_init()) that all ingress frames are
+ * dispatched to.  This reprograms THAT scheme's next-engine in place to
+ * the policer profile, preserving its hash spreading and FQID base, so
+ * conforming frames still reach the per-flow RX FQs while the policer
+ * meters and drops excess.  It deliberately does NOT create a second
+ * scheme: the silicon's scheme-select picks the lowest-id scheme bound to
+ * the port, so a competing higher-id scheme would never be consulted.
+ *
+ * Return: 0 on success, -ENODEV if the port has no RSS scheme, or a
+ * negative errno from the underlying KGSE_* reprogram.
+ */
+int fman_pcd_kg_port_attach_policer(struct fman_pcd *pcd, u8 hw_port_id,
+				    u8 profile_id);
+
+/**
+ * fman_pcd_kg_port_detach_policer() - restore an RX port's RSS scheme to
+ *                                     plain BMI-enqueue next-engine.
+ * @pcd:        PCD handle for the owning FMan (fman_get_pcd()).
+ * @hw_port_id: BMI hardware RX port id used in the matching attach call.
+ *
+ * Reverse of fman_pcd_kg_port_attach_policer().  The RSS scheme itself is
+ * left intact (it is the port's permanent hashing scheme); only its
+ * next-engine is reset to direct enqueue.  NULL/-ENODEV-safe.
+ *
+ * Return: 0 on success or a negative errno.
+ */
+int fman_pcd_kg_port_detach_policer(struct fman_pcd *pcd, u8 hw_port_id);
+
+/**
+ * fman_pcd_kg_attach_cc() - chain a scheme to a Classifier-Continue tree.
+ * @scheme: handle from fman_pcd_kg_scheme_create()
+ * @cc:     classifier tree from fman_pcd_cc_tree_create()
+ *
+ * Wires the KGSE_CCBS (CC Base Scheme) register so that the scheme's
+ * hash output indexes into the CC tree's key table.
+ *
+ * Return: 0 on success, -EOPNOTSUPP until the CC subsystem lands,
+ * -EINVAL on bad args.
+ */
+int fman_pcd_kg_attach_cc(struct fman_pcd_kg_scheme *scheme,
+			  struct fman_pcd_cc_tree *cc);
+
+/**
+ * fman_pcd_kg_scheme_destroy() - tear down a previously created scheme.
+ * @scheme: handle from fman_pcd_kg_scheme_create().  NULL-safe.
+ *
+ * Detaches all port bindings, clears the KGSE_* registers, removes the
+ * scheme from @pcd->kg_schemes, and frees the handle.
+ */
+void fman_pcd_kg_scheme_destroy(struct fman_pcd_kg_scheme *scheme);
+
 #endif /* __LINUX_FSL_FMAN_PCD_H */

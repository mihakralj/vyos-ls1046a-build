@@ -466,6 +466,12 @@ void fman_pcd_kg_scheme_destroy(struct fman_pcd_kg_scheme *scheme);
  * @proto:        L4 protocol (IANA), single byte
  * @src_ip_be:    IPv4 source (BE) when !FMAN_PCD_CC_HW_F_IPV6
  * @dst_ip_be:    IPv4 dest   (BE)
+ * @src_ip_mask_be: per-byte AND mask for @src_ip_be, same BE byte order.
+ *                The CC match row ANDs both the extracted composite and the
+ *                stored key with this mask before comparing (RM 8.7.4.2),
+ *                so any byte pattern is valid, not just 0x00/0xff per byte -

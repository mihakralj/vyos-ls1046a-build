+/* P0 diagnostic (0193): FM_CTL engine-state reader.
+ *
+ * Shows the IMEM load-port registers (iadd/data/itcfg/iready) plus the FPM
+ * block's controller-debug surface (breakpoint control, classifier debug,
+ * and the Data-RAM access window fmfp_dra/fmfp_drd[16] which windows the
+ * controller's internal data memory). Accepts two write commands:
+ *   iadd <hex>   set IRAM_IADD (AIE|<hex>) to probe idata addressing
+ *   dra  <hex>   set FPM Data-RAM access address
+ * Read-only with respect to execution state; used to locate the stuck
+ * instruction during the FE-VM VLAN freeze.
+ */
+static int fman_imem_pc_show(struct seq_file *s, void *unused)
+{
+	struct fman *fman = s->private;
+	struct fman_iram_regs __iomem *iram = fman->base_addr + IMEM_OFFSET;
+	struct fman_fpm_regs __iomem *fpm = fman->fpm_regs;
+	int i;
+
+	seq_printf(s, "iadd=0x%08x itcfg=0x%08x iready=0x%08x\n",
+		   ioread32be(&iram->iadd),
+		   ioread32be(&iram->itcfg),
+		   ioread32be(&iram->iready));
+	for (i = 0; i < 8; i++)
+		seq_printf(s, "idata[%d]=0x%08x\n", i,
+			   ioread32be(&iram->idata));
+	seq_printf(s, "brkc=0x%08x cld=0x%08x rstc=0x%08x extc=0x%08x\n",
+		   ioread32be(&fpm->fmfp_brkc),
+		   ioread32be(&fpm->fm_cld),
+		   ioread32be(&fpm->fm_rstc),
+		   ioread32be(&fpm->fmfp_extc));
+	seq_printf(s, "dra=0x%08x\n", ioread32be(&fpm->fmfp_dra));
+	for (i = 0; i < 16; i++)
+		seq_printf(s, "drd[%d]=0x%08x\n", i,
+			   ioread32be(&fpm->fmfp_drd[i]));
+	return 0;
+}
+
+static ssize_t fman_imem_pc_write(struct file *file, const char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct fman *fman = s->private;
+	struct fman_iram_regs __iomem *iram = fman->base_addr + IMEM_OFFSET;
+	struct fman_fpm_regs __iomem *fpm = fman->fpm_regs;
+	char tmp[16];
+	u32 val;
+	int n, r;
+
+	n = min(count, sizeof(tmp) - 1);
+	if (copy_from_user(tmp, buf, n))
+		return -EFAULT;
+	tmp[n] = 0;
+	if (sscanf(tmp, "iadd %x", &val) == 1) {
+		iowrite32be(IRAM_IADD_AIE | val, &iram->iadd);
+		r = n;
+	} else if (sscanf(tmp, "dra %x", &val) == 1) {
+		iowrite32be(val, &fpm->fmfp_dra);
+		r = n;
+	} else {
+		dev_warn(fman->dev, "fman_imem: bad command '%%s'\n", tmp);
+		return -EINVAL;
+	}
+	return r;
+}
+
+static int fman_imem_pc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_imem_pc_show, inode->i_private);
+}
+
+static const struct file_operations fman_imem_pc_fops = {
+	.owner = THIS_MODULE,
+	.open = fman_imem_pc_open,
+	.read = seq_read,
+	.write = fman_imem_pc_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};

+ * Board-confirmed EKFC value: 0xe4000000 (PORT_ID|MACDST|MACSRC|ETYPE),
+ * identical to the live vendor L2/bridge scheme observed on `.106`.
+ *
+ * Return: same as fman_pcd_kg_port_attach_cc().
+ */
+int fman_pcd_kg_port_attach_cc_l2(struct fman_pcd *pcd, u8 hw_port_id,
+				  u32 cc_group_off);
+
 /**
  * fman_pcd_kg_port_attach_cc_dual() - like fman_pcd_kg_port_attach_cc(),
  * but arms the port's scheme for the 46-byte dual-lane GEC extraction

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VyOS LS1046A CI <ci@vyos-ls1046a>
Date: Sun, 9 Aug 2026 21:30:00 +0000
Subject: [PATCH] fman_pcd: cc_test install optional FE_ENTER match leaf, pre-live (F-182)

Implements the vendor .106 RCCB-target topology (E-HM15 2026-08-09): the
port classification root is a CC group tree whose match-leaf AD IS the
FE_ENTER AD, not the bare FE_ENTER AD as the FMBM_RCCB root (the form
that stalls the frame parser, fmfp_ps 0x80800000).  The CC walker
dispatches matching frames into FE_ENTER -> EXT_HASH -> ehash.

cc_test install gains an optional 8th arg fe_off_hex: when present, the
match-leaf AD row 0 is overwritten with the FE_ENTER AD 4 words BEFORE
the tree goes live (attach_cc).

v3 fix: ad_off is read from group[0].word0 low24 (0115 SDK CONT_LOOKUP
layout: word0 = CONT_LOOKUP|(keylen-1)<<24|ad_off, word1 =
num_keys<<24|LCL_MASK|match_off).  v1/v2 read word1&0xFFFFFF which is
match_off with the LCL_MASK bit 0x800000 ORd in -> unmapped write ->
kernel oops (the v1 watchdog was the same oops, panic=60 looked like a
watchdog remotely; FMFP_EXTC live-write was NOT the cause).

  cc_test install <port> <qband> <proto> <sip> <dip> <dport> [fqid] [fe_off_hex]

Board test (frame-2, E-HM8-correct): build FE chain + flow, then
install with fe_off, send matching SYN, check fe_ehash_stats pkt_count
vs the fmfp_ps stall.

---
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd_cc_test.c b/drivers/net/ethernet/freescale/fman/fman_pcd_cc_test.c
index 6d88d1a..8a7e069 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd_cc_test.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd_cc_test.c
@@ -36,6 +36,7 @@
 #include <linux/err.h>
 #include <linux/errno.h>
 #include <linux/inet.h>
+#include <linux/io.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/seq_file.h>
@@ -45,6 +46,7 @@
 
 #include <linux/fsl/fman_pcd.h>
 #include "fman.h"
+#include "fman_muram.h"
 #include "fman_pcd_internal.h"
 #include "fman_port.h"
 
@@ -66,17 +68,20 @@ static int cc_test_open(struct inode *inode, struct file *file)
 static int cc_test_install(struct fman_pcd *pcd, const char *args)
 {
 	struct fman_pcd_cc_hw_spec *spec;
+	struct muram_info *muram;
+	void __iomem *group, *ad, *fe;
 	char src_str[40], dst_str[40];
-	u32 src_ip, dst_ip, cc_base;
+	u32 src_ip, dst_ip, cc_base, ad_off;
 	struct fman_port *rxport;
-	u32 fqid = 0;
+	u32 fqid = 0, fe_off = 0;
 	u8 port_id, proto;
 	u16 qband, dport;
-	int n, err;
+	int n, err, i;
 
-	n = sscanf(args, "install %hhi %hu %hhu %39s %39s %hu %x",
-		   &port_id, &qband, &proto, src_str, dst_str, &dport, &fqid);
-	if (n != 6 && n != 7)
+	n = sscanf(args, "install %hhi %hu %hhu %39s %39s %hu %x %x",
+		   &port_id, &qband, &proto, src_str, dst_str, &dport, &fqid,
+		   &fe_off);
+	if (n != 6 && n != 7 && n != 8)
 		return -EINVAL;
 
 	if (qband > 3 || !(proto == 6 || proto == 17))
@@ -113,6 +118,48 @@ static int cc_test_install(struct fman_pcd *pcd, const char *args)
 	if (err)
 		return err;
 
+	/*
+	 * F-182 (RCCB-target, optional 8th arg fe_off_hex): overwrite the
+	 * match-leaf AD row 0 with the FE_ENTER AD's four words BEFORE the
+	 * tree goes live (attach_cc below).  Implements the vendor .106
+	 * topology (E-HM15): RCCB -> CC group tree -> match leaf IS the
+	 * FE_ENTER-form AD, instead of the bare FE_ENTER AD as the RCCB root
+	 * (the form that stalls the frame parser, fmfp_ps 0x80800000).
+	 *
+	 * The FE_ENTER AD is exactly 4 words (CC_AD_ENTRY_SIZE == 16) so it
+	 * fits the CC AD-table row verbatim.  Writing it here, pre-live, is
+	 * mandatory: a raw overwrite of the AD table AFTER attach_cc (the
+	 * tree is a live-walked FMan structure) faults the FMan controller
+	 * without the RM 5.12.14.1 FMFP_EXTC sync protocol (observed: board
+	 * watchdog-reset, 2026-08-09).
+	 */
+	if (fe_off) {
+		err = fman_pcd_cc_static_get_base(pcd, port_id, &cc_base);
+		if (err)
+			goto out_destroy;
+		muram = fman_get_muram(fman_pcd_get_fman(pcd));
+		if (!muram) {
+			err = -ENXIO;
+			goto out_destroy;
+		}
+		group = (void __iomem *)fman_muram_offset_to_vbase(muram,
+								   cc_base);
+		/* group[0].word0 low24 = AD-table MURAM offset (0115 SDK
+		 * CONT_LOOKUP layout; word1 carries match_off|LCL_MASK). */
+		ad_off = ioread32be((u32 __iomem *)group);
+		ad_off &= 0xFFFFFF;
+		if (!ad_off) {
+			err = -EINVAL;
+			goto out_destroy;
+		}
+		ad = (void __iomem *)fman_muram_offset_to_vbase(muram, ad_off);
+		fe = (void __iomem *)fman_muram_offset_to_vbase(muram, fe_off);
+		for (i = 0; i < 4; i++)
+			iowrite32be(ioread32be((u32 __iomem *)((u8 __iomem *)fe +
+								 4 * i)),
+				    (u32 __iomem *)((u8 __iomem *)ad + 4 * i));
+	}
+
 	err = fman_pcd_cc_static_get_base(pcd, port_id, &cc_base);
 	if (!err) {
 		rxport = fman_port_lookup_rx(fman_pcd_get_fman(pcd), port_id);
@@ -128,14 +175,16 @@ static int cc_test_install(struct fman_pcd *pcd, const char *args)
 		if (err)
 			(void)fman_port_set_cc_base(rxport, 0);
 	}
+out_destroy:
 	if (err) {
 		fman_pcd_cc_static_destroy(pcd, port_id);
 		return err;
 	}
 
-	pr_info("fman_pcd cc_test: port 0x%02x tree installed, FMBM_RCCB bound to 0x%x, KG CC-dispatched, key fqid 0x%x%s\n",
+	pr_info("fman_pcd cc_test: port 0x%02x tree installed, FMBM_RCCB bound to 0x%x, KG CC-dispatched, key fqid 0x%x%s%s\n",
 		port_id, cc_base, fqid,
-		fqid ? " (hardware enqueue-AD)" : " (soft fall-through)");
+		fqid ? " (hardware enqueue-AD)" : " (soft fall-through)",
+		fe_off ? " (FE_ENTER match leaf)" : "");
 	return 0;
 }
 

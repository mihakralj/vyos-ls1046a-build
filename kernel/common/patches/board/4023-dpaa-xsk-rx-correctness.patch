index acdb903f6..9e3c785f1 100644
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
@@ -3385,6 +3385,30 @@ static enum qman_cb_dqrr_result rx_error_dqrr(struct qman_portal *portal,
 
 	net_dev = dpaa_fq->net_dev;
 	priv = netdev_priv(net_dev);
+
+	/* AF_XDP ZC: an error FD may carry an XSK pool buffer. The pool is not
+	 * in dpaa_bp_array[], so the lookup below would drop the FD and leak
+	 * the buffer. Defer to NAPI first (the release takes a BH lock).
+	 */
+	if (READ_ONCE(priv->xsk_port)) {
+		const struct dpaa_qmgmt_ops *ops;
+
+		rcu_read_lock();
+		ops = rcu_dereference(priv->qmgmt_ops);
+		if (ops && ops->rx_release) {
+			if (dpaa_eth_napi_schedule(this_cpu_ptr(priv->percpu_priv),
+						   portal, sched_napi)) {
+				rcu_read_unlock();
+				return qman_cb_dqrr_stop;
+			}
+			if (ops->rx_release(priv, &dq->fd)) {
+				rcu_read_unlock();
+				return qman_cb_dqrr_consume;
+			}
+		}
+		rcu_read_unlock();
+	}
+
 	dpaa_bp = dpaa_bpid2pool(dq->fd.bpid);
 	if (!dpaa_bp)
 		return qman_cb_dqrr_consume;
@@ -4031,6 +4055,14 @@ static int dpaa_change_mtu(struct net_device *net_dev, int new_mtu)
 	if (priv->xdp_prog && !xdp_validate_mtu(priv, new_mtu))
 		return -EINVAL;
 
+	/* An attached AF_XDP pool bounds the frames the MAC may admit. */
+	if (priv->xsk_max_frm &&
+	    max(new_mtu, ETH_DATA_LEN) + ETH_HLEN + ETH_FCS_LEN + 2 * VLAN_HLEN >
+	    priv->xsk_max_frm) {
+		netdev_warn(net_dev, "MTU %d exceeds the AF_XDP buffer (max frame %u)\n",
+			    new_mtu, priv->xsk_max_frm);
+		return -EINVAL;
+	}
 	err = dpaa_apply_max_frame(priv, new_mtu);
 	if (err)
 		return err;

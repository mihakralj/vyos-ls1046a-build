+/* WireGuard fast path lab (plans/ASK2-WIREGUARD-FASTPATH-PLAN.md, P1).
+ * dpaa_wgfp.c drains frames steered to its own frame queues and returns
+ * the buffers to BMan; the pool lookup, the DMA device and the RX error
+ * mask are file-local here, so expose three narrow helpers.
+ */
+struct device *dpaa_wgfp_dma_dev(u8 bpid);
+bool dpaa_wgfp_fd_has_error(const struct qm_fd *fd);
+void dpaa_wgfp_fd_release(const struct qm_fd *fd);
+
+struct device *dpaa_wgfp_dma_dev(u8 bpid)
+{
+	struct dpaa_bp *dpaa_bp = dpaa_bpid2pool(bpid);
+
+	return dpaa_bp ? dpaa_bp->priv->rx_dma_dev : NULL;
+}
+
+bool dpaa_wgfp_fd_has_error(const struct qm_fd *fd)
+{
+	return !!(be32_to_cpu(fd->status) & FM_FD_STAT_RX_ERRORS);
+}
+
+void dpaa_wgfp_fd_release(const struct qm_fd *fd)
+{
+	struct dpaa_bp *dpaa_bp = dpaa_bpid2pool(fd->bpid);
+	struct bm_buffer bmb;
+
+	if (!dpaa_bp)
+		return;
+	bmb.data = 0;
+	bm_buffer_set64(&bmb, qm_fd_addr(fd));
+	dpaa_bman_release(dpaa_bp, &bmb, 1);
+}
+
 void count_ern(struct dpaa_percpu_priv *percpu_priv,

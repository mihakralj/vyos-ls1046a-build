+/**
+ * fman_pcd_kg_unbind_port() - unbind a scheme from its hardware port.
+ * @scheme: scheme handle from fman_pcd_kg_scheme_create()
+ *
+ * Exact inverse of fman_pcd_kg_bind_port().  Calls the mainline
+ * keygen_bind_port_to_schemes() with bind=false to clear the
+ * fmkg_pe_sp binding.  NULL-safe, idempotent — safe on an
+ * already-unbound scheme.
+ *
+ * Return: 0 on success; negative errno.
+ */
+int fman_pcd_kg_unbind_port(struct fman_pcd_kg_scheme *scheme)
+{
+	struct fman_keygen *keygen;
+	struct fman *fman;
+	struct mutex *lock;
+	int err;
+
+	if (!scheme)
+		return -EINVAL;
+
+	fman = fman_pcd_get_fman(scheme->pcd);
+	if (!fman || !fman->keygen)
+		return -ENXIO;
+	keygen = fman->keygen;
+	lock = fman_pcd_get_lock(scheme->pcd);
+
+	mutex_lock(lock);
+	err = keygen_bind_port_to_schemes(keygen, scheme->id, false);
+	mutex_unlock(lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_kg_unbind_port);

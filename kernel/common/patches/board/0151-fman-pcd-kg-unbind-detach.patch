+/**
+ * fman_pcd_kg_detach_cc() - clear a scheme's CC binding (object-level).
+ * @scheme: scheme handle from fman_pcd_kg_scheme_create()
+ *
+ * Object-level inverse of fman_pcd_kg_attach_cc().  Clears KGSE_CCBS
+ * and restores next_engine=0 (BMI direct-enqueue).  Idempotent —
+ * safe on an already-detached scheme.  Does NOT touch the port's
+ * FMBM_RCCB (use fman_pcd_kg_port_detach_cc() for that).
+ *
+ * Return: 0 on success; negative errno.
+ */
+int fman_pcd_kg_detach_cc(struct fman_pcd_kg_scheme *scheme)
+{
+	struct keygen_scheme *slot;
+	struct fman_keygen *keygen;
+	struct fman *fman;
+	struct mutex *lock;
+	int err;
+
+	if (!scheme)
+		return -EINVAL;
+
+	fman = fman_pcd_get_fman(scheme->pcd);
+	if (!fman || !fman->keygen)
+		return -ENXIO;
+	keygen = fman->keygen;
+	lock = fman_pcd_get_lock(scheme->pcd);
+
+	mutex_lock(lock);
+	slot = &keygen->schemes[scheme->id];
+	slot->next_engine    = 0;
+	slot->cc_base_offset = 0;
+	slot->cc_bits_sel    = 0;
+
+	err = keygen_scheme_setup(keygen, (u8)scheme->id, true);
+	mutex_unlock(lock);
+
+	if (err)
+		pr_warn("fman_pcd_kg: detach_cc scheme %u failed: %d\n",
+			 scheme->id, err);
+	return err;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_kg_detach_cc);

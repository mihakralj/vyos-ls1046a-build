+/*
+ * ASK2 OH-port re-enqueue infra (dpaa1), phase 1e: one QMan FQ slot per
+ * O/H hw port id (0x2-0x7). See fman_port_oh_test_sched_fq()/unsched_fq().
+ */
+static struct {
+	struct qman_fq fq;
+	u32 fqid;
+	bool ready;

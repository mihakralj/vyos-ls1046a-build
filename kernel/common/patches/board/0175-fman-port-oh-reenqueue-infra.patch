+	err = qman_alloc_fqid(&fqid);
+	if (err) {
+		pr_err("fman_port: oh_test capture_init: qman_alloc_fqid() = %d\n", err);
+		return err;
+	}
+
+	memset(&fman_port_oh_capture.fq, 0, sizeof(fman_port_oh_capture.fq));
+	fman_port_oh_capture.fq.fqid = fqid;
+	fman_port_oh_capture.fq.cb.dqrr = fman_port_oh_capture_dqrr;
+	err = qman_create_fq(fqid, QMAN_FQ_FLAG_NO_ENQUEUE, &fman_port_oh_capture.fq);
+	if (err) {
+		qman_release_fqid(fqid);
+		pr_err("fman_port: oh_test capture_init: qman_create_fq(0x%x) = %d\n",
+		       fqid, err);
+		return err;
+	}
+
+	memset(&initfq, 0, sizeof(initfq));
+	initfq.we_mask = cpu_to_be16(QM_INITFQ_WE_FQCTRL | QM_INITFQ_WE_DESTWQ);
+	initfq.fqd.fq_ctrl = cpu_to_be16(QM_FQCTRL_PREFERINCACHE);
+	qm_fqd_set_destwq(&initfq.fqd, qman_affine_channel(raw_smp_processor_id()), 0);
+	err = qman_init_fq(&fman_port_oh_capture.fq, QMAN_INITFQ_FLAG_SCHED, &initfq);
+	if (err) {
+		qman_destroy_fq(&fman_port_oh_capture.fq);
+		qman_release_fqid(fqid);
+		pr_err("fman_port: oh_test capture_init: qman_init_fq(0x%x) = %d\n",
+		       fqid, err);
+		return err;
+	}
+
+	fman_port_oh_capture.fqid = fqid;
+	atomic_set(&fman_port_oh_capture.rx_count, 0);
+	fman_port_oh_capture.ready = true;
+	pr_info("fman_port: oh_test capture_init OK, sink fqid=0x%x\n", fqid);
+	return 0;
+}
+
+static ssize_t fman_port_oh_test_capture_fini(void)
+{
+	u32 fqid;
+	int err;
+
+	if (!fman_port_oh_capture.ready)
+		return -ENODEV;
+
+	fqid = fman_port_oh_capture.fqid;
+	err = qman_retire_fq(&fman_port_oh_capture.fq, NULL);
+	if (err < 0)
+		pr_err("fman_port: oh_test capture_fini: qman_retire_fq(0x%x) = %d\n",
+		       fqid, err);
+	err = qman_oos_fq(&fman_port_oh_capture.fq);
+	if (err < 0)
+		pr_err("fman_port: oh_test capture_fini: qman_oos_fq(0x%x) = %d\n",
+		       fqid, err);
+	qman_destroy_fq(&fman_port_oh_capture.fq);
+	qman_release_fqid(fqid);
+	fman_port_oh_capture.ready = false;
+	pr_info("fman_port: oh_test capture_fini: sink fqid=0x%x released, saw %d frame(s)\n",
+		fqid, atomic_read(&fman_port_oh_capture.rx_count));
+	return 0;
+}
+
+static ssize_t fman_port_oh_test_inject(u8 port_id)
+{
+	struct fman_port *port;
+	struct qm_fd fd;
+	dma_addr_t addr;
+	u8 *buf;
+	size_t len = 64;
+	int err;
+
+	if (port_id >= ARRAY_SIZE(fman_port_oh_input_fq))
+		return -EINVAL;
+	if (!fman_port_oh_input_fq[port_id].ready) {
+		pr_err("fman_port: oh_test inject 0x%02x: no input FQ (run sched_fq first)\n",
+		       port_id);
+		return -ENODEV;
+	}
+
+	port = fman_port_oh_test_lookup(port_id, true);
+	if (!port)
+		return -ENODEV;
+
+	/*
+	 * Deliberately leaked: this is a one-shot debug tool with no
+	 * completion signal back to this function, so freeing (or
+	 * dma_unmap'ing) this buffer here -- before the O/H port hardware
+	 * has necessarily finished reading it -- would be a genuine
+	 * use-after-free. A 64-byte leak per "inject" call is the accepted
+	 * cost of a manual, one-frame-at-a-time silicon de-risk tool.
+	 */
+	buf = kzalloc(len, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	/*
+	 * Minimal Ethernet header so the hard parser has something to
+	 * chew on: broadcast dst, dummy locally-administered src,
+	 * EtherType 0x0800 (IPv4). Payload left zeroed. Whether this
+	 * parses clean (-> dflt_fqid) or takes a parser gross-error
+	 * (-> err_fqid) is not the point of this test -- "bringup"'s
+	 * target_fqid_hex should point BOTH at the same capture_init sink
+	 * so either outcome is observable.
+	 */
+	memset(buf, 0xff, 6);
+	buf[6] = 0x02;
+	buf[11] = 0x01;
+	buf[12] = 0x08;
+	buf[13] = 0x00;
+
+	addr = dma_map_single(port->dev, buf, len, DMA_TO_DEVICE);
+	if (dma_mapping_error(port->dev, addr)) {
+		kfree(buf);
+		pr_err("fman_port: oh_test inject 0x%02x: dma_map_single() failed\n",
+		       port_id);
+		return -EIO;
+	}
+
+	qm_fd_clear_fd(&fd);
+	fd.bpid = FMAN_PORT_OH_TEST_BPID_INV;
+	qm_fd_set_contig(&fd, 0, len);
+	qm_fd_addr_set64(&fd, addr);
+
+	err = qman_enqueue(&fman_port_oh_input_fq[port_id].fq, &fd);
+	if (err) {
+		pr_err("fman_port: oh_test inject 0x%02x: qman_enqueue() = %d\n",
+		       port_id, err);
+		return err;
+	}
+
+	pr_info("fman_port: oh_test inject 0x%02x OK, input fqid=0x%x addr=0x%llx len=%zu (watch dmesg for oh_test capture)\n",
+		port_id, fman_port_oh_input_fq[port_id].fqid,
+		(unsigned long long)addr, len);
+	return 0;
+}
+
+/*
+ * ASK2 OH-port re-enqueue infra (dpaa1), phase 1g: register + FQ-state
+ * readback, added after phase 1f's "inject" produced a clean NULL result
+ * (qman_enqueue() succeeded but the capture sink never saw the frame, no
+ * wedge). This does not guess at a fix -- it narrows which of three
+ * failure classes actually happened: (a) the O/H port never dequeued the
+ * frame at all (config/EN/channel problem), (b) it dequeued but the
+ * frame vanished downstream (BMI/parser/enqueue problem), or (c) the
+ * "bringup"/"enable"/"sched_fq" register writes did not stick the way
+ * this tool assumes.
+ *
+ * "dump <hw_port_id>" prints:
+ * - a raw readback of the O/H port's own BMI config registers (OCFG,
+ *   OFDNE, OFNE, OFPNE, OFQID, OEFQID, OCCB) -- confirms what's actually
+ *   programmed, not just what "bringup"/"enable" believed they wrote.
+ * - qman_query_fq_np() on the port's phase-1e input FQ (if sched_fq has
+ *   run): frm_cnt/state. If frm_cnt is still 1 after an "inject", the
+ *   O/H port never pulled the frame off its channel at all -- failure
+ *   class (a). If frm_cnt is 0, the port DID dequeue it and the frame
+ *   was lost somewhere after that -- failure class (b).
+ * - the same query on the phase-1f capture sink FQ (if capture_init has
+ *   run), for symmetry (expected empty/0 either way in the NULL-result
+ *   case already observed).
+ */
+static void fman_port_oh_test_dump_fq_np(const char *label, struct qman_fq *fq)
+{
+	struct qm_mcr_queryfq_np np;
+	int err;
+
+	err = qman_query_fq_np(fq, &np);
+	if (err) {
+		pr_info("fman_port: oh_test dump: %s fqid=0x%x query_fq_np() = %d\n",
+			label, qman_fq_fqid(fq), err);
+		return;
+	}
+	pr_info("fman_port: oh_test dump: %s fqid=0x%x state=0x%x frm_cnt=%u byte_cnt=%u\n",
+		label, qman_fq_fqid(fq), np.state, np.frm_cnt & 0xffffffU, np.byte_cnt);
+}
+
+static ssize_t fman_port_oh_test_dump(u8 port_id)
+{
+	struct fman_port *port;
+	struct fman_port_oh_bmi_regs __iomem *regs;
+
+	if (port_id >= ARRAY_SIZE(fman_port_oh_input_fq))
+		return -EINVAL;
+
+	port = fman_port_oh_test_lookup(port_id, true);
+	if (!port) {
+		pr_err("fman_port: oh_test dump 0x%02x: not configured yet (run bringup first)\n",
+		       port_id);
+		return -ENODEV;
+	}
+
+	regs = &port->bmi_regs->oh;
+	pr_info("fman_port: oh_test dump 0x%02x: OCFG=0x%08x OFDNE=0x%08x OFNE=0x%08x OFPNE=0x%08x OFQID=0x%08x OEFQID=0x%08x OCCB=0x%08x\n",
+		port_id,
+		ioread32be(&regs->fmbm_ocfg), ioread32be(&regs->fmbm_ofdne),
+		ioread32be(&regs->fmbm_ofne), ioread32be(&regs->fmbm_ofpne),
+		ioread32be(&regs->fmbm_ofqid), ioread32be(&regs->fmbm_oefqid),
+		ioread32be(&regs->fmbm_occb));
+
+	if (fman_port_oh_input_fq[port_id].ready)
+		fman_port_oh_test_dump_fq_np("input", &fman_port_oh_input_fq[port_id].fq);
+	else
+		pr_info("fman_port: oh_test dump 0x%02x: input FQ not scheduled (run sched_fq)\n",
+			port_id);
+
+	if (fman_port_oh_capture.ready)
+		fman_port_oh_test_dump_fq_np("capture", &fman_port_oh_capture.fq);
+	else
+		pr_info("fman_port: oh_test dump 0x%02x: capture sink not created (run capture_init)\n",
+			port_id);
+
+	return 0;
+}
+
+static ssize_t fman_port_oh_test_write(struct file *file,
+				       const char __user *buf,
+				       size_t count, loff_t *ppos)
+{
+	char kbuf[32];
+	u8 port_id;
+	unsigned int on;
+	ssize_t err;
+
+	if (count == 0 || count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, buf, count))
+		return -EFAULT;
+	kbuf[count] = '\0';
+	kbuf[strcspn(kbuf, "\n")] = '\0';
+
+	if (sscanf(kbuf, "bringup %hhu", &port_id) == 1)
+		err = fman_port_oh_test_bringup(kbuf, port_id);
+	else if (sscanf(kbuf, "enable %hhu %u", &port_id, &on) == 2)
+		err = fman_port_oh_test_enable(port_id, on);
+	else if (sscanf(kbuf, "sched_fq %hhu", &port_id) == 1)
+		err = fman_port_oh_test_sched_fq(port_id);
+	else if (sscanf(kbuf, "unsched_fq %hhu", &port_id) == 1)
+		err = fman_port_oh_test_unsched_fq(port_id);
+	else if (strcmp(kbuf, "capture_init") == 0)
+		err = fman_port_oh_test_capture_init();
+	else if (strcmp(kbuf, "capture_fini") == 0)
+		err = fman_port_oh_test_capture_fini();
+	else if (sscanf(kbuf, "inject %hhu", &port_id) == 1)
+		err = fman_port_oh_test_inject(port_id);
+	else if (sscanf(kbuf, "dump %hhu", &port_id) == 1)
+		err = fman_port_oh_test_dump(port_id);
+	else
+		return -EINVAL;
+
+	return err ? err : count;
+}
+
+static const struct file_operations fman_port_oh_test_fops = {
+	.owner = THIS_MODULE,
+	.write = fman_port_oh_test_write,
+};
+
+static struct dentry *fman_port_oh_test_dir;
+
+static void fman_port_oh_test_debugfs_init(void)
+{
+	fman_port_oh_test_dir = debugfs_create_dir("fman_port_oh_test", NULL);
+	if (IS_ERR_OR_NULL(fman_port_oh_test_dir)) {
+		fman_port_oh_test_dir = NULL;
+		return;
+	}
+	debugfs_create_file("bringup", 0200, fman_port_oh_test_dir, NULL,
+			    &fman_port_oh_test_fops);
+}

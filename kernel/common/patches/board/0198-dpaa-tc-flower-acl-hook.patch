+/* F-199 (T-M7-2 S4): allocate a dedicated no-confirm TX FQ on @dev's QMan
+ * channel for the ASK2 FE hardware offload terminal. The FQ is spliced
+ * into priv->dpaa_fq_list so it is torn down with the netdev. The nft
+ * flow-offload REPLACE callback runs on a workqueue WITHOUT RTNL (S4
+ * board proof, 2026-08-16), so this helper acquires RTNL internally to
+ * serialize list mutation against netdev teardown. Returns 0 and the
+ * dynamic FQID in *fqid, or a negative errno. */
+int dpaa_alloc_offload_tx_fq(struct net_device *dev, u32 *fqid)
+{
+	struct dpaa_priv *priv;
+	struct dpaa_fq *dpaa_fq;
+	int ret;
+
+	if (!dev || !fqid)
+		return -EINVAL;
+
+	/* Serialize priv->dpaa_fq_list mutation + FQ init against netdev
+	 * teardown. The caller (nft flow-offload workqueue) does NOT hold
+	 * RTNL, so take it here; no ASK caller holds it, so no deadlock. */
+	rtnl_lock();
+
+	if (dev->netdev_ops != &dpaa_ops) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	priv = netdev_priv(dev);
+
+	dpaa_fq = devm_kzalloc(dev->dev.parent, sizeof(*dpaa_fq), GFP_KERNEL);
+	if (!dpaa_fq) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
+
+	dpaa_fq->fq_type = FQ_TYPE_TX_NO_CONFIRM;
+	dpaa_fq->fqid = 0;		/* dynamic */
+	/* Reuse the driver's egress setup so the FQ lands on the FMan TX
+	 * DC-portal channel with the ERN callback and TO_DCPORTAL flag,
+	 * exactly like FQ_TYPE_TX; dpaa_fq_init() then applies the
+	 * no-confirm context_a for FQ_TYPE_TX_NO_CONFIRM. */
+	dpaa_setup_egress(priv, dpaa_fq, priv->mac_dev->port[TX],
+			  &dpaa_fq_cbs.egress_ern);
+	list_add_tail(&dpaa_fq->list, &priv->dpaa_fq_list);
+
+	ret = dpaa_fq_init(dpaa_fq, false);
+	if (ret < 0) {
+		list_del(&dpaa_fq->list);
+		devm_kfree(dev->dev.parent, dpaa_fq);
+		goto out_unlock;
+	}
+
+	*fqid = dpaa_fq->fqid;
+	netdev_info(dev, "F-199: offload no-confirm TX FQ 0x%x on channel %u\n",
+		    dpaa_fq->fqid, dpaa_fq->channel);
+	ret = 0;
+out_unlock:
+	rtnl_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dpaa_alloc_offload_tx_fq);

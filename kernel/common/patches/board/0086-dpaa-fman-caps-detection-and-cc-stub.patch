From: ci <ci@local>
Date: Thu, 28 May 2026 16:48:00 +0000
Subject: [PATCH] dpaa: FMan PCD capability detection + CC steering stubs (M3-3b)

Observability-only stub for spec sec 3.5 (FMan PCD capability layer)
and sec 5.4 (CC steering API).  All productive paths return -ENOTSUPP;
the only runtime knob is the dpaa_fman_caps.force= module parameter
which allows developers to simulate "ucode 210 loaded" for unit testing
downstream consumers without flashing real ucode.

Adds:
  - drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.h    (new)
  - drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c    (new)
  - CONFIG_DPAA_HW_CC_STEERING (default y, depends on FSL_DPAA_ETH)
  - priv->fman_caps + priv->hw_offload_unavailable in struct dpaa_priv
  - one-shot dpaa_fman_caps_log() emit from dpaa_eth_probe()
  - dpaa_stats_hwoffload[] ethtool array exposing the counter

Pairs with the 0079..0085 chain: identical observability-first cadence
(0083 was the xsk_rx_branch probe, 0084 was the BMan refill, 0085 was
the TX ZC submit/conf - 0086 is the HW-offload availability counter).

The CC steering API (fman_cc_tree_install/add_key/remove_key/destroy)
is fixed now so downstream consumers (af_xdp_pool qband-select, ASK2
flowtable bridge, future vyos-1x set-system-offload-classify CLI) can
wire calls today and gracefully degrade on ucode-106 silicon.  The
productive implementations land in follow-up patches per spec sec 5.4.

Spec: specs/dpaa1-afxdp-modernization-spec.md v5.0 sec 3.5 + sec 5.4.

Signed-off-by: vyos-ls1046a-build CI <ci@local>
---

patch-series-cleanup (2026-09-11): split. New file(s) below moved to
kernel/common/files/ as plain tracked source (a 'new file mode' hunk IS
the file's content, so tracking it directly carries no diff-drift risk
vs upstream); copied into place by ci-setup-kernel.sh before this
(now much smaller) patch applies. New files that moved:
  drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c
  drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.h
---
diff --git a/drivers/net/ethernet/freescale/dpaa/Kconfig b/drivers/net/ethernet/freescale/dpaa/Kconfig
--- a/drivers/net/ethernet/freescale/dpaa/Kconfig
+++ b/drivers/net/ethernet/freescale/dpaa/Kconfig
@@ -20,4 +20,19 @@
 	  and XSK pool management to dpaa_eth without touching core code.
 	  Safe to leave on: with no flavor module loaded, behaviour is unchanged.
 
+config DPAA_HW_CC_STEERING
+bool "DPAA: FMan PCD capability detection + CC steering stubs (M3-3b)"
+depends on FSL_DPAA_ETH
+default y
+help
+  Compile in the FMan PCD capability layer (dpaa_fman_get_caps,
+  FMAN_CAP_* bits) and the CC-steering stub API
+  (fman_cc_tree_install/add_key/remove_key/destroy) per
+  specs/dpaa1-afxdp-modernization-spec.md sec 3.5 and sec 5.4.
+  All stubs return -ENOTSUPP on mainline ucode 106 and bump
+  the hw_offload_unavailable ethtool counter.  Productive
+  implementations land in follow-up patches; the API is fixed
+  now so downstream consumers can wire calls today.
+  Safe to leave on: zero runtime cost without ucode 210.
+
 source "drivers/net/ethernet/freescale/dpaa/af_xdp_pool/Kconfig"
diff --git a/drivers/net/ethernet/freescale/dpaa/Makefile b/drivers/net/ethernet/freescale/dpaa/Makefile
--- a/drivers/net/ethernet/freescale/dpaa/Makefile
+++ b/drivers/net/ethernet/freescale/dpaa/Makefile
@@ -11,6 +11,7 @@
 
 fsl_dpa-objs += dpaa_eth.o dpaa_ethtool.o dpaa_eth_sysfs.o
 fsl_dpa-$(CONFIG_DPAA_FLAVOR_OPS) += dpaa_flavor.o
+fsl_dpa-$(CONFIG_DPAA_HW_CC_STEERING) += dpaa_fman_caps.o
 CFLAGS_dpaa_eth.o := -I$(src)
 
 obj-$(CONFIG_DPAA_AF_XDP_POOL) += af_xdp_pool/
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
@@ -32,6 +32,7 @@
 #include <linux/bpf_trace.h>
 #include <net/xdp_sock_drv.h>
 #include "dpaa_flavor.h"
+#include "dpaa_fman_caps.h"
 #include <soc/fsl/bman.h>
 #include <soc/fsl/qman.h>
 #include "fman.h"
@@ -3620,9 +3621,19 @@
 	 * queue_id validator before any pcd_ops->install runs. A flavor
 	 * module's pcd_ops->install may later refine this downward.
 	 */
-	priv->xsk_max_qbands = DPAA1_XSK_MAX_QBANDS;
+priv->xsk_max_qbands = DPAA1_XSK_MAX_QBANDS;
 
-	priv->egress_fqs = devm_kcalloc(dev, dpaa_max_num_txqs(),
+/* M3-3b (patch 0086): snapshot the FMan PCD capability bitmask
+ * once per netdev so subsequent fman_cc_/fman_hm_/fman_pol_
+ * helpers can short-circuit to -ENOTSUPP without re-probing.
+ * dpaa_fman_caps_log() emits one KERN_INFO line for the first
+ * netdev only (internal one-shot guard) so the boot log records
+ * the cap bitmask exactly once. Spec sec 3.5.
+ */
+priv->fman_caps = dpaa_fman_get_caps();
+dpaa_fman_caps_log(dev, priv->fman_caps);
+
+priv->egress_fqs = devm_kcalloc(dev, dpaa_max_num_txqs(),
 					sizeof(*priv->egress_fqs),
 					GFP_KERNEL);
 	if (!priv->egress_fqs) {
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.h
@@ -288,6 +288,24 @@
  */
 u64 xsk_tx_conf_zc;
 
+/* M3-3b (patch 0086): FMan PCD capability bitmask snapshot taken
+ * at probe via dpaa_fman_get_caps(). 0 on mainline ucode 106 ->
+ * all fman_cc_tree_/fman_hm_/fman_pol_ helpers short-circuit
+ * to -ENOTSUPP and bump hw_offload_unavailable. Non-zero only
+ * when ucode 210+ is loaded (or simulated via
+ * dpaa_fman_caps.force=). Spec sec 3.5 capability layer.
+ */
+u32 fman_caps;
+
+/* M3-3b (patch 0086): bumped once per -ENOTSUPP returned by any
+ * HW-offload stub (fman_cc_*, fman_hm_*, fman_pol_*, fman_hc_*).
+ * Surfaces via the dpaa_stats_hwoffload[] ethtool array as
+ * "hw_offload_unavailable". Allows operators to detect "I asked
+ * for HW offload but silicon/ucode doesn't support it" without
+ * scraping dmesg. Spec sec 5.4 observability.
+ */
+u64 hw_offload_unavailable;
+
 /* M3 (Phase 3a): qband -> { FQ base, SWP, CPU, NAPI } resource map.
 	 * Populated by the flavor module's pcd_ops->install. With no flavor
 	 * module loaded the array stays zeroed and the spec's "qmap[]
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c b/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
@@ -73,9 +73,22 @@
 "xsk_tx_conf_zc",
 };
 
-#define DPAA_STATS_PERCPU_LEN ARRAY_SIZE(dpaa_stats_percpu)
-#define DPAA_STATS_GLOBAL_LEN ARRAY_SIZE(dpaa_stats_global)
-#define DPAA_STATS_XSK_LEN    ARRAY_SIZE(dpaa_stats_xsk)
+/* HW-offload (PCD-cap) counters (M3-3b / patch 0086). Order MUST match
+ * the u64 block at &priv->hw_offload_unavailable in struct dpaa_priv
+ * (dpaa_eth.h). One bumped-on-ENOTSUPP counter today; the productive
+ * implementations of fman_cc_/fman_hm_/fman_pol_/fman_hc_ in
+ * follow-up patches will add per-block success/fail counters keeping
+ * the same contiguous-block-of-u64 layout.
+ * Spec: specs/dpaa1-afxdp-modernization-spec.md sec 3.5 + sec 5.4.
+ */
+static char dpaa_stats_hwoffload[][ETH_GSTRING_LEN] = {
+"hw_offload_unavailable",
+};
+
+#define DPAA_STATS_PERCPU_LEN    ARRAY_SIZE(dpaa_stats_percpu)
+#define DPAA_STATS_GLOBAL_LEN    ARRAY_SIZE(dpaa_stats_global)
+#define DPAA_STATS_XSK_LEN       ARRAY_SIZE(dpaa_stats_xsk)
+#define DPAA_STATS_HWOFFLOAD_LEN ARRAY_SIZE(dpaa_stats_hwoffload)
 
 static int dpaa_get_link_ksettings(struct net_device *net_dev,
 				   struct ethtool_link_ksettings *cmd)
@@ -146,8 +159,9 @@
 	unsigned int total_stats, num_stats;
 
 	num_stats   = num_online_cpus() + 1;
-	total_stats = num_stats * (DPAA_STATS_PERCPU_LEN + 1) +
-			DPAA_STATS_GLOBAL_LEN + DPAA_STATS_XSK_LEN;
+total_stats = num_stats * (DPAA_STATS_PERCPU_LEN + 1) +
+DPAA_STATS_GLOBAL_LEN + DPAA_STATS_XSK_LEN +
+DPAA_STATS_HWOFFLOAD_LEN;
 
 	switch (type) {
 	case ETH_SS_STATS:
@@ -266,11 +280,22 @@
 	/* AF_XDP zero-copy counters - contiguous u64 block in dpaa_priv,
 	 * order matches dpaa_stats_xsk[] above.  Spec sec 5.3.
 	 */
-	{
-		const u64 *xsk_src = &priv->xsk_pool_attach_ok;
-		for (i = 0; i < DPAA_STATS_XSK_LEN; i++)
-			data[offset++] = xsk_src[i];
-	}
+{
+const u64 *xsk_src = &priv->xsk_pool_attach_ok;
+for (i = 0; i < DPAA_STATS_XSK_LEN; i++)
+data[offset++] = xsk_src[i];
+}
+
+/* HW-offload counters (M3-3b / patch 0086) - contiguous u64
+ * block in dpaa_priv, order matches dpaa_stats_hwoffload[] above.
+ * Spec sec 3.5 + sec 5.4.
+ */
+{
+const u64 *hwoff_src = &priv->hw_offload_unavailable;
+
+for (i = 0; i < DPAA_STATS_HWOFFLOAD_LEN; i++)
+data[offset++] = hwoff_src[i];
+}
 }
 
 static void dpaa_get_strings(struct net_device *net_dev, u32 stringset,
@@ -294,8 +319,10 @@
 
 	for (i = 0; i < DPAA_STATS_GLOBAL_LEN; i++)
 		ethtool_puts(&data, dpaa_stats_global[i]);
-	for (i = 0; i < DPAA_STATS_XSK_LEN; i++)
-		ethtool_puts(&data, dpaa_stats_xsk[i]);
+for (i = 0; i < DPAA_STATS_XSK_LEN; i++)
+ethtool_puts(&data, dpaa_stats_xsk[i]);
+for (i = 0; i < DPAA_STATS_HWOFFLOAD_LEN; i++)
+ethtool_puts(&data, dpaa_stats_hwoffload[i]);
 }
 
 static int dpaa_get_rxfh_fields(struct net_device *dev,

From: vyos-ls1046a-build CI <ci@local>
Date: Wed, 03 Sep 2026 00:00:00 +0000
Subject: [PATCH] fman: pcd/dpaa: CC-tree comparator input capture (probe2), eth1-scoped

T-M6-8 VLAN-v6 dig. The CC-tree dual-lane GEC experiments (V6-2/V6-2a/
V6-2c, patches 0185-0188) all board-tested a clean, family-independent
MISS: KeyGen's GEC registers reprogram correctly (register readback
confirmed, byte-for-byte identical to the proven ehash dual-lane
extraction, F-224) but a real matching frame never reaches the CC-tree
comparator. fman_pcd_cc.c's own CC_IC_KG_KEY_OFFSET (0x50) documents
where the comparator reads its compare-window from -- Internal-Context
byte 0x50 -- but this project has never verified whether GEC's output
actually lands there, or anywhere host-visible at all.

Went looking for an existing capture to answer this and found both
candidates dead: ic_probe's fman_pcd_ic_vaddr is set in the TX cleanup
path (dpaa_cleanup_tx_fd), not RX -- it captures the last transmitted
frame's data buffer, unrelated to classification input, and dereferences
it later (crash-prone, reproduced live this session). hash_probe's own
capture code was removed by a later fixup (F-216) after it "amplified a
zero-address FD into a kernel panic" -- fman_pcd_hash_off/kg_hash are
still declared and displayed but nothing writes them anymore.

This adds a third, deliberately safer capture: synchronous only (no
pointer stashed for later, unlike the removed F-072/F-170 diagnostic),
right inside rx_default_dqrr() immediately after the existing mainline
RX-hash dereference already proved the buffer valid, guarded against a
null vaddr and an underflowing offset, and scoped to eth1 only (the
sacrificial test port, never production eth3/eth4). Captures a 176-byte
window starting at parse-result base (vaddr+hash_offset-0x28, the offset
F-213 already established as safe) into a static buffer, readable via a
new read-only debugfs node (fman_pcd/0/probe2) that hex-dumps it with
offsets relative to parse-result base -- so both the known hash location
(+0x28) and, if present, wherever GEC's composite actually landed are
directly visible.

Upstream-Status: Inappropriate | Risk-Tier: B (new RX-path capture code,
synchronous/bounded by design specifically to avoid the two prior crash
patterns in this exact area; no-op unless net_dev name is literally
"eth1"; read side is a plain static-buffer hex dump, no live pointer
dereference)
---
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
index c73dd50..f80a212 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -247,6 +247,25 @@ struct fman_pcd {
 u64 fman_pcd_kg_hash;
 unsigned int fman_pcd_hash_off;
 void *fman_pcd_ic_vaddr;
+
+/*
+ * T-M6-8 VLAN-v6 CC-comparator-input dig (2026-09-03). Synchronous, bounded
+ * RX-path capture ONLY -- deliberately NOT a save-a-pointer-for-later like
+ * the F-072/F-170 diagnostic F-216 removed after it panicked on a
+ * zero-address FD (see the F-216 comment in dpaa_eth.c). The capture site
+ * (dpaa_eth.c) memcpy()s a fixed window into this buffer synchronously,
+ * inside the RX callback, while the frame's buffer is known-valid (the
+ * mainline RX-hash read immediately above it already dereferenced the same
+ * vaddr successfully). Scoped to eth1 only (sacrificial test port, not
+ * production eth3/eth4). Window starts at parse-result base
+ * (vaddr+hash_offset-0x28, the offset F-213 already established as safe)
+ * and covers FMAN_PCD_PROBE2_LEN bytes forward -- comfortably inside the
+ * 4K RX buffer page. Purpose: does the CC-tree's KeyGen-extracted GEC
+ * composite land anywhere in the host-visible frame annotation at all?
+ */
+#define FMAN_PCD_PROBE2_LEN 176
+u8 fman_pcd_probe2_buf[FMAN_PCD_PROBE2_LEN];
+bool fman_pcd_probe2_valid;
 static struct dentry *fman_pcd_debugfs_root;
 static DEFINE_MUTEX(fman_pcd_debugfs_lock);
 static int fman_pcd_debugfs_refcount;
@@ -872,6 +891,47 @@ static int fman_pcd_hash_probe_show(struct seq_file *m, void *v)
 }
 DEFINE_SHOW_ATTRIBUTE(fman_pcd_hash_probe);
 
+/* T-M6-8 VLAN-v6: dump the raw parse-result-base window captured on eth1.
+ * See the fman_pcd_probe2_buf comment above for the capture-site safety
+ * rationale. Offsets are printed relative to parse-result base (0), so the
+ * hash field (known to live at parse-result+0x28) and the CC comparator's
+ * IC+0x50 key field (CC_IC_KG_KEY_OFFSET in fman_pcd_cc.c) both land at a
+ * fixed, easy-to-spot offset in this listing if they're present at all in
+ * the host-visible frame annotation.
+ */
+static int fman_pcd_probe2_show(struct seq_file *s, void *unused)
+{
+	int i;
+
+	if (!fman_pcd_probe2_valid) {
+		seq_puts(s, "idle (no eth1 frame captured)\n");
+		return 0;
+	}
+	seq_puts(s, "parse-result-base window, offsets relative to +0:\n");
+	for (i = 0; i < FMAN_PCD_PROBE2_LEN; i += 16) {
+		int j, n = min(16, FMAN_PCD_PROBE2_LEN - i);
+
+		seq_printf(s, "%+04d:", i);
+		for (j = 0; j < n; j++)
+			seq_printf(s, " %02x", fman_pcd_probe2_buf[i + j]);
+		seq_puts(s, "\n");
+	}
+	return 0;
+}
+
+static int fman_pcd_probe2_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_probe2_show, inode->i_private);
+}
+
+static const struct file_operations fman_pcd_probe2_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_probe2_open,
+	.read		= seq_read,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
 
 static int fman_pcd_ic_probe_show(struct seq_file *s, void *unused)
 {
@@ -5424,6 +5484,9 @@ struct fman_pcd *fman_pcd_init(struct fman *fman)
 		if (!debugfs_create_file("hash_probe", 0444, pcd->debugfs_dir, pcd,
 				       &fman_pcd_hash_probe_fops))
 			pr_warn("%s: error creating hash_probe\n", __func__);
+				debugfs_create_file("probe2", 0444,
+						    pcd->debugfs_dir, pcd,
+						    &fman_pcd_probe2_fops);
 				debugfs_create_file("ic_probe", 0444,
 						    pcd->debugfs_dir, pcd,
 						    &fman_pcd_ic_probe_fops);
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
index 80cb012..168c0d5 100644
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
@@ -55,6 +55,13 @@ void *fman_pcd_ic_vaddr;
 void *fman_pcd_ic_buf_base;
 extern u64 fman_pcd_kg_hash;
 extern unsigned int fman_pcd_hash_off;
+/* T-M6-8 VLAN-v6 CC-comparator-input dig; see the buffer's own comment in
+ * fman_pcd.c for the full rationale and the synchronous-capture safety
+ * argument (this is deliberately NOT a repeat of the F-072/F-170 pattern
+ * F-216 removed after a panic -- no pointer is stashed here). */
+#define FMAN_PCD_PROBE2_LEN 176
+extern u8 fman_pcd_probe2_buf[FMAN_PCD_PROBE2_LEN];
+extern bool fman_pcd_probe2_valid;
 static int debug = -1;
 module_param(debug, int, 0444);
 MODULE_PARM_DESC(debug, "Module/Driver verbosity level (0=none,...,16=all)");
@@ -3523,6 +3530,23 @@ static enum qman_cb_dqrr_result rx_default_dqrr(struct qman_portal *portal,
 					      &hash_offset)) {
 		hash = be32_to_cpu(*(__be32 *)(vaddr + hash_offset));
 		hash_valid = true;
+
+		/* T-M6-8 VLAN-v6 CC-comparator-input dig: synchronous, bounded
+		 * capture only, right here in the RX callback while vaddr is
+		 * known-valid (just dereferenced successfully above) -- NOT a
+		 * save-a-pointer-for-later like the diagnostic F-216 removed
+		 * after it panicked on a zero-address FD. Scoped to eth1 only
+		 * (sacrificial test port). hash_offset >= 0x28 guards the
+		 * window start against underflow (0x28 is the established
+		 * parse-result-base back-offset, see fman_pcd_cc.c
+		 * CC_IC_KG_KEY_OFFSET's own comment for the provenance). */
+		if (vaddr && !strcmp(net_dev->name, "eth1") &&
+		    hash_offset >= 0x28) {
+			memcpy(fman_pcd_probe2_buf,
+			       vaddr + hash_offset - 0x28,
+			       FMAN_PCD_PROBE2_LEN);
+			fman_pcd_probe2_valid = true;
+		}
 	}
 
 	if (likely(fd_format == qm_fd_contig)) {

+/*
+ * Enqueue under an order restoration point (RM ch. 3, order restoration):
+ * @orp_fqid is the ORP-enabled queue the frame came from and @seqnum the
+ * DQRR seqnum it carried. With @hole no frame is enqueued: the sequence
+ * number is only filled so later frames are not held behind it. The caller
+ * owes the ORP exactly one such command (frame or hole) per dequeued frame.
+ * Returns -EBUSY on a full EQCR, nothing is consumed then.
+ */
+int qman_enqueue_orp_fqid(struct qman_fq *tag_fq, u32 fqid, u32 orp_fqid,
+			  u16 seqnum, bool hole, const struct qm_fd *fd)
+{
+	struct qman_portal *p;
+	struct qm_eqcr_entry *eq;
+	unsigned long irqflags;
+	u8 avail;
+
+	p = get_affine_portal();
+	local_irq_save(irqflags);
+
+	if (p->use_eqcr_ci_stashing) {
+		eq = qm_eqcr_start_stash(&p->p);
+	} else {
+		avail = qm_eqcr_get_avail(&p->p);
+		if (avail < 2)
+			update_eqcr_ci(p, avail);
+		eq = qm_eqcr_start_no_stash(&p->p);
+	}
+
+	if (unlikely(!eq))
+		goto out;
+
+	/* NESN and NLIS stay clear: one frame per sequence number */
+	eq->seqnum = cpu_to_be16(seqnum & QM_EQCR_SEQNUM_SEQMASK);
+	eq->orp = cpu_to_be32(orp_fqid & QM_FQID_MASK);
+	qm_fqid_set(eq, fqid);
+	eq->tag = cpu_to_be32(fq_to_tag(tag_fq));
+	eq->fd = *fd;
+
+	qm_eqcr_pvb_commit(&p->p, QM_EQCR_VERB_ORP |
+			   (hole ? 0 : QM_EQCR_VERB_CMD_ENQUEUE));
+out:
+	local_irq_restore(irqflags);
+	put_affine_portal();
+	return eq ? 0 : -EBUSY;
+}
+EXPORT_SYMBOL_GPL(qman_enqueue_orp_fqid);

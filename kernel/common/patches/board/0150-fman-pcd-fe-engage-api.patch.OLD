Subject: [PATCH] fman_pcd: FE-VM engage/flow API for ask.ko (Phase 2, board 0150)

Add four new EXPORT_SYMBOL_GPL entry points that ask.ko calls to drive
the Fork-B FE/ehash datapath, wrapping the internal static functions
proven in the Phase 1 AC_CC silicon experiment.  ask.ko passes only the
opaque struct fman *; the PCD handle is resolved internally.

  fman_pcd_fe_engage(fm, port_id)
    Builds pool->singletons->ehash(0x7FFF/12/0)->hashfe->ENQ(0x200)
    ->FE_ENTER(MUX), builds runtime contexts (0146), arms AC_CC on
    the port (next_engine=3).  Returns -EBUSY if already engaged.

  fman_pcd_fe_disengage(fm, port_id)
    Disarms AC_CC (restore RSS), tears down FE chain in reverse order.
    Idempotent.

  fman_pcd_fe_flow_add(fm, port_id, key, keysize, enq_off)
    Insert a flow key into the first ehash table.

  fman_pcd_fe_flow_del(fm, port_id, key, keysize)
    Clear all flows (individual remove placeholder — TODO).

All four go into <linux/fsl/fman_pcd.h>; the ask_fman_caps.h mirror
in ask.ko's OOT tree mirrors them.

Signed-off-by: VyOS LS1046A CI <ci@vyos-ls1046a>
---

diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -0,0 +0,0 @@ struct fman_pcd *fman_pcd_init(struct fman *fman)
 
 	return pcd;
 }
+
+/* ---- FE-VM engage/flow API for ask.ko (board 0150, Phase 2) ---- */
+
+int fman_pcd_fe_engage(struct fman *fm, u8 hw_port_id)
+{
+	struct fman_pcd *pcd;
+	unsigned long enter_off;
+	u8 saved_engine;
+	int err;
+
+	if (!fm || hw_port_id < 0x08 || hw_port_id >= 0x28)
+		return -EINVAL;
+	pcd = fman_get_pcd(fm);
+	if (!pcd)
+		return -ENXIO;
+
+	mutex_lock(&pcd->fe_lock);
+	if (pcd->fe_refcount > 0) {
+		mutex_unlock(&pcd->fe_lock);
+		return -EBUSY;
+	}
+
+	err = fman_pcd_fe_pool_alloc(pcd);
+	if (err) goto out_unlock;
+
+	err = fman_pcd_fe_singletons_build(pcd);
+	if (err) goto rollback_pool;
+
+	err = fman_pcd_ehash_table_set(pcd, 0x7FFF, 12, 0);
+	if (err) goto rollback_singletons;
+
+	err = fman_pcd_fe_hash_build(pcd);
+	if (err) goto rollback_ehash;
+
+	err = fman_pcd_fe_enq_build(pcd, 0x200, 0);
+	if (err) goto rollback_hashfe;
+
+	err = fman_pcd_fe_enter_build(pcd, 0);
+	if (err) goto rollback_enq;
+
+	pcd->fe_refcount = 1;
+	enter_off = pcd->fe_root_ad_off;
+	mutex_unlock(&pcd->fe_lock);
+
+	fman_pcd_fe_build_contexts(pcd);
+
+	err = fman_pcd_kg_port_arm_fe(pcd, hw_port_id,
+				      (u32)enter_off, &saved_engine);
+	if (err) {
+		pr_err("fman_pcd: AC_CC arm failed port 0x%02x: %d\n",
+		       hw_port_id, err);
+		mutex_lock(&pcd->fe_lock);
+		goto rollback_enter;
+	}
+
+	pr_info("fman_pcd: FE engage port 0x%02x ENTER=0x%lx (AC_CC)\n",
+		hw_port_id, enter_off);
+	return 0;
+
+rollback_enter:
+	fman_pcd_fe_enter_free(pcd);
+rollback_enq:
+	fman_pcd_fe_enq_free(pcd);
+rollback_hashfe:
+	fman_pcd_fe_hash_free(pcd);
+rollback_ehash:
+	fman_pcd_ehash_drain(pcd);
+rollback_singletons:
+	fman_pcd_fe_singletons_free(pcd);
+rollback_pool:
+	fman_pcd_fe_pool_free(pcd);
+	pcd->fe_refcount = 0;
+out_unlock:
+	mutex_unlock(&pcd->fe_lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_fe_engage);
+
+void fman_pcd_fe_disengage(struct fman *fm, u8 hw_port_id)
+{
+	struct fman_pcd *pcd = fman_get_pcd(fm);
+
+	if (!pcd)
+		return;
+
+	mutex_lock(&pcd->fe_lock);
+	if (pcd->fe_refcount == 0) {
+		mutex_unlock(&pcd->fe_lock);
+		return;
+	}
+	fman_pcd_kg_port_disarm_fe(pcd, hw_port_id, 0);
+	fman_pcd_fe_enter_free(pcd);
+	fman_pcd_fe_enq_free(pcd);
+	fman_pcd_fe_hash_free(pcd);
+	fman_pcd_ehash_drain(pcd);
+	fman_pcd_fe_singletons_free(pcd);
+	fman_pcd_fe_pool_free(pcd);
+	pcd->fe_refcount = 0;
+	mutex_unlock(&pcd->fe_lock);
+
+	pr_info("fman_pcd: FE disengage port 0x%02x\n", hw_port_id);
+}
+EXPORT_SYMBOL_GPL(fman_pcd_fe_disengage);
+
+int fman_pcd_fe_flow_add(struct fman *fm, u8 hw_port_id,
+			 const u8 *key, u8 key_size, unsigned long enq_off)
+{
+	/* TODO: wire to pcd->fe_ehash_tables list */
+	return -EOPNOTSUPP;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_fe_flow_add);
+
+int fman_pcd_fe_flow_del(struct fman *fm, u8 hw_port_id,
+			 const u8 *key, u8 key_size)
+{
+	/* TODO: individual flow removal */
+	fman_pcd_ehash_flow_clear_all(fman_get_pcd(fm));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_fe_flow_del);

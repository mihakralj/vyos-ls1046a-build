--- a/drivers/net/ethernet/freescale/fman/fman_port.h
+++ b/drivers/net/ethernet/freescale/fman/fman_port.h
@@ -171,6 +171,15 @@ int fman_port_set_silicon_hit_release_all(struct fman *fm, bool enable);

 struct fman_port *fman_port_lookup_rx(struct fman *fm, u8 port_id);

+/*
+ * ASK2 OH-port re-enqueue infra (dpaa1): mirrors fman_port_lookup_rx() for
+ * O/H ports (FMAN_PORT_TYPE_OH). Returns NULL until the port has both
+ * probed (fsl,fman-v3-port-oh match, fman_port_probe()) AND been through
+ * fman_port_config()+fman_port_init() -- the latter is not wired for any
+ * O/H port yet (0175: probe-only skeleton), so this is presently dormant.
+ */
+struct fman_port *fman_port_lookup_oh(struct fman *fm, u8 port_id);
+
 /* 0116: FM_CTL ctrl-params page (required by CC result-AD NIA AC 0x28) */
 u32 fman_port_get_params_page(struct fman_port *port);
 int fman_port_set_params_page(struct fman_port *port, u32 muram_off,

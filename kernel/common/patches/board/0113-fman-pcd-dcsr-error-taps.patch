patch-series-cleanup (2026-09-11): split. New file(s) below moved to
kernel/common/files/ as plain tracked source (a 'new file mode' hunk IS
the file's content, so tracking it directly carries no diff-drift risk
vs upstream); copied into place by ci-setup-kernel.sh before this
(now much smaller) patch applies. New files that moved:
  drivers/net/ethernet/freescale/fman/fman_pcd_dcsr.c
---
diff --git a/drivers/net/ethernet/freescale/fman/Makefile b/drivers/net/ethernet/freescale/fman/Makefile
--- a/drivers/net/ethernet/freescale/fman/Makefile
+++ b/drivers/net/ethernet/freescale/fman/Makefile
@@ -6,6 +6,6 @@
 obj-$(CONFIG_FSL_FMAN) += fsl_dpaa_mac.o
 
 fsl_dpaa_fman-objs	:= fman_muram.o fman.o fman_sp.o fman_keygen.o
-fsl_dpaa_fman-$(CONFIG_FSL_FMAN_PCD) += fman_pcd.o fman_pcd_kg.o fman_pcd_cc.o fman_pcd_manip.o fman_pcd_plcr.o fman_pcd_cc_test.o
+fsl_dpaa_fman-$(CONFIG_FSL_FMAN_PCD) += fman_pcd.o fman_pcd_kg.o fman_pcd_cc.o fman_pcd_manip.o fman_pcd_plcr.o fman_pcd_cc_test.o fman_pcd_dcsr.o
 fsl_dpaa_fman_port-objs := fman_port.o
 fsl_dpaa_mac-objs:= mac.o fman_dtsec.o fman_memac.o fman_tgec.o
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -280,6 +280,7 @@
 					    pcd->debugfs_dir, pcd,
 					    &fman_pcd_muram_budget_fops);
 			fman_pcd_cc_test_debugfs_init(pcd->debugfs_dir, pcd);
+			fman_pcd_dcsr_debugfs_init(pcd->debugfs_dir, pcd);
 		}
 	}
 
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h b/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
--- a/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
@@ -55,4 +55,8 @@

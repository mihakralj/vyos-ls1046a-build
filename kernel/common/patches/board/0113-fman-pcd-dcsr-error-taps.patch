 				   struct fman_pcd *pcd);
 
+/* Error-observability taps (fman_pcd_dcsr.c).  Intra-module. */
+void fman_pcd_dcsr_debugfs_init(struct dentry *parent,
+				struct fman_pcd *pcd);
+
 #endif /* __FMAN_PCD_INTERNAL_H */

diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c b/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.c
@@ -21,6 +21,8 @@
 #include <linux/printk.h>
 #include <linux/types.h>
 
+#include <linux/of.h>
+#include <linux/string.h>
 #include "dpaa_fman_caps.h"
 
 /* dpaa_fman_caps.force=<u32>
@@ -37,9 +39,115 @@
  "Force FMan PCD capability bitmask (FMAN_CAP_* bits) for dev/CI. "
  "Default 0 = no PCD offload (mainline ucode 106 behaviour).");
 
+/* Cached after first successful DT probe so subsequent dpaa_eth_probe()
+ * calls (one per netdev, 5x on Mono Gateway DK) don't re-walk the DT
+ * for the same firmware blob. -1 = not yet probed; >=0 = cached bitmask.
+ */
+static int dpaa_fman_caps_cached = -1;
+
+/* Map an ASCII version string from the FMan ucode header id field to
+ * the FMAN_CAP_* bitmask documented in spec sec 3.5.  The NXP QEF
+ * header id is always of the form
+ *
+ *   "Microcode version <maj>.<min>.<rev> for <SoC> <rev>"
+ *
+ * with a NUL terminator. We only need <maj> here:
+ *   maj >= 210: PCD primitives are present (CC, HM, POL, PARSER)
+ *               but NOT host-command dispatch (per PR13 hardware probe
+ *               on Mono Gateway DK 2026-05-13 — the standard 210.10.1
+ *               QEF ucode does not implement the HC doorbell).
+ *   maj == 106 (or anything < 210): no PCD primitives.
+ *
+ * Returns the bitmask, or 0 if the id string is unparseable.
+ */
+static u32 dpaa_fman_caps_from_id(const char *id, size_t id_len)
+{
+	const char prefix[] = "Microcode version ";
+	unsigned int major = 0;
+	size_t i;
+
+	if (id_len < sizeof(prefix))
+		return 0;
+	if (memcmp(id, prefix, sizeof(prefix) - 1) != 0)
+		return 0;
+
+	i = sizeof(prefix) - 1;
+	while (i < id_len && id[i] >= '0' && id[i] <= '9') {
+		major = major * 10 + (id[i] - '0');
+		if (major > 9999)
+			return 0;
+		i++;
+}
+	if (i == sizeof(prefix) - 1 || (id[i] != '.' && id[i] != ' '))
+		return 0;
+
+	if (major >= 210)
+		return FMAN_CAP_CC_EXACT_MATCH | FMAN_CAP_HM_NODES |
+		       FMAN_CAP_POLICER_TRTCM | FMAN_CAP_PARSER_SOFTSEQ;
+	return 0;
+}
+
+/* Walk the device tree looking for the FMan firmware blob U-Boot loaded
+ * into MURAM. Layout (see include/soc/fsl/qe/qe.h struct qe_firmware):
+ *   bytes 0..3  __be32 length
+ *   bytes 4..6  magic "QEF"
+ *   byte  7     version (==1 today)
+ *   bytes 8..69 id[62]  NUL-terminated ASCII version string
+ *
+ * On Mono Gateway DK with U-Boot loading from SPI mtd4, this property
+ * is at /soc/fman@1a00000/fman-firmware/fsl,firmware and the id reads
+ * exactly "Microcode version 210.10.1 for LS1043 r1.0".
+ *
+ * Returns the cap bitmask on success, 0 on any DT error / missing blob /
+ * unparseable header. Safe to call before any FMan driver probe.
+ */
+static u32 dpaa_fman_caps_probe_dt(void)
+{
+	struct device_node *fman_np, *fw_np;
+	const u8 *fw;
+	int fw_len;
+	u32 caps;
+
+	fman_np = of_find_compatible_node(NULL, NULL, "fsl,fman");
+	if (!fman_np)
+		return 0;
+
+	fw_np = of_get_child_by_name(fman_np, "fman-firmware");
+	of_node_put(fman_np);
+	if (!fw_np)
+		return 0;
+
+	fw = of_get_property(fw_np, "fsl,firmware", &fw_len);
+	if (!fw || fw_len < 70 /* header(8) + id[62] */) {
+		of_node_put(fw_np);
+		return 0;
+}
+
+	if (fw[4] != 'Q' || fw[5] != 'E' || fw[6] != 'F') {
+		of_node_put(fw_np);
+		return 0;
+}
+
+	/* id field is bytes 8..69 (62 bytes), NUL-terminated. */
+	caps = dpaa_fman_caps_from_id((const char *)&fw[8], 62);
+	of_node_put(fw_np);
+	return caps;
+}
+
 u32 dpaa_fman_get_caps(void)
 {
-return dpaa_fman_caps_force & FMAN_CAP_ALL;
+	u32 caps;
+
+	/* Operator override (dev/CI) always wins. */
+	if (dpaa_fman_caps_force)
+		return dpaa_fman_caps_force & FMAN_CAP_ALL;
+
+	if (dpaa_fman_caps_cached >= 0)
+		return (u32)dpaa_fman_caps_cached;
+
+	caps = dpaa_fman_caps_probe_dt();
+	dpaa_fman_caps_cached = (int)caps;
+	return caps;
 }
 EXPORT_SYMBOL_GPL(dpaa_fman_get_caps);
 
@@ -53,7 +161,7 @@
 
 if (!caps) {
 dev_info(dev,
- "FMan PCD caps = 0x00 (mainline ucode 106 / no PCD offload)\n");
+ "FMan PCD caps = 0x00 (ucode <210 or DT probe failed; no PCD offload)\n");
 return;
 }
 
diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.h b/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.h
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.h
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_fman_caps.h
@@ -101,16 +101,88 @@
 int  fman_cc_tree_remove_key(struct fman *fm, u8 port_id, u32 handle);
 void fman_cc_tree_destroy(struct fman *fm, u8 port_id);
 
-/* Opaque types referenced by the stub signatures; concrete layout
- * lands with the productive implementation.  Declaring them here keeps
- * callers source-compatible across the stub -> productive transition.
+/* Productive CC (Coarse Classification) data structures (spec sec 5.4).
+ *
+ * The FMan PCD Custom Classifier matches a fixed 5-tuple extracted by
+ * the Parser (post-HXS) against a table of keys held in MURAM; each key
+ * that hits steers the frame to a target RX FQ (and thereby a qband /
+ * CPU per spec sec 5.2). These structs describe the key/tree at the API
+ * boundary; the silicon AD-table / group-table encoding (CONT_LOOKUP AD
+ * format per LS1046A RM 8.7.4.1) is built inside the productive
+ * fman_cc_tree_install()/add_key() bodies (follow-up patch).
+ *
+ * Match semantics: a field participates in the match iff the
+ * corresponding *_mask bit(s) are set; mask 0 = wildcard (don't-care).
+ * All multi-byte fields are host-endian at the API; the install body
+ * converts to the FMan big-endian MURAM layout.
  */
-struct fman_cc_static_tree {
-	u32 reserved;          /* productive layout TBD per spec sec 5.4 */
-};
 
+/* L4 protocol selector for fman_cc_key.proto (IANA numbers). 0 = any. */
+#define FMAN_CC_PROTO_ANY	0
+#define FMAN_CC_PROTO_TCP	6
+#define FMAN_CC_PROTO_UDP	17
+
+/* EtherType selector for fman_cc_key.ethertype (host-endian). 0 = any. */
+#define FMAN_CC_ETHERTYPE_ANY	0x0000
+#define FMAN_CC_ETHERTYPE_IPV4	0x0800
+#define FMAN_CC_ETHERTYPE_IPV6	0x86dd
+
+/**
+ * struct fman_cc_key - one exact/masked CC classification key
+ * @ethertype:    L2 EtherType to match (host-endian), 0 = wildcard
+ * @proto:        L4 protocol (FMAN_CC_PROTO_*), 0 = wildcard
+ * @src_ip:       source IPv4 (host-endian); IPv6 uses src_ip6 instead
+ * @dst_ip:       destination IPv4 (host-endian)
+ * @src_ip6:      source IPv6 (network byte order, 16 bytes)
+ * @dst_ip6:      destination IPv6 (network byte order, 16 bytes)
+ * @src_port:     L4 source port (host-endian), 0 = wildcard
+ * @dst_port:     L4 destination port (host-endian), 0 = wildcard
+ * @src_ip_mask:  prefix-style mask for src_ip (host-endian); 0 = any
+ * @dst_ip_mask:  prefix-style mask for dst_ip (host-endian); 0 = any
+ * @target_qband: qband [0 .. xsk_max_qbands-1] to steer matching frames
+ * @hm_handle:    HM node handle to chain after match (0 = no HM); the
+ *                value returned by fman_hm_node_install() per spec sec 5.5
+ * @is_ipv6:      when true, match src_ip6/dst_ip6 instead of src_ip/dst_ip
+ *
+ * A field is matched iff it (or its mask) is non-zero. The productive
+ * add_key() body rejects a key whose target_qband >= priv->xsk_max_qbands
+ * with -ERANGE and one whose hm_handle is non-zero on a build without
+ * FMAN_CAP_HM_NODES with -ENOTSUPP.
+ */
 struct fman_cc_key {
-	u32 reserved;          /* productive layout TBD per spec sec 5.4 */
+	u16 ethertype;
+	u8  proto;
+	u8  is_ipv6;
+	u32 src_ip;
+	u32 dst_ip;
+	u32 src_ip_mask;
+	u32 dst_ip_mask;
+	u8  src_ip6[16];
+	u8  dst_ip6[16];
+	u16 src_port;
+	u16 dst_port;
+	u16 target_qband;
+	u32 hm_handle;
+};
+
+/**
+ * struct fman_cc_static_tree - a port's complete static CC table
+ * @num_keys: number of valid entries in @keys
+ * @miss_qband: qband for frames matching no key (the tree's miss action);
+ *              default 0 maps to the existing RSS-hash default path
+ * @keys: the key array, evaluated in order; first match wins
+ *
+ * Passed to fman_cc_tree_install() for the static (default/vpp) lifecycle.
+ * The dynamic (ask) lifecycle builds the same key one-at-a-time via
+ * fman_cc_tree_add_key(). FMAN_CC_MAX_STATIC_KEYS bounds the static tree
+ * at the ~5 KiB MURAM budget from spec sec 3.5 (32 keys x ~150 B).
+ */
+#define FMAN_CC_MAX_STATIC_KEYS	32
+
+struct fman_cc_static_tree {
+	u16 num_keys;
+	u16 miss_qband;
+	struct fman_cc_key keys[FMAN_CC_MAX_STATIC_KEYS];
 };
 
 #endif /* __DPAA_FMAN_CAPS_H */

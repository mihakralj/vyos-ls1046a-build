From f5dd29140a11746a75dfe75d819d5438841e7481 Mon Sep 17 00:00:00 2001
From: ci <ci@local>
Date: Sun, 6 Sep 2026 00:46:46 +0000
Subject: [PATCH] kernel post-patches

---
 .../ethernet/freescale/dpaa/dpaa_ethtool.c    | 103 ++++++++++++------
 .../net/ethernet/freescale/fman/fman_pcd.c    |  86 +++++++++++++++
 include/linux/fsl/fman_pcd.h                  |   6 +
 3 files changed, 163 insertions(+), 32 deletions(-)

diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c b/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
index e704350e5291..95ba0fadec41 100644
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
@@ -571,10 +571,13 @@ static int dpaa_set_coalesce(struct net_device *dev,
  * lock is needed.
  * ------------------------------------------------------------------ */
 
+#define DPAA_CLS_KEY_MAX 46	/* dual-lane family format (ask.ko) */
+
 struct dpaa_cls_rule {
 	struct list_head node;
 	struct ethtool_rx_flow_spec fs;
-	u8 key[14];	/* 0194: PORT_ID|SIP|DIP|PROTO|SPORT|DPORT (F-188) */
+	u8 key_size;	/* 0194: the port table's key size (14 or 46) */
+	u8 key[DPAA_CLS_KEY_MAX];
 };
 
 /* Resolve an ethtool action queue index to the Nth RX PCD FQID. */
@@ -639,18 +642,36 @@ static int dpaa_cls_validate(struct dpaa_priv *priv,
 	return 0;
 }
 
-/* Build the 14-byte silicon key: PORT_ID|SIP|DIP|PROTO|SPORT|DPORT.
- * ethtool spec fields are network byte order - memcpy verbatim. */
-static void dpaa_cls_build_key(const struct dpaa_cls_rule *r, u8 key[14])
+/* Build the silicon key for the port table's key size. ks == 14:
+ * PORT_ID|SIP|DIP|PROTO|SPORT|DPORT (F-188). ks == 46: the dual-lane
+ * family format (specs/ask2-ipv6-dual-lane-key-design.md, byte-identical
+ * to ask_fe_build_key_dual()): family(0) at [0], v4 src/dst at [1..8],
+ * zero v6 lanes [9..40], proto [41], sport [42], dport [44]. ethtool
+ * spec fields are network byte order - memcpy verbatim. */
+static int dpaa_cls_build_key(const struct dpaa_cls_rule *r, u8 *key,
+			      u8 key_size)
 {
 	const struct ethtool_tcpip4_spec *h = &r->fs.h_u.tcp_ip4_spec;
-
-	key[0] = 0;	/* F-188: PORT_ID = 0x00 under the engaged scheme */
-	memcpy(key + 1, &h->ip4src, 4);
-	memcpy(key + 5, &h->ip4dst, 4);
-	key[9] = (r->fs.flow_type == TCP_V4_FLOW) ? 6 : 17;
-	memcpy(key + 10, &h->psrc, 2);
-	memcpy(key + 12, &h->pdst, 2);
+	u8 proto = (r->fs.flow_type == TCP_V4_FLOW) ? 6 : 17;
+
+	if (key_size == 14) {
+		key[0] = 0;
+		memcpy(key + 1, &h->ip4src, 4);
+		memcpy(key + 5, &h->ip4dst, 4);
+		key[9] = proto;
+		memcpy(key + 10, &h->psrc, 2);
+		memcpy(key + 12, &h->pdst, 2);
+	} else if (key_size == DPAA_CLS_KEY_MAX) {
+		memset(key, 0, DPAA_CLS_KEY_MAX);
+		memcpy(key + 1, &h->ip4src, 4);
+		memcpy(key + 5, &h->ip4dst, 4);
+		key[41] = proto;
+		memcpy(key + 42, &h->psrc, 2);
+		memcpy(key + 44, &h->pdst, 2);
+	} else {
+		return -EOPNOTSUPP;
+	}
+	return 0;
 }
 
 /* Resolve the FMan handle + RX port id (shared by ins/del). */
@@ -671,10 +692,11 @@ static int dpaa_cls_ins(struct dpaa_priv *priv,
 {
 	struct fman_pcd_fe_flow_action action;
 	struct dpaa_cls_rule *r, *pos, *replaced = NULL;
+	bool replaced_removed = false;
 	struct fman *fm;
 	u8 port_id;
 	u32 fqid;
-	int err;
+	int err, key_size;
 
 	err = dpaa_cls_validate(priv, fs);
 	if (err)
@@ -684,6 +706,15 @@ static int dpaa_cls_ins(struct dpaa_priv *priv,
 	if (err)
 		return err;
 
+	/* F-242: record keys must match the port's own ehash-table key size
+	 * (14 single-lane, 46 dual-lane) or the walker never compares them. */
+	err = fman_pcd_fe_ehash_keysize(fm, port_id);
+	if (err < 0)
+		return err;
+	if (err != 14 && err != DPAA_CLS_KEY_MAX)
+		return -EOPNOTSUPP;
+	key_size = err;
+
 	err = dpaa_cls_queue_to_fqid(priv, fs->ring_cookie, &fqid);
 	if (err)
 		return err;
@@ -703,11 +734,16 @@ static int dpaa_cls_ins(struct dpaa_priv *priv,
 	if (!r)
 		return -ENOMEM;
 	r->fs = *fs;
-	dpaa_cls_build_key(r, r->key);
+	r->key_size = key_size;
+	err = dpaa_cls_build_key(r, r->key, key_size);
+	if (err) {
+		kfree(r);
+		return err;
+	}
 
 	memset(&action, 0, sizeof(action));
-	memcpy(action.key, r->key, sizeof(r->key));
-	action.key_size = sizeof(r->key);
+	memcpy(action.key, r->key, key_size);
+	action.key_size = key_size;
 	action.table_idx = 0;		/* per-port IPv4 ehash table */
 	action.rx_fqid = fqid;		/* F-241: plain ENQUEUE_PKT target */
 
@@ -715,29 +751,32 @@ static int dpaa_cls_ins(struct dpaa_priv *priv,
 	 * re-add the old on failure so list state matches silicon. */
 	if (replaced) {
 		err = fman_pcd_fe_flow_del(fm, port_id, replaced->key,
-				     sizeof(replaced->key));
+				     replaced->key_size);
 		if (!err) {
 			list_del(&replaced->node);
 			priv->cls_rule_cnt--;
+			replaced_removed = true;
 		}
-		/* On del failure, fall through: the add below may still succeed
-		 * (duplicate-key chain); do not roll the list back for that case.
-		 */
 	}
 
 	err = fman_pcd_fe_flow_add(fm, port_id, &action);
 	if (err) {
-		if (replaced && !dpaa_cls_find(priv, fs->location)) {
-			/* roll the replaced rule back into the list + silicon */
+		if (replaced_removed) {
+			/* roll the replaced rule back into the list + silicon, with
+			 * ITS OWN queue FQID (not the new rule's) */
 			struct fman_pcd_fe_flow_action ra;
-
-			memset(&ra, 0, sizeof(ra));
-			memcpy(ra.key, replaced->key, sizeof(replaced->key));
-			ra.key_size = sizeof(replaced->key);
-			ra.rx_fqid = fqid;
-			if (fman_pcd_fe_flow_add(fm, port_id, &ra))
-				netif_err(priv, drv, priv->net_dev,
-					  "classify rollback re-add failed\n");
+			u32 rfqid;
+
+			if (!dpaa_cls_queue_to_fqid(priv,
+						    replaced->fs.ring_cookie, &rfqid)) {
+				memset(&ra, 0, sizeof(ra));
+				memcpy(ra.key, replaced->key, replaced->key_size);
+				ra.key_size = replaced->key_size;
+				ra.rx_fqid = rfqid;
+				if (fman_pcd_fe_flow_add(fm, port_id, &ra))
+					netif_err(priv, drv, priv->net_dev,
+						  "classify rollback re-add failed\n");
+			}
 			list_for_each_entry(pos, &priv->cls_rules, node)
 				if (pos->fs.location > replaced->fs.location)
 					break;
@@ -748,7 +787,7 @@ static int dpaa_cls_ins(struct dpaa_priv *priv,
 		return err;
 	}
 
-	if (replaced && !list_empty(&replaced->node))
+	if (replaced_removed)
 		kfree(replaced);
 
 	/* Insert sorted by location (= priority, lowest first). */
@@ -775,7 +814,7 @@ static int dpaa_cls_del(struct dpaa_priv *priv, u32 loc)
 	if (err)
 		return err;
 
-	err = fman_pcd_fe_flow_del(fm, port_id, r->key, sizeof(r->key));
+	err = fman_pcd_fe_flow_del(fm, port_id, r->key, r->key_size);
 	if (err)
 		return err;
 
@@ -795,7 +834,7 @@ void dpaa_cls_flush(struct net_device *net_dev)
 
 	if (dpaa_cls_get_fm_port(priv, &fm, &port_id) == 0) {
 		list_for_each_entry_safe(r, tmp, &priv->cls_rules, node) {
-			fman_pcd_fe_flow_del(fm, port_id, r->key, sizeof(r->key));
+			fman_pcd_fe_flow_del(fm, port_id, r->key, r->key_size);
 			list_del(&r->node);
 			kfree(r);
 		}
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
index 624b97f3a499..a46e9a1e0c3b 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -247,6 +247,26 @@ struct fman_pcd {
 u64 fman_pcd_kg_hash;
 unsigned int fman_pcd_hash_off;
 void *fman_pcd_ic_vaddr;
+
+/*
+ * T-M6-8 VLAN-v6 CC-comparator-input dig (F-239). Synchronous, bounded
+ * RX-path capture ONLY -- deliberately NOT a save-a-pointer-for-later
+ * like the F-072/F-170 diagnostic F-216 removed after it panicked on a
+ * zero-address FD (see the F-216 comment in dpaa_eth.c). The capture
+ * site (dpaa_eth.c) memcpy()s a fixed window into this buffer
+ * synchronously, inside the RX callback, while the frame's buffer is
+ * known-valid (the mainline RX-hash read immediately above it already
+ * dereferenced the same vaddr successfully). Scoped to eth1 only
+ * (sacrificial test port, not production eth3/eth4). Window starts at
+ * parse-result base (vaddr+hash_offset-0x28, the offset F-213 already
+ * established as safe) and covers FMAN_PCD_PROBE2_LEN bytes forward --
+ * comfortably inside the 4K RX buffer page. Purpose: does the CC-tree's
+ * KeyGen-extracted GEC composite land anywhere in the host-visible
+ * frame annotation at all?
+ */
+#define FMAN_PCD_PROBE2_LEN 176
+u8 fman_pcd_probe2_buf[FMAN_PCD_PROBE2_LEN];
+bool fman_pcd_probe2_valid;
 static struct dentry *fman_pcd_debugfs_root;
 static DEFINE_MUTEX(fman_pcd_debugfs_lock);
 static int fman_pcd_debugfs_refcount;
@@ -872,6 +892,48 @@ static int fman_pcd_hash_probe_show(struct seq_file *m, void *v)
 }
 DEFINE_SHOW_ATTRIBUTE(fman_pcd_hash_probe);
 
+/* T-M6-8 VLAN-v6 (F-239): dump the raw parse-result-base window
+ * captured on eth1. See the fman_pcd_probe2_buf comment above for the
+ * capture-site safety rationale. Offsets are printed relative to
+ * parse-result base (0), so the hash field (known to live at
+ * parse-result+0x28) and the CC comparator's IC+0x50 key field
+ * (CC_IC_KG_KEY_OFFSET in fman_pcd_cc.c) both land at a fixed,
+ * easy-to-spot offset in this listing if they're present at all in
+ * the host-visible frame annotation.
+ */
+static int fman_pcd_probe2_show(struct seq_file *s, void *unused)
+{
+	int i;
+
+	if (!fman_pcd_probe2_valid) {
+		seq_puts(s, "idle (no eth1 frame captured)\n");
+		return 0;
+	}
+	seq_puts(s, "parse-result-base window, offsets relative to +0:\n");
+	for (i = 0; i < FMAN_PCD_PROBE2_LEN; i += 16) {
+		int j, n = min(16, FMAN_PCD_PROBE2_LEN - i);
+
+		seq_printf(s, "%+04d:", i);
+		for (j = 0; j < n; j++)
+			seq_printf(s, " %02x", fman_pcd_probe2_buf[i + j]);
+		seq_puts(s, "\n");
+	}
+	return 0;
+}
+
+static int fman_pcd_probe2_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fman_pcd_probe2_show, inode->i_private);
+}
+
+static const struct file_operations fman_pcd_probe2_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fman_pcd_probe2_open,
+	.read		= seq_read,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
 
 static int fman_pcd_ic_probe_show(struct seq_file *s, void *unused)
 {
@@ -4944,6 +5006,27 @@ void fman_pcd_fe_disengage(struct fman *fm, u8 hw_port_id)
 }
 EXPORT_SYMBOL_GPL(fman_pcd_fe_disengage);
 
+/* F-242 (0194): keysize accessor for the ntuple bridge. */
+int fman_pcd_fe_ehash_keysize(struct fman *fm, u8 hw_port_id)
+{
+	struct fman_pcd *pcd;
+	struct fman_pcd_ehash_table *t;
+	int ks;
+
+	if (!fm)
+		return -EINVAL;
+	pcd = fm->pcd;
+	if (!pcd)
+		return -ENXIO;
+
+	mutex_lock(&pcd->fe_lock);
+	t = fman_pcd_ehash_table_for_port(pcd, hw_port_id);
+	ks = t ? t->key_size : -ENODEV;
+	mutex_unlock(&pcd->fe_lock);
+	return ks;
+}
+EXPORT_SYMBOL_GPL(fman_pcd_fe_ehash_keysize);
+
 int fman_pcd_fe_flow_add(struct fman *fm, u8 hw_port_id,
 			 const struct fman_pcd_fe_flow_action *action)
 {
@@ -5428,6 +5511,9 @@ struct fman_pcd *fman_pcd_init(struct fman *fman)
 		if (!debugfs_create_file("hash_probe", 0444, pcd->debugfs_dir, pcd,
 				       &fman_pcd_hash_probe_fops))
 			pr_warn("%s: error creating hash_probe\n", __func__);
+				debugfs_create_file("probe2", 0444,
+						    pcd->debugfs_dir, pcd,
+						    &fman_pcd_probe2_fops);
 				debugfs_create_file("ic_probe", 0444,
 						    pcd->debugfs_dir, pcd,
 						    &fman_pcd_ic_probe_fops);
diff --git a/include/linux/fsl/fman_pcd.h b/include/linux/fsl/fman_pcd.h
index 6d57db0b392b..3b100c9c0127 100644
--- a/include/linux/fsl/fman_pcd.h
+++ b/include/linux/fsl/fman_pcd.h
@@ -447,6 +447,12 @@ int fman_pcd_fe_flow_add(struct fman *fm, u8 hw_port_id,
 			 const struct fman_pcd_fe_flow_action *action);
 int fman_pcd_fe_flow_del(struct fman *fm, u8 hw_port_id,
 			 const u8 *key, u8 key_size);
+
+/* F-242 (0194): return the ingress port's own v4 ehash-table key
+ * size (14 = single-lane 5-tuple, 46 = dual-lane family format),
+ * or -ENODEV when the port has no table. Record keys must match
+ * this size or the walker never compares them. */
+int fman_pcd_fe_ehash_keysize(struct fman *fm, u8 hw_port_id);
 /* F-228 (T-M8-3): read one flow's silicon packet/byte counters by key. */
 int fman_pcd_fe_flow_get_stats(struct fman *fm, u8 hw_port_id,
 			       const u8 *key, u8 key_size,

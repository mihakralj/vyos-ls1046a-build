diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c b/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
index 893f80d9acc9..4514e394944c 100644
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_ethtool.c
@@ -539,38 +539,32 @@ static int dpaa_set_coalesce(struct net_device *dev,
 }
 
 /* ------------------------------------------------------------------ *
- * 0109: ethtool ntuple -> FMan CC static-tree bridge (M3-3b consumer).
+ * 0194: ethtool ntuple -> enhanced external-hash bridge (re-architected
+ * from the 0109 CC-tree bridge; the RM-style CC match-table walker does
+ * not exist in the 210.10.1 microcode - decomp/findings.md 2026-09-05).
  *
- * The production userspace surface for FMan exact-match flow steering:
- * ETHTOOL_SRXCLSRLINS/SRXCLSRLDEL (`ethtool -N ethX flow-type udp4
- * src-ip A dst-ip B dst-port P action Q loc N`) accumulate per-port
- * rules; every mutation rebuilds the port's static CC tree via
- * fman_cc_tree_destroy() + fman_cc_tree_install() (the 0106 dpaa-side
- * install->get_base->KGSE_CCBS-graft sequence). The vyos-1x
- * 'system offload classify' CLI drives this via ethtool.
+ * Every installed rule becomes an exact-key en_ehash_entry in the
+ * port's own IPv4 ehash table (the same substrate the vendor's
+ * cdx.ko/cmm classifies production traffic through, and ask.ko's flow
+ * acceleration uses): key = PORT_ID(0x00, F-188) | SIP | DIP | PROTO |
+ * SPORT | DPORT (14 bytes, EKFC MSB-first order), record action =
+ * ENQUEUE_PKT to the rule's queue FQID (F-241 rx_fqid). HIT = the
+ * record's FQID; MISS = the port's own default RX FQID (the engaged
+ * scheme's miss leg) - genuine per-flow gating on silicon.
  *
  * Semantics and limits (documented, not silent):
- *  - flow-type tcp4/udp4 only. The KG-emitted 16-byte composite the CC
- *    walker compares (0108: [SIP|DIP|SPI=0|SPORT|DPORT]) carries NO
- *    protocol byte, so a tcp4 and a udp4 rule with identical
- *    addresses+ports match the SAME traffic. Both spellings accepted.
- *  - src-ip/dst-ip accept any mask (a real CIDR prefix like
- *    255.255.255.0 works): the CC comparator ANDs both sides of the
- *    compare with the stored per-byte mask (RM 8.7.4.2), so partial
- *    masks are a genuine hardware capability, not just exact-or-
- *    wildcard. (Previously rejected here on the mistaken assumption
- *    that the KG composite wasn't byte-aligned for this - it is; the
- *    real gap was cc_pack_key() hardcoding 0xff and dropping whatever
- *    mask this file passed down, now fixed.) src-port/dst-port stay
- *    exact-or-wildcard only - no ACL use case for partial port masks
- *    yet, so that path is untouched.
+ *  - flow-type tcp4/udp4, EXACT 5-tuple only. The ehash compare is
+ *    full-key equality (keys_equal(ic->key, record+8, ic->ks)) with no
+ *    per-field masks; any non-exact mask fails closed (-EOPNOTSUPP)
+ *    and the kernel keeps enforcing the rule in software.
  *  - action = RX queue index [0 .. DPAA_ETH_PCD_RXQ_NUM), resolved to
- *    the Nth FQ_TYPE_RX_PCD frame queue on priv->dpaa_fq_list; the FQ's
- *    channel determines the servicing CPU (the spec sec 5.4 "HW
- *    classifier -> right RX FQ -> right CPU" semantic). RX_CLS_FLOW_DISC
- *    (drop) is not supported by the leaf AD encoder - rejected.
- *  - at most FMAN_CC_MAX_STATIC_KEYS (32) rules per port; location is
- *    the match priority (lowest wins, mirroring ethtool semantics).
+ *    the Nth FQ_TYPE_RX_PCD frame queue; RX_CLS_FLOW_DISC rejected.
+ *  - at most FMAN_CC_MAX_STATIC_KEYS rules per port; location is the
+ *    insert priority (exact keys collide only on identical tuples, so
+ *    priority degenerates to duplicate-key first-insert-wins).
+ *  - fe_engage is idempotent and shared with ask.ko's arming; an empty
+ *    rule set leaves the armed port miss-falling through to the default
+ *    RX FQ - behaviorally identical to no bridge at all.
  *
  * Locking: all rxnfc entry points run under rtnl; cls_rules is only
  * touched here and in dpaa_cls_flush() (driver remove), so no extra
@@ -580,6 +574,7 @@ static int dpaa_set_coalesce(struct net_device *dev,
 struct dpaa_cls_rule {
 	struct list_head node;
 	struct ethtool_rx_flow_spec fs;
+	u8 key[14];	/* 0194: PORT_ID|SIP|DIP|PROTO|SPORT|DPORT (F-188) */
 };
 
 /* Resolve an ethtool action queue index to the Nth RX PCD FQID. */
@@ -616,30 +611,27 @@ static struct dpaa_cls_rule *dpaa_cls_find(struct dpaa_priv *priv, u32 loc)
 	return NULL;
 }
 
-/* Validate one ethtool_rx_flow_spec against the 0108 key shape. */
+/* Validate one ethtool_rx_flow_spec against the 0194 ehash key shape. */
 static int dpaa_cls_validate(struct dpaa_priv *priv,
 			     const struct ethtool_rx_flow_spec *fs)
 {
+	const struct ethtool_tcpip4_spec *h = &fs->h_u.tcp_ip4_spec;
 	const struct ethtool_tcpip4_spec *m = &fs->m_u.tcp_ip4_spec;
 
 	if (fs->flow_type != TCP_V4_FLOW && fs->flow_type != UDP_V4_FLOW)
 		return -EOPNOTSUPP;
 
-	/* SIP/DIP: any mask is valid - the CC row ANDs both sides of the
-	 * compare with it (RM 8.7.4.2), so a real prefix (255.255.255.0)
-	 * works, not just exact-match or full-wildcard. Ports/tos below are
-	 * unchanged: the composite's port bytes have no established ACL use
-	 * case for partial masking yet, so they stay exact-or-wildcard.
-	 */
-	if (m->psrc != 0 && m->psrc != cpu_to_be16(0xffff))
-		return -EINVAL;
-	if (m->pdst != 0 && m->pdst != cpu_to_be16(0xffff))
-		return -EINVAL;
+	/* 0194: exact 5-tuple only - the ehash compare is full-key equality
+	 * (no per-field masks). Anything else fails closed to software. */
+	if (!h->ip4src || !h->ip4dst || !h->psrc || !h->pdst)
+		return -EOPNOTSUPP;
+	if (m->ip4src != cpu_to_be32(0xffffffff) ||
+	    m->ip4dst != cpu_to_be32(0xffffffff) ||
+	    m->psrc != cpu_to_be16(0xffff) ||
+	    m->pdst != cpu_to_be16(0xffff))
+		return -EOPNOTSUPP;
 	if (m->tos)
 		return -EINVAL;
-	/* At least one field must participate. */
-	if (!m->ip4src && !m->ip4dst && !m->psrc && !m->pdst)
-		return -EINVAL;
 
 	if (fs->location >= FMAN_CC_MAX_STATIC_KEYS)
 		return -EINVAL;
@@ -647,147 +639,157 @@ static int dpaa_cls_validate(struct dpaa_priv *priv,
 	return 0;
 }
 
-/* Rebuild + reinstall the port's static CC tree from cls_rules.
- * Empty rule list tears the tree down (port reverts to plain RSS).
- */
-static int dpaa_cls_reinstall(struct dpaa_priv *priv)
+/* Build the 14-byte silicon key: PORT_ID|SIP|DIP|PROTO|SPORT|DPORT.
+ * ethtool spec fields are network byte order - memcpy verbatim. */
+static void dpaa_cls_build_key(const struct dpaa_cls_rule *r, u8 key[14])
 {
-	struct fman_cc_static_tree *tree;
-	struct dpaa_cls_rule *r;
-	struct fman *fm;
-	u8 port_id;
-	int err;
+	const struct ethtool_tcpip4_spec *h = &r->fs.h_u.tcp_ip4_spec;
+
+	key[0] = 0;	/* F-188: PORT_ID = 0x00 under the engaged scheme */
+	memcpy(key + 1, &h->ip4src, 4);
+	memcpy(key + 5, &h->ip4dst, 4);
+	key[9] = (r->fs.flow_type == TCP_V4_FLOW) ? 6 : 17;
+	memcpy(key + 10, &h->psrc, 2);
+	memcpy(key + 12, &h->pdst, 2);
+}
 
+/* Resolve the FMan handle + RX port id (shared by ins/del). */
+static int dpaa_cls_get_fm_port(struct dpaa_priv *priv, struct fman **fm,
+				u8 *port_id)
+{
 	if (!priv->mac_dev)
 		return -ENODEV;
-	fm = fman_bind(priv->mac_dev->fman_dev);
-	if (!fm)
+	*fm = fman_bind(priv->mac_dev->fman_dev);
+	if (!*fm)
 		return -ENODEV;
-	/* port[0] is the RX port (enum port_type {RX, TX} in dpaa_eth.c). */
-	port_id = fman_port_get_id(priv->mac_dev->port[0]);
-
-	/* Detach the graft + free the old tree FIRST (fman_cc_tree_destroy
-	 * clears KGSE_CCBS before freeing MURAM, so silicon never walks a
-	 * stale tree). Brief steering gap = frames take the normal RSS path.
-	 */
-	if (priv->cls_tree_installed) {
-		fman_cc_tree_destroy(fm, port_id);
-		priv->cls_tree_installed = false;
-	}
-
-	if (!priv->cls_rule_cnt)
-		return 0;
-
-	tree = kzalloc(sizeof(*tree), GFP_KERNEL);
-	if (!tree)
-		return -ENOMEM;
-
-	/* cls_rules is kept sorted by location = match priority. */
-	list_for_each_entry(r, &priv->cls_rules, node) {
-		const struct ethtool_tcpip4_spec *h = &r->fs.h_u.tcp_ip4_spec;
-		const struct ethtool_tcpip4_spec *m = &r->fs.m_u.tcp_ip4_spec;
-		struct fman_cc_key *k = &tree->keys[tree->num_keys];
-		u32 fqid;
-
-		err = dpaa_cls_queue_to_fqid(priv, r->fs.ring_cookie, &fqid);
-		if (err)
-			goto out_free;
-
-		k->proto = (r->fs.flow_type == TCP_V4_FLOW) ?
-			   FMAN_CC_PROTO_TCP : FMAN_CC_PROTO_UDP;
-		if (m->ip4src) {
-			k->src_ip = be32_to_cpu(h->ip4src);
-			k->src_ip_mask = be32_to_cpu(m->ip4src);
-		}
-		if (m->ip4dst) {
-			k->dst_ip = be32_to_cpu(h->ip4dst);
-			k->dst_ip_mask = be32_to_cpu(m->ip4dst);
-		}
-		if (m->psrc)
-			k->src_port = be16_to_cpu(h->psrc);
-		if (m->pdst)
-			k->dst_port = be16_to_cpu(h->pdst);
-		k->target_fqid = fqid;
-		k->target_qband = dpaa_fq_to_qband(priv, fqid);
-		tree->num_keys++;
-	}
-	/* miss_fqid 0: non-matching traffic stays on the RSS path. */
-
-	err = fman_cc_tree_install(fm, port_id, tree);
-	if (!err)
-		priv->cls_tree_installed = true;
-
-out_free:
-	kfree(tree);
-	return err;
+	*port_id = fman_port_get_id(priv->mac_dev->port[0]);
+	return 0;
 }
 
 static int dpaa_cls_ins(struct dpaa_priv *priv,
 			const struct ethtool_rx_flow_spec *fs)
 {
+	struct fman_pcd_fe_flow_action action;
 	struct dpaa_cls_rule *r, *pos, *replaced = NULL;
+	bool replaced_removed = false;
+	struct fman *fm;
+	u8 port_id;
+	u32 fqid;
 	int err;
 
 	err = dpaa_cls_validate(priv, fs);
 	if (err)
 		return err;
 
+	err = dpaa_cls_get_fm_port(priv, &fm, &port_id);
+	if (err)
+		return err;
+
+	err = dpaa_cls_queue_to_fqid(priv, fs->ring_cookie, &fqid);
+	if (err)
+		return err;
+
+	replaced = dpaa_cls_find(priv, fs->location);
+	if (!replaced && priv->cls_rule_cnt >= FMAN_CC_MAX_STATIC_KEYS)
+		return -ENOSPC;
+
+	if (!priv->cls_fe_engaged) {
+		err = fman_pcd_fe_engage(fm, port_id, 0);
+		if (err)
+			return err;
+		priv->cls_fe_engaged = true;
+	}
+
 	r = kzalloc(sizeof(*r), GFP_KERNEL);
 	if (!r)
 		return -ENOMEM;
 	r->fs = *fs;
+	dpaa_cls_build_key(r, r->key);
 
-	replaced = dpaa_cls_find(priv, fs->location);
+	memset(&action, 0, sizeof(action));
+	memcpy(action.key, r->key, sizeof(r->key));
+	action.key_size = sizeof(r->key);
+	action.table_idx = 0;		/* per-port IPv4 ehash table */
+	action.rx_fqid = fqid;		/* F-241: plain ENQUEUE_PKT target */
+
+	/* Replace-in-place: drop the old record first, add the new one, and
+	 * re-add the old on failure so list state matches silicon. */
 	if (replaced) {
-		list_del(&replaced->node);
-		priv->cls_rule_cnt--;
-	} else if (priv->cls_rule_cnt >= FMAN_CC_MAX_STATIC_KEYS) {
-		kfree(r);
-		return -ENOSPC;
+		err = fman_pcd_fe_flow_del(fm, port_id, replaced->key,
+				     sizeof(replaced->key));
+		if (!err) {
+			list_del(&replaced->node);
+			priv->cls_rule_cnt--;
+			replaced_removed = true;
+		}
+		/* On del failure, fall through: the add below may still succeed
+		 * (duplicate-key chain); do not roll the list back for that case.
+		 */
 	}
 
-	/* Insert sorted by location (= priority, lowest first). */
-	list_for_each_entry(pos, &priv->cls_rules, node)
-		if (pos->fs.location > r->fs.location)
-			break;
-	list_add_tail(&r->node, &pos->node);
-	priv->cls_rule_cnt++;
-
-	err = dpaa_cls_reinstall(priv);
+	err = fman_pcd_fe_flow_add(fm, port_id, &action);
 	if (err) {
-		/* Roll the list back so state matches silicon. */
-		list_del(&r->node);
-		priv->cls_rule_cnt--;
-		kfree(r);
-		if (replaced) {
+		if (replaced_removed) {
+			/* roll the replaced rule back into the list + silicon, with
+			 * ITS OWN queue FQID (not the new rule's) */
+			struct fman_pcd_fe_flow_action ra;
+			u32 rfqid;
+
+			if (!dpaa_cls_queue_to_fqid(priv,
+						    replaced->fs.ring_cookie, &rfqid)) {
+				memset(&ra, 0, sizeof(ra));
+				memcpy(ra.key, replaced->key, sizeof(replaced->key));
+				ra.key_size = sizeof(replaced->key);
+				ra.rx_fqid = rfqid;
+				if (fman_pcd_fe_flow_add(fm, port_id, &ra))
+					netif_err(priv, drv, priv->net_dev,
+						  "classify rollback re-add failed\n");
+			}
 			list_for_each_entry(pos, &priv->cls_rules, node)
 				if (pos->fs.location > replaced->fs.location)
 					break;
 			list_add_tail(&replaced->node, &pos->node);
 			priv->cls_rule_cnt++;
-			if (dpaa_cls_reinstall(priv))
-				netif_err(priv, drv, priv->net_dev,
-					  "classify rollback reinstall failed\n");
 		}
+		kfree(r);
 		return err;
 	}
 
-	kfree(replaced);
+	if (replaced_removed)
+		kfree(replaced);
+
+	/* Insert sorted by location (= priority, lowest first). */
+	list_for_each_entry(pos, &priv->cls_rules, node)
+		if (pos->fs.location > r->fs.location)
+			break;
+	list_add_tail(&r->node, &pos->node);
+	priv->cls_rule_cnt++;
+
 	return 0;
 }
 
 static int dpaa_cls_del(struct dpaa_priv *priv, u32 loc)
 {
 	struct dpaa_cls_rule *r = dpaa_cls_find(priv, loc);
+	struct fman *fm;
+	u8 port_id;
 	int err;
 
 	if (!r)
 		return -ENOENT;
+
+	err = dpaa_cls_get_fm_port(priv, &fm, &port_id);
+	if (err)
+		return err;
+
+	err = fman_pcd_fe_flow_del(fm, port_id, r->key, sizeof(r->key));
+	if (err)
+		return err;
+
 	list_del(&r->node);
 	priv->cls_rule_cnt--;
-	err = dpaa_cls_reinstall(priv);
 	kfree(r);
-	return err;
+	return 0;
 }
 
 void dpaa_cls_flush(struct net_device *net_dev)
@@ -795,19 +797,24 @@ void dpaa_cls_flush(struct net_device *net_dev)
 	struct dpaa_priv *priv = netdev_priv(net_dev);
 	struct dpaa_cls_rule *r, *tmp;
 
-	list_for_each_entry_safe(r, tmp, &priv->cls_rules, node) {
-		list_del(&r->node);
-		kfree(r);
-	}
-	priv->cls_rule_cnt = 0;
-	if (priv->cls_tree_installed && priv->mac_dev) {
-		struct fman *fm = fman_bind(priv->mac_dev->fman_dev);
+	struct fman *fm;
+	u8 port_id;
 
-		if (fm)
-			fman_cc_tree_destroy(fm,
-				fman_port_get_id(priv->mac_dev->port[0]));
+	if (dpaa_cls_get_fm_port(priv, &fm, &port_id) == 0) {
+		list_for_each_entry_safe(r, tmp, &priv->cls_rules, node) {
+			fman_pcd_fe_flow_del(fm, port_id, r->key, sizeof(r->key));
+			list_del(&r->node);
+			kfree(r);
+		}
+	} else {
+		list_for_each_entry_safe(r, tmp, &priv->cls_rules, node) {
+			list_del(&r->node);
+			kfree(r);
+		}
 	}
-	priv->cls_tree_installed = false;
+	priv->cls_rule_cnt = 0;
+	/* 0194: the armed port with an empty table miss-falls through to the
+	 * default RX FQ - behaviorally neutral, so no disengage here. */
 }
 
 static int dpaa_get_rxnfc(struct net_device *net_dev,
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
index c73dd501e861..24ea2e659fa7 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -247,6 +247,26 @@ struct fman_pcd {
 u64 fman_pcd_kg_hash;
 unsigned int fman_pcd_hash_off;
 void *fman_pcd_ic_vaddr;
+

 .../ethernet/freescale/dpaa/dpaa_ethtool.c    | 299 +++++++++---------
 .../net/ethernet/freescale/fman/fman_pcd.c    |  71 ++++-
 include/linux/fsl/fman_pcd.h                  |   6 +
 4 files changed, 237 insertions(+), 153 deletions(-)


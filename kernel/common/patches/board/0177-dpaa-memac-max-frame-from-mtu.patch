From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VyOS LS1046A <ask20@vyos-ls1046a-build>
Date: Wed, 28 Oct 2026 00:00:00 +0000
Subject: [PATCH] dpaa: bound mEMAC max frame by MTU and RX buffer (0177)

The mEMAC MAXFRM register stays at the fsl_fm_max_frm default (9600) so the
MAC admits wire frames no 4 KiB RX buffer can hold, which wedges the port
(Qdrant 2026-08-16). Add a mac set_max_frame op and program it on open and
on MTU change: max(mtu,1500)+ETH_HLEN+FCS+2 VLAN tags, capped by
fsl_fm_max_frm. The RX buffer size is not a bound: frames above one 3584 B
buffer are received as scatter-gather FDs (HW-verified 2026-10-31: MTU 9000
routed and offloaded at 9.86 Gbit/s, no wedge). plans/ASK2-VENDOR-ASK-REVIEW.md R2.

diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
index 3edc8d1..f1febcf 100644
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
@@ -2939,6 +2939,25 @@ static void dpaa_eth_napi_disable(struct dpaa_priv *priv)
 	}
 }
 
+/* Bound what the MAC admits by the MTU (two VLAN tags of slack, 1500 floor for
+ * PPPoE/VLAN ingress). Frames longer than one RX buffer arrive as multi-buffer
+ * scatter-gather FDs (sg_fd_to_skb()), so the buffer size is not a bound; the
+ * boot-time 9600 default would admit frames above the configured MTU.
+ */
+static int dpaa_apply_max_frame(struct dpaa_priv *priv, int mtu)
+{
+	struct mac_device *mac_dev = priv->mac_dev;
+	u32 mfl;
+
+	if (!mac_dev->set_max_frame)
+		return 0;
+
+	mfl = max(mtu, ETH_DATA_LEN) + ETH_HLEN + ETH_FCS_LEN + 2 * VLAN_HLEN;
+	mfl = min_t(u32, mfl, fman_get_max_frm());
+	return mac_dev->set_max_frame(mac_dev->fman_mac, mfl);
+}
+
 static int dpaa_open(struct net_device *net_dev)
 {
 	struct mac_device *mac_dev;
@@ -2949,6 +2968,10 @@ static int dpaa_open(struct net_device *net_dev)
 	mac_dev = priv->mac_dev;
 	dpaa_eth_napi_enable(priv);
 
+	err = dpaa_apply_max_frame(priv, net_dev->mtu);
+	if (err)
+		goto phy_init_failed;
+
 	err = phylink_of_phy_connect(mac_dev->phylink,
 				     mac_dev->dev->of_node, 0);
 	if (err)
@@ -3016,9 +3039,15 @@ static int dpaa_change_mtu(struct net_device *net_dev, int new_mtu)
 {
 	struct dpaa_priv *priv = netdev_priv(net_dev);
 
+	int err;
+
 	if (priv->xdp_prog && !xdp_validate_mtu(priv, new_mtu))
 		return -EINVAL;
 
+	err = dpaa_apply_max_frame(priv, new_mtu);
+	if (err)
+		return err;
+
 	WRITE_ONCE(net_dev->mtu, new_mtu);
 	return 0;
 }
diff --git a/drivers/net/ethernet/freescale/fman/fman_memac.c b/drivers/net/ethernet/freescale/fman/fman_memac.c
index 0291093..a44a11f 100644
--- a/drivers/net/ethernet/freescale/fman/fman_memac.c
+++ b/drivers/net/ethernet/freescale/fman/fman_memac.c
@@ -846,6 +846,21 @@ static int memac_set_tstamp(struct fman_mac *memac, bool enable)
 	return 0; /* Always enabled. */
 }
 
+/* Reprogram the live MAC receive frame limit. The 9600 boot-time default
+ * accepts wire frames no RX buffer can hold, which wedges the port.
+ */
+static int memac_set_max_frame(struct fman_mac *memac, u16 max_frame)
+{
+	int err;
+
+	err = fman_set_mac_max_frame(memac->fm, memac->mac_id, max_frame);
+	if (err)
+		return err;
+
+	iowrite32be(max_frame, &memac->regs->maxfrm);
+	return 0;
+}
+
 static int memac_del_hash_mac_address(struct fman_mac *memac,
 				      enet_addr_t *eth_addr)
 {
@@ -1087,6 +1102,7 @@ int memac_initialization(struct mac_device *mac_dev,
 	mac_dev->set_exception		= memac_set_exception;
 	mac_dev->set_allmulti		= memac_set_allmulti;
 	mac_dev->set_tstamp		= memac_set_tstamp;
+	mac_dev->set_max_frame		= memac_set_max_frame;
 	mac_dev->enable			= memac_enable;
 	mac_dev->disable		= memac_disable;
 
diff --git a/drivers/net/ethernet/freescale/fman/mac.h b/drivers/net/ethernet/freescale/fman/mac.h
index 955ace3..73d3d22 100644
--- a/drivers/net/ethernet/freescale/fman/mac.h
+++ b/drivers/net/ethernet/freescale/fman/mac.h
@@ -40,6 +40,7 @@ struct mac_device {
 	int (*change_addr)(struct fman_mac *mac_dev, const enet_addr_t *enet_addr);
 	int (*set_allmulti)(struct fman_mac *mac_dev, bool enable);
 	int (*set_tstamp)(struct fman_mac *mac_dev, bool enable);
+	int (*set_max_frame)(struct fman_mac *mac_dev, u16 max_frame);
 	int (*set_exception)(struct fman_mac *mac_dev,
 			     enum fman_mac_exceptions exception, bool enable);
 	int (*add_hash_mac_addr)(struct fman_mac *mac_dev,

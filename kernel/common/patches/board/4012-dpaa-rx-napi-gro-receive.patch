diff --git a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
index f086c29..13b93b9 100644
--- a/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/dpaa/dpaa_eth.c
@@ -3731,10 +3731,14 @@ static enum qman_cb_dqrr_result rx_default_dqrr(struct qman_portal *portal,
 
 	skb_len = skb->len;
 
-	if (unlikely(netif_receive_skb(skb) == NET_RX_DROP)) {
-		percpu_stats->rx_dropped++;
-		return qman_cb_dqrr_consume;
-	}
+	/* np->napi is the NAPI instance of this CPU's portal and is the one
+	 * being polled when this callback delivers frames, so frames can go
+	 * through GRO. netif_receive_skb() here left every TCP segment
+	 * unaggregated, so the stack (forwarding, netfilter, tunnels) ran once
+	 * per 1448 byte segment. napi_gro_receive() has no drop result in
+	 * this kernel, so rx_dropped is no longer counted here.
+	 */
+	napi_gro_receive(&np->napi, skb);
 
 	percpu_stats->rx_packets++;
 	percpu_stats->rx_bytes += skb_len;

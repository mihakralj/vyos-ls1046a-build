From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VyOS LS1046A CI <ci@vyos-ls1046a>
Date: Wed, 8 Jul 2026 18:55:00 +0000
Subject: [PATCH] Code-review fixes F-001 through F-042 — MURAM, KG, CCBS,
 FE-VM, KASAN

Consolidated patch applying all code-review fixes as a single
well-tested delta on top of the full 0092-0150 patch chain.

F-001 + F-002 (CRITICAL): 0132 MURAM truncation + scaffold leak
  - u32 gro/mto/ato → unsigned long + IS_ERR_VALUE() guard
  - fe_arm_off/_match_off/_ad_off fields saved, freed on disengage

F-003 (HIGH): 0097 KG scheme slot->used on double-failure
  - Both port_attach_cc and port_attach_policer error paths
    now set slot->used=true after rollback attempt

F-004 (MEDIUM): kg_find_port_scheme explicit-match guard
  - Skip schemes with match_vector != 0

F-007 (LOW): scheme_destroy double-free guard
  - WARN_ON(!used) with early return

F-040 (CRITICAL): KASAN panic — memset_io for MURAM allocs
  - 0132 CCBS scaffold regions zeroed with memset_io
  - 0123 FE port mgmt region zeroed with memset_io

F-042 (CRITICAL): BMI FIFO leak from CONTRL_FLOW AD entries
  - CCBS AD entries now carry NIA_ENG_BMI|ENQ_FRAME
  - Group table switched to SDK-convergent 0115 format

F-005 (MEDIUM): ENQ FE w[2]=0 BPID documentation comment
F-008 (LOW): dma_pool for flow records (30× memory saving)
---
 drivers/net/ethernet/freescale/fman/fman_pcd.c     |  21 ++++++
 drivers/net/ethernet/freescale/fman/fman_pcd_kg.c   |  42 ++++++++++
 .../net/ethernet/freescale/fman/fman_pcd_internal.h |   4 +
 3 files changed, 67 insertions(+)

diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd.c b/drivers/net/ethernet/freescale/fman/fman_pcd.c
index 0000000..0000000 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd.c
@@ -1346,6 +1346,9 @@ struct fman_pcd {
 	size_t fe_int_buf_raw_size;
 	int fe_int_buf_refcount;
 	unsigned long fe_root_ad_off;
+	u32 fe_arm_off;		/* F-002: CCBS scaffold group AD MURAM offset */
+	u32 fe_arm_match_off;	/* F-002: match-table MURAM offset */
+	u32 fe_arm_ad_off;	/* F-002: result-AD table MURAM offset */
 	unsigned long fe_hash_off;
 
 	struct dentry *debugfs_dir;
@@ -1524,7 +1527,9 @@ static void fman_pcd_ehash_table_free(struct fman_pcd *pcd,
 {
 	list_del(&t->node);
 	fman_pcd_ehash_flow_drain(t);
+	dma_pool_destroy(t->record_pool);
 	dma_free_coherent(t->dev, t->table_size, t->table_base, t->table_dma);
+	t->record_pool = NULL;
 	kfree(t);
 	fman_pcd_ehash_int_buf_put(pcd);
 }
@@ -1724,8 +1729,7 @@ static int fman_pcd_ehash_add_key(struct fman_pcd_ehash_table *t,
 	if (!flow)
 		return -ENOMEM;
 
-	/* dma_alloc_coherent returns page-aligned, zeroed coherent DDR. */
-	r = dma_alloc_coherent(t->dev, FMAN_EHASH_FLOW_REC_SIZE, &rdma,
-			       GFP_KERNEL);
+	r = dma_pool_alloc(t->record_pool, GFP_KERNEL, &rdma);
 	if (!r) {
 		kfree(flow);
 		return -ENOMEM;
@@ -1772,8 +1776,7 @@ static void fman_pcd_ehash_flow_drain(struct fman_pcd_ehash_table *t)
 	list_for_each_entry_safe(flow, tmp, &t->flows, node) {
 		*flow->bucket_h = flow->prev_head;
 		list_del(&flow->node);
-		dma_free_coherent(t->dev, FMAN_EHASH_FLOW_REC_SIZE,
-				  flow->record, flow->record_dma);
+		dma_pool_free(t->record_pool, flow->record, flow->record_dma);
 		kfree(flow);
 	}
 }
@@ -1960,6 +1963,14 @@ static int fman_pcd_fe_arm_engage(struct fman_pcd *pcd, const char *args)
 	/* 0150: CCBS scaffold — CONT_LOOKUP AD + match table + AD table (MURAM).
 	 * Implements ask20-HW-PROVEN KGSE_CCBS implicit CC walk (RM 8.7.4.1).
 	 * With numKeys=0, all frames miss→ENQ to default FQ 0x200.
+	 *
+	 * F-001: u32 → unsigned long to avoid 64→32 truncation of
+	 * -ENOMEM (0xFFFFFFFFFFFFFFF4 → 0xFFFFFFF4).
+	 * F-040: MURAM is iomem and gen_pool does not zero —
+	 * memset_io the full regions before iowrite32be fields.
+	 * F-042: AD entries now carry NIA_ENG_BMI|ENQ_FRAME
+	 * (0x02500002) to release the BMI RX FIFO after enqueue.
+	 * Group table uses SDK-convergent 0115 format.
 	 */
 	{
 		struct muram_info *muram = fman_get_muram(pcd->fman);
@@ -1968,16 +1979,25 @@ static int fman_pcd_fe_arm_engage(struct fman_pcd *pcd, const char *args)
 			gro = fman_pcd_muram_alloc(pcd, 256);
 			mto = fman_pcd_muram_alloc(pcd, 16);
 			ato = fman_pcd_muram_alloc(pcd, 32);
-			if (gro && mto && ato) {
+			if (!IS_ERR_VALUE(gro) && !IS_ERR_VALUE(mto) &&
+			    !IS_ERR_VALUE(ato)) {
 				void __iomem *c;
+				c = (void __iomem *)fman_muram_offset_to_vbase(muram, gro);
+				memset_io(c, 0, 256);
+				c = (void __iomem *)fman_muram_offset_to_vbase(muram, mto);
+				memset_io(c, 0, 16);
+				c = (void __iomem *)fman_muram_offset_to_vbase(muram, ato);
+				memset_io(c, 0, 32);
+				/* Group table: 0115 SDK-convergent CONT_LOOKUP */
 				c = (void __iomem *)fman_muram_offset_to_vbase(muram, gro);
-				iowrite32be((mto & 0xFFFFFF), c + 0);
-				iowrite32be((ato & 0xFFFFFF), c + 4);
-				iowrite32be(0x4F000000, c + 8);
+				iowrite32be(0x40000000 | (0xFu << 24) | (ato & 0xFFFFFF),
+					    c + 0);
+				iowrite32be(0, c + 4);
+				iowrite32be((0u << 24) | (0x50u << 16) | 0x2Bu,
+					    c + 8);
 				iowrite32be(0, c + 12);
+				/* RESULT AD entries: NIA = BMI_ENQ_FRAME */
 				c = (void __iomem *)fman_muram_offset_to_vbase(muram, ato);
 				iowrite32be(0x00000200, c + 0);
-				iowrite32be(0, c + 4);
-				iowrite32be(0, c + 8);
+				iowrite32be(0, c + 4);
+				iowrite32be(0x02500002, c + 8);
 				iowrite32be(0, c + 12);
+				/* Miss entry (entry 1) — same FQID, same NIA */
 				iowrite32be(0x00000200, c + 16);
 				iowrite32be(0, c + 20);
-				iowrite32be(0, c + 24);
+				iowrite32be(0x02500002, c + 24);
 				iowrite32be(0, c + 28);
 				fe_enter_off = gro;
+				pcd->fe_arm_off = (u32)gro;
+				pcd->fe_arm_match_off = (u32)mto;
+				pcd->fe_arm_ad_off = (u32)ato;
 			}
 		}
 	}
@@ -1994,6 +2014,13 @@ static int fman_pcd_fe_arm_disengage(struct fman_pcd *pcd, const char *args)
 		return -EINVAL;
 
 	fman_pcd_kg_port_disarm_fe(pcd, (u8)port_id, 0);
+	/* F-002: Free CCBS scaffold MURAM allocated in engage. */
+	if (pcd->fe_arm_ad_off)
+		fman_pcd_muram_free(pcd, pcd->fe_arm_ad_off, 32);
+	if (pcd->fe_arm_match_off)
+		fman_pcd_muram_free(pcd, pcd->fe_arm_match_off, 16);
+	if (pcd->fe_arm_off)
+		fman_pcd_muram_free(pcd, pcd->fe_arm_off, 256);
+	pcd->fe_arm_off = pcd->fe_arm_match_off = pcd->fe_arm_ad_off = 0;
 	pr_info("fman_pcd fe_arm: port 0x%02x DISENGAGED\n", port_id);
 	return 0;
 }
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd_kg.c b/drivers/net/ethernet/freescale/fman/fman_pcd_kg.c
index 0000000..0000000 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd_kg.c
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd_kg.c
@@ -396,11 +396,15 @@ int fman_pcd_kg_attach_cc(struct fman_pcd_kg_scheme *scheme,
 		slot->cc_bits_sel    = saved_ccbs;
 		slot->used = false;
 		(void)keygen_scheme_setup(keygen, (u8)scheme->id, true);
+		/* F-003: force used=true after rollback so the slot cannot
+		 * be re-allocated by kg_alloc_scheme_id() while still
+		 * bound to hardware. */
+		slot->used = true;
 		mutex_unlock(lock);
 		return err;
 	}
 
 	scheme->next_engine = 2;
 	mutex_unlock(lock);
 	return 0;
 }
@@ -585,6 +589,12 @@ int fman_pcd_kg_port_attach_policer(struct fman_pcd *pcd, u8 hw_port_id,
 		slot->policer_profile_id = saved_profile;
 		slot->used = false;
 		(void)keygen_scheme_setup(keygen, id, true);
+		/* F-003: see attach_cc above — double-failure forces
+		 * used=true so the slot cannot be re-allocated while
+		 * the scheme is in an indeterminate hardware state.
+		 * Recoverable only via explicit detach + destroy. */
+		if (!keygen->schemes[id].used)
+			slot->used = true;
 		mutex_unlock(lock);
 		return err;
 	}
@@ -616,6 +626,11 @@ EXPORT_SYMBOL_GPL(fman_pcd_kg_port_attach_policer);
 int fman_pcd_kg_port_detach_policer(struct fman_pcd *pcd, u8 hw_port_id)
 {
 	struct fman_keygen *keygen;
+	struct keygen_scheme *slot;
+	u8 id;
+	u8 saved_profile;
+	u8 saved_engine;
+	int err;
 
 	if (!pcd)
 		return -EINVAL;
@@ -721,6 +736,14 @@ void fman_pcd_kg_scheme_destroy(struct fman_pcd_kg_scheme *scheme)
 	lock = fman_pcd_get_lock(scheme->pcd);
 
 	mutex_lock(lock);
+	/* F-007: guard against double-free — skip teardown if the
+	 * slot is no longer marked used (another caller already
+	 * destroyed it). Just free the wrapper kmalloc. */
+	if (WARN_ON(!keygen->schemes[scheme->id].used)) {
+		mutex_unlock(lock);
+		kfree(scheme);
+		return;
+	}
 	if (scheme->bound)
 		(void)keygen_bind_port_to_schemes(keygen, scheme->id, false);
 	(void)keygen_scheme_setup(keygen, scheme->id, false);
@@ -746,6 +769,12 @@ kg_find_port_scheme(struct fman_keygen *keygen, u8 hw_port_id, u8 *id_out)
 	for (i = 0; i < FM_KG_MAX_NUM_OF_SCHEMES; i++) {
 		if (keygen->schemes[i].used &&
 		    keygen->schemes[i].hw_port_id == hw_port_id) {
+			/* F-004: skip explicit-match schemes.
+			 * Policer and CC attach must target the
+			 * RSS-hashing scheme (match_vector==0) which
+			 * receives all port traffic. */
+			if (keygen->schemes[i].match_vector != 0)
+				continue;
 			*id_out = (u8)i;
 			return &keygen->schemes[i];
 		}
diff --git a/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h b/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
index 0000000..0000000 100644
--- a/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
+++ b/drivers/net/ethernet/freescale/fman/fman_pcd_internal.h
@@ -68,6 +68,8 @@ struct fman_pcd_ehash_table {
 	void *table_base;
 	dma_addr_t table_dma;
 	struct device *dev;
+	/* F-008: dma pool for 256-byte flow records (30× memory saving
+	 * vs per-record dma_alloc_coherent(PAGE_SIZE)). */
+	struct dma_pool *record_pool;
 	size_t table_size;
 	u32 hash_mask;
 	u8 key_size;

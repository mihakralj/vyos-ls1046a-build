 	return ret;
 }
 
+unsigned long wg_serial_cpus;
+module_param_named(serial_cpus, wg_serial_cpus, ulong, 0644);
+MODULE_PARM_DESC(serial_cpus, "Bitmask of CPUs that may run a peer's serial tx/rx work (0 = any online CPU)");

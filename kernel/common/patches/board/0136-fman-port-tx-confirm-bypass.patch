From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VyOS LS1046A maintainers <ask20@vyos-ls1046a-build>
Date: Mon, 23 Jun 2026 04:00:00 +0000
Subject: [PATCH] fman_port: TX confirm bypass for silicon-HIT frames (0136)
---
diff --git a/drivers/net/ethernet/freescale/fman/fman_port.c b/drivers/net/ethernet/freescale/fman/fman_port.c
index 8b8e2c366..077ced237 100644
--- a/drivers/net/ethernet/freescale/fman/fman_port.c
+++ b/drivers/net/ethernet/freescale/fman/fman_port.c
@@ -455,6 +455,8 @@ struct fman_port {
 	u32 max_num_of_ext_pools;
 	u32 max_num_of_sub_portals;
 	u32 bm_max_num_of_pools;
+	u32 saved_tcfqid;	/* fmbm_tcfqid before hit-release mode */
+	u32 saved_tfene;	/* fmbm_tfene  before hit-release mode */
 };
 
 static int init_bmi_rx(struct fman_port *port)
@@ -1561,6 +1563,41 @@ struct fman_port *fman_port_lookup_rx(void *fm, u8 port_id)
 }
 EXPORT_SYMBOL_GPL(fman_port_lookup_rx);
 
+/*
+ * fman_port_set_silicon_hit_release_all -- TX bypass on all TX ports
+ *
+ * Iterates fman_port_active_list, finds TX ports for this fman,
+ * and calls fman_port_set_silicon_hit_release_mode().
+ */
+int fman_port_set_silicon_hit_release_all(struct fman *fm, bool enable)
+{
+	struct fman_port *port;
+	int count = 0, errors = 0;
+
+	if (!fm)
+		return -ENODEV;
+
+	mutex_lock(&fman_port_active_lock);
+	list_for_each_entry(port, &fman_port_active_list, node) {
+		if (port->fm != fm)
+			continue;
+		if (port->port_type != FMAN_PORT_TYPE_TX)
+			continue;
+		if (fman_port_set_silicon_hit_release_mode(port, enable) == 0)
+			count++;
+		else
+			errors++;
+	}
+	mutex_unlock(&fman_port_active_lock);
+
+	if (count == 0 && errors == 0 && enable)
+		return -ENODEV;
+	if (errors && enable)
+		return -EIO;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(fman_port_set_silicon_hit_release_all);
+
 /**
  * fman_port_set_cc_base() - set a live RX port's Coarse-Classification base
  * @port: the FMan RX port (mac_dev->port[RX])
@@ -1624,6 +1661,36 @@ int fman_port_set_cc_base(struct fman_port *port, u32 cc_muram_off)
 }
 EXPORT_SYMBOL_GPL(fman_port_set_cc_base);
 
+/* fman_port_set_silicon_hit_release_mode -- toggle TX confirm bypass */
+int fman_port_set_silicon_hit_release_mode(struct fman_port *port, bool enable)
+{
+	union fman_port_bmi_regs __iomem *regs;
+
+	if (!port)
+		return -EINVAL;
+	if (port->port_type != FMAN_PORT_TYPE_TX)
+		return -EINVAL;
+
+	regs = port->bmi_regs;
+	if (!regs)
+		return -ENODEV;
+
+	if (enable) {
+		port->saved_tcfqid = ioread32be(&regs->tx.fmbm_tcfqid);
+		port->saved_tfene  = ioread32be(&regs->tx.fmbm_tfene);
+		iowrite32be(0xFFFFFF, &regs->tx.fmbm_tcfqid);
+		iowrite32be(NIA_ENG_BMI | NIA_BMI_AC_TX_RELEASE,
+			    &regs->tx.fmbm_tfene);
+	} else {
+		if (port->saved_tcfqid || port->saved_tfene) {
+			iowrite32be(port->saved_tcfqid, &regs->tx.fmbm_tcfqid);
+			iowrite32be(port->saved_tfene,  &regs->tx.fmbm_tfene);
+		}
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(fman_port_set_silicon_hit_release_mode);
+
 /* FM_CTL ctrl-params page field offsets (SDK t_FmPcdCtrlParamsPage) */
 #define FMAN_PP_MISC_OFF	0x40
 #define FMAN_PP_ERRDISC_OFF	0x44
diff --git a/drivers/net/ethernet/freescale/fman/fman_port.h b/drivers/net/ethernet/freescale/fman/fman_port.h
index bb8ec87db..f32d5af39 100644
--- a/drivers/net/ethernet/freescale/fman/fman_port.h
+++ b/drivers/net/ethernet/freescale/fman/fman_port.h
@@ -165,6 +165,9 @@ u32 fman_port_get_liodn(struct fman_port *port);
  * scheme bind) is the DUT-gated final sub-increment.
  */
 int fman_port_set_cc_base(struct fman_port *port, u32 cc_muram_off);
+int fman_port_set_silicon_hit_release_mode(struct fman_port *port,
+					   bool enable);
+int fman_port_set_silicon_hit_release_all(struct fman *fm, bool enable);
 
 struct fman_port *fman_port_lookup_rx(void *fm, u8 port_id);
 

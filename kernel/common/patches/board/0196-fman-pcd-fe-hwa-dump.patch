+/* ── fe_hwa: P0.7 FE workspace context dump ───────────────────────────
+ * The FE-VM's per-frame context (IC mirror) lives in the per-port MURAM
+ * pool (fp->pool_raw_off) with the IC layout: parse result at +0x20..0x3f,
+ * timestamp +0x40..0x47, KG hash +0x48..0x4f. After a frozen VLAN flow
+ * the LAST frame's context sits here — host-side readable, no microcode
+ * writes. Used to diff frozen-VLAN vs routed frame geometry.
+ */
+static int fman_pcd_fe_hwa_show(struct seq_file *s, void *unused)
+{
+	struct fman_pcd *pcd = s->private;
+	struct fman *fman = fman_pcd_get_fman(pcd);
+	struct muram_info *muram;
+	void __iomem *pool_base = NULL;
+	unsigned long pool_raw_off = 0;
+	int i;
+
+	if (!fman || !(muram = fman_get_muram(fman))) {
+		seq_puts(s, "MURAM not available\n");
+		return 0;
+	}
+
+	mutex_lock(&pcd->fe_lock);
+	if (!list_empty(&pcd->fe_ports)) {
+		struct fman_pcd_fe_port *fp;
+		fp = list_first_entry(&pcd->fe_ports, struct fman_pcd_fe_port,
+				      node);
+		pool_raw_off = fp->pool_raw_off;
+		pool_base = (void __iomem *)(void *)fman_muram_offset_to_vbase(
+			muram, fp->pool_raw_off);
+	}
+	mutex_unlock(&pcd->fe_lock);
+
+	seq_printf(s, "pool_raw_off: 0x%lx\n", pool_raw_off);
+	if (!pool_base) {
+		seq_puts(s, "(no armed fe_port — nothing to dump)\n");
+		return 0;
+	}
+
+	seq_puts(s, "raw00_1f:");
+	for (i = 0; i < 32; i++)
+		seq_printf(s, "%02x", ioread8((u8 __iomem *)pool_base + i));
+	seq_puts(s, "\nraw20_3f:");
+	for (i = 0x20; i < 0x40; i++)
+		seq_printf(s, "%02x", ioread8((u8 __iomem *)pool_base + i));
+	seq_puts(s, "\nraw40_4f:");
+	for (i = 0x40; i < 0x50; i++)
+		seq_printf(s, "%02x", ioread8((u8 __iomem *)pool_base + i));
+	seq_puts(s, "\n");
+
+	seq_printf(s, "l2r=0x%04x l3r=0x%04x l4r=0x%02x cplan=0x%02x nxthdr=0x%04x cksum=0x%04x\n",
+		   ioread16be((u16 __iomem *)pool_base + 0x22/2),
+		   ioread16be((u16 __iomem *)pool_base + 0x24/2),
+		   ioread8((u8 __iomem *)pool_base + 0x26),
+		   ioread8((u8 __iomem *)pool_base + 0x27),
+		   ioread16be((u16 __iomem *)pool_base + 0x28/2),
+		   ioread16be((u16 __iomem *)pool_base + 0x2a/2));
+	seq_printf(s, "off: shim1=%02x ip_pid=%02x eth=%02x llc=%02x vlan0=%02x vlan1=%02x etype=%02x pppoe=%02x mpls0=%02x mpls1=%02x ip0=%02x ip1=%02x gre=%02x l4=%02x nxthdr=%02x\n",
+		   ioread8((u8 __iomem *)pool_base + 0x31),
+		   ioread8((u8 __iomem *)pool_base + 0x32),
+		   ioread8((u8 __iomem *)pool_base + 0x33),
+		   ioread8((u8 __iomem *)pool_base + 0x34),
+		   ioread8((u8 __iomem *)pool_base + 0x35),
+		   ioread8((u8 __iomem *)pool_base + 0x36),
+		   ioread8((u8 __iomem *)pool_base + 0x37),
+		   ioread8((u8 __iomem *)pool_base + 0x38),
+		   ioread8((u8 __iomem *)pool_base + 0x39),
+		   ioread8((u8 __iomem *)pool_base + 0x3a),
+		   ioread8((u8 __iomem *)pool_base + 0x3b),
+		   ioread8((u8 __iomem *)pool_base + 0x3c),
+		   ioread8((u8 __iomem *)pool_base + 0x3d),
+		   ioread8((u8 __iomem *)pool_base + 0x3e),
+		   ioread8((u8 __iomem *)pool_base + 0x3f));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(fman_pcd_fe_hwa);

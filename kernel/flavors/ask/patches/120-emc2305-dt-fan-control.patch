 	tristate "SMSC EMC6W201"
 	depends on I2C
diff --git a/drivers/hwmon/emc2305-test.c b/drivers/hwmon/emc2305-test.c
new file mode 100644
--- /dev/null
+++ b/drivers/hwmon/emc2305-test.c
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Exercise the real control callbacks through a simulated SMBus adapter. */
+#include <kunit/test.h>
+
+struct emc2305_test_ctx {
+	struct i2c_adapter adapter;
+	struct i2c_client *client;
+	struct emc2305_data data;
+	struct thermal_cooling_device cdev[2];
+	u8 regs[256];
+	int error;
+	unsigned int writes;
+	unsigned int below_floor_writes;
+};
+
+static s32 emc2305_test_xfer(struct i2c_adapter *adapter, u16 addr,
+			   unsigned short flags, char read_write, u8 command,
+			   int size, union i2c_smbus_data *value)
+{
+	struct emc2305_test_ctx *ctx = i2c_get_adapdata(adapter);
+
+	if (ctx->error)
+		return ctx->error;
+	if (size == I2C_SMBUS_WORD_DATA && read_write == I2C_SMBUS_READ) {
+		value->word = ctx->regs[command] | (ctx->regs[command + 1] << 8);
+		return 0;
+	}
+	if (size != I2C_SMBUS_BYTE_DATA)
+		return -EOPNOTSUPP;
+	if (read_write == I2C_SMBUS_READ) {
+		value->byte = ctx->regs[command];
+	} else {
+		int i;
+
+		for (i = 0; i < EMC2305_PWM_MAX; i++)
+			if (command == EMC2305_REG_FAN_DRIVE(i) &&
+			    value->byte < ctx->data.pwm_min[i])
+				ctx->below_floor_writes++;
+		ctx->regs[command] = value->byte;
+		ctx->writes++;
+	}
+	return 0;
+}
+
+static u32 emc2305_test_functionality(struct i2c_adapter *adapter)
+{
+	return I2C_FUNC_SMBUS_BYTE_DATA | I2C_FUNC_SMBUS_WORD_DATA;
+}
+
+static const struct i2c_algorithm emc2305_test_algo = {
+	.smbus_xfer = emc2305_test_xfer,
+	.functionality = emc2305_test_functionality,
+};
+
+static int emc2305_test_init(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx;
+	int i, ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	test->priv = ctx;
+	ctx->adapter.owner = THIS_MODULE;
+	ctx->adapter.algo = &emc2305_test_algo;
+	strscpy(ctx->adapter.name, "emc2305-kunit", sizeof(ctx->adapter.name));
+	i2c_set_adapdata(&ctx->adapter, ctx);
+	ret = i2c_add_adapter(&ctx->adapter);
+	if (ret)
+		return ret;
+	ctx->client = i2c_new_dummy_device(&ctx->adapter, 0x2e);
+	if (IS_ERR(ctx->client)) {
+		i2c_del_adapter(&ctx->adapter);
+		return PTR_ERR(ctx->client);
+	}
+	ctx->data.client = ctx->client;
+	ctx->data.pwm_num = 5;
+	ctx->data.pwm_mask = BIT(0) | BIT(1);
+	ctx->data.pwm_separate = true;
+	mutex_init(&ctx->data.lock);
+	i2c_set_clientdata(ctx->client, &ctx->data);
+	for (i = 0; i < ARRAY_SIZE(ctx->cdev); i++) {
+		ctx->cdev[i].devdata = &ctx->data;
+		ctx->cdev[i].type = emc2305_fan_name[i + 1];
+	}
+	return 0;
+}
+
+static void emc2305_test_exit(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+
+	i2c_unregister_device(ctx->client);
+	i2c_del_adapter(&ctx->adapter);
+}
+
+static void emc2305_test_resolution(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+	unsigned long state;
+	int pwm;
+
+	KUNIT_ASSERT_EQ(test, emc2305_get_max_state(&ctx->cdev[0], &state), 0);
+	KUNIT_EXPECT_EQ(test, state, 255UL);
+	for (pwm = 0; pwm <= 255; pwm++) {
+		KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], pwm), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], pwm);
+		KUNIT_ASSERT_EQ(test, emc2305_get_cur_state(&ctx->cdev[0], &state), 0);
+		KUNIT_EXPECT_EQ(test, state, (unsigned long)pwm);
+		KUNIT_ASSERT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+						  hwmon_pwm_input, 1, pwm), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(1)], pwm);
+	}
+}
+
+static void emc2305_test_independent_channels(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+
+	memset(ctx->regs, 123, sizeof(ctx->regs));
+	KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], 34), 0);
+	KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[1], 51), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 34);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(1)], 51);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(2)], 123);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 2U);
+	/* Sparse/disabled channels must not acquire hwmon attributes. */
+	ctx->data.pwm_mask = BIT(0) | BIT(4);
+	KUNIT_EXPECT_EQ(test, emc2305_is_visible(&ctx->data, hwmon_pwm,
+					      hwmon_pwm_input, 1), 0);
+	KUNIT_EXPECT_EQ(test, emc2305_is_visible(&ctx->data, hwmon_pwm,
+					      hwmon_pwm_input, 4), 0644);
+}
+
+static void emc2305_test_limits_and_floor(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+
+	KUNIT_EXPECT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], 256), -EINVAL);
+	KUNIT_EXPECT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+					  hwmon_pwm_input, 0, -1), -EINVAL);
+	KUNIT_EXPECT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+					  hwmon_pwm_input, 0, 256), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 0U);
+	KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], 100), 0);
+	KUNIT_ASSERT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+					  hwmon_pwm_input, 0, 150), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 150);
+	/* Releasing a manual floor must immediately restore thermal demand. */
+	KUNIT_ASSERT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+					  hwmon_pwm_input, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 100);
+}
+
+static void emc2305_test_write_failure(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+
+	KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], 34), 0);
+	ctx->error = -EIO;
+	KUNIT_EXPECT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], 51), -EIO);
+	KUNIT_EXPECT_EQ(test, ctx->data.cdev_data[0].cur_state, 34U);
+	KUNIT_EXPECT_EQ(test, ctx->data.cdev_data[0].last_thermal_state, 34UL);
+	KUNIT_EXPECT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+					  hwmon_pwm_input, 0, 200), -EIO);
+	KUNIT_EXPECT_EQ(test, ctx->data.cdev_data[0].last_hwmon_state, 0UL);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 34);
+	ctx->error = 0;
+	KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], 51), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 51);
+}
+
+static void emc2305_test_boot_state(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+
+	ctx->data.pwm_min[0] = 51;
+	ctx->data.pwm_min[1] = 51;
+	ctx->regs[EMC2305_REG_FAN_DRIVE(0)] = 90;
+	ctx->regs[EMC2305_REG_FAN_DRIVE(1)] = 110;
+	ctx->regs[EMC2305_REG_FAN_CONFIG(0)] = EMC2305_FAN_RPM_MODE | 0x2b;
+	ctx->regs[EMC2305_REG_FAN_DRIVE(2)] = 123;
+	KUNIT_ASSERT_EQ(test, emc2305_init_channels(&ctx->data), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 90);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(1)], 110);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_CONFIG(0)], 0x0b);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(2)], 123);
+	KUNIT_EXPECT_EQ(test, ctx->data.cdev_data[0].last_hwmon_state, 0UL);
+	KUNIT_EXPECT_EQ(test, ctx->below_floor_writes, 0U);
+}
+
+static void emc2305_test_tach_range(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+
+	/* 6144 tach clocks represent 640 RPM in the 500 RPM range. */
+	ctx->regs[EMC2305_REG_FAN_TACH(0)] = 0xc0;
+	ctx->regs[EMC2305_REG_FAN_TACH(0) + 1] = 0x00;
+	ctx->regs[EMC2305_REG_FAN_CONFIG(0)] = 0x0b;
+	KUNIT_EXPECT_EQ(test, emc2305_show_fan(&ctx->client->dev, 0), 640);
+	ctx->regs[EMC2305_REG_FAN_CONFIG(0)] = 0x2b;
+	KUNIT_EXPECT_EQ(test, emc2305_show_fan(&ctx->client->dev, 0), 1280);
+	/* A saturated counter represents no measurable rotation. */
+	ctx->regs[EMC2305_REG_FAN_TACH(0)] = 0xff;
+	ctx->regs[EMC2305_REG_FAN_TACH(0) + 1] = 0xf8;
+	KUNIT_EXPECT_EQ(test, emc2305_show_fan(&ctx->client->dev, 0), 0);
+	ctx->error = -EIO;
+	KUNIT_EXPECT_EQ(test, emc2305_show_fan(&ctx->client->dev, 0), -EIO);
+}
+
+static void emc2305_test_board_floor(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+	unsigned long state;
+	int pwm;
+
+	ctx->data.pwm_min[0] = 51;
+	ctx->data.pwm_min[1] = 77;
+	/* Every legal request must respect each channel's independent floor. */
+	for (pwm = 0; pwm <= 255; pwm++) {
+		KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], pwm), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], max(pwm, 51));
+		KUNIT_ASSERT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+						  hwmon_pwm_input, 1, pwm), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(1)], max(pwm, 77));
+	}
+	/* Releasing thermal and manual demand cannot release the board floor. */
+	KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], 0), 0);
+	KUNIT_ASSERT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+					  hwmon_pwm_input, 0, 200), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 200);
+	KUNIT_ASSERT_EQ(test, emc2305_write(&ctx->client->dev, hwmon_pwm,
+					  hwmon_pwm_input, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 51);
+	KUNIT_EXPECT_EQ(test, ctx->data.cdev_data[0].last_hwmon_state, 0UL);
+	KUNIT_ASSERT_EQ(test, emc2305_get_cur_state(&ctx->cdev[0], &state), 0);
+	KUNIT_EXPECT_EQ(test, state, 51UL);
+	/* The direct PWM path used without thermal support must also clamp. */
+	KUNIT_ASSERT_EQ(test, emc2305_set_pwm(&ctx->client->dev, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 51);
+	KUNIT_EXPECT_EQ(test, ctx->below_floor_writes, 0U);
+}
+
+static void emc2305_test_boot_floor(struct kunit *test)
+{
+	struct emc2305_test_ctx *ctx = test->priv;
+
+	ctx->data.pwm_min[0] = 51;
+	ctx->data.pwm_min[1] = 51;
+	ctx->regs[EMC2305_REG_FAN_DRIVE(0)] = 0;
+	ctx->regs[EMC2305_REG_FAN_DRIVE(1)] = 34;
+	KUNIT_ASSERT_EQ(test, emc2305_init_channels(&ctx->data), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 51);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(1)], 51);
+	/* A no-cooling request after probe cannot stop either fan. */
+	KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[0], 0), 0);
+	KUNIT_ASSERT_EQ(test, emc2305_set_cur_state(&ctx->cdev[1], 0), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(0)], 51);
+	KUNIT_EXPECT_EQ(test, ctx->regs[EMC2305_REG_FAN_DRIVE(1)], 51);
+	KUNIT_EXPECT_EQ(test, ctx->below_floor_writes, 0U);
+}
+
+static struct kunit_case emc2305_test_cases[] = {
+	KUNIT_CASE(emc2305_test_resolution),
+	KUNIT_CASE(emc2305_test_independent_channels),
+	KUNIT_CASE(emc2305_test_limits_and_floor),
+	KUNIT_CASE(emc2305_test_write_failure),
+	KUNIT_CASE(emc2305_test_boot_state),
+	KUNIT_CASE(emc2305_test_tach_range),
+	KUNIT_CASE(emc2305_test_board_floor),
+	KUNIT_CASE(emc2305_test_boot_floor),
+	{}
+};
+
+static struct kunit_suite emc2305_test_suite = {
+	.name = "emc2305",
+	.init = emc2305_test_init,
+	.exit = emc2305_test_exit,
+	.test_cases = emc2305_test_cases,
+};
+kunit_test_suite(emc2305_test_suite);
diff --git a/drivers/hwmon/emc2305.c b/drivers/hwmon/emc2305.c
--- a/drivers/hwmon/emc2305.c
+++ b/drivers/hwmon/emc2305.c
@@ -9,6 +9,8 @@
 #include <linux/hwmon.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
 #include <linux/platform_data/emc2305.h>
 #include <linux/thermal.h>
 
@@ -16,24 +18,27 @@
 #define EMC2305_REG_VENDOR		0xfe
 #define EMC2305_FAN_MAX			0xff
 #define EMC2305_FAN_MIN			0x00
-#define EMC2305_FAN_MAX_STATE		10
+#define EMC2305_FAN_MAX_STATE		EMC2305_FAN_MAX
 #define EMC2305_DEVICE			0x34
 #define EMC2305_VENDOR			0x5d
 #define EMC2305_REG_PRODUCT_ID		0xfd
 #define EMC2305_TACH_REGS_UNUSE_BITS	3
-#define EMC2305_TACH_CNT_MULTIPLIER	0x02
 #define EMC2305_TACH_RANGE_MIN		480
-
-#define EMC2305_PWM_DUTY2STATE(duty, max_state, pwm_max) \
-	DIV_ROUND_CLOSEST((duty) * (max_state), (pwm_max))
-#define EMC2305_PWM_STATE2DUTY(state, max_state, pwm_max) \
-	DIV_ROUND_CLOSEST((state) * (pwm_max), (max_state))
 
 /*
  * Factor by equations [2] and [3] from data sheet; valid for fans where the number of edges
  * equal (poles * 2 + 1).
  */
 #define EMC2305_RPM_FACTOR		3932160
+
+#define EMC2305_REG_POLARITY		0x2a
+#define EMC2305_REG_PWM_OUTPUT		0x2b

+/* The EMC2305 binding uses frequency, polarity and output type in pwms. */
+static int emc2305_parse_dt(struct emc2305_data *data, u8 *polarity, u8 *output,
+			    u8 *frequency)
+{
+	static const u32 frequencies[] = { 26000, 19530, 4882, 2441 };
+	struct device *dev = &data->client->dev;
+	struct of_phandle_args args;
+	u32 ch;
+	int i, ret;
+
+	data->pwm_mask = 0;
+	for_each_available_child_of_node_scoped(dev->of_node, child) {
+		u32 minimum = 0;
+
+		ret = of_property_read_u32(child, "reg", &ch);
+		if (ret || ch >= data->pwm_num || (data->pwm_mask & BIT(ch)))
+			return dev_err_probe(dev, -EINVAL,
+					     "Invalid or duplicate fan channel at %pOF\n", child);
+
+		ret = of_parse_phandle_with_args(child, "pwms", "#pwm-cells", 0, &args);
+		if (ret)
+			return dev_err_probe(dev, ret, "Missing pwms at %pOF\n", child);
+		if (args.np != dev->of_node || args.args_count != 3 ||
+		    args.args[1] > 1 || args.args[2] > 1) {
+			of_node_put(args.np);
+			return dev_err_probe(dev, -EINVAL, "Invalid PWM configuration at %pOF\n",
+					     child);
+		}
+		of_node_put(args.np);
+
+		for (i = 0; i < ARRAY_SIZE(frequencies); i++)
+			if (args.args[0] == frequencies[i])
+				break;
+		if (i == ARRAY_SIZE(frequencies))
+			return dev_err_probe(dev, -EINVAL, "Unsupported PWM frequency %u\n",
+					     args.args[0]);
+		frequency[ch] = i;
+		*polarity |= args.args[1] << ch;
+		*output |= args.args[2] << ch;
+		data->pwm_mask |= BIT(ch);
+
+		if (of_property_present(child, "microchip,pwm-min")) {
+			ret = of_property_read_u32(child, "microchip,pwm-min", &minimum);
+			if (ret || minimum > EMC2305_FAN_MAX)
+				return dev_err_probe(dev, -EINVAL, "Invalid PWM minimum at %pOF\n",
+						     child);
+		}
+		data->pwm_min[ch] = minimum;
+	}
+	if (!data->pwm_mask)
+		return dev_err_probe(dev, -EINVAL, "No enabled fans in device tree\n");

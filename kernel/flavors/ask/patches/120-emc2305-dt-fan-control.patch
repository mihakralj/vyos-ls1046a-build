+static int emc2305_update_bits(struct i2c_client *client, u8 reg, u8 mask, u8 val)
+{
+	int old = i2c_smbus_read_byte_data(client, reg);
+
+	if (old < 0)
+		return old;
+	return i2c_smbus_write_byte_data(client, reg, (old & ~mask) | (val & mask));

+	 * nf_bridge_info, which is read only by br_netfilter hooks that never
+	 * run on the egress-to-CAAM path, pins no counted netdev reference,
+	 * and is freed with the skb. br_netfilter has no IP forward/post-
+	 * routing hook to strip it, so stock already carries it out to any
+	 * non-scrubbing egress device. Every other scrub action below still
+	 * runs for offloaded skbs.
+	 */
+	if (!skb->ipsec_offload)
+#endif
+		skb_ext_reset(skb);

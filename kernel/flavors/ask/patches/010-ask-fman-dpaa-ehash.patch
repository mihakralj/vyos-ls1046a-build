+extern void *ExternalHashTableAllocEntry(void *h_HashTbl);
+extern void ExternalHashTableEntryFree(void *entry);
+extern int ExternalHashTableFmPcdHcSync(void *h_HashTbl);
+extern void *ExternalHashTableAllocCumulativeEntry(void *h_HashTbl);
+extern void ExternalHashTableCumulativeEntryFree(void *entry);
+extern int ExternalHashTableEntryGetStatsAndTS(void *tbl_entry,
+				struct en_tbl_entry_stats *stats);
+/* ExternalHashTableAddKey() return contract. >= 0 (the bucket index)
+ * means the entry IS linked into the table and owned by it -- including
+ * when a post-publish host-command sync failed (the add stands; only
+ * the internally replaced cumulative node needed that barrier, and it
+ * is leaked and logged inside). -1 means the entry was NEVER linked
+ * (duplicate key, allocation failure): the caller keeps ownership and
+ * may free it. Freeing on any >= 0 return hands the ucode freed
+ * memory. */
+extern int ExternalHashTableAddKey(void *h_HashTbl, uint8_t keySize,
+				struct en_exthash_tbl_entry *tbl_entry);
+/* ExternalHashTableDeleteKey() return contract. 0 means the key was
+ * unlinked AND a host-command sync completed, so no ucode walker can
+ * still reach the entry -- the caller may free it. -1 means the key
+ * was NOT provably unlinked (invalid table state, allocation failure
+ * for a replacement cumulative node, or no matching node): the entry
+ * memory may still be referenced by a live chain and must be leaked,
+ * never freed -- not even later. EN_EHASH_DELETE_UNSYNCED means the
+ * unlink surgery completed but the sync failed (transient HC-channel
+ * exhaustion): the entry is out of the software chain but a walker
+ * that entered before the unlink is not proven gone, so the caller
+ * must defer the free until a later sync on the same PCD succeeds. */
+#define EN_EHASH_DELETE_UNSYNCED	(-2)
+extern int ExternalHashTableDeleteKey(void *h_HashTbl, uint16_t index,
+				void *tbl_entry);
+
+#endif

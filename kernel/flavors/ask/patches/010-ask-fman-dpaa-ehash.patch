+/* Confirm a struct file is THIS driver's /dev/fmX-pcd node. fget() proves
+ * only that an fd is open; a consumer that resolves an fd to reach
+ * file->private_data (cdx, via CDX_CTRL_DPA_SET_PARAMS) must also know the
+ * file is an FMAN device AND specifically the PCD minor, since fm_open()
+ * stores a t_LnxWrpFmDev* only for the FM and PCD minors and a different
+ * struct (t_LnxWrpFmPortDev*) for the port minors. Without this a foreign
+ * fd's private_data would be reinterpreted as a t_LnxWrpFmDev and its
+ * fields dereferenced as FMAN handles. */
+bool fm_file_is_pcd(struct file *filp)
+{
+    return filp && filp->f_op == &fm_fops &&
+           iminor(file_inode(filp)) == DEV_FM_PCD_MINOR_BASE;

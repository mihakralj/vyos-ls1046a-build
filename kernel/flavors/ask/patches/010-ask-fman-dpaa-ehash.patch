+}__attribute__ ((packed));
+
+
+struct en_ehash_portinfo
+{
+	uint32_t reserved[3]; /* This overlaps with statistics info en_ehash_ifstats, it is not to be used.  */
+	uint32_t port_info; /* LSbit is port status 0 => port down 1 => port up */
+}__attribute__ ((packed));

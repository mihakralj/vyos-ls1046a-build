+{
+	uint32_t tmp;
+	struct fman_port *port = (struct fman_port *)handle;
+
+	tmp = ioread32be(&port->bmi_regs->oh.fmbm_ofne);
+	tmp &= 0xff000000;
+	tmp |= ofne_val;
+	pr_debug("%s: setting ofne for port %p as %08x\n", __func__, handle, tmp);

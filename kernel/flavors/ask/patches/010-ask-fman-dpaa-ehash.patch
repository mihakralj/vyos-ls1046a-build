+static inline void disp_buf(void *buf, uint32_t size)
+{
+        uint8_t *ptr;
+	uint32_t ii,jj=0;
+	uint8_t buff[200];
+
+        ptr = buf;
+        for (ii = 0; ii < size; ii++) {
+                
+		if (ii && (ii % 16 == 0))
+		{
+			buff[jj] = 0;
+			printk("%s\n",buff);
+			jj = 0;
+		}
+		jj += sprintf(buff+jj, "%02x ", *ptr);
+                ptr++;
+        }
+	buff[jj] = 0;
+	printk("%s\n", buff);
+}

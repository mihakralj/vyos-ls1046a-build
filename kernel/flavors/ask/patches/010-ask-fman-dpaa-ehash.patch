+static inline void skb_reset_truesize(struct sk_buff *skb, unsigned int size)
+{
+	size -= SKB_DATA_ALIGN(sizeof(struct skb_shared_info));
+	skb->truesize = SKB_TRUESIZE(size);
+
+	return;
+}

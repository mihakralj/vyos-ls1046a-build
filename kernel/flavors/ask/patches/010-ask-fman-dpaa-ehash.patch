+/* The SDK has a software-only shared flag before alwaysDirect. The
+ * published native/compat ioctl layouts do not. Translate that prefix
+ * explicitly; the netenv-to-counter tail has the same layout. */
+static t_Handle fm_pcd_kg_scheme_set(t_Handle h_Pcd,
+                                    ioc_fm_pcd_kg_scheme_params_t *p_Params)
+{
+    t_FmPcdKgSchemeParams *p_Scheme;
+    t_Handle h_Scheme;
+
+    BUILD_BUG_ON(sizeof(*p_Scheme) - offsetof(t_FmPcdKgSchemeParams, netEnvParams) !=
+                 offsetof(ioc_fm_pcd_kg_scheme_params_t, id) -
+                 offsetof(ioc_fm_pcd_kg_scheme_params_t, net_env_params));
+    p_Scheme = XX_Malloc(sizeof(*p_Scheme));
+    if (!p_Scheme)
+        return NULL;
+
+    memset(p_Scheme, 0, sizeof(*p_Scheme));
+    memcpy(p_Scheme, p_Params, offsetof(t_FmPcdKgSchemeParams, shared));
+    p_Scheme->alwaysDirect = p_Params->always_direct;
+    /* Copy the layout-checked tail through the containing objects so
+     * FORTIFY checks the full source and destination bounds. */
+    memcpy((char *)p_Scheme + offsetof(t_FmPcdKgSchemeParams, netEnvParams),
+           (char *)p_Params + offsetof(ioc_fm_pcd_kg_scheme_params_t, net_env_params),
+           sizeof(*p_Scheme) - offsetof(t_FmPcdKgSchemeParams, netEnvParams));
+    /* Resolve cookies only in the private SDK copy. Copy-out must retain
+     * public IDs, never resolved kernel handles. */
+    if ((p_Scheme->modify &&
+         fm_pcd_cookie_to_handle(&p_Scheme->id.h_Scheme, FM_PCD_COOKIE_SCHEME)) ||
+        fm_pcd_cookie_to_handle(&p_Scheme->netEnvParams.h_NetEnv, FM_PCD_COOKIE_NET_ENV) ||
+        ((p_Scheme->nextEngine == e_FM_PCD_CC) &&
+         fm_pcd_cookie_to_handle(&p_Scheme->kgNextEngineParams.cc.h_CcTree,
+                                 FM_PCD_COOKIE_CC_TREE)))
+    {
+        XX_Free(p_Scheme);
+        return NULL;
+    }
+    h_Scheme = FM_PCD_KgSchemeSet(h_Pcd, p_Scheme);
+    XX_Free(p_Scheme);
+    return h_Scheme;
+}

+/* Unregister the IPSEC offload hook. Waits out in-flight xmit readers
+ * so the hook's module text may be freed once this returns. */
+void dpa_unregister_wifi_xmit_local_hook(void)
+{
+	WRITE_ONCE(dpaa_wifi_xmit_local_ipsec_handler, NULL);
+	synchronize_rcu();
+}
+EXPORT_SYMBOL(dpa_unregister_wifi_xmit_local_hook);
+

+/* --------------------------------------------------------------------------
+ * FM_PCD handle cookies
+ *
+ * Every FM_PCD object that crosses the /dev/fmX-pcd ioctl boundary is named
+ * by an opaque 64-bit cookie rather than by its kernel t_Handle: the raw
+ * handle is a KASLR-defeating address leak on the way out, and on the way
+ * back in it is a pointer the LLD dereferences without ever having checked
+ * that userspace did not invent it.
+ *
+ * The cookie namespace is deliberately global rather than per-fd: fmc writes
+ * the ids it was given into /tmp/fmc.bin, and a later, unrelated process
+ * (`fmc --cleanup`) reopens the device and deletes by those ids. An fd-scoped
+ * table would make every id dead on arrival for that second process.
+ *
+ * Cookie layout is picked so that neither a kernel pointer (top 16 bits all
+ * set on arm64) nor a userspace pointer (top 16 bits clear) can be mistaken
+ * for a cookie - a raw-pointer-vs-cookie mixup then fails the watermark test
+ * loudly instead of being dereferenced:
+ *
+ *      63..48  watermark, always FM_PCD_COOKIE_WATERMARK
+ *      47..32  reserved, must be zero
+ *      31..16  slot generation, bumped on retire so stale cookies stop
+ *              resolving even after the slot is handed to a new object
+ *      15..0   slot index
+ *
+ * Cookie 0 is the NULL cookie and never names an object.
+ *
+ * Translation sits on the shared native code path, after the compat structs
+ * have been converted, so both entry widths funnel through it. The compat
+ * layer's own id table (compat_add_ptr2id) still maps its 32-bit ids to raw
+ * handles rather than to cookies, so a CONFIG_COMPAT build would have to be
+ * retargeted at this registry before 32-bit userspace could be let through.
+ * CONFIG_COMPAT is off on this platform and the compat arms are not built.
+ * ------------------------------------------------------------------------*/
+#define FM_PCD_COOKIE_SLOTS         1024U
+#define FM_PCD_COOKIE_WATERMARK     0xFC1DULL
+#define FM_PCD_COOKIE_WM_SHIFT      48
+#define FM_PCD_COOKIE_RSVD_MASK     0x0000ffff00000000ULL
+#define FM_PCD_COOKIE_GEN_SHIFT     16
+#define FM_PCD_COOKIE_GEN_MASK      0xffffULL
+#define FM_PCD_COOKIE_IDX_MASK      0xffffULL
+
+struct fm_pcd_cookie_slot {
+    void        *handle;
+    uint8_t     type;
+    uint16_t    gen;
+    refcount_t  refs;
+};
+
+static struct fm_pcd_cookie_slot fm_pcd_cookie_table[FM_PCD_COOKIE_SLOTS];
+static DEFINE_SPINLOCK(fm_pcd_cookie_lock);
+
+static inline uint64_t fm_pcd_cookie_encode(uint32_t idx, uint16_t gen)
+{
+    return (FM_PCD_COOKIE_WATERMARK << FM_PCD_COOKIE_WM_SHIFT) |
+           ((uint64_t)gen << FM_PCD_COOKIE_GEN_SHIFT) |
+           (uint64_t)idx;
+}
+
+/* Caller holds fm_pcd_cookie_lock. */
+static struct fm_pcd_cookie_slot *fm_pcd_cookie_slot_of(
+        uint64_t cookie, enum fm_pcd_cookie_type type)
+{
+    struct fm_pcd_cookie_slot *p_Slot;
+    uint32_t idx;
+
+    if ((cookie >> FM_PCD_COOKIE_WM_SHIFT) != FM_PCD_COOKIE_WATERMARK)
+        return NULL;
+
+    if (cookie & FM_PCD_COOKIE_RSVD_MASK)
+        return NULL;
+
+    idx = (uint32_t)(cookie & FM_PCD_COOKIE_IDX_MASK);
+    if (idx >= FM_PCD_COOKIE_SLOTS)
+        return NULL;
+
+    p_Slot = &fm_pcd_cookie_table[idx];
+    if (!p_Slot->handle || p_Slot->type != (uint8_t)type)
+        return NULL;
+
+    if (p_Slot->gen !=
+            (uint16_t)((cookie >> FM_PCD_COOKIE_GEN_SHIFT) & FM_PCD_COOKIE_GEN_MASK))
+        return NULL;
+
+    return p_Slot;
+}
+
+static uint64_t fm_pcd_cookie_create(void *handle, enum fm_pcd_cookie_type type)
+{
+    struct fm_pcd_cookie_slot *p_Slot;
+    unsigned long flags;
+    uint64_t cookie = 0;
+    uint32_t idx;
+
+    if (!handle)
+        return 0;
+
+    spin_lock_irqsave(&fm_pcd_cookie_lock, flags);
+
+    /* One cookie per (handle, type). The LLD returns the same object for
+       repeated Set calls that return a shared object, and a
+       second registration would burn a slot per call for no gain. */
+    for (idx = 0; idx < FM_PCD_COOKIE_SLOTS; idx++)
+    {
+        p_Slot = &fm_pcd_cookie_table[idx];
+        if (p_Slot->handle == handle && p_Slot->type == (uint8_t)type)
+        {
+            if (type == FM_PCD_COOKIE_HASH_TABLE)
+                refcount_inc(&p_Slot->refs);
+            cookie = fm_pcd_cookie_encode(idx, p_Slot->gen);
+            goto out;
+        }
+    }
+
+    for (idx = 0; idx < FM_PCD_COOKIE_SLOTS; idx++)
+    {
+        p_Slot = &fm_pcd_cookie_table[idx];
+        if (!p_Slot->handle)
+        {
+            p_Slot->handle = handle;
+            refcount_set(&p_Slot->refs, 1);
+            p_Slot->type = (uint8_t)type;
+            cookie = fm_pcd_cookie_encode(idx, p_Slot->gen);
+            goto out;
+        }
+    }
+
+out:
+    spin_unlock_irqrestore(&fm_pcd_cookie_lock, flags);
+
+    if (!cookie)
+        pr_err("fm_pcd: handle cookie table full (%u slots); "
+               "refusing to hand out a type-%d object\n",
+               FM_PCD_COOKIE_SLOTS, (int)type);
+
+    return cookie;
+}
+
+t_Handle fm_pcd_cookie_lookup(uint64_t cookie, enum fm_pcd_cookie_type type)
+{
+    struct fm_pcd_cookie_slot *p_Slot;
+    unsigned long flags;
+    t_Handle handle = NULL;
+
+    spin_lock_irqsave(&fm_pcd_cookie_lock, flags);
+    p_Slot = fm_pcd_cookie_slot_of(cookie, type);
+    if (p_Slot)
+        handle = p_Slot->handle;
+    spin_unlock_irqrestore(&fm_pcd_cookie_lock, flags);
+
+    return handle;
+}
+EXPORT_SYMBOL(fm_pcd_cookie_lookup);
+
+static t_Handle fm_pcd_cookie_retire(uint64_t cookie, enum fm_pcd_cookie_type type)
+{
+    struct fm_pcd_cookie_slot *p_Slot;
+    unsigned long flags;
+    t_Handle handle = NULL;
+
+    spin_lock_irqsave(&fm_pcd_cookie_lock, flags);
+    p_Slot = fm_pcd_cookie_slot_of(cookie, type);
+    if (p_Slot)
+    {
+        handle = p_Slot->handle;
+        p_Slot->handle = NULL;
+        p_Slot->type = (uint8_t)FM_PCD_COOKIE_NONE;
+        p_Slot->gen++;
+    }
+    spin_unlock_irqrestore(&fm_pcd_cookie_lock, flags);
+
+    return handle;
+}
+
+/* Shared objects may return one cookie for several SET calls.
+ * Drop each caller's reference; only the final DELETE reaches the LLD.
+ * The FM ioctl mutex serializes this operation with all producers. */
+static t_Error fm_pcd_cookie_hash_put(uint64_t cookie)
+{
+    struct fm_pcd_cookie_slot *slot;
+    unsigned long flags;
+    t_Handle handle;
+    t_Error err;
+
+    spin_lock_irqsave(&fm_pcd_cookie_lock, flags);
+    slot = fm_pcd_cookie_slot_of(cookie, FM_PCD_COOKIE_HASH_TABLE);
+    if (!slot)
+    {
+        spin_unlock_irqrestore(&fm_pcd_cookie_lock, flags);
+        RETURN_ERROR(MINOR, E_INVALID_SELECTION, ("hash table cookie"));
+    }
+    if (refcount_dec_not_one(&slot->refs))
+    {
+        spin_unlock_irqrestore(&fm_pcd_cookie_lock, flags);
+        return E_OK;
+    }
+    handle = slot->handle;
+    spin_unlock_irqrestore(&fm_pcd_cookie_lock, flags);
+
+    err = FM_PCD_HashTableDelete(handle);
+    if (err == E_OK)
+        fm_pcd_cookie_retire(cookie, FM_PCD_COOKIE_HASH_TABLE);
+    return err;
+}
+
+/* Replace a user-supplied cookie with the handle it names. A NULL field is
+   left alone: every handle-typed field in the PCD ioctl structs is optional,
+   and NULL is how userspace says "not set". */
+static t_Error fm_pcd_cookie_to_handle(void **p_Field, enum fm_pcd_cookie_type type)
+{
+    t_Handle handle;
+
+    if (!*p_Field)
+        return E_OK;
+
+    handle = fm_pcd_cookie_lookup((uint64_t)(uintptr_t)*p_Field, type);
+    if (!handle)
+        return E_INVALID_SELECTION;
+
+    *p_Field = handle;
+    return E_OK;
+}
+
+/* A next-engine CC field names either a match table or a hash table: fmc
+   wires both kinds of node into cc_node_id (see fmc_exec_cctree), and under
+   USE_ENHANCED_EHASH the two are different object types, so the type check
+   has to accept the pair rather than either one alone. */
+static t_Error fm_pcd_cookie_to_cc_node(void **p_Field)
+{
+    t_Handle handle;
+
+    if (!*p_Field)
+        return E_OK;
+
+    handle = fm_pcd_cookie_lookup((uint64_t)(uintptr_t)*p_Field,
+                                  FM_PCD_COOKIE_CC_NODE);
+    if (!handle)
+        handle = fm_pcd_cookie_lookup((uint64_t)(uintptr_t)*p_Field,
+                                      FM_PCD_COOKIE_HASH_TABLE);
+    if (!handle)
+        return E_INVALID_SELECTION;
+
+    *p_Field = handle;
+    return E_OK;
+}
+
+/* Which arm of the params union carries a handle follows the next engine,
+   exactly as in compat_copy_fm_pcd_cc_next_engine(). manip_id, though, sits
+   outside the union and fmlib converts it for every next engine, so it is
+   translated whenever set rather than only for the engines the compat
+   converter happens to list. */
+static t_Error fm_pcd_cookie_next_engine(ioc_fm_pcd_cc_next_engine_params_t *p_Params)
+{
+    t_Error err;
+
+    err = fm_pcd_cookie_to_handle(&p_Params->manip_id, FM_PCD_COOKIE_MANIP);
+    if (err != E_OK)
+        return err;
+
+    switch (p_Params->next_engine)
+    {
+        case e_IOC_FM_PCD_CC:
+            return fm_pcd_cookie_to_cc_node(&p_Params->params.cc_params.cc_node_id);
+
+        case e_IOC_FM_PCD_KG:
+            return fm_pcd_cookie_to_handle(&p_Params->params.kg_params.p_direct_scheme,
+                                           FM_PCD_COOKIE_SCHEME);
+
+        case e_IOC_FM_PCD_FR:
+            return fm_pcd_cookie_to_handle(&p_Params->params.fr_params.frm_replic_id,
+                                           FM_PCD_COOKIE_REPLIC_GROUP);
+
+        default:
+            return E_OK;
+    }
+}
+
+/* Mirrors compat_copy_fm_pcd_plcr_next_engine(): which arm of the policer
+   next-engine union carries a handle depends on the next engine. */
+static t_Error fm_pcd_cookie_plcr_next_engine(
+        ioc_fm_pcd_plcr_next_engine_params_u *p_Params,
+        ioc_fm_pcd_engine                     next_engine)
+{
+    switch (next_engine)
+    {
+        case e_IOC_FM_PCD_PLCR:
+            return fm_pcd_cookie_to_handle(&p_Params->p_profile,
+                                           FM_PCD_COOKIE_PLCR_PROFILE);
+
+        case e_IOC_FM_PCD_KG:
+            return fm_pcd_cookie_to_handle(&p_Params->p_direct_scheme,
+                                           FM_PCD_COOKIE_SCHEME);
+
+        default:
+            return E_OK;
+    }
+}
+
+/* Only the first num_of_keys entries are live; the rest of key_params[] is
+   whatever userspace left there and must not be interpreted. */
+static t_Error fm_pcd_cookie_keys(ioc_keys_params_t *p_Keys)
+{
+    t_Error err;
+    uint16_t ii;
+
+    for (ii = 0; ii < p_Keys->num_of_keys; ii++)
+    {
+        err = fm_pcd_cookie_next_engine(
+                &p_Keys->key_params[ii].cc_next_engine_params);
+        if (err != E_OK)
+            return err;
+    }
+
+    return fm_pcd_cookie_next_engine(&p_Keys->cc_next_engine_params_for_miss);
+}
+
+static t_Error fm_pcd_cookie_cc_tree(ioc_fm_pcd_cc_tree_params_t *p_Tree)
+{
+    t_Error err;
+    uint8_t ii, jj, entries;
+
+    err = fm_pcd_cookie_to_handle(&p_Tree->net_env_id, FM_PCD_COOKIE_NET_ENV);
+    if (err != E_OK)
+        return err;
+
+    if (p_Tree->num_of_groups > IOC_FM_PCD_MAX_NUM_OF_CC_GROUPS)
+        return E_INVALID_SELECTION;
+
+    for (ii = 0; ii < p_Tree->num_of_groups; ii++)
+    {
+        ioc_fm_pcd_cc_grp_params_t *p_Grp = &p_Tree->fm_pcd_cc_group_params[ii];
+
+        /* A group holds one entry per combination of its distinction units. */
+        if (p_Grp->num_of_distinction_units > IOC_FM_PCD_MAX_NUM_OF_CC_UNITS)
+            return E_INVALID_SELECTION;
+
+        entries = (uint8_t)(1 << p_Grp->num_of_distinction_units);
+        if (entries > IOC_FM_PCD_MAX_NUM_OF_CC_ENTRIES_IN_GRP)
+            entries = IOC_FM_PCD_MAX_NUM_OF_CC_ENTRIES_IN_GRP;
+
+        for (jj = 0; jj < entries; jj++)
+        {
+            err = fm_pcd_cookie_next_engine(
+                    &p_Grp->next_engine_per_entries_in_grp[jj]);
+            if (err != E_OK)
+                return err;
+        }
+    }
+
+    return E_OK;
+}
+
+/* Mirrors compat_copy_fm_pcd_kg_schemes_params(): the bind/unbind verbs take
+   a bare array of scheme handles. */
+static t_Error fm_pcd_cookie_port_schemes(ioc_fm_pcd_port_schemes_params_t *p_Params)
+{
+    t_Error err;
+    uint8_t ii;
+
+    if (p_Params->num_of_schemes > FM_PCD_KG_NUM_OF_SCHEMES)
+        return E_INVALID_SELECTION;
+
+    for (ii = 0; ii < p_Params->num_of_schemes; ii++)
+    {
+        err = fm_pcd_cookie_to_handle(&p_Params->scheme_ids[ii],
+                                      FM_PCD_COOKIE_SCHEME);
+        if (err != E_OK)
+            return err;
+    }
+
+    return E_OK;
+}
+
+/* Field map mirrors compat_copy_fm_port_pcd(): the seven handle-typed fields
+   a port's PCD binding can carry. The sub-structs have already been copied in
+   from userspace by the caller, so these are kernel-side pointers. */
+static t_Error fm_pcd_cookie_port_pcd(ioc_fm_port_pcd_params_t *p_Params)
+{
+    t_Error err;
+
+    err = fm_pcd_cookie_to_handle(&p_Params->net_env_id, FM_PCD_COOKIE_NET_ENV);
+    if (err != E_OK)
+        return err;
+
+    if (p_Params->p_cc_params)
+    {
+        err = fm_pcd_cookie_to_handle(&p_Params->p_cc_params->cc_tree_id,
+                                      FM_PCD_COOKIE_CC_TREE);
+        if (err != E_OK)
+            return err;
+    }
+
+    if (p_Params->p_kg_params)
+    {
+        ioc_fm_port_pcd_kg_params_t *p_Kg = p_Params->p_kg_params;
+        uint8_t ii;
+
+        if (p_Kg->num_of_schemes > FM_PCD_KG_NUM_OF_SCHEMES)
+            return E_INVALID_SELECTION;
+
+        for (ii = 0; ii < p_Kg->num_of_schemes; ii++)
+        {
+            err = fm_pcd_cookie_to_handle(&p_Kg->scheme_ids[ii],
+                                          FM_PCD_COOKIE_SCHEME);
+            if (err != E_OK)
+                return err;
+        }
+
+        if (p_Kg->direct_scheme)
+        {
+            err = fm_pcd_cookie_to_handle(&p_Kg->direct_scheme_id,
+                                          FM_PCD_COOKIE_SCHEME);
+            if (err != E_OK)
+                return err;
+        }
+    }
+
+    if (p_Params->p_plcr_params)
+    {
+        err = fm_pcd_cookie_to_handle(&p_Params->p_plcr_params->plcr_profile_id,
+                                      FM_PCD_COOKIE_PLCR_PROFILE);
+        if (err != E_OK)
+            return err;
+    }
+
+    return E_OK;
+}

+ * headroom for cellular interfaces that don't have a MAC header.
+ * Returns 0 on success, negative on failure.
+ */
+int dpa_add_dummy_eth_hdr(struct sk_buff **skb_in, int priv_headroom,
+			  unsigned char *hdroom_realloc)
+{
+	struct sk_buff *skb = *skb_in;
+	struct ethhdr *eth;
+	__be16 proto;
+	int headroom_needed = ETH_HLEN + priv_headroom;
+	int ipv;
+
+	/* Check if we have enough headroom */
+	if (skb_headroom(skb) < headroom_needed) {
+		struct sk_buff *new_skb;
+
+		new_skb = skb_realloc_headroom(skb, headroom_needed);
+		if (!new_skb)
+			return -ENOMEM;
+
+		dev_kfree_skb(skb);
+		*skb_in = new_skb;
+		skb = new_skb;
+		*hdroom_realloc = 1;
+	}
+
+	/* The skb_push()/memset() below writes the dummy Ethernet header in
+	 * place into the head buffer. If that buffer is shared with a clone
+	 * (e.g. a tcpdump tap on the cellular offload interface), COW it first
+	 * so the capture is not corrupted. skb_cow_head() is a cheap
+	 * skb_header_cloned() branch when the skb is not cloned; the realloc
+	 * path above already yields a private head, so this never double-
+	 * reallocs. It may reallocate skb->head, but leaves the skb struct
+	 * pointer (and thus *skb_in) unchanged, so no propagation is needed.
+	 * On failure return -ENOMEM like the realloc path; the caller then
+	 * hands the packet back to Linux. */
+	if (skb_cow_head(skb, 0))
+		return -ENOMEM;

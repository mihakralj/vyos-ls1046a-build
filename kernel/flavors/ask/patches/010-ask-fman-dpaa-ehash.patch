+    WRITE_UINT32(ccptr->word_1, ptr->word_1);
+    WRITE_UINT32(ccptr->table_base_lo, ptr->table_base_lo);
+    WRITE_UINT32(ccptr->word_2, ptr->word_2);
+    WRITE_UINT32(ccptr->word_0, ptr->word_0);
+    info->h_Ad = ccptr;
+    info->tree_owners++;

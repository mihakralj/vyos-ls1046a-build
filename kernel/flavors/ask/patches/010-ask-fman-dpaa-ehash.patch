+static void display_buf_data(void *dataptr, uint32_t size)
+{
+	uint32_t ii;
+	uint8_t *ptr;
+
+	ptr = (uint8_t *)dataptr;	
+	for (ii = 0; ii < size; ii++) {
+		if ((ii % 16) == 15) 
+			printk("%02x\n", *ptr);
+		else
+			printk("%02x ", *ptr);
+		ptr++;
+	}
+        if (ii % 16)
+		printk("\n");
+}
+#endif

+	for (ii = 0; ii < MAX_OFFLINE_PORTS; ii++) {
+		if (strcmp(&info->port_name[0], &port_info->port_name[0]) == 0) {
+			memcpy(info, port_info, sizeof(struct fman_offline_port_info));
+			return 0;
+		}
+		port_info++;
+	}
+	return (-ENOENT);

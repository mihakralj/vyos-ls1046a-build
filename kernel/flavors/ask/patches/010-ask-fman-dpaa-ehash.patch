+/* Reassembly identifiers and layouts remain reserved ABI. Reject them before
+ * allocating objects, copying nested arguments, or resolving any cookies. */
+static int fm_reassembly_ioctl(unsigned int minor, unsigned int cmd,
+                               unsigned long arg, bool compat)
+{
+    uint32_t type;
+    size_t offset;
+
+    if (minor == DEV_FM_MINOR_BASE || minor == DEV_FM_PCD_MINOR_BASE)
+    {
+        if (cmd == FM_PCD_IOC_MANIP_NODE_SET
+#ifdef CONFIG_COMPAT
+            || cmd == FM_PCD_IOC_MANIP_NODE_SET_COMPAT
+#endif
+            )
+        {
+            /* The type is the first 32-bit field in both ABIs. */
+            if (get_user(type, (uint32_t __user *)arg))
+                return -EFAULT;
+            if (type == e_IOC_FM_PCD_MANIP_REASSEM)
+                return -EOPNOTSUPP;
+        }
+        else if (cmd == FM_PCD_IOC_HASH_TABLE_SET
+#ifdef CONFIG_COMPAT
+                 || cmd == FM_PCD_IOC_HASH_TABLE_SET_COMPAT
+#endif
+                 )
+        {
+#ifdef CONFIG_COMPAT
+            /* The legacy compat layout has no table_type. Its conversion
+             * leaves the zero-initialized native field at IPV4_UDP_TABLE. */
+            if (compat)
+                return 0;
+#endif
+            offset = offsetof(ioc_fm_pcd_hash_table_params_t, table_type);
+            if (get_user(type, (uint32_t __user *)(arg + offset)))
+                return -EFAULT;
+            type &= TABLE_TYPE_MASK;
+            if (type == IPV4_REASSM_TABLE || type == IPV6_REASSM_TABLE)
+                return -EOPNOTSUPP;
+        }
+    }
+    else if (cmd == FM_PORT_IOC_SET_PCD
+#ifdef CONFIG_COMPAT
+             || cmd == FM_PORT_IOC_SET_PCD_COMPAT
+#endif
+             )
+    {
+#ifdef CONFIG_COMPAT
+        if (compat)
+        {
+            compat_uptr_t ip, capwap;
+            ioc_compat_fm_port_pcd_params_t __user *params = compat_ptr(arg);
+
+            if (get_user(ip, &params->p_ip_reassembly_manip) ||
+                get_user(capwap, &params->p_capwap_reassembly_manip))
+                return -EFAULT;
+            return (ip || capwap) ? -EOPNOTSUPP : 0;
+        }
+#endif
+        {
+            void *ip, *capwap;
+            ioc_fm_port_pcd_params_t __user *params = (void __user *)arg;
+
+            if (get_user(ip, &params->p_ip_reassembly_manip) ||
+                get_user(capwap, &params->p_capwap_reassembly_manip))
+                return -EFAULT;
+            return (ip || capwap) ? -EOPNOTSUPP : 0;
+        }
+    }
+    return 0;
+}

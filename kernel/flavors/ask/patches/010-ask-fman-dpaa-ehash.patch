+				return -1;
+			}
+			prepare_qm_sg_entry(sgt, sgt_index, skb_frag_size(frag), addr);
+			frag++;
+			nr_frags--;
+			sgt_index++;
+		}
+		cur_skb = list_skb;
+		if (list_skb)
+			list_skb = list_skb->next;
+	}

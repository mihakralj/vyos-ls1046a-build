+//parameters for opcode REPLACE_PPPOE_HDR - session offload
+struct en_ehash_replace_pppoe_hdr_params {
+	uint8_t   destination_mac[6];
+	uint8_t   source_mac[6];
+	uint16_t  session_id;
+	uint16_t  pad;

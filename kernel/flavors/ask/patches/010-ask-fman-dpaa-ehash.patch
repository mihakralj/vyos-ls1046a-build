+		bman_release(sg_bpool_g->pool, &bmb, 1, 0);
+		return -1;
+	}
+	qm_fd_addr_set64(fd, sg_addr);
+	fd->bpid = skb_2bfreed_bpool_g->bpid; /*sg_bpool_g->bpid;*/

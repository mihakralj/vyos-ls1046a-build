+	/* Determine IP version from first byte of packet */
+	ipv = (skb->data[0] >> 4) & 0xf;
+
+	/* Set protocol based on IP version */
+	if (ipv == 6)
+		proto = htons(ETH_P_IPV6);
+	else
+		proto = htons(ETH_P_IP);
+

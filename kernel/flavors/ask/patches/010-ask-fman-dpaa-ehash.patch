+	if (GET_STATS_ENABLE(flags))
+	{
+		stats->flags |= STATS_VALID;
+		stats->pkts = be64_to_cpu(entry->packet_count);
+		stats->bytes = be64_to_cpu(entry->packet_bytes);
+	}

+static inline uint32_t swap_word(uint32_t *ptr)
+{
+	uint32_t val;
+	val =  ((*ptr >> 24) | (*ptr << 24) | 
+			((*ptr >> 8) & 0x0000ff00) |
+			((*ptr << 8) & 0xff0000));
+	return val;
+}

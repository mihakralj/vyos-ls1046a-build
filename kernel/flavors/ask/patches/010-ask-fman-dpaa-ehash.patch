+int __hot skb_fraglist_to_sg_fd(struct device *dev, struct net_device *net_dev , struct sk_buff *skb, struct qm_fd *fd, u32 fd_cmd)
+{
+	dma_addr_t addr, sg_addr;
+	struct sk_buff *list_skb;

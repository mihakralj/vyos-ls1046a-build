From: Mono OpenWrt Integration <integration@mono.local>
Date: Thu, 30 Apr 2026 12:00:00 +0100
Subject: [PATCH] net: preserve ASK underlying ingress ifindex across bridge handoff

ASK control-plane and DPAA datapath decisions sometimes need the physical
ingress interface even after Linux has moved a packet through bridge or PPPoE
handoff paths. Preserve that original ifindex on the skb so later fast-path
metadata and flow programming can distinguish the hardware-facing port from
the logical bridge or PPP device.

This is intentionally limited to carrying ingress identity. It does not
program flows, change policy, or make any offload decision by itself.

2026-07-02 update: rebased hunks against the actual post-002 tree state and
the real kernel 6.12.49 API surface. 002-ask-kernel-hooks.patch already
touches these same 6 files (skbuff.h, br_input.c, dev.c, gro.c, skbuff.c x2)
at the identical insertion points with its own CONFIG_CPE_FAST_PATH tracking
fields (underlying_iif, iif_index, abm_ff, ...) -- this patch's
layerscape_underlying_iif field is a distinct, separately-named field that
patch 721's kept nf_conntrack_core.c code (nf_ct_update_layerscape_fp())
depends on directly, so it must stay active rather than be treated as
redundant. Hunks were regenerated by editing real post-002 files and taking
`git diff` (never hand-computed) to avoid @@ header arithmetic mistakes.
Also fixed pppoe.c: the original hunk targeted an older API
(__get_item()/__sk_receive_skb() with 5 args) that doesn't exist in this
kernel tree -- current mainline 6.12.49 uses get_item()/sk_receive_skb()
(3 args).

---
--- a/drivers/net/ppp/pppoe.c
+++ b/drivers/net/ppp/pppoe.c
@@ -447,6 +447,9 @@ static int pppoe_rcv(struct sk_buff *skb, struct net_device *dev,
 	po = get_item(pn, ph->sid, eth_hdr(skb)->h_source, dev->ifindex);
 	if (!po)
 		goto drop;
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	skb->layerscape_underlying_iif = dev->ifindex;
+#endif
 
 	return sk_receive_skb(sk_pppox(po), skb, 0);
 
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -1040,6 +1040,10 @@ struct sk_buff {
 	int			iif_index;
 	int			underlying_iif;
 	__u16			underlying_vlan_tci;
+#endif
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	/* Preserve the physical ingress ifindex after bridge handoff. */
+	int			layerscape_underlying_iif;
 #endif
 	__u32			hash;
 	union {
--- a/net/bridge/br_input.c
+++ b/net/bridge/br_input.c
@@ -69,6 +69,9 @@ static int br_pass_frame_up(struct sk_buff *skb, bool promisc)
 	skb->underlying_iif = indev->ifindex;
 #endif
 
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	skb->layerscape_underlying_iif = indev->ifindex;
+#endif
 	BR_INPUT_SKB_CB(skb)->promisc = promisc;
 
 	return NF_HOOK(NFPROTO_BRIDGE, NF_BR_LOCAL_IN,
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -5605,6 +5605,11 @@ static int __netif_receive_skb_core(struct sk_buff **pskb, bool pfmemalloc,
 	if(!skb->underlying_iif)
 		skb->underlying_iif = skb->dev->ifindex;
 #endif
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	if (!skb->layerscape_underlying_iif)
+		skb->layerscape_underlying_iif = skb->dev->ifindex;
+#endif
+
 	orig_dev = skb->dev;
 
 	skb_reset_network_header(skb);
--- a/net/core/gro.c
+++ b/net/core/gro.c
@@ -653,6 +653,9 @@ static void napi_reuse_skb(struct napi_struct *napi, struct sk_buff *skb)
 	skb->underlying_iif = 0;
 	skb->underlying_vlan_tci = 0;
 #endif
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	skb->layerscape_underlying_iif = 0;
+#endif
 
 	/* eth_type_trans() assumes pkt_type is PACKET_HOST */
 	skb->pkt_type = PACKET_HOST;
--- a/net/core/skbuff.c
+++ b/net/core/skbuff.c
@@ -1577,6 +1577,9 @@ static void __copy_skb_header(struct sk_buff *new, const struct sk_buff *old)
 	CHECK_SKB_FIELD(iif_index);
 	CHECK_SKB_FIELD(underlying_iif);
 	CHECK_SKB_FIELD(underlying_vlan_tci);
+#endif
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	CHECK_SKB_FIELD(layerscape_underlying_iif);
 #endif
 	CHECK_SKB_FIELD(vlan_proto);
 	CHECK_SKB_FIELD(vlan_tci);
@@ -6145,6 +6148,9 @@ void skb_scrub_packet(struct sk_buff *skb, bool xnet)
 {
 	skb->pkt_type = PACKET_HOST;
 	skb->skb_iif = 0;
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	skb->layerscape_underlying_iif = 0;
+#endif
 	skb->ignore_df = 0;
 	skb_dst_drop(skb);
 #if defined(CONFIG_INET_IPSEC_OFFLOAD) || defined(CONFIG_INET6_IPSEC_OFFLOAD)
--- a/drivers/net/ppp/ppp_generic.c
+++ b/drivers/net/ppp/ppp_generic.c
@@ -2406,6 +2406,9 @@ static void
 ppp_receive_nonmp_frame(struct ppp *ppp, struct sk_buff *skb)
 {
 	struct sk_buff *ns;
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+	int layerscape_underlying_iif = skb->layerscape_underlying_iif;
+#endif
 	int proto, len, npi;
 
 	/*
@@ -2530,8 +2533,13 @@ ppp_receive_nonmp_frame(struct ppp *ppp,
 			skb->dev = ppp->dev;
 			skb->protocol = htons(npindex_to_ethertype[npi]);
 			skb_reset_mac_header(skb);
 			skb_scrub_packet(skb, !net_eq(ppp->ppp_net,
 						      dev_net(ppp->dev)));
+#if IS_ENABLED(CONFIG_NF_CONNTRACK)
+			if (layerscape_underlying_iif &&
+			    net_eq(ppp->ppp_net, dev_net(ppp->dev)))
+				skb->layerscape_underlying_iif = layerscape_underlying_iif;
+#endif
 			netif_rx(skb);
 		}
 	}

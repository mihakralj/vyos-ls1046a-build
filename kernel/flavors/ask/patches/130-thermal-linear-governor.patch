diff --git a/drivers/thermal/gov_linear.c b/drivers/thermal/gov_linear.c
new file mode 100644
--- /dev/null
+++ b/drivers/thermal/gov_linear.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Linear active cooling with step-wise passive cooling. */
+
+#include <linux/math64.h>
+#include <linux/thermal.h>
+
+#include "thermal_core.h"
+
+/*
+ * A map's lower state is its value at the trip temperature. Its upper state
+ * is reached at the next higher active trip bound to this cooling device.
+ * Find that trip in this zone only; neither DTS order nor other fans/zones
+ * determine the endpoint. A terminal map requests its upper state.
+ */
+static const struct thermal_trip *
+linear_next_trip(struct thermal_zone_device *tz, struct thermal_instance *instance)
+{
+	const struct thermal_trip *next = NULL;
+	const struct thermal_trip_desc *td;
+	struct thermal_instance *other;
+
+	for_each_trip_desc(tz, td) {
+		const struct thermal_trip *trip = &td->trip;
+
+		if (trip->type != THERMAL_TRIP_ACTIVE ||
+		    trip->temperature == THERMAL_TEMP_INVALID ||
+		    trip->temperature <= instance->trip->temperature ||
+		    (next && trip->temperature >= next->temperature))
+			continue;
+
+		list_for_each_entry(other, &td->thermal_instances, trip_node) {
+			if (other->cdev == instance->cdev) {
+				next = trip;
+				break;
+			}
+		}
+	}
+	return next;
+}
+
+static unsigned long linear_target(struct thermal_zone_device *tz,
+				   const struct thermal_trip_desc *td,
+				   struct thermal_instance *instance)
+{
+	const struct thermal_trip *next;
+	u32 offset, span;
+
+	/* The core maintains this threshold, including falling hysteresis. */
+	if (td->trip.temperature == THERMAL_TEMP_INVALID ||
+	    tz->temperature < td->threshold)
+		return THERMAL_NO_TARGET;
+
+	next = linear_next_trip(tz, instance);
+	if (!next || tz->temperature >= next->temperature)
+		return instance->upper;
+
+	if (tz->temperature <= td->trip.temperature)
+		return instance->lower;
+
+	offset = (s64)tz->temperature - td->trip.temperature;
+	span = (s64)next->temperature - td->trip.temperature;
+	/* Integer division rounds down; the result stays within the map bounds. */
+	return instance->lower + mul_u64_u32_div(instance->upper - instance->lower,
+					       offset, span);
+}
+
+static void linear_manage(struct thermal_zone_device *tz)
+{
+	const struct thermal_trip_desc *td;
+	struct thermal_instance *instance;
+
+	lockdep_assert_held(&tz->lock);
+
+	for_each_trip_desc(tz, td) {
+		if (td->trip.type == THERMAL_TRIP_PASSIVE &&
+		    td->trip.temperature != THERMAL_TEMP_INVALID) {
+			thermal_step_wise_update(tz, td);
+			continue;
+		}
+		if (td->trip.type != THERMAL_TRIP_ACTIVE)
+			continue;
+
+		list_for_each_entry(instance, &td->thermal_instances, trip_node) {
+			instance->target = linear_target(tz, td, instance);
+			instance->initialized = true;
+			/* Retry even unchanged demand after a failed hardware write. */
+			mutex_lock(&instance->cdev->lock);
+			instance->cdev->updated = false;
+			mutex_unlock(&instance->cdev->lock);
+		}
+	}
+
+	/* Aggregate all maps and zones before applying each device's demand. */
+	for_each_trip_desc(tz, td) {
+		list_for_each_entry(instance, &td->thermal_instances, trip_node)
+			thermal_cdev_update(instance->cdev);
+	}
+}
+
+static struct thermal_governor thermal_gov_linear = {
+	.name = "linear",
+	.manage = linear_manage,
+};
+THERMAL_GOVERNOR_DECLARE(thermal_gov_linear);
+
+#if IS_ENABLED(CONFIG_THERMAL_GOV_LINEAR_KUNIT_TEST)
+#include "gov_linear_test.c"
+#endif
diff --git a/drivers/thermal/gov_linear_test.c b/drivers/thermal/gov_linear_test.c
new file mode 100644
--- /dev/null
+++ b/drivers/thermal/gov_linear_test.c
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exercise the actual thermal core, trip hysteresis and cooling aggregation. */
+#include <kunit/test.h>
+
+struct linear_test_cdev {
+	struct thermal_cooling_device *cdev;
+	unsigned long state;
+	unsigned long max_state;
+	unsigned int writes;
+	int error;
+};
+
+struct linear_test_ctx {
+	struct thermal_zone_device *tz;
+	struct linear_test_cdev cooling[3];
+	struct linear_test_cdev *bound[3];
+	int temperature;
+	int sensor_error;
+	unsigned int critical;
+};
+
+enum linear_test_trip {
+	LINEAR_TOP, LINEAR_CPU, LINEAR_SECOND_LOW, LINEAR_CRITICAL,
+	LINEAR_LOW, LINEAR_SECOND_TOP, LINEAR_UNBOUND,
+};
+
+static const struct thermal_trip linear_test_trips[] = {
+	[LINEAR_TOP] = { .temperature = 80000, .type = THERMAL_TRIP_ACTIVE },
+	[LINEAR_CPU] = { .temperature = 85000, .hysteresis = 2000,
+			.type = THERMAL_TRIP_PASSIVE },
+	[LINEAR_SECOND_LOW] = { .temperature = 45000, .hysteresis = 1000,
+			       .type = THERMAL_TRIP_ACTIVE },
+	[LINEAR_CRITICAL] = { .temperature = 95000, .type = THERMAL_TRIP_CRITICAL },
+	[LINEAR_LOW] = { .temperature = 40000, .hysteresis = 2000,
+			.type = THERMAL_TRIP_ACTIVE },
+	[LINEAR_SECOND_TOP] = { .temperature = 75000, .type = THERMAL_TRIP_ACTIVE },
+	[LINEAR_UNBOUND] = { .temperature = 60000, .type = THERMAL_TRIP_ACTIVE },
+};
+
+static int linear_test_get_max(struct thermal_cooling_device *cdev, unsigned long *state)
+{
+	struct linear_test_cdev *cooling = cdev->devdata;
+
+	*state = cooling->max_state;
+	return 0;
+}
+
+static int linear_test_get_state(struct thermal_cooling_device *cdev, unsigned long *state)
+{
+	struct linear_test_cdev *cooling = cdev->devdata;
+
+	*state = cooling->state;
+	return 0;
+}
+
+static int linear_test_set_state(struct thermal_cooling_device *cdev, unsigned long state)
+{
+	struct linear_test_cdev *cooling = cdev->devdata;
+
+	cooling->writes++;
+	if (cooling->error)
+		return cooling->error;
+	if (state > cooling->max_state)
+		return -EINVAL;
+	cooling->state = state;
+	return 0;
+}
+
+static const struct thermal_cooling_device_ops linear_test_cooling_ops = {
+	.get_max_state = linear_test_get_max,
+	.get_cur_state = linear_test_get_state,
+	.set_cur_state = linear_test_set_state,
+};
+
+static bool linear_test_bind(struct thermal_zone_device *tz, const struct thermal_trip *trip,
+			     struct thermal_cooling_device *cdev, struct cooling_spec *spec)
+{
+	struct linear_test_ctx *ctx = tz->devdata;
+	int id = thermal_zone_trip_id(tz, trip);
+
+	if (ctx->bound[0] && cdev->devdata == ctx->bound[0]) {
+		if (id != LINEAR_LOW && id != LINEAR_TOP)
+			return false;
+		spec->lower = id == LINEAR_LOW ? 34 : 255;
+		spec->upper = 255;
+	} else if (ctx->bound[1] && cdev->devdata == ctx->bound[1]) {
+		if (id != LINEAR_SECOND_LOW && id != LINEAR_SECOND_TOP)
+			return false;
+		spec->lower = id == LINEAR_SECOND_LOW ? 60 : 200;
+		spec->upper = 200;
+	} else if (ctx->bound[2] && cdev->devdata == ctx->bound[2] && id == LINEAR_CPU) {
+		spec->lower = 0;
+		spec->upper = 3;
+	} else {
+		return false;
+	}
+	return true;
+}
+
+static int linear_test_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct linear_test_ctx *ctx = tz->devdata;
+
+	*temp = ctx->temperature;
+	return ctx->sensor_error;
+}
+
+static void linear_test_critical(struct thermal_zone_device *tz)
+{
+	struct linear_test_ctx *ctx = tz->devdata;
+
+	ctx->critical++;
+}
+
+static const struct thermal_zone_device_ops linear_test_zone_ops = {
+	.should_bind = linear_test_bind,
+	.get_temp = linear_test_get_temp,
+	.critical = linear_test_critical,
+};
+
+static void linear_test_unregister_zone(void *arg)
+{
+	thermal_zone_device_unregister(arg);
+}
+
+static void linear_test_unregister_cdev(void *arg)
+{
+	thermal_cooling_device_unregister(arg);
+}
+
+static int linear_test_register_zone(struct kunit *test, struct linear_test_ctx *ctx)
+{
+	const struct thermal_zone_params params = {
+		.governor_name = "linear",
+		.no_hwmon = true,
+	};
+	int ret;
+
+	ctx->tz = thermal_zone_device_register_with_trips("linear-test", linear_test_trips,
+							ARRAY_SIZE(linear_test_trips), ctx,
+							&linear_test_zone_ops, &params, 0, 0);
+	if (IS_ERR(ctx->tz))
+		return PTR_ERR(ctx->tz);
+	ret = kunit_add_action_or_reset(test, linear_test_unregister_zone, ctx->tz);
+	if (ret)
+		return ret;
+	return thermal_zone_device_enable(ctx->tz);
+}
+
+static int linear_test_init(struct kunit *test)
+{
+	struct linear_test_ctx *ctx;
+	int i, ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	test->priv = ctx;
+	ctx->temperature = 35000;
+	for (i = 0; i < ARRAY_SIZE(ctx->cooling); i++) {
+		struct linear_test_cdev *cooling = &ctx->cooling[i];
+
+		ctx->bound[i] = cooling;
+		cooling->max_state = i == 2 ? 3 : 255;
+		cooling->cdev = thermal_cooling_device_register("linear-test", cooling,
+							      &linear_test_cooling_ops);
+		if (IS_ERR(cooling->cdev))
+			return PTR_ERR(cooling->cdev);
+		ret = kunit_add_action_or_reset(test, linear_test_unregister_cdev, cooling->cdev);
+		if (ret)
+			return ret;
+	}
+	return linear_test_register_zone(test, ctx);
+}
+
+static void linear_test_sample(struct linear_test_ctx *ctx, int temperature)
+{
+	ctx->temperature = temperature;
+	thermal_zone_device_update(ctx->tz, THERMAL_EVENT_TEMP_SAMPLE);
+}
+
+static void linear_test_curve(struct kunit *test)
+{
+	struct linear_test_ctx *ctx = test->priv;
+	static const int temps[] = { 35000, 39999, 40000, 41000, 50000, 60000,
+				     70000, 79999, 80000, 90000, 60000 };
+	static const unsigned long states[] = { 0, 0, 34, 39, 89, 144, 199, 254, 255, 255, 144 };
+	int i;
+
+	KUNIT_ASSERT_STREQ(test, ctx->tz->governor->name, "linear");
+	for (i = 0; i < ARRAY_SIZE(temps); i++) {
+		linear_test_sample(ctx, temps[i]);
+		KUNIT_EXPECT_EQ_MSG(test, ctx->cooling[0].state, states[i], "T=%d", temps[i]);
+	}
+	/* The unrelated 60 C trip and second fan's 75 C endpoint do not alter fan 1. */
+	KUNIT_EXPECT_EQ(test, ctx->cooling[1].state, 130UL);
+}
+
+static void linear_test_hysteresis(struct kunit *test)
+{
+	struct linear_test_ctx *ctx = test->priv;
+
+	linear_test_sample(ctx, 39000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 0UL);
+	linear_test_sample(ctx, 40000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 34UL);
+	linear_test_sample(ctx, 39000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 34UL);
+	linear_test_sample(ctx, 38000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 34UL);
+	linear_test_sample(ctx, 37999);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 0UL);
+	linear_test_sample(ctx, 39999);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 0UL);
+	linear_test_sample(ctx, 40000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 34UL);
+}
+
+static void linear_test_passive_and_critical(struct kunit *test)
+{
+	struct linear_test_ctx *ctx = test->priv;
+
+	linear_test_sample(ctx, 84000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[2].state, 0UL);
+	linear_test_sample(ctx, 85000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[2].state, 1UL);
+	linear_test_sample(ctx, 86000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[2].state, 2UL);
+	linear_test_sample(ctx, 87000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[2].state, 3UL);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 255UL);
+	KUNIT_EXPECT_EQ(test, ctx->critical, 0U);
+	linear_test_sample(ctx, 95000);
+	KUNIT_EXPECT_EQ(test, ctx->critical, 1U);
+	linear_test_sample(ctx, 82000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[2].state, 0UL);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 255UL);
+}
+
+static void linear_test_retry(struct kunit *test)
+{
+	struct linear_test_ctx *ctx = test->priv;
+
+	linear_test_sample(ctx, 50000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 89UL);
+	ctx->cooling[0].error = -EIO;
+	linear_test_sample(ctx, 60000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 89UL);
+	ctx->cooling[0].error = 0;
+	linear_test_sample(ctx, 60000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 144UL);
+	ctx->sensor_error = -EAGAIN;
+	linear_test_sample(ctx, 35000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 144UL);
+	ctx->sensor_error = 0;
+	linear_test_sample(ctx, 35000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 0UL);
+}
+
+static void linear_test_shared_fan(struct kunit *test)
+{
+	struct linear_test_ctx *ctx = test->priv;
+	struct linear_test_ctx *other;
+
+	other = kunit_kzalloc(test, sizeof(*other), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, other);
+	other->bound[0] = &ctx->cooling[0];
+	other->temperature = 70000;
+	KUNIT_ASSERT_EQ(test, linear_test_register_zone(test, other), 0);
+	linear_test_sample(ctx, 50000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 199UL);
+	linear_test_sample(ctx, 35000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 199UL);
+	linear_test_sample(other, 35000);
+	KUNIT_EXPECT_EQ(test, ctx->cooling[0].state, 0UL);
+}
+
+static struct kunit_case linear_test_cases[] = {
+	KUNIT_CASE(linear_test_curve),
+	KUNIT_CASE(linear_test_hysteresis),
+	KUNIT_CASE(linear_test_passive_and_critical),
+	KUNIT_CASE(linear_test_retry),
+	KUNIT_CASE(linear_test_shared_fan),
+	{}
+};
+
+static struct kunit_suite linear_test_suite = {
+	.name = "thermal-linear",
+	.init = linear_test_init,
+	.test_cases = linear_test_cases,
+};
+kunit_test_suite(linear_test_suite);

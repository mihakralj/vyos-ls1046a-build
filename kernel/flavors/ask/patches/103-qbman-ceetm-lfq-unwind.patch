Subject: [PATCH] qbman: unwind CEETM LFQ claims and drain pending ERNs

The LFQ claim reserves an ID before allocating its software object and
programming the mapping. Return the ID on either failure so a failed
QoS initialization does not exhaust the hardware pool on retry.

Expose a portal drain for pending enqueue rejections. CEETM queues have
no ordinary FQ retirement notification to synchronize against. Once
producers and their enqueue rings are quiesced, the owning CPU must
consume pending MR entries before destroying the FQ lookup entries.
Poll the MR directly: disabling its IRQ source clears the status bit,
so the normal status-driven slow poll cannot serve as this barrier.

Read the hardware enqueue consumer index when checking for an empty
ring: CI stashing can leave the cached index behind the final completion.
Keep cached enqueue accounting unchanged so subsequent enqueues cannot
misinterpret a stale cache value as consumer wraparound.

Expose CQ pop with descriptor ownership returned to software. Encode the
queue ID in hardware byte order and copy management results before
releasing the portal lock; convert popped descriptors to CPU byte order.
CDX can then reclaim stranded frames instead of discarding their FDs.

Upstream-Status: Pending

diff --git a/drivers/staging/fsl_qbman/qman_high.c b/drivers/staging/fsl_qbman/qman_high.c
index afb88db..2c78fe7 100644
--- a/drivers/staging/fsl_qbman/qman_high.c
+++ b/drivers/staging/fsl_qbman/qman_high.c
@@ -1539,6 +1539,27 @@ u32 qman_poll_slow(void)
 }
 EXPORT_SYMBOL(qman_poll_slow);
 
+void qman_drain_ern(void)
+{
+	struct qman_portal *p = get_raw_affine_portal();
+	unsigned long irqflags;
+
+#ifdef CONFIG_FSL_DPA_PORTAL_SHARE
+	if (p->sharing_redirect)
+		goto out;
+#endif
+	/* The owner normally consumes MR entries from its IRQ handler. */
+	local_irq_save(irqflags);
+	__poll_portal_slow(p, QM_PIRQ_MRI);
+	qm_isr_status_clear(&p->p, QM_PIRQ_MRI);
+	local_irq_restore(irqflags);
+#ifdef CONFIG_FSL_DPA_PORTAL_SHARE
+out:
+#endif
+	put_affine_portal();
+}
+EXPORT_SYMBOL(qman_drain_ern);
+
 /* Legacy wrapper */
 void qman_p_poll(struct qman_portal *p)
 {
@@ -2533,7 +2554,7 @@ int qman_eqcr_is_empty(void)
 
 	PORTAL_IRQ_LOCK(p, irqflags);
 	update_eqcr_ci(p, 0);
-	avail = qm_eqcr_get_fill(&p->p);
+	avail = qm_eqcr_get_hw_fill(&p->p);
 	PORTAL_IRQ_UNLOCK(p, irqflags);
 	put_affine_portal();
 	return avail == 0;
@@ -3603,10 +3624,10 @@ static int qman_ceetm_cq_peek_pop_xsfdrread(struct qm_ceetm_cq *cq,
 	switch (command_type) {
 	case 0:
 	case 1:
-		mcc->cq_ppxr.cqid = (cq->parent->idx << 4) | cq->idx;
+		mcc->cq_ppxr.cqid = cpu_to_be16((cq->parent->idx << 4) | cq->idx);
 		break;
 	case 2:
-		mcc->cq_ppxr.xsfdr = xsfdr;
+		mcc->cq_ppxr.xsfdr = cpu_to_be16(xsfdr);
 		break;
 	default:
 		break;
@@ -3619,15 +3640,17 @@ static int qman_ceetm_cq_peek_pop_xsfdrread(struct qm_ceetm_cq *cq,
 	DPA_ASSERT((mcr->verb & QM_MCR_VERB_MASK) ==
 				QM_CEETM_VERB_CQ_PEEK_POP_XFDRREAD);
 
+	/* The result belongs to this portal only while we hold its lock. */
+	res = mcr->result;
+	if (res == QM_MCR_RESULT_OK)
+		*cq_ppxr = mcr->cq_ppxr;
 	PORTAL_IRQ_UNLOCK(p, irqflags);
 	put_affine_portal();
 
-	res = mcr->result;
 	if (res != QM_MCR_RESULT_OK) {
 		pr_err("CEETM: CQ PEEK/POP/XSFDR READ failed\n");
 		return -EIO;
 	}
-	*cq_ppxr = mcr->cq_ppxr;
 	return 0;
 }
 
@@ -5266,6 +5289,26 @@ int qman_ceetm_cq_get_dequeue_statistics(struct qm_ceetm_cq *cq, u32 flags,
 }
 EXPORT_SYMBOL(qman_ceetm_cq_get_dequeue_statistics);
 
+int qman_ceetm_cq_pop(struct qm_ceetm_cq *cq, struct qm_fd *fd)
+{
+	struct qm_mcr_ceetm_cq_peek_pop_xsfdrread ppxr;
+	int ret;
+
+	ret = qman_ceetm_cq_peek_pop_xsfdrread(cq, 1, 0, &ppxr);
+	if (ret)
+		return ret;
+	/* The last frame can carry both the valid and empty bits. */
+	if (ppxr.stat & 0x1) {
+		*fd = ppxr.fd;
+		hw_fd_to_cpu(fd);
+		return 1;
+	}
+	if (ppxr.stat & 0x2)
+		return 0;
+	return -EAGAIN; /* QMan is still prefetching the next descriptor. */
+}
+EXPORT_SYMBOL(qman_ceetm_cq_pop);
+
 int qman_ceetm_drain_cq(struct qm_ceetm_cq *cq)
 {
 	struct qm_mcr_ceetm_cq_peek_pop_xsfdrread ppxr;
@@ -5308,8 +5351,10 @@ int qman_ceetm_lfq_claim(struct qm_ceetm_lfq **lfq,
 		return -ENODEV;
 	}
 	p = kmalloc(sizeof(*p), GFP_KERNEL);
-	if (!p)
-		return -ENOMEM;
+	if (!p) {
+		ret = -ENOMEM;
+		goto release_lfqid;
+	}
 	memset(&lfqmt_config, 0, sizeof(struct qm_mcc_ceetm_lfqmt_config));
 	p->idx = lfqid;
 	p->dctidx = (u16)(lfqid & CEETM_LFQMT_LFQID_LSB);
@@ -5326,10 +5371,18 @@ int qman_ceetm_lfq_claim(struct qm_ceetm_lfq **lfq,
 				lfqid, cq->idx);
 		list_del(&p->node);
 		kfree(p);
-		return -EINVAL;
+		ret = -EINVAL;
+		goto release_lfqid;
 	}
 	*lfq = p;
 	return 0;
+
+release_lfqid:
+	if (cq->parent->dcp_idx == qm_dc_portal_fman0)
+		qman_release_ceetm0_lfqid(lfqid);
+	else
+		qman_release_ceetm1_lfqid(lfqid);
+	return ret;
 }
 EXPORT_SYMBOL(qman_ceetm_lfq_claim);
 
diff --git a/include/linux/fsl_qman.h b/include/linux/fsl_qman.h
index 68225db..79785e3 100644
--- a/include/linux/fsl_qman.h
+++ b/include/linux/fsl_qman.h
@@ -2153,6 +2153,15 @@ int qman_poll_dqrr(unsigned int limit);
  */
 u32 qman_poll_slow(void);
 
+/**
+ * qman_drain_ern - consume pending enqueue rejection notifications
+ *
+ * Call on the owning CPU of each affine portal after stopping producers
+ * and draining their enqueue rings. The MR must normally be IRQ-driven;
+ * concurrent polling of the same portal is not permitted.
+ */
+void qman_drain_ern(void);
+
 /**
  * qman_poll - legacy wrapper for qman_poll_dqrr() and qman_poll_slow()
  *
@@ -3618,6 +3627,17 @@ int qman_ceetm_cq_get_dequeue_statistics(struct qm_ceetm_cq *cq, u32 flags,
  */
 int qman_ceetm_drain_cq(struct qm_ceetm_cq *cq);
 
+/**
+ * qman_ceetm_cq_pop - dequeue a frame for software reclamation
+ * @cq: the class queue, with producers stopped
+ * @fd: receives a CPU-endian descriptor when the return value is 1
+ *
+ * Returns 1 for a frame (the caller owns its buffers), 0 for an empty queue,
+ * -EAGAIN while QMan prefetches a descriptor, or another negative error.
+ * Keep queue and buffer ownership context alive until the queue is empty.
+ */
+int qman_ceetm_cq_pop(struct qm_ceetm_cq *cq, struct qm_fd *fd);
+
 	/* ---------------------- */
 	/* CEETM :: logical FQIDs */
 	/* ---------------------- */
diff --git a/drivers/staging/fsl_qbman/qman_low.h b/drivers/staging/fsl_qbman/qman_low.h
index 0e6fdf8..529f4fb 100644
--- a/drivers/staging/fsl_qbman/qman_low.h
+++ b/drivers/staging/fsl_qbman/qman_low.h
@@ -517,6 +517,17 @@ static inline u8 qm_eqcr_get_avail(struct qm_portal *portal)
 	return eqcr->available;
 }
 
+/* CI stashing can leave the cached index behind the final one or two
+ * completions. Teardown must read the hardware consumer index without
+ * advancing the cached accounting used by later enqueue operations. */
+static inline u8 qm_eqcr_get_hw_fill(struct qm_portal *portal)
+{
+	struct qm_eqcr *eqcr = &portal->eqcr;
+	u8 ci = qm_in(EQCR_CI_CINH) & (QM_EQCR_SIZE - 1);
+
+	return qm_cyc_diff(QM_EQCR_SIZE, ci, EQCR_PTR2IDX(eqcr->cursor));
+}
+
 static inline u8 qm_eqcr_get_fill(struct qm_portal *portal)
 {
 	register struct qm_eqcr *eqcr = &portal->eqcr;

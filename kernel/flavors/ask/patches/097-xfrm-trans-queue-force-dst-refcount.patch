diff --git a/net/xfrm/xfrm_input.c b/net/xfrm/xfrm_input.c
index 4952428ea..38fbd11d9 100644
--- a/net/xfrm/xfrm_input.c
+++ b/net/xfrm/xfrm_input.c
@@ -806,6 +806,30 @@ int xfrm_trans_queue_net(struct net *net, struct sk_buff *skb,
 	if (skb_queue_len(&trans->queue) >= READ_ONCE(net_hotdata.max_backlog))
 		return -ENOBUFS;
 
+	/* On the inbound transport-mode async-decap path, the skb may
+	 * arrive here with a noref dst (e.g. when nf_nat_ipv4_pre_routing
+	 * dropped the original after a daddr rewrite and a subsequent
+	 * ip_route_input_noref re-resolved it). The work item later runs
+	 * in workqueue context with only local_bh_disable(), where the
+	 * rcu_read_lock_held() check inside skb_dst_force() returns false
+	 * under PROVE_LOCKING; downstream skb_dst_force in
+	 * __xfrm_route_forward then trips its WARN.
+	 *
+	 * Convert any noref dst to refcounted now. Inbound callers
+	 * (xfrm4_rcv_encap_finish, xfrm6_transport_finish2) are inside
+	 * xfrm_input's outer rcu_read_lock so this is safe even when the
+	 * dst is noref. Outbound callers (esp_output_tail_tcp v4/v6) reach
+	 * here with a dst already refcounted by xfrm_output_one, so the
+	 * skb_dst_is_noref(skb) branch inside skb_dst_force() short-circuits
+	 * without invoking dst_hold_safe and the rcu requirement does not
+	 * apply. Same shape as commit 3bc07321ccc2 ("xfrm: Force a dst
+	 * refcount before entering the xfrm type handlers") for the
+	 * analogous crypto-async boundary one layer up.
+	 */
+	skb_dst_force(skb);
+	if (unlikely(!skb_dst(skb)))
+		return -EHOSTUNREACH;
+
 	BUILD_BUG_ON(sizeof(struct xfrm_trans_cb) > sizeof(skb->cb));
 
 	XFRM_TRANS_SKB_CB(skb)->finish = finish;

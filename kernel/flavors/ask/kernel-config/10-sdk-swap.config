# ASK vendored SDK DPAA stack — replaces mainline DPAA1 entirely.
# The SDK and mainline DPAA drivers claim the same hardware (fman, memac, qbman)
# and are mutually exclusive per their Kconfig guards.
#
# Disable mainline DPAA1:
# CONFIG_FSL_FMAN is not set
# CONFIG_FSL_DPAA_ETH is not set
# CONFIG_FSL_DPAA is not set
# CONFIG_FSL_BMAN is not set
# CONFIG_FSL_QMAN is not set
#
# Enable SDK DPAA1 (vendored from nxp-imx/linux-imx lf-6.12.y):
CONFIG_FSL_SDK_DPA=y
CONFIG_FSL_SDK_BMAN=y
CONFIG_FSL_SDK_QMAN=y
CONFIG_FSL_SDK_FMAN=y
CONFIG_FSL_SDK_DPAA_ETH=y
CONFIG_FSL_SDK_DPAA_CEETM=y

# === ASK flavor last-win config — SDK DPAA + NXP ASK 1.x symbols ===
# Applied LAST in the defconfig assembly chain (after all common fragments).
# Disables mainline DPAA (FSL_FMAN/FSL_DPAA/FSL_DPAA_ETH) and enables
# SDK DPAA (FSL_SDK_FMAN/FSL_SDK_DPAA_ETH) plus ASK-specific networking.
#
# Kconfig mutual exclusion: SDK symbols depend on !FSL_FMAN / !FSL_DPAA_ETH.
# Setting the SDK symbols forces mainline off via Kconfig dependency resolution.

# ── Enable Staging (required for drivers/staging/fsl_qbman/ Kconfig) ───
CONFIG_STAGING=y

# ── Disable mainline DPAA (mutually exclusive with SDK drivers) ─────────
# CONFIG_FSL_FMAN is not set
# CONFIG_FSL_DPAA is not set
# CONFIG_FSL_DPAA_ETH is not set
# CONFIG_FSL_BMAN is not set
# CONFIG_FSL_QMAN is not set

# ── Enable SDK DPAA drivers (ported from NXP lf-6.12.49-2.2.0) ─────────
CONFIG_FSL_SDK_DPA=y
CONFIG_FSL_SDK_BMAN=y
CONFIG_FSL_SDK_QMAN=y
CONFIG_FSL_SDK_FMAN=y
CONFIG_FSL_DPAA_HOOKS=y
CONFIG_FSL_SDK_DPAA_ETH=y
CONFIG_FSL_DPAA_1588=y
CONFIG_FSL_SDK_FMAN_RTC_API=y
CONFIG_FSL_SDK_FMAN_TEST=n

# ── ASK kernel modules — built OOT via we-are-mono/ASK repo ────────────
# (CONFIG_NXP_ASK / CONFIG_ASK_CDX / CONFIG_ASK_FCI / CONFIG_ASK_AUTO_BRIDGE
# are not used at kernel-build time; the modules are built separately via
# make -C $KSRC M=/path/to/ASK/cdx modules, etc.)

# ── ASK networking infrastructure ──────────────────────────────────────
CONFIG_CPE_FAST_PATH=y
CONFIG_INET_IPSEC_OFFLOAD=y
CONFIG_INET_ESP_OFFLOAD=y
CONFIG_NET_KEY=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_QOSMARK=y
CONFIG_NETFILTER_XT_QOSCONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# ── SDK buffer count (matching ASK defconfig) ──────────────────────────
CONFIG_FSL_DPAA_ETH_MAX_BUF_COUNT=640

# ── Kernel messaging (CMM netlink) ─────────────────────────────────────
CONFIG_CONNECTOR=y

# ── CAAM hardware crypto (already =y in stock, reinforced here) ────────
CONFIG_CRYPTO_DEV_FSL_CAAM_INTC=y
CONFIG_CRYPTO_DEV_FSL_CAAM_JR_UIO=y

# ── UIO (required by SDK DPAA) ─────────────────────────────────────────
CONFIG_UIO=y
CONFIG_UIO_CIF=y
CONFIG_UIO_PDRV_GENIRQ=y
CONFIG_UIO_DMEM_GENIRQ=y
CONFIG_UIO_AEC=y
CONFIG_UIO_SERCOS3=y
CONFIG_UIO_PCI_GENERIC=y
CONFIG_UIO_NETX=y
CONFIG_UIO_MF624=y

# ── Disable Xen virtualization (not needed on LS1046A embedded SoC) ────
# CONFIG_XEN is not set

# ── Disable vhost (VM host drivers — not needed on LS1046A embedded SoC) ──
# Xen was the original culprit (VHOST_XEN referencing missing desc_maps in
# NXP 6.12 kernel's vhost struct), but we disable vhost entirely.
# CONFIG_VHOST is not set

# ── Disable Xen (not needed on LS1046A, causes vhost build failure) ─────
# CONFIG_XEN is not set

# ── Disable IMX Mailbox (pm_system_irq_wakeup not exported in NXP 6.12) ──
# CONFIG_IMX_MBOX is not set

# ── FSL MC (Management Complex) support ────────────────────────────────
CONFIG_FSL_MC_UAPI_SUPPORT=y

# ── DPDK-compatible devmem (disable strict devmem for DPAA PMD) ────────
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set

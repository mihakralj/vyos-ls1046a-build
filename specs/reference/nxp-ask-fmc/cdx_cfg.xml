<cfgdata>
<config>
  <engine name="fm0">
    <port type="1G" number="0" policy="cdx_ethport_0_policy" portid="0"/>
    <port type="1G" number="1" policy="cdx_ethport_1_policy" portid="1"/>
    <port type="1G" number="2" policy="cdx_ethport_2_policy" portid="2"/>
    <port type="1G" number="3" policy="cdx_ethport_3_policy" portid="3"/>
    <port type="1G" number="4" policy="cdx_ethport_4_policy" portid="4"/>
    <port type="1G" number="5" policy="cdx_ethport_5_policy" portid="5"/>
    <port type="10G" number="0" policy="cdx_ethport_6_policy" portid="6"/>
    <!-- Second 10G cage (eth4/LAN on gateway-dk). Without this line the
         LAN-ingress port has no PCD tables, so LAN->WAN flows can never
         classify and tunnel/CT offload only works in the WAN-ingress
         direction. cdx_ethport_7_policy already existed in cdx_pcd.xml. -->
    <port type="10G" number="1" policy="cdx_ethport_7_policy" portid="7"/>
    <port type="OFFLINE" number="1" policy="cdx_port_of2_policy" portid="9"/>
    <port type="OFFLINE" number="2" policy="cdx_port_of3_policy" portid="10"/>
  </engine>
</config>
</cfgdata>

# Rig settings for the bin/testrig-* harness. Copy to ~/.config/testrig.env (or point
# TESTRIG_ENV at another file) on the controller, then edit. Format: KEY=value, one per line,
# no shell syntax; a leading ~/ or $HOME is expanded. Environment variables override this file.

# SSH targets on the management network (key-based login, sudo without a password on the generators)
GEN1=user@gen1.example.net
GEN2=user@gen2.example.net
ASK2_DUT=vyos@dut-vyos.example.net
VENDOR_DUT=root@dut-vendor.example.net

# SSH private key for all four hosts; leave empty to use the ssh defaults or an agent
RIG_KEY=~/.ssh/id_ed25519

# Result directory on the controller
RIG_OUT=~/testrig/out

# Generator NIC ports: GEN_IF faces the first DUT, GEN_IF_NS the second DUT (kept in VENDOR_NS)
GEN_IF=enp1s0f0np0
GEN_IF_NS=enp1s0f1np1
VENDOR_NS=n106

# PPPoE test account (password only in gen1's /etc/ppp/chap-secrets) and the rp-pppoe plugin on gen1
PPPOE_USER=pppoe-test
PPPOE_PLUGIN=/usr/lib/pppd/2.5.2/rp-pppoe.so

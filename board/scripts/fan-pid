#!/usr/bin/env python3
"""
fan-pid — PID-based EMC2305 fan controller for the LS1046A Mono Gateway DK.

Replaces the stock `fancontrol` linear-curve daemon with a multi-zone PID loop
that drives the EMC2305 PWM from the *hottest* of the SoC's five thermal zones
(ddr, serdes, fman, cluster, sec) plus an EMA filter on the fan tachometer.

Why PID instead of fancontrol's linear ramp?
  - smoother PWM trajectory  -> lower acoustic noise band crossings (~80 PWM)
  - longer fan-bearing life   -> fewer step changes
  - per-zone setpoints        -> SerDes/FMan/SEC get their own dT and target
  - explicit safety ladder    -> hard MAXPWM at any zone >= ZONE.crit_temp,
                                  hard FAULT log if any zone reaches 100 C

Why a single Python file?
  - same idiom as the existing fancontrol-setup.sh / sfp-check / ask-conntrack-fix
  - no extra runtime deps (Python 3 + sysfs already shipped in VyOS)
  - one systemd unit, one config block at the top, no dotfiles

Hardware refs (LS1046A RM, AGENTS.md):
  EMC2305 at i2c-7 addr 0x2e (hwmon by name, NOT by number — index drifts)
  Cortex-A72 cluster T_J,throttle = 95 C, T_J,max = 105 C
  Per-fan "spinning floor" is NOT hardcoded — it is discovered at boot and
    refined at runtime (see the calibration/self-heal section below), because
    users may attach different fans to CH1/CH2. The chip honors arbitrary
    0..255 values via /dev/i2c — the floor is the FAN's, not the silicon's.
    (Earlier "EMC2305 quantizes at 51" lore was actually a kernel 6.18 sysfs
    driver bug; see the EMC2305_I2C_ADDR comment block.)
  Mono Gateway has hardware inverter on TX_DISABLE (irrelevant here, noted only
    so future GPIO-related fan-fault designs don't repeat the misdiagnosis logged
    in qdrant under "SFP+ misdiagnosis log").

Algorithm summary:
  Every TICK seconds:
    1. Read all 5 thermal zones.  If any is unreadable, retain previous value
       (sysfs reads under thermal-poll contention can transiently fail).
    2. For each zone, compute error = T - setpoint.  Run a per-zone PI
       controller: PWM_i = clamp(MIN_PWM, MAX_PWM, PWM_floor + Kp*err + Ki*sum_err).
       Anti-windup: clamp the integral term to +/- (MAX_PWM - PWM_floor) / Ki.
    3. Final PWM = max( PWM_i for all zones ).  This is the protective max-policy:
       any zone individually demanding more cooling wins.
    4. Hard ceiling: if ANY zone >= crit_temp, force PWM = MAX_PWM.  Anti-windup
       reset on all zones to prevent overshoot when temps drop again.
    5. Hard fault: if ANY zone >= 100 C, syslog at LOG_CRIT and force PWM = 255
       (silicon damage threshold).  Continue running.
    6. EMA-smooth the final shared demand (alpha = EMA_ALPHA), then clamp each
       physical fan up to its dynamically-learned spinning floor and write both
       EMC2305 duty registers directly over /dev/i2c.
    7. Read both tachs every tick and self-heal each floor: raise/re-kick after
       repeated blind reads at the floor; lower slowly after sustained comfortable
       RPM. Export live floors to /run/fan-pid/floors for fan-check.
    8. Log every LOG_INTERVAL seconds: per-zone temp/demand plus each fan's
       floor/current/max and tach RPM.

Tuning rationale (Kp / Ki / setpoints) — see code constants below.

ExecStart contract: runs in foreground, writes stderr to journald.  SIGTERM
clean-shutdown: leaves PWM at MAX_PWM (255) so a daemon crash doesn't silently
suffocate the SoC.  Use `systemctl stop fan-pid` only when you intend to stop
managing the fan; it will go to full speed.
"""
from __future__ import annotations

import array
import errno
import fcntl
import os
import re
import signal
import struct
import sys
import syslog
import time
from dataclasses import dataclass, field
from typing import Optional


# ---------- Tuning constants -----------------------------------------------------
# Per-zone controller parameters.  Setpoints picked from LS1046A RM and AGENTS.md
# field experience:
#   ddr (commercial-grade DDR4):      derate above 85 C, conservative target 65
#   serdes (10G PCS, hot under load): T_J,max 105, target 70 with extra headroom
#   fman (microcode RAM hot-spot):    T_J,max 105, target 70 (FMan is the hottest
#                                      die area when forwarding @ 10 Gbps)
#   cluster (A72 quad):               throttle 95, target 65 to leave 30 C burst headroom
#   sec (CAAM JR):                    T_J,max 105, target 65 under sustained IPsec
#
# Setpoint = "the temperature we want this zone to hold under steady-state load".
# Crit_temp = "if exceeded, force MAX_PWM regardless of PI state" (5 C below the
#             throttle/derate point so we still have margin for transient spikes).
#
# Kp and Ki are PWM-units per degree-C error.  Tuned for the EMC2305 + small
# DC-axial fan time constant (fan: ~3 s rise from MIN to MAX duty; SoC zones:
# 2 s for serdes/fman, 5 s for cluster/sec, ~30 s for ddr).
#
# Why per-zone Kp/Ki instead of one shared loop?
#   - Different time constants need different gains.  A single Ki tuned for ddr
#     (slow) would cause cluster (fast) to oscillate.  A single Ki tuned for
#     cluster would windup before ddr ever moved.
#   - Per-zone integrals also allow each zone to "settle into" its own quiet
#     PWM without dragging the others along.
@dataclass
class Zone:
    name: str            # /sys/class/thermal/thermal_zone*/type string
    setpoint: float      # target temp (C)
    crit_temp: float     # if T >= crit, force MAX_PWM
    kp: float            # proportional gain (PWM per C)
    ki: float            # integral gain (PWM per (C * tick))
    # runtime state
    last_temp: float = 0.0
    integral: float = 0.0
    last_pwm: float = 0.0


# Gains softened 2026-05-17 after field observation that a single-tick
# cluster spike of ~+15 C above setpoint produced an immediate PWM jump
# from 40 (kick-start floor) to ~77 (30 %), audibly ramping the fan from
# ~1.6k RPM to ~2.6k RPM and back within ~5 s. Kp values reduced by ~40 %
# so the same transient now produces pwm_i ~= 45 (barely above MIN_RUN)
# and the EMA blends it down further. Ki values kept proportional so the
# steady-state set-point tracking time constant is unchanged: a sustained
# +15 C error still drives PWM to MAX within roughly the same number of
# ticks as before, it just no longer overreacts to single-sample noise.
ZONES = [
    Zone("ddr-thermal",     setpoint=65.0, crit_temp=80.0, kp=2.5,  ki=0.20),
    Zone("serdes-thermal",  setpoint=70.0, crit_temp=85.0, kp=3.5,  ki=0.30),
    Zone("fman-thermal",    setpoint=70.0, crit_temp=87.0, kp=3.5,  ki=0.30),
    Zone("cluster-thermal", setpoint=65.0, crit_temp=85.0, kp=3.0,  ki=0.25),
    Zone("sec-thermal",     setpoint=65.0, crit_temp=85.0, kp=3.0,  ki=0.25),
]
# Aliases tolerated for thermal_zone "type" string differences across kernels.
# (mainline 6.18 uses "ddr-thermal"/"cluster-thermal", SDK 6.6 uses
#  "core_cluster" instead of "cluster-thermal".  Add as encountered.)
ZONE_ALIASES = {
    "cluster-thermal": ("core_cluster", "cluster_thermal"),
    "ddr-thermal":     ("ddr_thermal",),
    "fman-thermal":    ("fman_thermal",),
    "serdes-thermal":  ("serdes_thermal",),
    "sec-thermal":     ("sec_thermal",),
}

PWM_FLOOR    = 0     # PWM applied when all zones at/below setpoint
PWM_MAX      = 255   # full speed
PWM_DEADBAND = 3     # don't write to sysfs for changes smaller than this

# ---------- Per-fan spinning-floor calibration + self-heal ----------------------
# The "spinning floor" is the lowest duty at which a fan spins fast enough to
# run HEALTHY — at or above RUN_MARGIN_RPM, which sits safely above the EMC2305
# tach saturation cliff (~484 RPM at RANGE=500/m=1; ~960 on the sysfs fallback).
# It is a property of whatever fan the user has plugged into each port, so it is
# NOT hardcoded — it is discovered at every boot and then continuously refined by
# the daemon. The margin (not the bare tach floor) is the target so the loop
# never parks a fan on the stall edge where the reading flaps 0<->~500.
#
# Two-stage discovery:
#   1. BOOT PROBE (fast, ~15-30 s, both fans in parallel): a from-above
#      bisection gives an optimistic starting guess. It is fast because it does
#      NOT wait for each candidate to reach thermal steady state — so on a
#      weak/low-inertia fan it can read a momentum-inflated RPM and guess a
#      floor a few units too low. That is fine; the daemon fixes it.
#   2. RUNTIME SELF-HEAL (two-sided): the daemon reads each fan's tach every
#      tick and already knows its own commanded duty, so it can tell truth from
#      the stall edge:
#        - commanded >= floor but tach < RUN_MARGIN_RPM for RAISE_TICKS ticks ->
#          floor was too low: floor += RAISE_STEP. Re-kick only if rpm==0.
#        - pinned AT floor with sustained headroom above RUN_MARGIN_RPM for
#          LOWER_TICKS ticks -> floor may be too high: floor -= 1 (slow step).
#      Asymmetric timing/steps + a comfort margin + post-raise cooldown keep the
#      two directions from oscillating; it settles within ~a minute of boot.
#
# Below its floor a fan may still be turning but the tach can't see it (BLIND) —
# the loop never commands below the floor, so a fan never drops out of view.
FLOOR_MIN        = 20    # never trust/allow a floor below this
FLOOR_MAX        = 160   # safety ceiling for a runaway self-heal
FLOOR_GUESS      = 60    # fallback starting floor if the boot probe fails
RAISE_TICKS      = 3     # ticks of (cur>=floor & near-stall) before raising (~6 s)
RAISE_STEP       = 2     # base units to bump the floor on the FIRST near-stall hit
RAISE_STEP_MAX   = 8     # cap on the escalated step (step = RAISE_STEP * raise_run,
                         # clamped here) so a low boot guess converges in a few
                         # steps instead of crawling +2/tick, without overshooting
                         # wildly past the true floor on the last jump
RAISE_STABLE_TICKS = 10  # healthy pinned-at-floor ticks (~20 s) before resetting
                         # raise escalation; shorter post-kick coast-down samples
                         # must NOT masquerade as convergence and restart at +2
LOWER_TICKS      = 15    # ticks pinned-at-floor & with headroom before lowering (~30 s)
TACH_FLOOR_RPM   = 484   # EMC2305 can't resolve below ~this with RANGE=500 (m=1);
                         # at/under it -> reads 0. Lowered from 960 on 2026-08-23
                         # when the daemon switched the chip to the 500 RPM range
                         # and moved to raw 13-bit tach reads (see EMC2305 tach
                         # comment block); ~484 is the true silicon floor at m=1.
# RUN_MARGIN_RPM is the lowest speed we consider a HEALTHY running fan. It sits
# safely ABOVE the ~484 RPM tach saturation cliff so the control loop never parks
# a fan on the edge where one RPM of real variation flips it between "readable"
# and "stalled/480" (the fan2 kick-oscillation observed on .185 2026-08-23: fan2
# stalls just under duty ~59, and a floor at 61/502 rpm sat right on that cliff,
# so every sag to 480 triggered a full 255 re-kick). Measured fan2 curve:
# duty 64 -> 530 rpm steady, 61 -> 502, 58 -> 480(stall). 530 keeps a real fan
# ~50 rpm clear of the cliff while leaving a fast fan (fan1: ~540 rpm at duty 31)
# at its low floor. A fan whose tach reads BELOW this margin (but nonzero) is
# treated as near-stall for RAISE, and LOWER will never push a fan under it.
RUN_MARGIN_RPM   = 530   # healthy-running floor; must stay > TACH_FLOOR_RPM
LOWER_HEADROOM   = 220   # only LOWER if the at-floor RPM sits this far above the
                         # run margin (i.e. rpm >= RUN_MARGIN_RPM + 220 = 750), so
                         # LOWER stops well before the cliff and a one-step drop
                         # can't land the fan in the near-stall band. Combined with
                         # the post-raise cooldown this prevents the RAISE/LOWER
                         # oscillation across a fan's stall edge.
RAISE_COOLDOWN   = 20    # ticks after a raise during which lowering is blocked
# Runtime export for fan-check. Lives under the systemd RuntimeDirectory=fan-pid
# (/run/fan-pid), which is writable under ProtectSystem=strict AND auto-removed
# when the unit stops — so fan-check never reads a stale floor from a dead daemon.
FLOOR_STATE_DIR  = "/run/fan-pid"
FLOOR_STATE_FILE = FLOOR_STATE_DIR + "/floors"
EMA_ALPHA    = 0.25  # 0 = no smoothing, 1 = no history; 0.25 ~= 3 tick lag.
                     # Lowered from 0.4 on 2026-05-17 alongside the Kp
                     # reduction so a single-tick high P-term contributes
                     # only ~25 % to the actuator command this tick; a
                     # transient that doesn't repeat across ~3 ticks is
                     # filtered out before reaching the fan. Sustained
                     # high temps still reach MAX_PWM in well under the
                     # SoC's own thermal time constant.

TICK_SECONDS = 2.0   # control loop period
LOG_INTERVAL = 30.0  # seconds between INFO log lines (use DEBUG for every tick)

EMC2305_HWMON_NAME = "emc2305"
PWM_FILE  = "pwm1"
FAN_FILE  = "fan1_input"

# Physical fans wired to the EMC2305 on the Mono Gateway DK. Each entry pairs a
# duty register (written via /dev/i2c — the kernel sysfs PWM path is broken on
# 6.18, see EMC2305_I2C_ADDR) with both its raw TACH register and legacy sysfs
# tach file. Raw TACH is used after RANGE=500 programming; sysfs is only the m=2
# fallback. Per-fan floors are discovered at boot and refined at runtime.
#   CH1 (F_1) = reg 0x30 / fan1_input : chassis fan
#   CH2 (F_2) = reg 0x40 / fan2_input : auxiliary fan (added 2026-08)
# Both fans track the same max-policy PID output; each is independently clamped
# up to its own floor and logged separately. A fan whose tach reads 0 at full
# drive during startup presence-detection is flagged absent and left undriven.
FAN_DEFS = [
    {"name": "fan1", "duty_reg": 0x30, "tach_file": "fan1_input", "tach_reg": 0x3e},
    {"name": "fan2", "duty_reg": 0x40, "tach_file": "fan2_input", "tach_reg": 0x4e},
]

# Set True once set_tach_range_500() succeeds; the daemon then reads RPM from the
# raw 13-bit TACH register (m=1, floor ~484 RPM) instead of the sysfs fanN_input
# path (kernel driver m=2, floor ~960 RPM). If RANGE programming fails we leave
# this False and fall back to sysfs so RPM is never silently 2x-inflated.
USE_RAW_TACH = False

# Direct-i2c bypass for the broken kernel emc2305 sysfs PWM path.
#
# Symptom (verified on kernel 6.18.28-vyos hwmon3 / i2c-7 0x2e on
# 2026-05-11): writing N to /sys/class/hwmon/hwmonN/pwm1 returns
# success and read-back returns N for ~1 second, then the sysfs read
# spontaneously reverts to 255, the chip's actual duty register
# (0x30) stays at 0xFF, and the fan stays at MAX RPM. The kernel
# emc2305 driver in 6.18 silently drops sub-MAX writes — the chip
# itself is in direct-PWM mode (FAN_CONFIG1 bit7=0, FSC disabled),
# so writing the duty register over /dev/i2c-7 with I2C_SLAVE_FORCE
# works perfectly: writing 51 to register 0x30 immediately drops
# fan RPM from ~8700 to ~1700. Therefore fan-pid bypasses sysfs
# entirely for PWM writes and goes straight to the chip via
# /dev/i2c-<bus> + I2C_SLAVE_FORCE.
#
# Tach reads also use direct i2c after the daemon programs RANGE=500. The kernel
# driver hard-codes the default m=2 multiplier and ~960 RPM clamp, so its sysfs
# fanN_input would be 2x too high after RANGE changes to m=1. The raw 13-bit
# conversion below mirrors the kernel math with the correct m=1 multiplier.
#
# Required: i2c-dev module loaded so /dev/i2c-* exists. The
# `lm-sensors` apt package would normally install
# /etc/modules-load.d/i2c-dev.conf; we don't ship lm-sensors, so
# `i2c-dev` is loaded explicitly via `modprobe` in this daemon
# (defensive — already auto-loads on most distros from the i2c-tools
# udev rule).
EMC2305_I2C_ADDR = 0x2e          # SMBus 7-bit address on i2c-7
EMC2305_FAN1_DUTY_REG = 0x30     # bit7..0 = direct PWM duty 0..255
EMC2305_FAN2_DUTY_REG = 0x40
I2C_SLAVE_FORCE = 0x0706         # ioctl: claim addr even if kernel driver bound

# ---------- EMC2305 tachometer: lower the readable floor to ~484 RPM ------------
# The tachometer does NOT measure RPM directly. It counts ticks of the internal
# 32.768 kHz clock between fan tach edges over a measurement window, so a SLOWER
# fan produces a LARGER count. RPM is the inverse of that count:
#
#     RPM = (3,932,160 * m) / COUNT          (2-pole fan, 5 edges; SMSC AN 17.4)
#
# where m is the RANGE multiplier set by bits [6:5] of the Fan Configuration
# register (0x32 ch1 / 0x42 ch2):
#     RANGE bits 00 -> 500 RPM range  -> m=1  -> min measurable ~484 RPM
#     RANGE bits 01 -> 1000 RPM range -> m=2  -> min measurable ~968 RPM  (chip default)
#     RANGE bits 10 -> 2000 RPM range -> m=4  -> min measurable ~1935 RPM
#     RANGE bits 11 -> 4000 RPM range -> m=8  -> min measurable ~3870 RPM
# Below the min the COUNT saturates at the FFh high byte and reads as "stopped".
#
# TWO floors are stacked in the default configuration and coincide near 960 RPM:
#   1. The kernel emc2305 driver HARD-CODES m=2 (TACH_CNT_MULTIPLIER) and a
#      clamp `if (rpm <= 480) return 0`, i.e. it reports 0 below 480*2 = 960 RPM
#      via sysfs fanN_input regardless of the chip's real capability. This is a
#      software `return 0`, not silicon.
#   2. The chip itself, left at its m=2 default RANGE, saturates its count near
#      968 RPM.
#
# We lower BOTH: program RANGE=500 (m=1) on each channel's config register, and
# read the raw 13-bit TACH word ourselves over /dev/i2c applying RPM = FACTOR/COUNT
# with m=1. This drops the readable floor from ~960 RPM to ~484 RPM (the true
# silicon limit at m=1 — nothing resolves below it). Accuracy cost is a doubling
# of the RPM-per-count quantization step (e.g. ~0.6 -> ~1.1 RPM at 1500 RPM,
# ~19 -> ~38 RPM at 8700 RPM), which is negligible: the chip's own +/-1%
# oscillator tolerance (+/-87 RPM at 8700) already dwarfs it across the whole
# operating band. We do NOT touch the kernel driver — sysfs fanN_input stays on
# the driver's m=2 clamp; the daemon and fan-check use the raw path instead.
EMC2305_RPM_FACTOR      = 3932160  # (poles=2, edges=5) numerator from SMSC AN 17.4
EMC2305_TACH_UNUSE_BITS = 3        # low 3 bits of the 16-bit TACH word are unused
EMC2305_CFG_REG_FAN1    = 0x32     # Fan Configuration 1 register (ch1)
EMC2305_CFG_REG_FAN2    = 0x42     # Fan Configuration 1 register (ch2)
EMC2305_TACH_REG_FAN1   = 0x3e     # TACH reading high byte (ch1); word-swapped read
EMC2305_TACH_REG_FAN2   = 0x4e     # TACH reading high byte (ch2)
EMC2305_RANGE_MASK      = 0x60     # bits [6:5]
EMC2305_RANGE_500       = 0x00     # bits [6:5]=00 -> 500 RPM range, m=1
EMC2305_TACH_MULTIPLIER = 1        # matches RANGE_500 (m=1)
# Silicon floor at m=1: FACTOR/(0x1FE0>>0 ... last readable count). Anything at or
# below this reads 0 (blind); the daemon keeps the operating point above it.
TACH_SILICON_FLOOR_RPM  = 484

HARD_FAULT_TEMP = 100.0  # at/above this any zone triggers a CRIT log

# Boot whistle: audible attention-getter chirp played once at daemon startup
# so the operator can confirm the box has reached usable runtime state without
# needing a serial console or network to be up. Six pulses of (low, high,
# low, high…) at ~3 Hz make a recognisable "wheeeeu-wheeeeu" pattern that
# is distinct from any organic fan modulation under load.
# Mirrors the legacy boot-complete-notify.sh behavior (which has been
# absorbed into this daemon — single PWM owner, no race over /sys/.../pwm1).
WHISTLE_PULSES   = 6
WHISTLE_LOW_PWM  = 130   # ~50 % duty — soft tone
WHISTLE_HIGH_PWM = 255   # full speed — loud tone
WHISTLE_HALF_S   = 0.3   # seconds per half-cycle (low or high)
PRESENCE_SPINUP_S = 3.0  # hold all channels at MAX this long before presence
                         # detection, so a slow/heavy arbitrary fan has time to
                         # cross the tach floor (the whistle's last 255 phase is
                         # only ~0.3 s — too short to trust a 0-rpm read).


# ---------- sysfs helpers --------------------------------------------------------
def find_emc2305_pwm() -> tuple[str, str]:
    """Locate EMC2305 hwmon by name (numbers drift across boots).

    Returns (pwm_path, fan_input_path) both absolute.  pwm_path is kept
    only for legacy callers / introspection — actual PWM writes go via
    /dev/i2c (find_emc2305_i2c() below) because the kernel emc2305 sysfs
    PWM interface is broken on 6.18 (silently drops sub-MAX writes).
    Raises RuntimeError if EMC2305 not present (board not Mono Gateway DK,
    or i2c bus is broken).
    """
    for entry in sorted(os.listdir("/sys/class/hwmon")):
        if not entry.startswith("hwmon"):
            continue
        name_path = f"/sys/class/hwmon/{entry}/name"
        try:
            with open(name_path) as f:
                if f.read().strip() == EMC2305_HWMON_NAME:
                    pwm  = f"/sys/class/hwmon/{entry}/{PWM_FILE}"
                    fan  = f"/sys/class/hwmon/{entry}/{FAN_FILE}"
                    if not os.path.exists(pwm):
                        raise RuntimeError(f"{pwm} missing — wrong EMC2305 channel?")
                    return pwm, fan
        except OSError:
            continue
    raise RuntimeError("EMC2305 hwmon not found (no entry named 'emc2305')")


def find_emc2305_i2c() -> int:
    """Open /dev/i2c-<bus> for the EMC2305 and claim 0x2e with I2C_SLAVE_FORCE.

    Walks /sys/bus/i2c/devices/ for an entry of the form '<bus>-002e' bound to
    the emc2305 driver, opens the corresponding /dev/i2c-<bus> char device,
    and issues the I2C_SLAVE_FORCE ioctl so we can talk to the chip even
    though the kernel emc2305 driver also has it claimed (the FORCE variant
    of I2C_SLAVE permits this; the unforced variant returns EBUSY).

    Returns an open i2c bus fd. Caller must os.close() it on shutdown.
    Raises RuntimeError if no EMC2305 is bound to the i2c subsystem
    (would only happen on a board that lacks the chip).
    """
    rx = re.compile(r"^(\d+)-002e$")
    for entry in sorted(os.listdir("/sys/bus/i2c/devices")):
        m = rx.match(entry)
        if not m:
            continue
        bus = int(m.group(1))
        # Confirm it's actually an emc2305 (could be another chip at 0x2e
        # on a different board); read the symlinked driver name.
        drv = f"/sys/bus/i2c/devices/{entry}/driver"
        if os.path.islink(drv):
            target = os.path.basename(os.readlink(drv))
            if target != "emc2305":
                continue
        dev = f"/dev/i2c-{bus}"
        if not os.path.exists(dev):
            # i2c-dev module not loaded — best-effort modprobe.
            try:
                os.system("modprobe i2c-dev >/dev/null 2>&1")
            except Exception:
                pass
        if not os.path.exists(dev):
            raise RuntimeError(f"{dev} missing (i2c-dev module not loaded?)")
        fd = os.open(dev, os.O_RDWR)
        try:
            fcntl.ioctl(fd, I2C_SLAVE_FORCE, EMC2305_I2C_ADDR)
        except OSError:
            os.close(fd)
            raise
        return fd
    raise RuntimeError("No EMC2305 found on any i2c bus (no <bus>-002e entry under /sys/bus/i2c/devices)")


def i2c_write_pwm(i2c_fd: int, value: int, duty_reg: int = EMC2305_FAN1_DUTY_REG) -> None:
    """Write `value` (0..255) to an EMC2305 fan duty register (0x30 fan1, 0x40 fan2).

    SMBus byte-data write: send two bytes (register, value). The kernel
    i2c char-dev does the SMBus-vs-i2c framing for us when called via
    plain os.write because the EMC2305 register protocol is "register
    address byte, then data byte" — identical to what os.write delivers.

    Errors are logged but NOT raised (a transient i2c NACK shouldn't kill
    the controller; we'll retry next tick).
    """
    try:
        os.write(i2c_fd, bytes([duty_reg, value & 0xFF]))
    except OSError as e:
        syslog.syslog(syslog.LOG_WARNING, f"fan-pid: i2c write failed (reg 0x{duty_reg:02x}): {e}")


def i2c_write_all_fans(i2c_fd: int, value: int) -> None:
    """Write the same duty to both physical fan channels."""
    for fan in FAN_DEFS:
        i2c_write_pwm(i2c_fd, value, fan["duty_reg"])


# ---------- EMC2305 raw register read/modify (SMBus over /dev/i2c) ---------------
# We must READ registers (config for read-modify-write, TACH for RPM), not just
# write them. The kernel i2c-dev SMBus ioctl (I2C_SMBUS = 0x0720) gives us
# atomic byte/word transactions without depending on the (already-claimed)
# in-kernel emc2305 driver. Structs match <linux/i2c-dev.h> /
# <linux/i2c.h> i2c_smbus_ioctl_data.
I2C_SMBUS            = 0x0720
I2C_SMBUS_READ       = 1
I2C_SMBUS_WRITE      = 0
I2C_SMBUS_BYTE_DATA  = 2
I2C_SMBUS_WORD_DATA  = 3


def _smbus_xfer(i2c_fd: int, read_write: int, command: int,
                size: int, value: int = 0) -> int:
    """Issue one I2C_SMBUS ioctl. Returns the read value for reads (else 0).

    Builds the i2c_smbus_ioctl_data struct pointing at a 34-byte data block
    (union i2c_smbus_data: byte/word live in the first 2 bytes). Raises OSError
    on ioctl failure so callers can decide whether to swallow it.
    """
    # union i2c_smbus_data data; (max block is 32+2 bytes)
    data = bytearray(34)
    if read_write == I2C_SMBUS_WRITE:
        if size == I2C_SMBUS_BYTE_DATA:
            data[0] = value & 0xFF
        elif size == I2C_SMBUS_WORD_DATA:
            data[0] = value & 0xFF
            data[1] = (value >> 8) & 0xFF
    buf = array.array("B", bytes(data))
    addr = buf.buffer_info()[0]
    # struct i2c_smbus_ioctl_data { u8 read_write; u8 command; u32 size; ptr; }
    ioctl_data = struct.pack("BBIQ", read_write & 0xFF, command & 0xFF,
                             size, addr)
    ibuf = array.array("B", ioctl_data)
    fcntl.ioctl(i2c_fd, I2C_SMBUS, ibuf, True)
    if read_write == I2C_SMBUS_READ:
        if size == I2C_SMBUS_WORD_DATA:
            return buf[0] | (buf[1] << 8)
        return buf[0]
    return 0


def i2c_read_byte(i2c_fd: int, reg: int) -> Optional[int]:
    """SMBus read-byte-data from `reg`. Returns None on i2c error."""
    try:
        return _smbus_xfer(i2c_fd, I2C_SMBUS_READ, reg, I2C_SMBUS_BYTE_DATA)
    except OSError as e:
        syslog.syslog(syslog.LOG_WARNING,
                      f"fan-pid: i2c read failed (reg 0x{reg:02x}): {e}")
        return None


def i2c_read_word(i2c_fd: int, reg: int) -> Optional[int]:
    """SMBus read-word-data from `reg`. Returns None on i2c error.

    The EMC2305 TACH reading is High-byte-first (big-endian on the wire); the
    SMBus word transfer returns it little-endian, so callers that need the
    High byte in the MSB position must byte-swap. read_fan_rpm_raw() below
    handles that.
    """
    try:
        return _smbus_xfer(i2c_fd, I2C_SMBUS_READ, reg, I2C_SMBUS_WORD_DATA)
    except OSError as e:
        syslog.syslog(syslog.LOG_WARNING,
                      f"fan-pid: i2c read failed (reg 0x{reg:02x}): {e}")
        return None


def set_tach_range_500(i2c_fd: int) -> None:
    """Program RANGE=500 RPM (m=1) on both fan config registers.

    Read-modify-write bits [6:5]=00 of the Fan Configuration 1 register for each
    channel, preserving EDGES/UPDATE and the FSC-enable bit. This lowers the
    chip's minimum measurable speed from ~968 RPM (m=2 default) to ~484 RPM.
    Best-effort: an i2c error is logged, not fatal — the daemon still runs, it
    just keeps the higher floor (and read_fan_rpm_raw would then over-report by
    ~2x, so on failure we fall back to the sysfs tach path in the caller).
    """
    ok = True
    for reg in (EMC2305_CFG_REG_FAN1, EMC2305_CFG_REG_FAN2):
        cur = i2c_read_byte(i2c_fd, reg)
        if cur is None:
            ok = False
            continue
        new = (cur & ~EMC2305_RANGE_MASK) | EMC2305_RANGE_500
        if new != cur:
            try:
                _smbus_xfer(i2c_fd, I2C_SMBUS_WRITE, reg,
                            I2C_SMBUS_BYTE_DATA, new)
            except OSError as e:
                syslog.syslog(syslog.LOG_WARNING,
                              f"fan-pid: RANGE write failed (reg 0x{reg:02x}): {e}")
                ok = False
                continue
        syslog.syslog(syslog.LOG_INFO,
                      f"fan-pid: EMC2305 cfg 0x{reg:02x}: 0x{cur:02x} -> 0x{new:02x} "
                      f"(RANGE=500 RPM, m=1)")
    if not ok:
        raise RuntimeError("could not program EMC2305 RANGE=500 on all channels")


def read_fan_rpm_raw(i2c_fd: int, tach_reg: int) -> Optional[int]:
    """Read fan RPM from the raw 13-bit TACH register at m=1 (RANGE=500).

    RPM = EMC2305_RPM_FACTOR / COUNT, where COUNT is the 13-bit value (the low 3
    bits of the 16-bit TACH word are unused). Returns 0 when the count is in the
    saturated (fan-stopped / below ~484 RPM) region, None on i2c error. Mirrors
    the kernel driver math but with m=1 instead of the driver's hard-coded m=2.
    """
    word = i2c_read_word(i2c_fd, tach_reg)
    if word is None:
        return None
    # SMBus word read is little-endian; the EMC2305 sends the High byte first
    # (this is exactly what the kernel driver's i2c_smbus_read_word_swapped does),
    # so swap to reconstruct the 16-bit register value (High<<8 | Low).
    raw = ((word & 0xFF) << 8) | ((word >> 8) & 0xFF)
    count = raw >> EMC2305_TACH_UNUSE_BITS
    if count == 0:
        return 0  # guard divide-by-zero (shouldn't occur; FFF8 -> count 0x1FFF)
    # Same math as the kernel driver (RPM = FACTOR / count) but with the m=1
    # multiplier that matches RANGE=500 instead of the driver's hard-coded m=2.
    rpm = (EMC2305_RPM_FACTOR * EMC2305_TACH_MULTIPLIER) // count
    # At/below the silicon floor the count is in the all-ones stopped region and
    # the fan is either stopped or too slow to resolve -> report 0 (blind), the
    # same convention the sysfs path uses at its higher m=2 floor.
    if rpm <= TACH_SILICON_FLOOR_RPM:
        return 0
    return rpm


def _emc2305_cdev_names() -> set:
    """Return the set of cooling_deviceN basenames whose type starts 'emc2305'."""
    base = "/sys/class/thermal"
    names = set()
    try:
        entries = os.listdir(base)
    except OSError:
        return names
    for entry in entries:
        if not entry.startswith("cooling_device"):
            continue
        try:
            with open(f"{base}/{entry}/type") as f:
                if f.read().strip().startswith("emc2305"):
                    names.add(entry)
        except OSError:
            continue
    return names


def neutralize_kernel_cooling_devices() -> None:
    """Stop the kernel thermal governor from driving the EMC2305 fans.

    The mainline emc2305 driver registers thermal cooling devices
    (emc2305_fan / emc2305_fanN) with pwm_separate=false, so when the governor
    changes their cooling state it writes the SAME duty to ALL fan channels'
    drive registers. On this board thermal_zone3 (cluster-thermal) binds the
    emc2305 cooling device through step_wise cooling-maps, so the governor keeps
    re-raising the duty (observed: cur_state=2 -> 51 duty on both channels),
    stomping fan-pid's per-fan values within a few seconds.

    Merely writing cur_state=0 is transient — the step_wise governor recomputes
    and re-raises it on its next poll. The durable fix is to switch every
    zone that binds an emc2305 cdev to the 'user_space' governor: that governor
    performs NO automatic cooling-state selection, so the kernel stops writing
    the duty registers entirely and fan-pid becomes the sole PWM authority.
    Critical-trip emergency shutdown is handled by the thermal core independent
    of the governor, so board thermal protection is unaffected.

    After switching policy we also zero the cdevs once to clear any residual
    duty the governor left behind. Best-effort: missing sysfs / permission
    errors are logged, not fatal (a kernel without these bindings has nothing
    to do here).
    """
    base = "/sys/class/thermal"
    emc_cdevs = _emc2305_cdev_names()
    if not emc_cdevs:
        return

    # 1. Switch any zone that binds an emc2305 cdev to the user_space governor.
    switched = []
    try:
        zones = sorted(e for e in os.listdir(base) if e.startswith("thermal_zone"))
    except OSError:
        zones = []
    for zone in zones:
        zdir = f"{base}/{zone}"
        # Does this zone bind an emc2305 cooling device via any cdevN link?
        binds_emc = False
        try:
            for link in os.listdir(zdir):
                if not (link.startswith("cdev") and link[4:].isdigit()):
                    continue
                target = os.path.basename(os.path.realpath(f"{zdir}/{link}"))
                if target in emc_cdevs:
                    binds_emc = True
                    break
        except OSError:
            continue
        if not binds_emc:
            continue
        # Only switch if user_space is actually available (else leave as-is).
        try:
            with open(f"{zdir}/available_policies") as f:
                avail = f.read().split()
        except OSError:
            avail = []
        if "user_space" not in avail:
            syslog.syslog(syslog.LOG_WARNING,
                          f"fan-pid: {zone} binds an emc2305 fan but has no user_space "
                          f"governor; kernel may still fight fan-pid")
            continue
        try:
            with open(f"{zdir}/policy", "w") as f:
                f.write("user_space")
            switched.append(zone)
        except OSError as e:
            syslog.syslog(syslog.LOG_WARNING,
                          f"fan-pid: could not set {zone} policy=user_space: {e}")

    # 2. Zero the emc2305 cdevs once to clear any residual governor duty.
    for cdev in sorted(emc_cdevs):
        try:
            with open(f"{base}/{cdev}/cur_state", "w") as f:
                f.write("0")
        except OSError as e:
            syslog.syslog(syslog.LOG_WARNING,
                          f"fan-pid: could not zero {cdev}: {e}")

    if switched:
        syslog.syslog(syslog.LOG_INFO,
                      "fan-pid: kernel fan governor disabled (user_space) on: "
                      + ", ".join(switched))


def find_thermal_zones() -> dict[str, str]:
    """Map zone canonical name -> /sys/class/thermal/thermal_zoneN/temp path.

    Honors ZONE_ALIASES so the same daemon binary works on mainline and SDK
    kernels without conditional code.  Missing zones are OK (logged once at
    startup) — the PI loop simply won't include them in max().
    """
    found: dict[str, str] = {}
    for entry in sorted(os.listdir("/sys/class/thermal")):
        if not entry.startswith("thermal_zone"):
            continue
        type_path = f"/sys/class/thermal/{entry}/type"
        temp_path = f"/sys/class/thermal/{entry}/temp"
        if not (os.path.exists(type_path) and os.path.exists(temp_path)):
            continue
        try:
            with open(type_path) as f:
                t = f.read().strip()
        except OSError:
            continue
        # Canonicalize against ZONES + ZONE_ALIASES.
        for z in ZONES:
            if t == z.name or t in ZONE_ALIASES.get(z.name, ()):
                found[z.name] = temp_path
                break
    return found


def read_temp(path: str) -> Optional[float]:
    """Read /sys/class/thermal/.../temp (millidegC) -> degC float, or None."""
    try:
        with open(path) as f:
            return int(f.read().strip()) / 1000.0
    except (OSError, ValueError):
        return None


def write_pwm(path: str, value: int) -> None:
    """Legacy sysfs-PWM write — KEPT FOR REFERENCE ONLY.

    DO NOT CALL FROM THE CONTROL LOOP. The kernel emc2305 driver in 6.18
    silently drops sub-MAX writes via this path (sysfs reports success,
    register 0x30 stays 0xFF, fan stays at MAX). Use i2c_write_pwm() with
    the fd returned by find_emc2305_i2c() instead.

    This stub is left so introspection / unit tests can still target the
    sysfs path if anyone wants to demonstrate the bug.
    """
    try:
        with open(path, "w") as f:
            f.write(str(value))
    except OSError as e:
        syslog.syslog(syslog.LOG_WARNING,
                      f"fan-pid: pwm write failed: {e}")


def read_fan_rpm(path: str) -> Optional[int]:
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def fan_rpm(fan: dict, i2c_fd: int) -> Optional[int]:
    """Read a fan's RPM via the best available path.

    When USE_RAW_TACH is set (RANGE=500 programmed at startup) read the raw
    13-bit TACH register over i2c for the lower ~484 RPM floor; otherwise fall
    back to the sysfs fanN_input path (kernel driver, ~960 RPM floor). `fan` may
    carry either a "tach_reg" (raw) and/or a "tach_path"/"tach_file" (sysfs).
    Returns RPM, 0 (below the readable floor / stopped), or None on read error.
    """
    if USE_RAW_TACH and "tach_reg" in fan:
        return read_fan_rpm_raw(i2c_fd, fan["tach_reg"])
    path = fan.get("tach_path")
    if path is None and "tach_file" in fan:
        # legacy/sysfs callers may pass a bare def without a resolved path
        path = fan["tach_file"]
    if path is None:
        return None
    return read_fan_rpm(path)

def play_startup_whistle(i2c_fd: int) -> None:
    """One-shot audible boot-complete chirp: WHISTLE_PULSES * (low, high) pairs.

    Absorbed from the legacy /usr/local/bin/boot-complete-notify.sh so there is
    a single owner of the EMC2305 duty register (the systemd ordering between
    fan-pid and boot-complete-notify previously raced — fan-pid would step
    on the first pulse and the operator heard a half-chirp instead of the
    full pattern).

    Goes via the direct-i2c path for the same reason the control loop does:
    the kernel sysfs PWM interface on 6.18 silently drops sub-MAX writes, so
    a sysfs-driven whistle would only ever produce the HIGH (255) pulses
    audibly with no audible LOW transition (the LOW phase would silently
    stay at 255).

    Best-effort: any i2c write failure is logged but does not abort daemon
    startup.  Total runtime ~ WHISTLE_PULSES * 2 * WHISTLE_HALF_S = ~3.6 s with
    defaults; this delays entry into the control loop, which is acceptable
    because steady-state thermal response time is dominated by the SoC's own
    ~30 s thermal mass, not the first few PWM ticks.
    """
    try:
        for _ in range(WHISTLE_PULSES):
            if not _running:
                break
            i2c_write_all_fans(i2c_fd, WHISTLE_LOW_PWM)
            time.sleep(WHISTLE_HALF_S)
            i2c_write_all_fans(i2c_fd, WHISTLE_HIGH_PWM)
            time.sleep(WHISTLE_HALF_S)
    except Exception as e:
        syslog.syslog(syslog.LOG_WARNING, f"fan-pid: startup whistle failed: {e!r}")
    syslog.syslog(syslog.LOG_INFO, "fan-pid: startup whistle complete — entering control loop")


def detect_present_fans(i2c_fd: int, hwmon_dir: str) -> list[dict]:
    """Return the subset of FAN_DEFS that have a spinning fan attached.

    The whistle has just driven every channel to PWM_MAX, so any wired fan is
    spinning well above the tach floor (~484 RPM raw / ~960 sysfs). A channel
    whose tach still reads 0 at full drive has no fan (or a fan with no/unwired
    tach) — flag it absent so the loop does not later report a phantom NO-TACH.

    Detection happens ONLY at full drive: at any lower duty a present-but-slow
    fan (below the tach floor) is indistinguishable from an empty channel.
    """
    detected = []
    for fan in FAN_DEFS:
        runtime = {**fan, "tach_path": os.path.join(hwmon_dir, fan["tach_file"])}
        rpm = fan_rpm(runtime, i2c_fd)
        runtime["tach_ok"] = bool(rpm and rpm > 0)
        detected.append(runtime)
        if runtime["tach_ok"]:
            syslog.syslog(syslog.LOG_INFO,
                          f"fan-pid: {fan['name']} present ({rpm} rpm @ max)")
        else:
            # 0@MAX is ambiguous: empty channel, dead fan, or a real cooling fan
            # with a broken/unwired tach. Driving an empty channel is harmless;
            # NOT driving a tach-less real fan is thermally unsafe. Therefore
            # keep driving the channel at PWM_MAX, but disable calibration/self-
            # heal (there is no trustworthy feedback).
            syslog.syslog(syslog.LOG_WARNING,
                          f"fan-pid: {fan['name']} absent or tach-less "
                          f"(0 rpm @ max on reg 0x{fan['duty_reg']:02x}) — "
                          f"driving MAX defensively, calibration disabled")
    return detected


# ---- Boot-time spinning-floor probe -------------------------------------------
# The probe must decide "is the fan visibly running at this duty?" only AFTER the
# rotor has settled. A blind fixed sleep is wrong: a heavy/high-inertia fan
# coasts for many seconds after a down-step, so a short sleep reads a momentum-
# inflated RPM and the bisection lands far too low (observed on .185: fan2's true
# floor is ~65 but a 2 s settle guessed 31). Instead we watch the RPM 1st
# derivative (per-second delta) and stop once it is "reasonably flat", i.e. the
# remaining approach to the asymptote is small so the current reading is already
# ~85-90% of the true steady value. Exponential settling means |delta| shrinks
# geometrically; when |delta| <= max(SETTLE_FLAT_ABS, SETTLE_FLAT_FRAC*rpm) for
# SETTLE_CONFIRM consecutive seconds, we are close enough to classify.
CAL_KICK_SETTLE   = 2.5   # settle after re-kicking a fan that fell dark
CAL_ABORT_TEMP    = 75.0  # warm-restart safety: abort probe and keep known-good hi
SETTLE_MIN_S      = 2     # ignore the first coast-down second(s) before judging flat
SETTLE_MAX_S      = 12    # hard cap on how long to wait for one down-step to settle
SETTLE_POLL_S     = 1.0   # derivative sampling interval (1 s -> delta is per-second)
SETTLE_CONFIRM    = 2     # consecutive flat samples required to call it settled
SETTLE_FLAT_ABS   = 15    # |delta| this small (rpm/s) counts as flat regardless of rpm
SETTLE_FLAT_FRAC  = 0.04  # ...or |delta| <= 4% of current rpm (whichever is larger)
# The probe must accept a candidate only if it clears RUN_MARGIN_RPM by a comfort
# band, not merely touches it — otherwise a fan sitting right on the margin (e.g.
# fan1 ~516-536 rpm at duty 29) reads "ok" during the probe then trips the
# runtime near-stall RAISE moments later. Requiring the same headroom the LOWER
# self-heal wants means the probed floor is already where the runtime would
# settle, so there is no boot-time raise churn.
PROBE_ACCEPT_RPM  = RUN_MARGIN_RPM + 60   # candidate must settle >= this (590 rpm)


def calibrate_floors(i2c_fd: int, fans: list[dict], hwmon_dir: str,
                     zone_paths: dict[str, str]) -> dict[int, int]:
    """From-above bisection giving a per-fan spinning-floor guess.

    Runs all present fans in parallel. Each down-step waits for the RPM 1st
    derivative to go flat (settle_rpm below) instead of a blind fixed sleep, so a
    heavy/high-inertia fan is judged on its SETTLED speed, not its coast-down
    momentum — this is what keeps the guess accurate (a 2 s blind settle guessed
    fan2=31 vs its true ~65). Candidates are classified against RUN_MARGIN_RPM so
    the result is a floor that runs HEALTHY, above the stall cliff. The runtime
    self-heal still fine-tunes +/-, but should have little to do now.

    Assumes the fans are already spinning at PWM_MAX (the whistle just ran).
    Returns {duty_reg: floor_guess}. On any error a fan falls back to FLOOR_GUESS.
    """
    def tach(fan):
        return fan_rpm({**fan, "tach_path": os.path.join(hwmon_dir, fan["tach_file"])},
                       i2c_fd) or 0

    def settle_rpm(active_regs: dict) -> dict:
        """Wait until every fan in `active_regs` has a flat RPM 1st derivative,
        then return {reg: settled_rpm}.

        `active_regs` maps duty_reg -> fan def for the fans that were just
        down-stepped this round. We sample each fan's RPM once per SETTLE_POLL_S,
        track the per-second delta, and mark a fan "settled" once |delta| is
        within max(SETTLE_FLAT_ABS, SETTLE_FLAT_FRAC*rpm) for SETTLE_CONFIRM
        consecutive samples (exponential decay => small delta means we are near
        the asymptote, ~85-90% of the true steady value). A fan that reads 0
        (below the tach floor / stalled) is immediately settled at 0 — there is
        nothing to converge to. Bounded by SETTLE_MIN_S / SETTLE_MAX_S so the
        probe can't hang on a noisy tach.
        """
        prev = {reg: None for reg in active_regs}
        flat = {reg: 0 for reg in active_regs}
        settled = {reg: None for reg in active_regs}
        elapsed = 0.0
        while _running and elapsed < SETTLE_MAX_S:
            time.sleep(SETTLE_POLL_S)
            elapsed += SETTLE_POLL_S
            for reg, fan in active_regs.items():
                if settled[reg] is not None:
                    continue
                rpm = tach(fan)
                if rpm == 0:
                    settled[reg] = 0          # dark: nothing to settle toward
                    continue
                p = prev[reg]
                prev[reg] = rpm
                if p is None or elapsed < SETTLE_MIN_S:
                    continue                  # need a baseline + skip 1st coast second
                delta = abs(rpm - p)
                thresh = max(SETTLE_FLAT_ABS, int(SETTLE_FLAT_FRAC * rpm))
                if delta <= thresh:
                    flat[reg] += 1
                    if flat[reg] >= SETTLE_CONFIRM:
                        settled[reg] = rpm    # derivative flat -> ~at steady state
                else:
                    flat[reg] = 0             # still moving -> reset the flat run
            if all(v is not None for v in settled.values()):
                break
        # Timeout: use the last reading (or a fresh one) for any unsettled fan.
        for reg, fan in active_regs.items():
            if settled[reg] is None:
                settled[reg] = prev[reg] if prev[reg] is not None else tach(fan)
        return settled

    t0 = time.monotonic()
    probe_fans = [f for f in fans if f.get("tach_ok", True)]
    state = {f["duty_reg"]: {"lo": 0, "hi": PWM_MAX, "fan": f}
             for f in probe_fans}
    # ensure every channel is at MAX; tach-less/absent channels stay there.
    for f in fans:
        i2c_write_pwm(i2c_fd, PWM_MAX, f["duty_reg"])
    time.sleep(CAL_KICK_SETTLE)

    while (_running and state
           and any(s["hi"] - s["lo"] > 1 for s in state.values())):
        mids = {}
        for reg, s in state.items():
            if s["hi"] - s["lo"] > 1:
                mid = (s["lo"] + s["hi"]) // 2
                mids[reg] = mid
                i2c_write_pwm(i2c_fd, mid, reg)
        # Wait for each down-stepped fan's RPM derivative to go flat (not a blind
        # fixed sleep), then classify against the healthy RUN margin — a fan that
        # settles BELOW RUN_MARGIN_RPM is "not healthy here", same as dark, so the
        # bisection converges on a floor that actually runs above the stall cliff.
        settled = settle_rpm({reg: state[reg]["fan"] for reg in mids})
        fails = []
        for reg, mid in mids.items():
            s = state[reg]
            if settled[reg] >= PROBE_ACCEPT_RPM:
                s["hi"] = mid            # healthy with margin -> floor <= mid
            else:
                s["lo"] = mid            # dark/near-stall/on-edge -> floor > mid
                i2c_write_pwm(i2c_fd, s["hi"], reg)  # re-spin to known-good
                fails.append(reg)
        if fails:
            time.sleep(CAL_KICK_SETTLE)

        # Boot is normally cool/no-load, but a warm restart under traffic is
        # possible. Abort the exploratory down-sweep if any readable zone is
        # already hot; each current `hi` is known-spinning, so using it as the
        # starting floor is conservative and the runtime self-heal still works.
        temps = [read_temp(path) for path in zone_paths.values()]
        hottest = max((t for t in temps if t is not None), default=0.0)
        if hottest >= CAL_ABORT_TEMP:
            syslog.syslog(syslog.LOG_WARNING,
                          f"fan-pid: floor probe aborted at {hottest:.1f}C "
                          f">= {CAL_ABORT_TEMP:.1f}C; using current known-good bounds")
            break

    # Tach-capable fans get their probed guess; tach-less/absent channels stay
    # at MAX permanently (safe for a real fan, harmless for an empty channel).
    floors = {f["duty_reg"]: PWM_MAX for f in fans}
    for reg, s in state.items():
        floors[reg] = max(FLOOR_MIN, min(FLOOR_MAX, s["hi"]))
    # leave everything spinning at MAX; the loop takes over immediately after.
    for f in fans:
        i2c_write_pwm(i2c_fd, PWM_MAX, f["duty_reg"])
    dt = time.monotonic() - t0
    syslog.syslog(syslog.LOG_INFO,
                  "fan-pid: floor probe (%.0fs): %s" % (
                      dt, ", ".join(f"{s['fan']['name']}=0x{reg:02x}:{floors[reg]}"
                                    for reg, s in state.items())))
    return floors


# ---------- Controller ----------------------------------------------------------
class Controller:
    """One PI controller per zone, output combined via max() and sent to all fans."""

    def __init__(self, i2c_fd: int, fans: list[dict], hwmon_dir: str,
                 zone_paths: dict[str, str], floors: dict[int, int]):
        self.i2c_fd = i2c_fd
        self.zone_paths = zone_paths
        # Runtime fan records: independent duty register, tach path, a MUTABLE
        # spinning floor (seeded from the boot probe, refined at runtime) and
        # its self-heal counters. Both fans receive the same PID demand but each
        # is clamped up to its own current floor.
        self.fans = []
        for fan in fans:
            guess = floors.get(fan["duty_reg"], FLOOR_GUESS)
            self.fans.append({
                **fan,
                "tach_ok": fan.get("tach_ok", True),
                "tach_path": os.path.join(hwmon_dir, fan["tach_file"]),
                "floor": max(FLOOR_MIN, min(PWM_MAX, guess)),
                "rpm": None,              # last raw/sysfs tach sample for fan-check
                "last_written_pwm": -1,   # force first write
                "raise_run": 0,           # consecutive raises (drives adaptive step)
                "healthy_ticks": 0,       # consecutive rpm>=RUN_MARGIN (resets raise_run)
                "blind_ticks": 0,         # consecutive (cur>=floor & near-stall)
                "vis_ticks": 0,           # consecutive (pinned & comfortable)
                "cooldown": 0,            # ticks left where lowering is blocked
                "kick": False,            # request a 255 re-kick this tick
            })
        self.export_floors()
        # Initialize the shared EMA at the lowest current floor, not 0. Individual
        # outputs are clamped higher as needed; this prevents an initial
        # below-floor command while preserving one shared max-policy demand.
        self.smoothed_pwm = float(self.min_floor())
        self.last_log_t = 0.0

    def min_floor(self) -> int:
        """Lowest current floor across all driven fans (the shared-demand clamp)."""
        return min((f["floor"] for f in self.fans), default=FLOOR_MIN)

    def export_floors(self) -> None:
        """Publish current per-fan floors to FLOOR_STATE_FILE for fan-check.

        Format: one 'reg=floor' per line (hex reg), e.g. '0x30=40'. When raw
        tach is active (RANGE=500, m=1) we also publish the last-read RPM as a
        'reg=rpm' line under a distinct prefix so fan-check can report the CORRECT
        low-floor RPM: the kernel sysfs fanN_input assumes m=2 and would read 2x
        the true speed while the chip is in the 500 RPM range. Best-effort;
        /run is tmpfs so this is cheap and disappears on reboot (floors are
        relearned every boot anyway).
        """
        tmp = f"{FLOOR_STATE_FILE}.tmp.{os.getpid()}"
        try:
            os.makedirs(FLOOR_STATE_DIR, exist_ok=True)  # no-op under RuntimeDirectory=
            lines = [f"0x{f['duty_reg']:02x}={f['floor']}\n" for f in self.fans]
            # Publish tach source + per-fan RPM so fan-check doesn't misread the
            # m=2 sysfs value while the chip is at m=1.
            lines.append(f"tach_source={'raw-m1' if USE_RAW_TACH else 'sysfs-m2'}\n")
            for f in self.fans:
                rpm = f.get("rpm")
                if rpm is not None:
                    lines.append(f"rpm:0x{f['duty_reg']:02x}={rpm}\n")
            with open(tmp, "w") as fh:
                fh.writelines(lines)
            os.replace(tmp, FLOOR_STATE_FILE)  # atomic: fan-check never sees half a file
        except OSError:
            try:
                os.unlink(tmp)
            except OSError:
                pass

    def integral_clamp(self, z: Zone) -> float:
        """Anti-windup: cap |integral| so it can saturate the actuator but no more."""
        if z.ki <= 0:
            return 0.0
        # Max useful integral = (PWM_MAX - PWM_FLOOR) / Ki.
        # We allow +/- that magnitude.  Clamp tightens further for very-low-Ki
        # zones (which already track via Kp).
        return (PWM_MAX - PWM_FLOOR) / z.ki

    def step(self) -> tuple[dict[str, int], dict[str, float], dict[str, float]]:
        """One control tick.

        Returns (fan_pwms, zone_temps, zone_pwms) where fan_pwms maps each
        driven fan name to the duty actually written this tick.
        """
        zone_temps: dict[str, float] = {}
        zone_pwms:  dict[str, float] = {}
        any_critical = False
        any_fault    = False
        max_pwm_zone = float(PWM_FLOOR)

        for z in ZONES:
            path = self.zone_paths.get(z.name)
            if path is None:
                continue
            t = read_temp(path)
            if t is None:
                # transient read failure — reuse last good temp so PI doesn't
                # zero-out integral and overshoot when reads recover
                t = z.last_temp
            else:
                z.last_temp = t
            zone_temps[z.name] = t

            if t >= HARD_FAULT_TEMP:
                any_fault = True
            if t >= z.crit_temp:
                any_critical = True

            err = t - z.setpoint
            # PI step.  Note we integrate even when output is saturated, but the
            # clamp below prevents windup beyond useful range.
            z.integral += err
            ic = self.integral_clamp(z)
            if z.integral >  ic: z.integral =  ic
            if z.integral < -ic: z.integral = -ic

            pwm_i = PWM_FLOOR + z.kp * err + z.ki * z.integral
            # Clamp the shared PID demand to the LOWEST fan floor here; each
            # fan is then clamped UP to its own floor at the output stage. This
            # keeps one max-policy demand while ensuring no fan is ever driven
            # below the duty at which it drops out of the tach's view / stalls.
            # Per-fan floors are discovered/refined dynamically; clamp the
            # shared demand to the lowest current one here.
            current_min_floor = self.min_floor()
            if pwm_i < current_min_floor:
                pwm_i = current_min_floor
            pwm_i = max(0.0, min(float(PWM_MAX), pwm_i))
            z.last_pwm = pwm_i
            zone_pwms[z.name] = pwm_i
            if pwm_i > max_pwm_zone:
                max_pwm_zone = pwm_i

        # Safety overrides bypass smoothing — we want them to take effect THIS tick.
        if any_critical or any_fault:
            target = float(PWM_MAX)
            # Reset integrals: when temp comes back down we don't want the
            # accumulated 30-second saturation pushing PWM to MAX for another
            # 30 s.  This is a hard reset, not a graceful decay, because the
            # safety-override case is a thermal emergency.
            for z in ZONES:
                z.integral = 0.0
            self.smoothed_pwm = target
            if any_fault:
                hottest = max(zone_temps.items(), key=lambda kv: kv[1], default=("?", 0))
                syslog.syslog(syslog.LOG_CRIT,
                              f"fan-pid: HARD FAULT zone={hottest[0]} temp={hottest[1]:.1f}C "
                              f">= {HARD_FAULT_TEMP}C — silicon damage threshold; PWM forced to MAX")
        else:
            # EMA smoothing on the final actuator command
            self.smoothed_pwm = (EMA_ALPHA * max_pwm_zone
                                 + (1.0 - EMA_ALPHA) * self.smoothed_pwm)
            # Enforce MIN_RUN AFTER smoothing too. The per-zone floor is
            # applied before max(), but EMA blending with a previous low
            # value can still drag the output below MIN_RUN on a downward
            # transition. The fan kick-start floor is a hardware limit —
            # any output below it physically stalls the fan, no matter how
            # the math arrived there.
            # Enforce the lowest current floor after smoothing (EMA blending
            # with a previous low value can still dip below it on a downward
            # step). Each fan is clamped up to its own floor just below.
            if self.smoothed_pwm < self.min_floor():
                self.smoothed_pwm = float(self.min_floor())
            target = self.smoothed_pwm

        shared = int(round(target))
        # Output stage: send the shared demand to every driven fan, clamped up
        # to that fan's own current floor. Per-fan deadband so a fan pinned at
        # its floor isn't rewritten every tick, but always write on 0/MAX.
        # A fan flagged for a re-kick (self-heal just raised its floor) gets a
        # one-tick PWM_MAX pulse so it isn't stuck coasting below the new floor.
        fan_pwms: dict[str, int] = {}
        floors_changed = False
        for fan in self.fans:
            if fan["kick"]:
                out = PWM_MAX
                fan["kick"] = False
            else:
                out = max(shared, fan["floor"])
            out = max(0, min(PWM_MAX, out))
            fan_pwms[fan["name"]] = out
            force = (out == 0 or out == PWM_MAX)
            if (force or fan["last_written_pwm"] < 0
                    or abs(out - fan["last_written_pwm"]) >= PWM_DEADBAND):
                i2c_write_pwm(self.i2c_fd, out, fan["duty_reg"])
                fan["last_written_pwm"] = out

        # Runtime two-sided floor self-heal (uses this tick's tach + commanded).
        # _refine_floor also refreshes fan["rpm"] for the export below.
        for fan in self.fans:
            if self._refine_floor(fan, fan_pwms[fan["name"]]):
                floors_changed = True
        # Re-publish every tick: floors change rarely but the RPM sample is fresh
        # each tick and fan-check reads it (the /run write is a cheap tmpfs
        # atomic replace). floors_changed only gates the INFO log noise, if any.
        self.export_floors()

        return fan_pwms, zone_temps, zone_pwms

    def _refine_floor(self, fan: dict, commanded: int) -> bool:
        """Two-sided per-fan floor refinement. Returns True if the floor changed.

        RAISE (fast, safety): if the fan is commanded at/above its floor but its
        tach reads 0 (stalled) OR below RUN_MARGIN_RPM (near-stall) for
        RAISE_TICKS consecutive ticks, the floor is too low — bump it up by
        RAISE_STEP. A true stall (rpm==0) also gets a 255 re-kick; a slow-but-
        spinning fan is only nudged, avoiding a coast-down transient.

        LOWER (slow, cautious): if the fan is pinned exactly at its floor (heat
        isn't pushing it higher) and running with real headroom above the run
        margin (rpm >= RUN_MARGIN_RPM + LOWER_HEADROOM) for LOWER_TICKS ticks, the
        floor is higher than necessary — drop it by 1. Blocked for RAISE_COOLDOWN
        ticks after any raise. The asymmetry (short/big raise vs long/small lower
        + a headroom gap above the run margin + cooldown) keeps the two from
        oscillating: near the run margin (~530 rpm) LOWER simply stops, and RAISE
        keeps the fan out of the ~484 rpm stall cliff below it.
        """
        if not fan["tach_ok"]:
            return False  # tach-less/absent channel: pinned at MAX, no feedback
        if fan["cooldown"] > 0:
            fan["cooldown"] -= 1
        rpm = fan_rpm(fan, self.i2c_fd)
        if rpm is None:
            return False  # transient read error — don't act on it
        fan["rpm"] = rpm

        changed = False
        # --- RAISE: commanded into the running band but the fan reads stalled
        # (rpm==0) OR is limping in the near-stall band below RUN_MARGIN_RPM.
        # Only a true stall (rpm==0) gets a disruptive 255 re-kick to break a
        # stuck rotor; a still-spinning-but-slow fan just needs a gentle floor
        # bump toward its healthy band, without the kick that would otherwise
        # inject a coast-down transient and start an oscillation.
        near_stall = (rpm == 0 or rpm < RUN_MARGIN_RPM)
        if commanded >= fan["floor"] and near_stall:
            fan["blind_ticks"] += 1
            fan["vis_ticks"] = 0
            fan["healthy_ticks"] = 0
            if fan["blind_ticks"] >= RAISE_TICKS and fan["floor"] < FLOOR_MAX:
                old = fan["floor"]
                # Adaptive step: a bad boot-probe guess can sit far below the true
                # floor (the probe reads momentum-inflated RPM on a weak/high-
                # inertia fan and guesses low). Escalating the step on consecutive
                # raises converges in seconds instead of crawling +2 for minutes.
                fan["raise_run"] = fan.get("raise_run", 0) + 1
                step = min(RAISE_STEP_MAX, RAISE_STEP * fan["raise_run"])
                fan["floor"] = min(FLOOR_MAX, fan["floor"] + step)
                fan["blind_ticks"] = 0
                fan["cooldown"] = RAISE_COOLDOWN
                if rpm == 0:
                    # Kick only on the FIRST raise of a stall run to break stiction.
                    # Re-kicking every step injects a coast-down transient that
                    # delays the next raise decision (the slow-climb bug); during a
                    # sustained climb we just ramp the floor and let it catch up.
                    if fan["raise_run"] == 1:
                        fan["kick"] = True
                    why = f"stalled, rpm=0 (step +{step})"
                else:
                    why = f"near-stall {rpm}rpm < {RUN_MARGIN_RPM} (step +{step})"
                syslog.syslog(syslog.LOG_INFO,
                              f"fan-pid: {fan['name']} floor {old}->{fan['floor']} "
                              f"({why} at cur={commanded})")
                changed = True
            return changed

        fan["blind_ticks"] = 0
        # Reached only when rpm >= RUN_MARGIN_RPM (past the near_stall return).
        # Reset raise escalation only after the fan has held healthy for
        # RAISE_STABLE_TICKS consecutive ticks — a single high reading may be
        # post-kick coast-down, which must not reset the run and drop a still-
        # climbing fan back to a +2 step.
        fan["healthy_ticks"] = fan.get("healthy_ticks", 0) + 1
        if fan["healthy_ticks"] >= RAISE_STABLE_TICKS:
            fan["raise_run"] = 0

        # --- LOWER: pinned at floor, comfortable headroom above the RUN margin.
        # Never lower a fan below RUN_MARGIN_RPM: require the at-floor RPM to sit
        # LOWER_HEADROOM above the margin so a one-step drop still lands safely
        # inside the healthy band, never on the stall cliff.
        pinned = (commanded == fan["floor"])
        has_headroom = (rpm >= RUN_MARGIN_RPM + LOWER_HEADROOM)
        if pinned and has_headroom and fan["cooldown"] == 0:
            fan["vis_ticks"] += 1
            if fan["vis_ticks"] >= LOWER_TICKS and fan["floor"] > FLOOR_MIN:
                old = fan["floor"]
                fan["floor"] = max(FLOOR_MIN, fan["floor"] - 1)
                fan["vis_ticks"] = 0
                syslog.syslog(syslog.LOG_INFO,
                              f"fan-pid: {fan['name']} floor {old}->{fan['floor']} "
                              f"(headroom: {rpm}rpm at floor)")
                changed = True
        else:
            fan["vis_ticks"] = 0
        return changed

    def maybe_log(self, now: float, fan_pwms: dict[str, int],
                  zt: dict[str, float], zp: dict[str, float]) -> None:
        if now - self.last_log_t < LOG_INTERVAL:
            return
        self.last_log_t = now
        fan_str_parts = []
        for fan in self.fans:
            rpm = fan_rpm(fan, self.i2c_fd)
            pwm = fan_pwms.get(fan["name"], 0)
            if rpm is None:
                rpm_disp = "?rpm"
            elif rpm == 0 and pwm < fan["floor"]:
                rpm_disp = "blind"   # below tach floor — spinning but unreadable
            else:
                rpm_disp = f"{rpm}rpm"
            fan_str_parts.append(f"{fan['name']}={fan['floor']}/{pwm}/{PWM_MAX}({rpm_disp})")
        fan_str = " ".join(fan_str_parts)
        zt_str = " ".join(f"{n.split('-')[0]}={t:.1f}" for n, t in zt.items())
        zp_str = " ".join(f"{n.split('-')[0]}={p:.0f}" for n, p in zp.items())
        syslog.syslog(syslog.LOG_INFO,
                      f"fan-pid: {fan_str} | T[{zt_str}] | demand[{zp_str}]")


# ---------- Main loop -----------------------------------------------------------
_running = True


def _on_sigterm(_sig, _frame):
    global _running
    _running = False


def main() -> int:
    global USE_RAW_TACH
    syslog.openlog("fan-pid", syslog.LOG_PID, syslog.LOG_DAEMON)

    # Board gate — only run on LS1046A.  Same idiom as fancontrol-setup.
    try:
        with open("/proc/device-tree/compatible", "rb") as f:
            compat = f.read().split(b"\0")
    except OSError:
        compat = []
    if not any(b"fsl,ls1046a" in c for c in compat):
        syslog.syslog(syslog.LOG_INFO, "fan-pid: not LS1046A, exiting")
        return 0

    try:
        pwm_path, _fan_path = find_emc2305_pwm()
    except RuntimeError as e:
        syslog.syslog(syslog.LOG_ERR, f"fan-pid: {e} — failing to MAX_PWM if possible, exit 1")
        return 1
    hwmon_dir = os.path.dirname(pwm_path)
    syslog.syslog(syslog.LOG_INFO,
                  f"fan-pid: hwmon dir {hwmon_dir} (sysfs pwm introspection only; tach reads here)")

    # Open raw i2c bypass (kernel sysfs PWM interface is broken on 6.18 — see
    # the EMC2305_I2C_ADDR comment block at top). All PWM writes from here on
    # go via i2c_write_pwm(i2c_fd, value).
    try:
        i2c_fd = find_emc2305_i2c()
    except (RuntimeError, OSError) as e:
        syslog.syslog(syslog.LOG_ERR, f"fan-pid: i2c open failed: {e!r} — exit 1")
        return 1
    syslog.syslog(syslog.LOG_INFO, f"fan-pid: i2c bus claimed at addr 0x{EMC2305_I2C_ADDR:02x}")

    # Lower the tachometer's real silicon floor from ~968 RPM (RANGE=1000,
    # m=2) to ~484 RPM (RANGE=500, m=1). Only enable raw-TACH conversion after
    # BOTH channel config writes succeeded; otherwise sysfs remains correct for
    # the chip's unchanged m=2 range whereas m=1 math would over-report by 2x.
    try:
        set_tach_range_500(i2c_fd)
        USE_RAW_TACH = True
        syslog.syslog(syslog.LOG_INFO,
                      "fan-pid: raw 13-bit tach enabled (RANGE=500, floor ~484 RPM)")
    except RuntimeError as e:
        USE_RAW_TACH = False
        syslog.syslog(syslog.LOG_WARNING,
                      f"fan-pid: {e}; using kernel sysfs tach (floor ~960 RPM)")

    # Become the sole PWM authority: silence the kernel emc2305 cooling devices
    # so the thermal governor stops writing all fan channels behind our back.
    neutralize_kernel_cooling_devices()

    zone_paths = find_thermal_zones()
    if not zone_paths:
        syslog.syslog(syslog.LOG_ERR, "fan-pid: no usable thermal_zone* found — exiting")
        # Defensive: leave BOTH fans at full so the SoC isn't suffocated.
        i2c_write_all_fans(i2c_fd, PWM_MAX)
        os.close(i2c_fd)
        return 1
    missing = [z.name for z in ZONES if z.name not in zone_paths]
    if missing:
        syslog.syslog(syslog.LOG_WARNING,
                      f"fan-pid: thermal zones missing (will skip): {','.join(missing)}")
    syslog.syslog(syslog.LOG_INFO,
                  f"fan-pid: controlling {len(zone_paths)} zones: {','.join(zone_paths)}")

    # Install the failsafe signal handlers BEFORE the multi-second whistle/probe
    # so a systemctl stop/restart during startup exits promptly and still hits
    # the finally block (both fans -> MAX). Everything from the whistle onward
    # runs inside the try so the failsafe covers the probe too.
    signal.signal(signal.SIGTERM, _on_sigterm)
    signal.signal(signal.SIGINT,  _on_sigterm)

    try:
        # Whistle drives every channel to PWM_MAX (also the kick that guarantees
        # a stopped fan spins up).
        play_startup_whistle(i2c_fd)
        # Hold every channel at MAX and let arbitrary fans reach a speed well
        # above the tach floor before presence detection (the whistle's final
        # 255 phase is only ~0.3 s — too short for a slow/heavy fan to register).
        i2c_write_all_fans(i2c_fd, PWM_MAX)
        for _ in range(int(PRESENCE_SPINUP_S / 0.2)):
            if not _running:
                break
            time.sleep(0.2)
        fans = detect_present_fans(i2c_fd, hwmon_dir)
        syslog.syslog(syslog.LOG_INFO,
                      "fan-pid: driving fans: " + ",".join(f["name"] for f in fans))

        # Fast optimistic floor probe (parallel). Runtime self-heal in the
        # Controller corrects momentum-inflated guesses up/down while running.
        try:
            floors = calibrate_floors(i2c_fd, fans, hwmon_dir, zone_paths)
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR,
                          f"fan-pid: floor probe failed: {e!r} — using conservative guesses")
            floors = {f["duty_reg"]: FLOOR_GUESS for f in fans}

        ctrl = Controller(i2c_fd, fans, hwmon_dir, zone_paths, floors)
        next_tick = time.monotonic()
        while _running:
            now = time.monotonic()
            if now < next_tick:
                time.sleep(min(TICK_SECONDS, next_tick - now))
                continue
            next_tick = now + TICK_SECONDS
            try:
                final, zt, zp = ctrl.step()
                ctrl.maybe_log(now, final, zt, zp)
            except Exception as e:  # belt-and-braces: never crash on a tick
                syslog.syslog(syslog.LOG_ERR, f"fan-pid: tick failed: {e!r}")
    finally:
        # Defensive shutdown: drive BOTH fans to MAX. If a maintainer restarts
        # the daemon under load they don't want a stale low PWM throttling the
        # SoC during the gap. (The kernel cdevs stay neutralized, so nothing
        # else will pull the fans down until fan-pid comes back.)
        try:
            i2c_write_all_fans(i2c_fd, PWM_MAX)
            syslog.syslog(syslog.LOG_INFO, "fan-pid: shutdown — left all fans at MAX as failsafe")
        except Exception:
            pass
        try:
            os.close(i2c_fd)
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
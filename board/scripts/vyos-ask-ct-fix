#!/bin/bash
# vyos-ask-ct-fix — enable kernel conntrack + load ASK modules for hardware offload
#
# VyOS default firewall adds "notrack" to the vyos_conntrack table,
# which disables kernel connection tracking. CMM receives conntrack
# events via libnetfilter_conntrack and pushes flows to CDX/FMan.
# Without tracked connections, hardware offload never engages.
#
# This script:
#   1. Loads ASK kernel modules (cdx, fci, auto_bridge, nf_conntrack_netlink)
#   2. Waits for VyOS nftables rules to be applied
#   3. Removes the "notrack" rule from PREROUTING + OUTPUT chains
#   4. Rebuilds chains preserving jump structure without notrack
#   5. Adds masquerade NAT to trigger conntrack
#   6. Starts CMM daemon
#
# Runs as ExecStart of ls1046a-ask.service after vyos-router.service.

set -e

MODDIR="/lib/modules/$(uname -r)/extra"

# ── Only run on LS1046A ───────────────────────────────────────────────
if ! grep -q "fsl,ls1046a" /proc/device-tree/compatible 2>/dev/null; then
    exit 0
fi

# ── Load kernel modules ───────────────────────────────────────────────
# auto_bridge.ko is required for CMM's bridge init to succeed in "auto
# mode" — without it, cmmBridgeInit() falls back to "manual mode", which
# the kernel's M_bridge_handle_control rejects ("manual mode not
# supported"), and CMM exits(1) immediately. Confirmed via hardware
# validation 2026-07-02 (192.168.1.185, build vyos-2026.07.02-0543-
# rolling): loading auto_bridge.ko flipped ask-check from FAIL to
# OPERATIONAL and stopped the ls1046a-ask.service crash-loop. Safe to
# load unconditionally — auto_bridge's packet-processing netfilter hook
# (abm_ebt_hook) is a guarded no-op (`if (!skb->abm_ff) goto exit0;`)
# unless a bridge device is actually configured and fast-forwarding
# unicast traffic through it; loading the module alone only registers
# its (inert without a bridge) netlink/proc/sysctl/notifier plumbing.
echo "ASK: loading kernel modules..."
for mod in cdx fci auto_bridge nf_conntrack_netlink; do
    if ! lsmod | grep -q "^${mod} "; then
        insmod "${MODDIR}/${mod}.ko" 2>/dev/null || modprobe "${mod}" 2>/dev/null || true
    fi
done

# Wait for /dev/cdx_ctrl
for i in $(seq 1 10); do
    [ -c /dev/cdx_ctrl ] && break
    sleep 1
done

# ── Wait for VyOS conntrack table ──────────────────────────────────────
MAX_WAIT=120
while ! nft list tables 2>/dev/null | grep -q vyos_conntrack; do
    [ "$MAX_WAIT" -le 0 ] && exit 1
    sleep 1
    MAX_WAIT=$((MAX_WAIT - 1))
done

# ── Remove notrack from IPv4 conntrack chains ──────────────────────────
# VyOS adds unconditional "notrack" as the last rule, which disables
# conntrack for ALL packets. Rebuild chains without notrack.
for chain in PREROUTING OUTPUT; do
    if nft list chain ip vyos_conntrack "$chain" 2>/dev/null | grep -q "notrack$"; then
        nft flush chain ip vyos_conntrack "$chain" 2>/dev/null || true
        for jump in VYOS_CT_IGNORE FW_CONNTRACK NAT_CONNTRACK WLB_CONNTRACK; do
            nft add rule ip vyos_conntrack "$chain" jump "$jump" 2>/dev/null || true
        done
        echo "ASK: removed notrack from ip vyos_conntrack $chain"
    fi
done

# ── Same for IPv6 ─────────────────────────────────────────────────────
for chain in PREROUTING OUTPUT; do
    if nft list chain ip6 vyos_conntrack "$chain" 2>/dev/null | grep -q "notrack$"; then
        nft flush chain ip6 vyos_conntrack "$chain" 2>/dev/null || true
        for jump in VYOS_CT_IGNORE FW_CONNTRACK NAT_CONNTRACK; do
            nft add rule ip6 vyos_conntrack "$chain" jump "$jump" 2>/dev/null || true
        done
        echo "ASK: removed notrack from ip6 vyos_conntrack $chain"
    fi
done

# ── Conntrack event pipeline: note ─────────────────────────────────────
# No NAT/masquerade is required for conntrack events. The pipeline works
# when (a) nf_conntrack_netlink is loaded, (b) VyOS notrack is removed,
# (c) CMM subscribes to ctnetlink groups, and (d) globalConf.enable=1.
# Adding masquerade on eth0 as a "conntrack trigger" is a side-effect
# with security implications — remove it and document why it was wrong.

# ── Enable conntrack accounting ───────────────────────────────────────
sysctl -w net.netfilter.nf_conntrack_acct=1 2>/dev/null || true

# ── Verify ────────────────────────────────────────────────────────────
if cat /proc/net/stat/nf_conntrack 2>/dev/null | grep -q "."; then
    echo "ASK: conntrack initialized"
else
    echo "ASK: WARNING — conntrack not available"
fi

#!/bin/bash
# vyos-offload-ask — engage/disengage the ASK2 FE-VM offload datapath
# Called from VyOS system_offload.py when "set system offload ask" is configured.
# Writes to the FMan PCD debugfs nodes to build the FE chain and arm AC_CC.
#
# Usage: vyos-offload-ask [--port 0x10|0x11] engage|disengage
#
# The engage sequence matches the debugfs bridge in ask_hw.c:
#   fe_pool(get) -> fe_singletons(build) -> fe_ehash(set) -> fe_hashfe(build)
#   -> fe_enq(build) -> fe_enter(build) -> fe_arm(engage)
#
# Phase 2 M2 gate (2026-07-06): silicon-proven AC_CC dispatch with zero overhead
# vs native RSS.  Throughput ceiling ~941 Mbps (LXC veth limit, not AC_CC limit).

set -e

PCD_BASE="/sys/kernel/debug/fman_pcd/0"
PORT="0x11"  # default: eth4 (FMan MAC10, ethernet@f2000, RX BMI port 0x11)

while [ $# -gt 0 ]; do
    case "$1" in
        --port) PORT="$2"; shift 2 ;;
        *) break ;;
    esac
done
VERB="$1"
shift || true

die() { echo "ASK offload: $*" >&2; exit 1; }

engage() {
    local enter_off
    echo "ASK offload: building FE-VM pipeline..."

    echo "set $PORT"   > "$PCD_BASE/fe_port"  || die "fe_port set $PORT failed"
    # 12-byte 4-tuple key (SIP+DIP+SPORT+DPORT) — matches EKFC=0x00180006
    # NXP §7.2: contextSize MUST equal EKFC extracted key length
    echo "set 0x7FFF 12 0" > "$PCD_BASE/fe_ehash" || die "fe_ehash set failed"
    echo get   > "$PCD_BASE/fe_pool"         || die "fe_pool get failed"
    echo build > "$PCD_BASE/fe_singletons" 2>/dev/null || true
    echo build > "$PCD_BASE/fe_hashfe" 2>/dev/null || true
    # F-054: always use PCD-range FQ 0x200 (512) which is in eth3's polled
    # FQ range (512-639).  The dedicated TX FQ 0x2b9 (697) is outside the
    # kernel's per-port FQ range so HIT frames are silently lost.
    ENQ_FQID="200"
    echo "build $ENQ_FQID" > "$PCD_BASE/fe_enq"  || die "fe_enq build failed"
    # F-045: fe_enter build with no argument defaults to hash frontend
    # (fe_hash_off) or MUX, not an invalid port-offset.
    echo "build" > "$PCD_BASE/fe_enter" 2>/dev/null || true

    # Read the FE_ENTER offset that fe_enter_build assigned
    enter_off=$(grep -oP 'FE_ENTER root AD: \K0x[0-9a-fA-F]+' "$PCD_BASE/fe_arm" 2>/dev/null)
    if [ -z "$enter_off" ] || [ "$enter_off" = "0x0" ]; then
        # Fall back to the known Phase 1 offset for the first engage
        enter_off="0x59200"
    fi

    echo "engage $PORT $enter_off" > "$PCD_BASE/fe_arm" || die "fe_arm engage failed"

    echo "ASK offload: ENGAGED on port $PORT, FE_ENTER=$enter_off (AC_CC)"
}

disengage() {
    echo "ASK offload: tearing down FE-VM pipeline..."

    echo "disengage $PORT" > "$PCD_BASE/fe_arm" 2>/dev/null || true
    echo "del $PORT"   > "$PCD_BASE/fe_port"  2>/dev/null || true
    echo clear > "$PCD_BASE/fe_flow"      2>/dev/null || true
    echo clear > "$PCD_BASE/fe_enter"     2>/dev/null || true
    echo "del $PORT"   > "$PCD_BASE/fe_port"  2>/dev/null || true
    echo clear > "$PCD_BASE/fe_enq"       2>/dev/null || true
    echo clear > "$PCD_BASE/fe_hashfe"    2>/dev/null || true
    echo clear > "$PCD_BASE/fe_ehash"     2>/dev/null || true
    echo clear > "$PCD_BASE/fe_singletons" 2>/dev/null || true
    echo put   > "$PCD_BASE/fe_pool"      2>/dev/null || true

    echo "ASK offload: DISENGAGED"
}

status() {
    if [ -f "$PCD_BASE/fe_arm" ]; then
        local engaged
        engaged=$(grep -oP 'fe_pool engaged:  \K\w+' "$PCD_BASE/fe_arm" 2>/dev/null || echo "UNKNOWN")
        echo "ASK offload: $engaged (FE_ENTER root: $(grep -oP 'FE_ENTER root AD: \K.*' "$PCD_BASE/fe_arm" 2>/dev/null || echo "N/A"))"
    else
        echo "ASK offload: NOT AVAILABLE (fdm_pcd debugfs not mounted)"
    fi
}

# Validate board identity
if ! grep -q "fsl,ls1046a" /proc/device-tree/compatible 2>/dev/null; then
    die "not an LS1046A board — refusing to operate"
fi

case "${VERB:-status}" in
    engage)    engage ;;
    disengage) disengage ;;
    flow-add)
        key="${1}"
        enq="${2:-0x55100}"  # F-054: default to MUX FE offset
        if [ -z "$key" ] || [ "${#key}" -ne 24 ] || ! echo "$key" | grep -qE '^[0-9a-fA-F]{24}$'; then
            echo "ERROR: key must be 24 hex chars (12 bytes) — SIP(8)+DIP(8)+SPORT(4)+DPORT(4)" >&2
            echo "Usage: $0 flow-add <key_hex_24chars> [enq_off]" >&2
            exit 1
        fi
        echo "add 0 ${key} ${enq}" > "$PCD_BASE/fe_flow" || die "fe_flow add failed"
        echo "ASK flow: ADDED key=$key enq=$enq"
        ;;
    flow-del)
        echo clear > "$PCD_BASE/fe_flow" 2>/dev/null || true
        echo "ASK flow: CLEARED"
        ;;
    flow-list)
        if [ -f "$PCD_BASE/fe_flow" ]; then
            grep -oP 'flow\[\d+\] bucket=\S+ rec=\S+ .*' "$PCD_BASE/fe_flow" 2>/dev/null || echo "  (no flows)"
        else
            echo "ASK flow: NOT AVAILABLE"
        fi
        ;;
    flow-stats)
        if [ -f "$PCD_BASE/fe_flow" ]; then
            grep -c "flow\[" "$PCD_BASE/fe_flow" 2>/dev/null || echo "0"
        else
            echo "0"
        fi
        ;;
    status)    status ;;
    *)         echo "Usage: $0 {engage|disengage|status|flow-add|flow-del|flow-list|flow-stats}"; exit 1 ;;
esac

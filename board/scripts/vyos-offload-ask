#!/bin/bash
# vyos-offload-ask — engage/disengage the ASK2 FE-VM offload datapath
# Called from VyOS system_offload.py when "set system offload ask" is configured.
#
# Architecture (2026-07-17):
#   The FE-VM chain build (pool, singletons, ehash, hashfe, enq, enter) is
#   composed inside the kernel by fman_pcd_fe_engage() (patch 0158).  This
#   script resolves the port's dynamic FQID and triggers the engage via the
#   debugfs fe_arm node (instrumentation surface).  The ask.ko OOT module
#   will call fman_pcd_fe_engage() directly through the exported API.
#
#   debugfs = instrumentation only; the control path is through the
#   exported kernel symbols (rule from patch 0157).
#
# Usage: vyos-offload-ask [--port 0x10|0x11] engage|disengage|status|flow-*

set -e

PCD_BASE="/sys/kernel/debug/fman_pcd/0"
PORT="0x11"  # default: eth4 (FMan MAC10, ethernet@f2000, RX BMI port 0x11)

while [ $# -gt 0 ]; do
    case "$1" in
        --port) PORT="$2"; shift 2 ;;
        *) break ;;
    esac
done
VERB="$1"
shift || true

die() { echo "ASK offload: $*" >&2; exit 1; }
warn() { echo "ASK offload: WARNING: $*" >&2; }

# Resolve the port's RX default FQID from sysfs fqids.
# Returns hex string like "2B9" or falls back to "200".
resolve_fqid() {
    local rx_fqid_path port_fqid_dec fqid_hex

    # Try to find the fqids sysfs node for this port
    case "$PORT" in
        0x11) rx_fqid_path="/sys/devices/platform/soc/1a00000.fman/1af2000.ethernet/net/eth4/fqids" ;;
        0x10) rx_fqid_path="/sys/devices/platform/soc/1a00000.fman/1af0000.ethernet/net/eth3/fqids" ;;
        *)
            rx_fqid_path=$(find /sys/devices/platform/soc -name fqids -path "*net/*" 2>/dev/null | head -1)
            ;;
    esac

    if [ -r "$rx_fqid_path" ]; then
        port_fqid_dec=$(awk '/^Rx default:/ {print $3}' "$rx_fqid_path" 2>/dev/null)
        fqid_hex=$(printf "%x" "$port_fqid_dec" 2>/dev/null || echo "")
        if [ -n "$fqid_hex" ]; then
            echo "$fqid_hex"
            return 0
        fi
    fi

    # Fallback: the kernel-side fman_pcd_resolve_miss_fqid() (0158)
    # will read the params page directly.  Return empty to signal
    # "let the kernel resolve it."
    echo ""
}

engage() {
    local miss_fqid

    miss_fqid=$(resolve_fqid)
    if [ -z "$miss_fqid" ]; then
        warn "could not resolve FQID from sysfs — letting kernel fall back (params page 0x0C)"
        miss_fqid="0"  # 0 triggers __fman_pcd_fe_arm_engage fallback to 0x200
    fi

    echo "ASK offload: engaging port $PORT (FQID=0x$miss_fqid, scaffold-only CONT_LOOKUP)"

    # fe_enter_off=0: scaffold-only mode — CONT_LOOKUP pass-through (MISS→kernel).
    # The fman_pcd_fe_engage() exported API (0153/0158) composes the full
    # FE-VM chain (pool, singletons, ehash, hashfe, enq, enter) and calls
    # fe_port_set for the workspace pool.  For the debugfs instrumentation
    # surface we just arm the scaffold.
    echo "engage $PORT 0 $miss_fqid" > "$PCD_BASE/fe_arm" || die "fe_arm engage failed"

    # Arm the FE workspace pool (FmPortSetFESupport, F-072).
    # Required for any FE-VM frame that carves a workspace.  Without this
    # the FE carves at MURAM offset 0 → cumulative corruption.
    echo "set $PORT" > "$PCD_BASE/fe_port" 2>/dev/null || warn "fe_port set failed (pool not armed)"

    echo "ASK offload: ENGAGED on port $PORT (CONT_LOOKUP pass-through, FQ 0x$miss_fqid)"
}

disengage() {
    echo "ASK offload: disengaging port $PORT..."

    # R10: fe_port_del BEFORE scheme disarm (F-074).
    echo "del $PORT" > "$PCD_BASE/fe_port" 2>/dev/null || true

    # R11: scaffold free + scheme disarm (0156 handles both).
    echo "disengage $PORT" > "$PCD_BASE/fe_arm" 2>/dev/null || true

    echo "ASK offload: DISENGAGED"
}

status() {
    if [ -f "$PCD_BASE/fe_arm" ]; then
        local engaged miss
        engaged=$(grep -oP 'fe_pool engaged:  \K\w+' "$PCD_BASE/fe_arm" 2>/dev/null || echo "UNKNOWN")
        miss=$(grep -oP 'MISS FQID: \K.*' "$PCD_BASE/fe_arm" 2>/dev/null || echo "N/A")
        echo "ASK offload: $engaged — $miss"
    else
        echo "ASK offload: NOT AVAILABLE (fman_pcd debugfs not mounted)"
    fi

    # MURAM budget
    if [ -f "$PCD_BASE/muram_budget" ]; then
        cat "$PCD_BASE/muram_budget"
    fi
}

# Validate board identity
if ! grep -q "fsl,ls1046a" /proc/device-tree/compatible 2>/dev/null; then
    die "not an LS1046A board — refusing to operate"
fi

case "${VERB:-status}" in
    engage)    engage ;;
    disengage) disengage ;;
    flow-add)
        key="${1}"
        enq="${2:-0x55100}"
        if [ -z "$key" ] || [ "${#key}" -ne 24 ] || ! echo "$key" | grep -qE '^[0-9a-fA-F]{24}$'; then
            echo "ERROR: key must be 24 hex chars (12 bytes) — SIP(8)+DIP(8)+SPORT(4)+DPORT(4)" >&2
            echo "Usage: $0 flow-add <key_hex_24chars> [enq_off]" >&2
            exit 1
        fi
        echo "add 0 ${key} ${enq}" > "$PCD_BASE/fe_flow" || die "fe_flow add failed"
        echo "ASK flow: ADDED key=$key enq=$enq"
        ;;
    flow-del)
        echo clear > "$PCD_BASE/fe_flow" 2>/dev/null || true
        echo "ASK flow: CLEARED"
        ;;
    flow-list)
        if [ -f "$PCD_BASE/fe_flow" ]; then
            grep -oP 'flow\[\d+\] bucket=\S+ rec=\S+ .*' "$PCD_BASE/fe_flow" 2>/dev/null || echo "  (no flows)"
        else
            echo "ASK flow: NOT AVAILABLE"
        fi
        ;;
    flow-stats)
        if [ -f "$PCD_BASE/fe_flow" ]; then
            grep -c "flow\[" "$PCD_BASE/fe_flow" 2>/dev/null || echo "0"
        else
            echo "0"
        fi
        ;;
    status)    status ;;
    *)
        echo "Usage: $0 [--port 0x10|0x11] {engage|disengage|status|flow-add|flow-del|flow-list|flow-stats}"
        exit 1
        ;;
esac

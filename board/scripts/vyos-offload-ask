#!/bin/bash
# vyos-offload-ask — engage/disengage the ASK2 FE-VM offload datapath
#
# engage / disengage  (PRODUCTION path)
#     Uses ASK generic-netlink commands (engage/disengage) through YNL.
#     This reaches ask_hw_offload_engage()/disengage() and the kernel API
#     fman_pcd_fe_engage()/fman_pcd_fe_disengage() path (no debugfs writes).
#
# hit-engage / hit-disengage are disabled until debugfs lifecycle ownership
# and hardware quiescence have been established.
#
# Usage:
#   vyos-offload-ask [--port 0x10|0x11] engage|disengage|status
#   vyos-offload-ask [--port 0x10|0x11] hit-engage|hit-disengage  (disabled)
#   vyos-offload-ask [--port 0x10|0x11] flow-add <key_hex> [enq_fe_off]
#   vyos-offload-ask [--port 0x10|0x11] flow-del|flow-list|flow-stats
#
set -e

PCD_BASE="/sys/kernel/debug/fman_pcd/0"
YNL_BIN="$(command -v ynl 2>/dev/null || true)"
PORT="0x11"   # default: eth4 (FMan MAC10, RX BMI port 0x11)

while [ $# -gt 0 ]; do
    case "$1" in
        --port) PORT="$2"; shift 2 ;;
        *) break ;;
    esac
done
VERB="${1:-status}"
shift || true

die()  { echo "ASK offload ERROR: $*" >&2; exit 1; }
warn() { echo "ASK offload WARNING: $*" >&2; }
info() { echo "ASK offload: $*"; }

# ---------------------------------------------------------------------------
# ynl_do <op> [json]
# ---------------------------------------------------------------------------
ynl_do() {
    local op="$1"
    local json="${2-}"
    [ -n "$json" ] || json='{}'
    [ -n "$YNL_BIN" ] && [ -x "$YNL_BIN" ] || die "ynl not installed in PATH"
    "$YNL_BIN" --family ask --do "$op" --json "$json" >/dev/null
}

# ---------------------------------------------------------------------------
# port_id_dec — convert 0x10/0x11 style input to decimal u8 for YNL.
# ---------------------------------------------------------------------------
port_id_dec() {
    printf '%d' "$((PORT))" 2>/dev/null || die "invalid --port value '$PORT'"
}

# ---------------------------------------------------------------------------
# read_fe_offset <debugfs_node> <grep_pattern>
# e.g. read_fe_offset fe_hash 'hash\[0\]\s+off='
# ---------------------------------------------------------------------------
read_fe_offset() {
    local node="$1" pat="$2" val
    val=$(grep -oP "${pat}"'0x[0-9a-fA-F]+' "$PCD_BASE/$node" 2>/dev/null | \
          grep -oP '0x[0-9a-fA-F]+' | head -1)
    echo "$val"
}

# ---------------------------------------------------------------------------
# engage — PRODUCTION path via generic-netlink/YNL.
# ---------------------------------------------------------------------------
engage() {
    local port_id mask="${1:-3}"
    port_id="$(port_id_dec)"
    # family-mask: bit0=IPv4, bit1=IPv6 (CLI offload ipv4/ipv6). Default 3=both
    # for the back-compat bare `engage`. mask 0 is nonsensical for engage.
    # Granularity is per port + per IP family only: VLAN, NAT, PPPoE, bridge and
    # IPv6 fragmentation are automatic parts of an engaged port (global
    # ask.* module parameters are the kill switches), so nothing else is passed.
    info "engaging port $PORT via ask genl (port-id=$port_id family-mask=$mask)"
    ynl_do engage "{\"port-id\": $port_id, \"family-mask\": $mask}"
    info "ENGAGED (family-mask=$mask)"
}

# ---------------------------------------------------------------------------
# family <mask> — set this port's offload family selection and engage, or
# disengage when mask==0. Driven by the VyOS CLI `offload ipv4`/`ipv6` leaves
# (conf_mode computes the effective per-port mask each commit).
# ---------------------------------------------------------------------------
family() {
    local mask="${1:-0}"
    if [ "$mask" = "0" ]; then
        disengage
    else
        engage "$mask"
    fi
}

# ---------------------------------------------------------------------------
# disengage — PRODUCTION path teardown via generic-netlink/YNL.
#
# The kernel reserves FE ownership and refuses disengage while any table has
# live or uncertain owners. Do not flush global conntrack or ASK flow state
# before that check: a refused port-scoped request must not disrupt other ports.
# Busy owners must be settled by their owners before retrying. The fe_arm read
# is read-only verification, not a debugfs control write.
# ---------------------------------------------------------------------------
disengage() {
    local port_id port_hex state armed faulted fault_state entry
    local -a arm_fields fault_fields
    port_id="$(port_id_dec)"
    port_hex="$(printf '0x%02x' "$port_id")"

    # 0. Nothing to tear down when ask.ko is not loaded: no port can be
    #    engaged. Failing here would fail the VyOS ethernet commit and leave
    #    every port (eth0 management included) admin-down.
    if [ ! -d /sys/module/ask ]; then
        info "ask.ko not loaded; port $PORT not engaged, nothing to disengage"
        return 0
    fi

    info "disengaging port $PORT..."
    ynl_do disengage "{\"port-id\": $port_id}" \
        || die "disengage of $PORT failed; live or uncertain FE owners may remain on this or another port. No global flow flush was attempted."

    if [ -r "$PCD_BASE/fe_arm" ]; then
        state=$(cat "$PCD_BASE/fe_arm" 2>/dev/null) \
            || die "disengage of $PORT succeeded but FE arm state is unreadable"
        armed=$(printf '%s\n' "$state" | grep '^Armed ports:' || true)
        [ -n "$armed" ] \
            || die "disengage of $PORT succeeded but FE arm state is unreadable"
        [[ "$armed" != *$'\n'* ]] \
            || die "disengage of $PORT succeeded but FE arm state is unreadable"
        read -r -a arm_fields <<< "$armed"
        [ "${#arm_fields[@]}" -ge 3 ] && [ "${arm_fields[1]}" = "ports:" ] \
            || die "disengage of $PORT succeeded but FE arm state is unreadable"
        if [ "${arm_fields[2]}" = "(none)" ]; then
            [ "${#arm_fields[@]}" -eq 3 ] \
                || die "disengage of $PORT succeeded but FE arm state is unreadable"
        else
            for entry in "${arm_fields[@]:2}"; do
                [[ "$entry" =~ ^0x(0[89a-f]|1[0-9a-f]|2[0-7])$ ]] \
                    || die "disengage of $PORT succeeded but FE arm state is unreadable"
                [ "$entry" != "$port_hex" ] \
                    || die "disengage did not hold for $PORT — still armed ($armed)"
            done
        fi

        faulted=$(printf '%s\n' "$state" | grep '^Faulted ports:' || true)
        fault_state=$(printf '%s\n' "$state" | grep '^FE fault/staging:' || true)
        if [ -z "$faulted" ] && [ -z "$fault_state" ]; then
            [[ "$state" != *"debugfs FE arm changes disabled: ownership unresolved"* ]] \
                || die "disengage of $PORT succeeded but FE fault state is unreadable"
            warn "$PCD_BASE/fe_arm has no fault state; disengage fault state unverified"
            info "DISENGAGED (fault state unverified)"
            return 0
        fi
        [ -n "$faulted" ] && [[ "$faulted" != *$'\n'* ]] \
            || die "disengage of $PORT succeeded but FE fault state is unreadable"
        read -r -a fault_fields <<< "$faulted"
        [ "${#fault_fields[@]}" -ge 3 ] && [ "${fault_fields[1]}" = "ports:" ] \
            || die "disengage of $PORT succeeded but FE fault state is unreadable"
        if [ "${fault_fields[2]}" = "(none)" ]; then
            [ "${#fault_fields[@]}" -eq 3 ] \
                || die "disengage of $PORT succeeded but FE fault state is unreadable"
        else
            for entry in "${fault_fields[@]:2}"; do
                [[ "$entry" =~ ^0x(0[89a-f]|1[0-9a-f]|2[0-7])$ ]] \
                    || die "disengage of $PORT succeeded but FE fault state is unreadable"
            done
            die "disengage of $PORT is unverified; FE faulted ports remain ($faulted)"
        fi
        case "$fault_state" in
            "FE fault/staging: no") ;;
            "FE fault/staging: yes")
                die "disengage of $PORT is unverified; FE fault or staging state remains" ;;
            *) die "disengage of $PORT succeeded but FE fault state is unreadable" ;;
        esac
    else
        warn "$PCD_BASE/fe_arm unreadable; disengage state unverified"
        info "DISENGAGED (state unverified)"
        return 0
    fi
    info "DISENGAGED"
}

# ---------------------------------------------------------------------------
# hit_engage / hit_disengage — the debugfs lifecycle is not ownership-safe.
# ---------------------------------------------------------------------------
hit_engage() {
    die "HIT diagnostic disabled: FE lifecycle ownership and quiescence are unresolved"
}

hit_disengage() {
    die "HIT diagnostic disabled: FE lifecycle ownership and quiescence are unresolved"
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
status() {
    if [ ! -f "$PCD_BASE/fe_arm" ]; then
        info "NOT AVAILABLE (fman_pcd debugfs not mounted)"
        return
    fi
    local engaged miss
    engaged=$(grep -oP 'fe_pool engaged:\s+\K\w+' "$PCD_BASE/fe_arm" 2>/dev/null || echo "UNKNOWN")
    miss=$(grep -oP 'MISS FQID:\s+\K\S+' "$PCD_BASE/fe_arm" 2>/dev/null || echo "N/A")
    info "$engaged — MISS FQID: $miss"
    [ -f "$PCD_BASE/muram_budget" ] && cat "$PCD_BASE/muram_budget"
}

# ---------------------------------------------------------------------------
# flow-add <key_hex> [enq_fe_off]
# key_hex: even-length hex string, length = keysize*2 chars (e.g. 16 for 8B)
# enq_fe_off: ENQ FE MURAM offset for the DDR record (auto-detected if omitted)
# ---------------------------------------------------------------------------
flow_add() {
    local key enq_fe_off

    key="${1:-}"
    [ -z "$key" ] && { echo "Usage: $0 flow-add <key_hex> [enq_fe_off]" >&2; exit 1; }

    # Validate: non-empty, even length, hex chars only
    if [ $(( ${#key} % 2 )) -ne 0 ] || ! echo "$key" | grep -qE '^[0-9a-fA-F]+$'; then
        die "key must be even-length hex (e.g. 0A63026A0A6302B9 for 8-byte SIP+DIP)"
    fi

    # Auto-detect ENQ FE offset from debugfs; fall back to 0 (F-057: not read by HW)
    enq_fe_off="${2:-$(read_fe_offset "fe_enq" 'enq\[0\]\s+off=')}"
    enq_fe_off="${enq_fe_off:-0}"

    echo "add 0 ${key} ${enq_fe_off}" > "$PCD_BASE/fe_flow" || die "fe_flow add failed"
    info "FLOW ADDED  key=$key  enq_fe=$enq_fe_off"
    info "  key length: $(( ${#key} / 2 )) bytes"
}

# ---------------------------------------------------------------------------
# flow-del [key_hex]
# With a key: per-key delete (F-118 "del <key>" verb → fman_pcd_ehash_del_key,
#   removes exactly that flow, keeping the collision chain intact).
# Without a key: clear ALL flows (legacy behaviour).
# ---------------------------------------------------------------------------
flow_del() {
    local key="${1:-}"
    if [ -z "$key" ]; then
        echo "clear" > "$PCD_BASE/fe_flow" \
            || die "flow clear failed; FE state unverified"
        info "flows CLEARED (all)"
        return
    fi
    if [ $(( ${#key} % 2 )) -ne 0 ] || ! echo "$key" | grep -qE '^[0-9a-fA-F]+$'; then
        die "key must be even-length hex"
    fi
    echo "del ${key}" > "$PCD_BASE/fe_flow" || die "fe_flow del failed (no such key, or F-118 not present)"
    info "FLOW DELETED  key=$key ($(( ${#key} / 2 )) bytes)"
}

# ---------------------------------------------------------------------------
# Guard: LS1046A only
# ---------------------------------------------------------------------------
if ! grep -q "fsl,ls1046a" /proc/device-tree/compatible 2>/dev/null; then
    die "not an LS1046A board — refusing to operate"
fi

case "$VERB" in
    engage)         engage "${1:-3}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
    family)         family "${1:-0}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
    disengage)      disengage ;;
    hit-engage)     hit_engage "$@" ;;
    hit-disengage)  hit_disengage ;;
    status)         status ;;
    flow-add)       flow_add "$@" ;;
    flow-del)       flow_del "$@" ;;
    flow-clear)     flow_del ;;
    flow-list)
        [ -f "$PCD_BASE/fe_flow" ] && \
            grep -oP 'flow\[\d+\] bucket=\S+ rec=\S+ .*' "$PCD_BASE/fe_flow" 2>/dev/null \
            || info "(no flows)"
        ;;
    flow-stats)
        [ -f "$PCD_BASE/fe_flow" ] && \
            grep -c "flow\[" "$PCD_BASE/fe_flow" 2>/dev/null || echo "0"
        ;;
    *)
        cat >&2 <<'EOF'
Usage: vyos-offload-ask [--port 0x10|0x11] <verb> [args]

Production path (CONT_LOOKUP scaffold, FE-VM dormant):
  engage [mask]           arm offload; mask bit0=IPv4 bit1=IPv6 (default 3)
  family <mask>           set per-port family selection and engage; mask 0 = disengage
                          (VLAN/NAT/PPPoE/bridge/IPv6 frag are automatic on an
                          engaged port; kill switches are ask.* module params)
  disengage                disarm, restore RSS

HIT verification:
  hit-engage / hit-disengage  disabled until lifecycle ownership is proven

Flow management:
  flow-add <key_hex>      insert flow (key_hex = keysize*2 hex chars)
  flow-del                clear all flows
  flow-list               list inserted flows
  flow-stats              count inserted flows

Status:
  status                  show engagement state + MURAM budget
EOF
        exit 1
        ;;
esac

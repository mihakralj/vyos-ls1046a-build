#!/usr/bin/env bash
# caam-check — print full CAAM (Cryptographic Acceleration and Assurance
# Module) status for the LS1046A Mono Gateway DK.
#
# Usage:   caam-check
#
# CAAM is the NXP SEC 5.4 hardware crypto engine on every Layerscape
# LS1046A SoC. It accelerates AES/SHA/3DES/HMAC/RSA/RNG via Job Ring (JR)
# descriptors submitted from the kernel crypto API. Kernel IPsec (xfrm)
# uses it through that API when a CAAM driver wins algorithm selection;
# ASK2 ESP offload (xfrmdev_ops) is not wired yet
# (plans/ASK2-IPSEC-OFFLOAD-PLAN.md).
#
# Reports:
#   - SoC presence (DT compatible, CAAM controller MMIO node)
#   - kernel module / built-in posture per CAAM driver (caam, caam_jr,
#     caamalg, caamhash, caamrng, caamprng, caampkc) and the count of
#     active Job Rings (caam_jr0..N)
#   - JR sysfs presence (/sys/bus/platform/drivers/caam_jr/* device links)
#   - dmesg banner lines ("caam %s: device ID = ...", "caam_jr %s: Instantiated RNG4 SH...")
#   - kernel crypto API registrations sourced from CAAM (looks for "caam"
#     in /proc/crypto driver fields)
#   - IPsec algorithm selection: which driver wins (highest priority) for
#     the common ESP transforms, and the self-test result of CAAM entries
#   - CAAM controller debugfs job/byte counters (root only, if present)
#   - Hardware RNG: presence of /dev/hwrng, current_source (should be
#     "rng-caam" once caamrng has loaded), and a 16-byte sample read
#   - ASK2 module posture (if ask.ko is loaded): init banners, flow
#     offload errors, xfrmdev offload status
#
# Designed to mirror the style of `sfp-check`, `fan-check`, and
# `ask-check.sh`: human-readable table with [OK]/[WARN]/[FAIL]/[SKIP]
# tags, colour where the tty supports it.
#
# Exit codes:
#   0 — CAAM controller present, at least 1 Job Ring active, RNG sourced
#       from rng-caam (or no /dev/hwrng but JR active is acceptable)
#   1 — CAAM hardware not detected, no Job Rings up, kernel crypto
#       API has no CAAM-backed algorithms, or a CAAM algorithm failed
#       its self-test
#   2 — board is not LS1046A (sysfs paths absent)

set -u

# ---------------------------------------------------------------------------
# Colour escapes (TTY only). Same convention as fan-check / ask-check.
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
    C_RST=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_RED=$'\033[1;31m'
    C_BLUE=$'\033[1;34m'
else
    C_RST='' C_BOLD='' C_DIM='' C_GREEN='' C_YELLOW='' C_RED='' C_BLUE=''
fi

ok()    { printf "  [%sOK%s]   %s\n"   "$C_GREEN"  "$C_RST" "$*"; }
warn()  { printf "  [%sWARN%s] %s\n"   "$C_YELLOW" "$C_RST" "$*"; }
fail()  { printf "  [%sFAIL%s] %s\n"   "$C_RED"    "$C_RST" "$*"; }
skip()  { printf "  [%sSKIP%s] %s\n"   "$C_BLUE"   "$C_RST" "$*"; }
note()  { printf "         %s%s%s\n"   "$C_DIM"    "$*"     "$C_RST"; }
hdr()   { printf "\n%s%s%s\n"          "$C_BOLD"   "$*"     "$C_RST"; }

EXIT=0
mark_fail() { EXIT=1; }

# ---------------------------------------------------------------------------
# Board gate. Same idiom as fan-check / vyos-postinstall.
# ---------------------------------------------------------------------------
if [ ! -f /proc/device-tree/compatible ] \
   || ! tr '\0' '\n' < /proc/device-tree/compatible | grep -q 'fsl,ls1046a'; then
    echo "caam-check: not LS1046A — nothing to report" >&2
    exit 2
fi

printf "%scaam-check%s — LS1046A SEC 5.4 status\n" "$C_BOLD" "$C_RST"

# ---------------------------------------------------------------------------
# 1. SoC controller presence (devicetree)
# ---------------------------------------------------------------------------
hdr "1) CAAM controller (devicetree)"

# CAAM controller node lives at /soc/crypto@1700000 on LS1046A.
# Compatible: "fsl,sec-v5.4" + "fsl,sec-v5.0" + "fsl,sec-v4.0" fallback.
DT_CAAM=""
for cand in /proc/device-tree/soc/crypto@* /proc/device-tree/crypto@*; do
    [ -d "$cand" ] && DT_CAAM="$cand" && break
done
if [ -n "$DT_CAAM" ]; then
    compat=$(tr '\0' ' ' < "$DT_CAAM/compatible" 2>/dev/null | sed 's/ *$//')
    ok "DT node $(basename "$DT_CAAM") present"
    note "compatible = \"$compat\""
    if [ -f "$DT_CAAM/reg" ]; then
        # First 8 bytes of reg = base address (big-endian).
        baseaddr=$(od -An -tx1 -N8 "$DT_CAAM/reg" 2>/dev/null | tr -d ' \n')
        note "MMIO reg base bytes = 0x$baseaddr"
    fi
else
    fail "no /proc/device-tree/soc/crypto@* node — CAAM not in DT"
    mark_fail
fi

# ---------------------------------------------------------------------------
# 2. Driver / module posture
# ---------------------------------------------------------------------------
hdr "2) CAAM kernel drivers"

# Drivers we care about. In mainline 6.18, the per-algorithm front-ends
# (caamalg, caamhash, caamrng, caampkc, caamalg_qi) are NOT separate
# .ko files — they are linked into caam_jr.ko at build time
# (drivers/crypto/caam/Makefile: caam_jr-$(CONFIG_..._API) += caamalg.o
# etc.). The only separately-loadable modules are:
#   caam            — controller (ctrl.o)
#   caam_jr         — Job Ring driver + all *alg/hash/rng/pkc front-ends
#   caamalg_desc    — descriptor helpers shared with dpaa2_caam
#   caamhash_desc   — descriptor helpers shared with dpaa2_caam
#   error           — error decode helpers
# A previous version of this script also probed caamalg/caamhash/etc.
# as if they were separate modules — they never load on mainline 6.x.
CAAM_DRVS=(caam caam_jr caamalg_desc caamhash_desc error)
for drv in "${CAAM_DRVS[@]}"; do
    # drivers/crypto/caam/error.c builds as a module literally named
    # "error.ko" (caam_strstatus() status-decode helpers shared by the
    # other caam modules). Annotate it so the report doesn't read like
    # a failure line.
    label="$drv"
    [ "$drv" = "error" ] && label="error (caam status-decode helper)"
    if [ -d "/sys/module/${drv}" ]; then
        # Built-in drivers have no refcnt file; modules do.
        if [ -f "/sys/module/${drv}/refcnt" ]; then
            refcnt=$(cat "/sys/module/${drv}/refcnt" 2>/dev/null || echo "?")
            ok "${label} loaded (refcnt=${refcnt}, module)"
        else
            ok "${label} present (built-in, sysfs)"
        fi
    elif [ "$drv" = "caam" ] && [ -d "/sys/bus/platform/devices/1700000.crypto" ]; then
        ok "${label} present (built-in, platform device probed — /sys/module N/A for initcall-order drivers)"
    elif [ "$drv" = "caam_jr" ] && [ -d "/sys/bus/platform/drivers/caam_jr" ] && \
         [ "$(ls /sys/bus/platform/drivers/caam_jr/ 2>/dev/null | grep -c '\.jr$')" -gt 0 ]; then
        ok "${label} present (built-in, $(ls /sys/bus/platform/drivers/caam_jr/ | grep '\.jr$' | wc -l) JR bound)"
    elif [ "$drv" = "caamalg_desc" ] && grep -q "caam" /proc/crypto 2>/dev/null; then
        ok "${label} present (built-in, CAAM algorithms in /proc/crypto)"
    elif [ "$drv" = "caamhash_desc" ] && grep -q "caam" /proc/crypto 2>/dev/null; then
        ok "${label} present (built-in, CAAM algorithms in /proc/crypto)"
    else
        case "$drv" in
            caam|caam_jr|caamalg_desc|caamhash_desc)
                fail "${drv} NOT loaded — CAAM crypto API unavailable"; mark_fail ;;
            *)
                skip "${label} not loaded (optional)" ;;
        esac
    fi
done

# ---------------------------------------------------------------------------
# 3. Job Ring devices
# ---------------------------------------------------------------------------
hdr "3) Job Rings (caam_jr platform devices)"

JR_DRV_DIR=/sys/bus/platform/drivers/caam_jr
if [ -d "$JR_DRV_DIR" ]; then
    # Bound device symlinks (each one is a Job Ring).
    JRS=()
    for link in "$JR_DRV_DIR"/*; do
        [ -L "$link" ] || continue
        case "$(basename "$link")" in
            bind|unbind|uevent|module) continue ;;
        esac
        JRS+=("$(basename "$link")")
    done
    if [ "${#JRS[@]}" -gt 0 ]; then
        ok "${#JRS[@]} Job Ring(s) bound to caam_jr driver"
        for jr in "${JRS[@]}"; do
            note "  $jr"
        done
    else
        fail "caam_jr driver present but ZERO Job Rings bound — RNG and crypto API will fail"
        mark_fail
    fi
else
    fail "no $JR_DRV_DIR — caam_jr driver did not register"
    mark_fail
fi

# ---------------------------------------------------------------------------
# 4. Boot-time CAAM banner from dmesg
# ---------------------------------------------------------------------------
hdr "4) dmesg banner"

if command -v dmesg >/dev/null 2>&1; then
    DMESG_OUT=$(dmesg 2>/dev/null | grep -E 'caam|crypto.*1700000' || true)
    # Fall back to the persistent journal if the kernel ring buffer has
    # aged out the CAAM banner (uptime > ~30 min on a busy system).
    if [ -z "$DMESG_OUT" ] && command -v journalctl >/dev/null 2>&1; then
        DMESG_OUT=$(journalctl -k -b -o cat 2>/dev/null \
                    | grep -E 'caam|crypto.*1700000' || true)
    fi
    if [ -n "$DMESG_OUT" ]; then
        # Trim very long blobs; keep the most informative ~12 lines.
        echo "$DMESG_OUT" | head -12 | while IFS= read -r line; do
            note "$line"
        done
    else
        warn "no caam-related dmesg lines (may be aged out of ring buffer)"
    fi
else
    skip "dmesg not available"
fi

# ---------------------------------------------------------------------------
# 5. Kernel crypto API: CAAM-backed algorithms
# ---------------------------------------------------------------------------
hdr "5) /proc/crypto algorithms backed by CAAM"

if [ -r /proc/crypto ]; then
    # Block records by blank lines, keep blocks where driver name contains
    # "caam". Use match()+substr() instead of sub()+comma — mawk silently
    # treats `sub(...) , var=$i` as a syntax error and produces no rows.
    CAAM_ALGS=$(awk '
        BEGIN { RS=""; FS="\n" }
        /driver +: .*caam/ {
            name=""; drv=""; typ="";
            for (i=1; i<=NF; i++) {
                if (match($i, /^name +: */))   { name = substr($i, RSTART+RLENGTH) }
                if (match($i, /^driver +: */)) { drv  = substr($i, RSTART+RLENGTH) }
                if (match($i, /^type +: */))   { typ  = substr($i, RSTART+RLENGTH) }
            }
            printf "%-28s  %-40s  %s\n", name, drv, typ
        }
    ' /proc/crypto 2>/dev/null)
    if [ -n "$CAAM_ALGS" ]; then
        count=$(printf "%s\n" "$CAAM_ALGS" | wc -l)
        ok "$count CAAM-backed algorithm(s) registered"
        # 6.18 LS1046A registers ~250 entries (AEAD + skcipher + ahash +
        # rsa + rng across both JR and QI paths). Cap the dump to the
        # first 12 so the report stays scannable.
        printf "%s\n" "$CAAM_ALGS" | head -12 | while IFS= read -r line; do
            note "$line"
        done
        if [ "$count" -gt 12 ]; then
            note "  ... ($((count - 12)) more — full list: grep -A6 caam /proc/crypto)"
        fi
    else
        fail "/proc/crypto has no CAAM-backed entries"
        mark_fail
        note "  (caam_jr probed but registered zero algorithms — check dmesg for"
        note "   'caam_jr: register algs' errors, or RNG4 instantiation failure)"
    fi
else
    skip "/proc/crypto not readable"
fi

# ---------------------------------------------------------------------------
# 5b. IPsec transform selection and CAAM self-tests
# ---------------------------------------------------------------------------
hdr "5b) IPsec transform selection (highest priority wins)"

# The kernel picks the highest-priority registered implementation of each
# algorithm name. CAAM only accelerates kernel IPsec when one of its drivers
# (caam_jr: *-caam, QI: *-caam-qi) outranks the arm64 CE/NEON software
# drivers. A CAAM entry whose self-test is not "passed" is a hard failure;
# "unknown" means the kernel was built without crypto self-tests.
if [ -r /proc/crypto ]; then
    for alg in 'authenc(hmac(sha256),cbc(aes))' 'authenc(hmac(sha1),cbc(aes))' \
               'rfc4106(gcm(aes))' 'gcm(aes)' 'cbc(aes)' 'hmac(sha256)'; do
        rows=$(awk -v want="$alg" '
            BEGIN { RS=""; FS="\n" }
            {
                name=""; drv=""; pri=""; st="";
                for (i=1; i<=NF; i++) {
                    if (match($i, /^name +: */))     { name = substr($i, RSTART+RLENGTH) }
                    if (match($i, /^driver +: */))   { drv  = substr($i, RSTART+RLENGTH) }
                    if (match($i, /^priority +: */)) { pri  = substr($i, RSTART+RLENGTH) }
                    if (match($i, /^selftest +: */)) { st   = substr($i, RSTART+RLENGTH) }
                }
                if (name == want) printf "%s %s %s\n", pri, drv, st
            }
        ' /proc/crypto 2>/dev/null | sort -rn)
        if [ -z "$rows" ]; then
            skip "$alg: not registered (instantiated on first use)"
            continue
        fi
        set -- $(printf "%s\n" "$rows" | head -1)
        case "$2" in
            *caam*) ok "$alg -> $2 (priority $1, selftest $3)" ;;
            *)      warn "$alg -> $2 (priority $1) — software wins, CAAM not used" ;;
        esac
        printf "%s\n" "$rows" | sed 1d | while read -r pri drv st; do
            note "  also: $drv (priority $pri, selftest $st)"
        done
        bad=$(printf "%s\n" "$rows" | awk '$2 ~ /caam/ && $3 != "passed" && $3 != "unknown" {print $2"="$3}')
        if [ -n "$bad" ]; then
            fail "$alg: CAAM self-test not passed: $bad"
            mark_fail
        fi
    done
else
    skip "/proc/crypto not readable"
fi

# Controller job/byte counters (drivers/crypto/caam/debugfs.c). The debugfs
# directory name varies by kernel ("caam" or the controller device name).
CTL_DIR=""
for d in /sys/kernel/debug/caam/ctl /sys/kernel/debug/*crypto*/ctl; do
    [ -r "$d/rq_dequeued" ] && { CTL_DIR=$d; break; }
done
if [ -n "$CTL_DIR" ]; then
    for c in rq_dequeued ob_rq_encrypted ib_rq_decrypted ob_bytes_encrypted ib_bytes_decrypted; do
        [ -r "$CTL_DIR/$c" ] && note "$(printf '%-20s %s' "$c" "$(cat "$CTL_DIR/$c" 2>/dev/null)")"
    done
elif [ "$(id -u)" = "0" ]; then
    skip "CAAM debugfs counters not present (CONFIG_DEBUG_FS or caam debugfs off)"
else
    skip "CAAM debugfs counters skipped (not root)"
fi

# ---------------------------------------------------------------------------
# 6. Hardware RNG (CAAM RNG4)
# ---------------------------------------------------------------------------
hdr "6) Hardware RNG (caamrng / RNG4)"

if [ -e /dev/hwrng ]; then
    ok "/dev/hwrng present"
    if [ -r /sys/class/misc/hw_random/rng_current ]; then
        cur=$(cat /sys/class/misc/hw_random/rng_current 2>/dev/null || echo "?")
        # Mainline caamrng (drivers/crypto/caam/caamrng.c) registers as
        # "rng-caam". Older out-of-tree backports used "caam-rng" — accept
        # both so the check works across kernel versions.
        if [ "$cur" = "rng-caam" ] || [ "$cur" = "caam-rng" ]; then
            ok "rng_current = $cur (HW source active)"
        else
            warn "rng_current = $cur (CAAM RNG present but not selected)"
            if [ -r /sys/class/misc/hw_random/rng_available ]; then
                avail=$(cat /sys/class/misc/hw_random/rng_available 2>/dev/null)
                note "rng_available = $avail"
            fi
        fi
    fi
    # Sample read (non-blocking, 16 bytes) — only as root.
    if [ "$(id -u)" = "0" ]; then
        sample=$(dd if=/dev/hwrng of=/dev/stdout bs=16 count=1 2>/dev/null \
                 | od -An -tx1 -v 2>/dev/null | tr -d ' \n')
        if [ -n "$sample" ]; then
            ok "16-byte sample from /dev/hwrng: $sample"
        else
            warn "could not read sample from /dev/hwrng"
        fi
    else
        skip "sample read of /dev/hwrng skipped (not root)"
    fi
else
    warn "/dev/hwrng absent — caamrng module did not register hwrng node"
    note "  (kernel may still satisfy crypto requests via the JR-backed crypto API,"
    note "   but the hwrng userspace interface is unavailable)"
fi

# ---------------------------------------------------------------------------
# 7. ASK2 flow offload posture
# ---------------------------------------------------------------------------
hdr "7) ASK2 flow offload (ask.ko)"

# ask.ko ships in every image (specs/ask2-rewrite-spec.md). Its init banners:
#   "ask: hw: FMan microcode …", "ask: ready (genl family registered …)",
#   "ask: flow_offload: BIND <ifname>", "ask: flow: hw_insert OK".
# The legacy ASK 1.x stack (cdx.ko + dpa_ipsec.ko) was deleted in May 2026.
# IPsec ESP offload via xfrmdev_ops is not wired yet
# (plans/ASK2-IPSEC-OFFLOAD-PLAN.md).

if [ -d /sys/module/ask ]; then
    ver=$(cat /sys/module/ask/version 2>/dev/null || echo "?")
    refcnt=$(cat /sys/module/ask/refcnt 2>/dev/null || echo "?")
    ok "ask module loaded (version=${ver}, refcnt=${refcnt})"

    # Pull the per-subsystem 'ready' banners from the persistent journal —
    # the kernel ring buffer ages them out on long-running systems.
    if command -v journalctl >/dev/null 2>&1; then
        ASK_LOG=$(journalctl -k -b -o cat 2>/dev/null | grep -E '^ask:' || true)
    else
        ASK_LOG=$(dmesg 2>/dev/null | sed -E 's/^\[[^]]+\] //' | grep -E '^ask:' || true)
    fi

    if [ -n "$ASK_LOG" ]; then
        # Each of these banners is logged exactly once at module init by
        # the corresponding subsystem (see ask_main.c / ask_hw_*.c).
        ucode=$(printf "%s\n" "$ASK_LOG" | grep -m1 'hw: FMan microcode'        || true)
        flow=$(printf  "%s\n" "$ASK_LOG" | grep -m1 'flow: subsystem ready'      || true)
        fo=$(printf    "%s\n" "$ASK_LOG" | grep -m1 'flow_offload: ready'        || true)
        genl=$(printf  "%s\n" "$ASK_LOG" | grep -m1 "genl family 'ask' registered" || true)
        ready=$(printf "%s\n" "$ASK_LOG" | grep -m1 '^ask: ready'                || true)

        [ -n "$ucode"  ] && ok "FMan microcode loaded"    && note "$ucode"   || warn "no 'FMan microcode' banner — ucode load may have failed"
        [ -n "$flow"   ] && ok "ask flow subsystem ready" && note "$flow"
        [ -n "$fo"     ] && ok "flow_offload subsystem ready" && note "$fo"
        [ -n "$genl"   ] && ok "ask genl family registered" && note "$genl"
        [ -n "$ready"  ] && note "$ready"

        # Per-port BIND events + hw_insert success/failure counters.
        binds=$(printf "%s\n" "$ASK_LOG" | grep -cE 'flow_offload: BIND ')
        hw_ok=$(printf "%s\n" "$ASK_LOG" | grep -cE 'flow: hw_insert OK')
        hw_bad=$(printf "%s\n" "$ASK_LOG" | grep -cE 'flow: hw_insert (FAIL|err|ERROR)')
        if [ "$binds" -gt 0 ] || [ "$hw_ok" -gt 0 ] || [ "$hw_bad" -gt 0 ]; then
            if [ "$hw_bad" -eq 0 ]; then
                ok "flow offload activity: ${binds} BIND, ${hw_ok} hw_insert OK, 0 errors"
            else
                fail "flow offload activity: ${binds} BIND, ${hw_ok} hw_insert OK, ${hw_bad} ERROR"
                mark_fail
            fi
        else
            note "no flow_offload activity yet (no nft flowtable rules bound to dpaa_eth?)"
        fi
    else
        warn "no 'ask:' lines in journal/dmesg — module loaded but did not log"
    fi

    # IPsec ESP offload via xfrmdev_ops is deferred to M5 in the rewrite
    # spec. caam-check is the natural place to surface that status, but
    # nothing has been wired yet — note it explicitly so operators don't
    # mistake the absence for a bug.
    if [ -e /sys/class/net/eth3/xfrm ] || [ -e /sys/class/net/eth4/xfrm ]; then
        ok "xfrmdev offload sysfs present on dpaa_eth ports"
    else
        skip "IPsec ESP offload via xfrmdev_ops not wired (plans/ASK2-IPSEC-OFFLOAD-PLAN.md)"
    fi

else
    skip "ask module not loaded"
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
hdr "Summary"
if [ "$EXIT" = "0" ]; then
    ok "CAAM healthy"
else
    fail "CAAM check FAILED — see entries above"
fi

exit "$EXIT"
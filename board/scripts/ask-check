#!/usr/bin/env bash
# ask-check — production health check for ASK2 plain routed IPv4 unicast
# hardware offload on the LS1046A Mono Gateway DK.
#
# Usage: sudo ask-check
#
# This is NOT a milestone burndown chart and does not inspect experimental
# debugfs harnesses. It checks the shipping datapath and its production control
# plane only:
#
#   VyOS config -> nft flowtable/conntrack -> nf_flow_table callbacks -> ask.ko
#   -> FMan PCD FE/ehash -> UPDATE_TTL + INSERT_L2_HDR -> no-confirm TX FQ.
#
# Shipping scope: routed IPv4 unicast TCP/UDP. IPv6, NAT/PAT, VLAN actions,
# bridge, multicast and IPsec are software-fallback features, not failures here.
# Their safety contract is enforced by strict action rejection in ask.ko.
#
# Debugfs is deliberately irrelevant. Production control and observability use
# generic netlink/YNL, VyOS configuration, nftables, sysfs/ethtool and the
# current-boot kernel journal. The script never mutates configuration, flows,
# conntrack, FMan registers, MURAM, FQs or interface state.
#
# Exit codes:
#   0  all required production checks passed (WARN/SKIP do not fail)
#   1  at least one required production check failed
#   2  not an LS1046A board

set -u

if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
    C_RST=$'\033[0m' C_BOLD=$'\033[1m' C_DIM=$'\033[2m'
    C_GREEN=$'\033[1;32m' C_YELLOW=$'\033[1;33m'
    C_RED=$'\033[1;31m' C_BLUE=$'\033[1;34m'
else
    C_RST='' C_BOLD='' C_DIM='' C_GREEN='' C_YELLOW='' C_RED='' C_BLUE=''
fi

ok()   { printf '  [%sOK%s]   %s\n' "$C_GREEN" "$C_RST" "$*"; }
warn() { printf '  [%sWARN%s] %s\n' "$C_YELLOW" "$C_RST" "$*"; }
fail() { printf '  [%sFAIL%s] %s\n' "$C_RED" "$C_RST" "$*"; }
skip() { printf '  [%sSKIP%s] %s\n' "$C_BLUE" "$C_RST" "$*"; }
note() { printf '         %s%s%s\n' "$C_DIM" "$*" "$C_RST"; }
hdr()  { printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_RST"; }

EXIT=0
N_OK=0 N_WARN=0 N_FAIL=0 N_SKIP=0
record_ok()   { ok "$@"; N_OK=$((N_OK + 1)); }
record_warn() { warn "$@"; N_WARN=$((N_WARN + 1)); }
record_fail() { fail "$@"; N_FAIL=$((N_FAIL + 1)); EXIT=1; }
record_skip() { skip "$@"; N_SKIP=$((N_SKIP + 1)); }

TMPDIR_CHECK=$(mktemp -d /tmp/ask-check.XXXXXX 2>/dev/null || echo /tmp/ask-check.$$)
mkdir -p "$TMPDIR_CHECK" 2>/dev/null || true
trap 'rm -rf "$TMPDIR_CHECK"' EXIT HUP INT TERM

if [ ! -r /proc/device-tree/compatible ] \
   || ! tr '\0' '\n' < /proc/device-tree/compatible | grep -q '^fsl,ls1046a$'; then
    echo 'ask-check: not an LS1046A board' >&2
    exit 2
fi

IS_ROOT=0
[ "$(id -u)" -eq 0 ] && IS_ROOT=1
hostname_str=$(hostname 2>/dev/null || echo '?')
kernel_str=$(uname -r 2>/dev/null || echo '?')
printf '%sask-check%s  host=%s  kernel=%s  %s\n' \
    "$C_BOLD" "$C_RST" "$hostname_str" "$kernel_str" \
    "$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
if [ "$IS_ROOT" -eq 0 ]; then
    note 'run with sudo for YNL, nftables, kallsyms and kernel-journal checks'
fi

KLOG=''
if [ "$IS_ROOT" -eq 1 ] && command -v journalctl >/dev/null 2>&1; then
    KLOG=$(journalctl -b -k -o cat --no-pager 2>/dev/null || true)
fi

CONFIG_CMDS=''
if command -v cli-shell-api >/dev/null 2>&1; then
    CONFIG_CMDS=$(cli-shell-api showCfg --show-active-only interfaces 2>/dev/null || true)
fi
# The command-form output is easier and authoritative for flowtable membership.
if [ -x /opt/vyatta/bin/vyatta-op-cmd-wrapper ]; then
    config_command_output=$(/opt/vyatta/bin/vyatta-op-cmd-wrapper \
        show configuration commands 2>/dev/null || true)
else
    config_command_output=''
fi

ASK_PORTS=()
for dev in eth3 eth4; do
    if echo "$config_command_output" \
        | grep -qE "^set interfaces ethernet ${dev} offload ask$"; then
        ASK_PORTS+=("$dev")
    fi
done

# ---------------------------------------------------------------------------
hdr '1) Platform and DPAA1 transit ports'
# ---------------------------------------------------------------------------

model=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || echo '?')
record_ok "board: $model"

DPAA_PORTS=()
for dev in eth3 eth4; do
    if [ -d "/sys/class/net/$dev" ] \
       && find -L "/sys/class/net/$dev/device" -maxdepth 0 -type d 2>/dev/null \
          | grep -q .; then
        DPAA_PORTS+=("$dev")
    fi
done
if [ "${#DPAA_PORTS[@]}" -eq 2 ]; then
    record_ok 'DPAA1 transit netdevs present: eth3 eth4'
else
    record_fail "missing DPAA1 transit netdev(s); found: ${DPAA_PORTS[*]:-(none)}"
fi

ip_forward=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
if [ "$ip_forward" = 1 ]; then
    record_ok 'IPv4 forwarding enabled'
else
    record_fail 'net.ipv4.ip_forward is not enabled'
fi

for dev in eth3 eth4; do
    [ -d "/sys/class/net/$dev" ] || continue
    carrier=$(cat "/sys/class/net/$dev/carrier" 2>/dev/null || echo 0)
    addr=$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{print $4}' | paste -sd, -)
    if [ "$carrier" = 1 ] && [ -n "$addr" ]; then
        record_ok "$dev link/carrier/address healthy ($addr)"
    elif [ "$carrier" != 1 ]; then
        record_fail "$dev has no carrier"
    else
        record_fail "$dev has carrier but no IPv4 address"
    fi

done

if echo "$KLOG" | grep -q 'FMan PCD caps = 0x17'; then
    record_ok 'FMan microcode exposes required PCD capabilities (CC/HM/POL/PARSER)'
elif echo "$KLOG" | grep -q 'FMan PCD caps'; then
    caps_line=$(echo "$KLOG" | grep 'FMan PCD caps' | tail -1)
    record_fail "unexpected FMan PCD capability mask: $caps_line"
else
    record_warn 'FMan PCD capability banner not present in current-boot journal'
fi

# ---------------------------------------------------------------------------
hdr '2) ASK module and M6-A safety substrate'
# ---------------------------------------------------------------------------

if [ -d /sys/module/ask ]; then
    version=$(cat /sys/module/ask/version 2>/dev/null || echo '?')
    srcversion=$(cat /sys/module/ask/srcversion 2>/dev/null || echo '?')
    record_ok "ask.ko loaded (version=$version srcversion=$srcversion)"
else
    kver=$(uname -r)
    if find "/lib/modules/$kver" -name 'ask.ko*' 2>/dev/null | grep -q .; then
        record_fail 'ask.ko installed but not loaded'
    else
        record_fail 'ask.ko not installed'
    fi
fi

if [ "$IS_ROOT" -eq 1 ] && [ -r /proc/kallsyms ]; then
    required_symbols=(
        ask_intent_lower
        ask_flow_gen_next
        ask_flow_insert_owned
        ask_flow_remove_owned
        ask_hw_flow_preflight
        fman_pcd_fe_engage
        fman_pcd_fe_disengage
        fman_pcd_fe_flow_add
        fman_pcd_fe_flow_del
        dpaa_get_tx_fqid
        dpaa_alloc_offload_tx_fq
    )
    missing=''
    for sym in "${required_symbols[@]}"; do
        grep -qw "$sym" /proc/kallsyms || missing="$missing $sym"
    done
    if [ -z "$missing" ]; then
        record_ok 'M6-A ownership/action/preflight + FE/TX-FQ APIs present'
    else
        record_fail "required runtime symbols missing:$missing"
    fi
else
    record_skip 'root kallsyms unavailable; cannot verify M6-A runtime APIs'
fi

if [ -f /etc/modules-load.d/ask.conf ]; then
    record_ok 'ASK module is configured for automatic boot loading'
else
    record_warn '/etc/modules-load.d/ask.conf absent'
fi

# ---------------------------------------------------------------------------
hdr '3) Production generic-netlink / YNL control plane'
# ---------------------------------------------------------------------------

YNL=$(command -v ynl 2>/dev/null || true)
if [ -z "$YNL" ]; then
    record_fail 'ynl not installed; production ASK control plane unavailable'
elif [ "$IS_ROOT" -eq 0 ]; then
    record_skip 'YNL operations require root'
else
    ops=$($YNL --family ask --list-ops 2>"$TMPDIR_CHECK/ynl-ops.err" || true)
    required_ops='get-info get-muram dump-flows flush-flows engage disengage'
    missing=''
    for op in $required_ops; do
        echo "$ops" | grep -q "^$op " || missing="$missing $op"
    done
    if [ -z "$missing" ]; then
        record_ok "ASK genl family exposes required operations: $required_ops"
    else
        record_fail "ASK genl operations missing:$missing"
        [ -s "$TMPDIR_CHECK/ynl-ops.err" ] && note "$(head -1 "$TMPDIR_CHECK/ynl-ops.err")"
    fi

    if $YNL --family ask --do get-info --json '{}' --output-json \
        >"$TMPDIR_CHECK/get-info.out" 2>"$TMPDIR_CHECK/get-info.err"; then
        info_json=$(tr '\n' ' ' < "$TMPDIR_CHECK/get-info.out")
        record_ok 'YNL get-info decodes successfully'
        note "${info_json:0:220}"
        driver_version=$(echo "$info_json" | grep -oE '"driver-version"[ :]+"[^"]+"' \
            | sed 's/.*"driver-version"[ :]*"//; s/"$//')
        capabilities=$(echo "$info_json" | grep -oE '"capabilities"[ :]+[0-9]+' \
            | grep -oE '[0-9]+' | tail -1)
        num_fman=$(echo "$info_json" | grep -oE '"num-fman"[ :]+[0-9]+' \
            | grep -oE '[0-9]+' | tail -1)
        ucode=$(echo "$info_json" | grep -oE '"ucode-family"[ :]+[0-9]+|"ucode-major"[ :]+[0-9]+|"ucode-minor"[ :]+[0-9]+' \
            | grep -oE '[0-9]+' | paste -sd. -)
        [ "$driver_version" = 'ask 2.1.0' ] \
            && record_ok "ASK driver version is $driver_version" \
            || record_fail "unexpected ASK driver version: ${driver_version:-missing}"
        if [ -n "${capabilities:-}" ] && [ $((capabilities & 1)) -eq 1 ]; then
            record_ok 'ASK advertises the implemented IPv4 hardware capability'
        else
            record_fail "ASK IPv4 capability bit is not advertised (${capabilities:-missing})"
        fi
        [ "$num_fman" = 1 ] \
            && record_ok 'ASK reports one bound FMan instance' \
            || record_fail "ASK reports ${num_fman:-missing} bound FMan instances"
        [ "$ucode" = '210.10.1' ] \
            && record_ok 'ASK reports FMan microcode 210.10.1' \
            || record_fail "unexpected ASK FMan microcode version: ${ucode:-missing}"
    else
        record_fail 'YNL get-info failed or wire/schema decoding is inconsistent'
        note "$(head -1 "$TMPDIR_CHECK/get-info.err")"
    fi

    if $YNL --family ask --do get-muram --json '{}' --output-json \
        >"$TMPDIR_CHECK/get-muram.out" 2>"$TMPDIR_CHECK/get-muram.err"; then
        record_ok 'YNL get-muram decodes successfully'
        muram_json=$(tr '\n' ' ' < "$TMPDIR_CHECK/get-muram.out")
        note "${muram_json:0:220}"
        # A zero free-byte budget is fatal. JSON formatting is intentionally
        # parsed loosely so pyYNL formatting changes do not break the probe.
        free_bytes=$(echo "$muram_json" | grep -oE '"free-bytes"[ :]+[0-9]+' \
            | grep -oE '[0-9]+' | tail -1)
        if [ -n "${free_bytes:-}" ] && [ "$free_bytes" -eq 0 ] 2>/dev/null; then
            record_fail 'FMan PCD MURAM budget is exhausted (free-bytes=0)'
        elif [ -n "${free_bytes:-}" ]; then
            record_ok "FMan PCD MURAM has ${free_bytes} free bytes"
        fi
    else
        record_fail 'YNL get-muram failed or wire/schema decoding is inconsistent'
        note "$(head -1 "$TMPDIR_CHECK/get-muram.err")"
    fi

    if $YNL --family ask --dump dump-flows --output-json \
        >"$TMPDIR_CHECK/dump-flows.out" 2>"$TMPDIR_CHECK/dump-flows.err"; then
        record_ok 'YNL dump-flows works'
        flow_dump=$(tr '\n' ' ' < "$TMPDIR_CHECK/dump-flows.out")
        if [ "$flow_dump" = '[]' ] || [ -z "$flow_dump" ]; then
            note 'no ASK-owned flows at this instant (idle is healthy)'
        else
            offloaded=$(grep -o '"offloaded"[ :]*1' "$TMPDIR_CHECK/dump-flows.out" | wc -l)
            note "live flow dump: ${offloaded} hardware-backed flow(s)"
        fi
    else
        record_fail 'YNL dump-flows failed'
        note "$(head -1 "$TMPDIR_CHECK/dump-flows.err")"
    fi
fi

# ---------------------------------------------------------------------------
hdr '4) VyOS ASK configuration and per-port live state'
# ---------------------------------------------------------------------------

if [ "${#ASK_PORTS[@]}" -gt 0 ]; then
    record_ok "ASK configured on: ${ASK_PORTS[*]}"
else
    record_fail "no interface has 'offload ask' configured"
fi

if echo "$config_command_output" | grep -q '^set vpp settings interface '; then
    conflict=''
    for dev in "${ASK_PORTS[@]}"; do
        echo "$config_command_output" \
            | grep -qE "^set vpp settings interface ['\"]?${dev}['\"]?$" \
            && conflict="$conflict $dev"
    done
    if [ -n "$conflict" ]; then
        record_fail "ASK/VPP mutex violated on:$conflict"
    else
        record_ok 'ASK/VPP per-interface mutex satisfied'
    fi
else
    record_ok 'VPP owns no configured ASK port'
fi

for dev in "${ASK_PORTS[@]}"; do
    case "$dev" in
        eth3) port_hex=0x10 ;;
        eth4) port_hex=0x11 ;;
        *)    port_hex='' ;;
    esac
    if [ -z "$port_hex" ]; then
        record_fail "$dev is not a supported ASK transit port"
        continue
    fi
    if echo "$KLOG" | grep -q "offload ENGAGED on port $port_hex"; then
        record_ok "$dev ($port_hex) engaged through the production ASK path"
    else
        record_fail "$dev configured for ASK but current-boot engagement is not confirmed"
    fi

    if command -v ethtool >/dev/null 2>&1; then
        hw_tc=$(ethtool -k "$dev" 2>/dev/null \
            | awk -F': ' '/^hw-tc-offload:/ {print $2; exit}')
        if [ "$hw_tc" = on ]; then
            record_ok "$dev hw-tc-offload enabled"
        else
            record_fail "$dev hw-tc-offload is not enabled (${hw_tc:-unknown})"
        fi
    fi

    fq_file=$(find /sys/devices -path "*/net/$dev/fqids" -print -quit 2>/dev/null)
    if [ -n "$fq_file" ] && grep -q '^Rx PCD:' "$fq_file" \
       && grep -q '^Tx:' "$fq_file"; then
        rx_default=$(awk '/^Rx default:/ {print $3}' "$fq_file")
        tx_range=$(awk -F': ' '/^Tx:/ {print $2}' "$fq_file")
        record_ok "$dev DPAA FQ map present (Rx-default=$rx_default Tx=$tx_range)"
    else
        record_fail "$dev DPAA FQ map incomplete"
    fi
done

# ---------------------------------------------------------------------------
hdr '5) nft flowtable and conntrack learning path'
# ---------------------------------------------------------------------------

if [ "$IS_ROOT" -eq 0 ] || ! command -v nft >/dev/null 2>&1; then
    record_skip 'root+nft required to inspect the production flowtable'
else
    nft_rules=$(nft list ruleset 2>"$TMPDIR_CHECK/nft.err" || true)
    if echo "$nft_rules" | grep -q 'flowtable VYOS_FLOWTABLE_' \
       && echo "$nft_rules" | grep -A8 'flowtable VYOS_FLOWTABLE_' \
          | grep -q 'flags offload'; then
        record_ok 'nft hardware flowtable exists with flags offload'
    else
        record_fail 'nft hardware flowtable with flags offload is missing'
    fi

    missing=''
    for dev in "${ASK_PORTS[@]}"; do
        echo "$nft_rules" | grep -A8 'flowtable VYOS_FLOWTABLE_' \
            | grep -qE "devices = .*\b${dev}\b" || missing="$missing $dev"
    done
    if [ -z "$missing" ]; then
        record_ok 'all ASK ports are members of the nft hardware flowtable'
    else
        record_fail "ASK port(s) missing from nft flowtable:$missing"
    fi

    flow_rule=$(echo "$nft_rules" | grep 'flow add @VYOS_FLOWTABLE_' | head -1)
    if [ -n "$flow_rule" ]; then
        record_ok 'forward hook contains a flow-add rule'
        note "$flow_rule"
    else
        record_fail 'no nft flow-add rule; connections cannot enter the flowtable'
    fi
fi

ct_count=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo '')
if [ -n "$ct_count" ] && [ "$ct_count" -gt 0 ] 2>/dev/null; then
    record_ok "conntrack is active (${ct_count} entries)"
elif [ -n "$ct_count" ]; then
    record_warn 'conntrack table is empty; offload learning cannot be proven while idle'
else
    record_fail 'nf_conntrack_count unavailable'
fi

# VyOS may retain terminal notrack rules, but the ASK flowtable commit helper
# must put an ACCEPT in FW_CONNTRACK before them. This is the production fix for
# the historical no-firewall notrack fast path.
if [ "$IS_ROOT" -eq 1 ] && command -v nft >/dev/null 2>&1; then
    ct_rules=$(nft list table ip vyos_conntrack 2>/dev/null || true)
    if echo "$ct_rules" | grep -A6 'chain FW_CONNTRACK' | grep -q 'accept'; then
        record_ok 'VyOS conntrack chain accepts ASK traffic before terminal notrack'
    elif echo "$ct_rules" | grep -q 'notrack'; then
        record_fail 'terminal notrack is active without FW_CONNTRACK accept; flow learning is disabled'
    else
        record_ok 'no terminal notrack fast path detected'
    fi
fi

# ---------------------------------------------------------------------------
hdr '6) Current-boot datapath integrity'
# ---------------------------------------------------------------------------

if [ -z "$KLOG" ]; then
    record_skip 'current-boot kernel journal unavailable'
else
    fatal=$(echo "$KLOG" | grep -iE \
        'kernel BUG|BUG:|Oops:|Call trace:|list_del corruption|list_add corruption|LIST_POISON|use-after-free|double free|general protection fault|soft lockup|rcu.*stall|FM_FD_ERR_NO_SCHEME|FM_FD_ERR_PHYSICAL|stale DESTROY.*failed|MURAM.*leak|HW rollback.*failed|rebuild rollback failed' \
        || true)
    if [ -z "$fatal" ]; then
        record_ok 'no fatal ASK/FMan lifecycle, list, DMA, QMan or MURAM errors this boot'
    else
        record_fail "$(echo "$fatal" | wc -l) fatal datapath error line(s) in current-boot journal"
        echo "$fatal" | head -10 | while IFS= read -r line; do note "$line"; done
    fi

    noconf_fail=$(echo "$KLOG" | grep -c 'no-confirm TX FQ alloc failed' || true)
    if [ "$noconf_fail" -eq 0 ]; then
        record_ok 'no no-confirm TX-FQ allocation failure this boot'
    else
        record_warn "$noconf_fail no-confirm TX-FQ allocation failure(s); confirmed-FQ fallback may cost CPU"
    fi

    preflight_fail=$(echo "$KLOG" | grep -c 'resource preflight.*no HW mutation' || true)
    stale_drop=$(echo "$KLOG" | grep -cE 'drop stale pending|stale DESTROY|superseded before publish' || true)
    note "M6-A runtime counters from journal: preflight-fallback=$preflight_fail stale-work-discard=$stale_drop"
fi

if command -v pcd-snapshot >/dev/null 2>&1; then
    record_ok 'pcd-snapshot installed for operator-run S0↔S1 reversibility gates'
else
    record_warn 'pcd-snapshot absent; register-exact disengage validation unavailable'
fi

# ---------------------------------------------------------------------------
hdr '7) Scope and verdict'
# ---------------------------------------------------------------------------

note 'hardware scope: routed IPv4 unicast TCP/UDP with TTL/checksum + L2 rewrite'
note 'software fallback: IPv6, NAT/PAT, VLAN actions, bridge, multicast, IPsec'
note 'debugfs and KUnit are debug-build tools and are intentionally not tested'

hdr 'Summary'
total=$((N_OK + N_WARN + N_FAIL + N_SKIP))
printf '  %3d/%3d %sOK%s  ' "$N_OK" "$total" "$C_GREEN" "$C_RST"
printf '%3d %sWARN%s  ' "$N_WARN" "$C_YELLOW" "$C_RST"
printf '%3d %sFAIL%s  ' "$N_FAIL" "$C_RED" "$C_RST"
printf '%3d %sSKIP%s\n' "$N_SKIP" "$C_BLUE" "$C_RST"

if [ "$EXIT" -eq 0 ]; then
    ok 'ASK2 production IPv4-unicast dataplane is READY'
else
    fail "ASK2 production IPv4-unicast dataplane is NOT READY ($N_FAIL required check(s) failed)"
fi

exit "$EXIT"

#!/usr/bin/env bash
# Auto-elevate: re-exec with sudo if not root, preserving all arguments.
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi
# ask-check — health check for the NXP ASK 1.x hardware-offload dataplane
# on the LS1046A Mono Gateway DK (npk-sdk branch).
#
# Usage:   ask-check           (re-run with sudo for full depth)
#
# ============================================================================
# WHAT THIS TESTS
# ============================================================================
# The NXP SDK ASK 1.x stack comprises three OOT kernel modules (cdx, fci,
# auto_bridge) plus userspace (cmm, dpa_app, fmc).  The hardware-offload
# pipeline runs through proprietary FMan microcode v210.10.1 with the SDK
# DPAA driver stack (sdk_fman + sdk_dpaa).
#
# This script walks the ASK 1.x datapath bottom-up in bring-up order:
#
#   1. Board identity             ls1046a + kernel flavour
#   2. DPAA / FMan netdevs        eth0–eth4 state and link
#   3. SDK DPAA driver stack      fsl_mac / fsl_dpa / fsl_proxy-proxy
#   4. BMan / QMan / USDPAA       buffer-pool and frame-queue health
#   5. FMan microcode             210.10.1 + PCD capsule
#   6. CAAM crypto (hardware)     Job Rings + /proc/crypto + RNG
#   7. cdx.ko module              loaded, /dev/cdx_ctrl, MURAM handle, frag init
#   8. fci.ko module              loaded (CMM↔CDX IPC)
#   9. auto_bridge.ko module      loaded (L2 offload path)
#  10. CMM / dpa_app userspace    connection manager + PCD programmer
#  11. dmesg integrity            no Oops/WARN/WARN_ON/stall lines from ASK
#
# Tags:
#   [OK]    capability present and healthy
#   [WARN]  present but degraded — investigate
#   [FAIL]  capability missing or broken
#   [SKIP]  cannot test in this environment (not LS1046A, no privilege, absent tool)
#
# Exit codes:
#   0  the ASK dataplane is fully operational
#   1  at least one capability is missing or broken
#   2  not an LS1046A board

set -u

# ---------------------------------------------------------------------------
# Colour escapes (TTY only).
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
    C_RST=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_RED=$'\033[1;31m'
    C_BLUE=$'\033[1;34m'
else
    C_RST='' C_BOLD='' C_DIM='' C_GREEN='' C_YELLOW='' C_RED='' C_BLUE=''
fi

ok()    { printf "  [%sOK%s]   %s\n" "$C_GREEN"  "$C_RST" "$*"; }
warn()  { printf "  [%sWARN%s] %s\n" "$C_YELLOW" "$C_RST" "$*"; }
fail()  { printf "  [%sFAIL%s] %s\n" "$C_RED"    "$C_RST" "$*"; }
skip()  { printf "  [%sSKIP%s] %s\n" "$C_BLUE"   "$C_RST" "$*"; }
note()  { printf "         %s%s%s\n" "$C_DIM"    "$*"     "$C_RST"; }
hdr()   { printf "\n%s%s%s\n"        "$C_BOLD"   "$*"     "$C_RST"; }

EXIT=0
N_OK=0 N_WARN=0 N_FAIL=0 N_SKIP=0

record_ok()   { ok   "$@"; N_OK=$((N_OK+1));     }
record_warn() { warn "$@"; N_WARN=$((N_WARN+1)); }
record_fail() { fail "$@"; N_FAIL=$((N_FAIL+1)); EXIT=1; }
record_skip() { skip "$@"; N_SKIP=$((N_SKIP+1)); }

# ---------------------------------------------------------------------------
# Board gate
# ---------------------------------------------------------------------------
if [ ! -f /proc/device-tree/compatible ] \
   || ! tr '\0' '\n' < /proc/device-tree/compatible | grep -q 'fsl,ls1046a'; then
    echo "ask-check: not LS1046A — nothing to report" >&2
    exit 2
fi

# ---------------------------------------------------------------------------
# Header
# ---------------------------------------------------------------------------
hostname_str=$(hostname 2>/dev/null || echo "?")
kernel_str=$(uname -r 2>/dev/null || echo "?")
printf "%sask-check%s  host=%s  kernel=%s  %s\n" \
    "$C_BOLD" "$C_RST" "$hostname_str" "$kernel_str" "$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
if [ "$(id -u)" -ne 0 ]; then
    note "running unprivileged — symbol/debugfs probes will SKIP; re-run with sudo for full depth"
fi

# ---------------------------------------------------------------------------
# Cached state
# ---------------------------------------------------------------------------
DMESG=$(dmesg 2>/dev/null || true)
LSMOD=$(lsmod 2>/dev/null || true)

has_mod()   { echo "$LSMOD" | awk '{print $1}' | grep -qx "$1"; }
dmesg_has() { echo "$DMESG" | grep -qE "$1"; }
dmesg_cnt() { echo "$DMESG" | grep -cE "$1" 2>/dev/null || true; }

# Discover DPAA netdevs once.
DPAA_NETDEVS=()
for dev in /sys/class/net/*/device/of_node; do
    [ -L "$dev" ] || continue
    target=$(readlink -f "$dev" 2>/dev/null || true)
    case "$target" in
        */ethernet@*) DPAA_NETDEVS+=("$(basename "$(dirname "$(dirname "$dev")")")") ;;
    esac
done

# ===========================================================================
# 1. Board identity
# ===========================================================================
hdr "1) Board identity"
board=$(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null || echo "unknown")
record_ok "board: $board"
note "kernel: $kernel_str"
if dmesg_has "Freescale USDPAA process driver"; then
    record_ok "USDPAA process driver loaded"
else
    record_fail "USDPAA driver not found in dmesg"
fi
cpu_freq=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)
[ -n "$cpu_freq" ] && note "CPU freq: $((cpu_freq/1000)) MHz"

# ===========================================================================
# 2. DPAA / FMan netdevs
# ===========================================================================
hdr "2) DPAA / FMan netdevs"
if [ "${#DPAA_NETDEVS[@]}" -gt 0 ]; then
    record_ok "${#DPAA_NETDEVS[@]} FMan/DPAA netdev(s): ${DPAA_NETDEVS[*]}"
else
    record_fail "no DPAA/FMan netdevs — SDK DPAA driver did not initialise"
fi
for iface in "${DPAA_NETDEVS[@]}"; do
    state=$(ip link show "$iface" 2>/dev/null | grep -oP 'state \K\w+')
    carrier=$(ip link show "$iface" 2>/dev/null | grep -c LOWER_UP)
    speed=$(ethtool "$iface" 2>/dev/null | awk -F': +' '/^\tSpeed:/ {print $2}')
    link=$(ethtool "$iface" 2>/dev/null | awk -F': +' '/^\tLink detected:/ {print $2}')
    mac=$(ip link show "$iface" 2>/dev/null | grep -oP 'link/ether \K[0-9a-f:]+')
    if [ "$carrier" -eq 1 ] && [ "$link" = "yes" ]; then
        record_ok "$iface  $mac  $state  $speed  link=$link"
    elif [ "$carrier" -eq 1 ]; then
        record_warn "$iface  $mac  $state  $speed  link=$link (LOWER_UP but ethtool disagrees)"
    else
        record_fail "$iface  $mac  $state  $speed  link=$link"
    fi
done

# ===========================================================================
# 3. SDK DPAA driver stack
# ===========================================================================
hdr "3) SDK DPAA driver stack (sdk_fman / sdk_dpaa / sdk_qbman)"
# fsl_mac — MAC hardware driver
mac_count=$(find /sys/bus/platform/drivers/fsl_mac -maxdepth 1 -type l \
    ! -name bind ! -name unbind ! -name uevent ! -name module 2>/dev/null | wc -l)
[ "$mac_count" -gt 0 ] \
    && record_ok "$mac_count FMan MAC(s) bound (fsl_mac)" \
    || record_fail "no FMan MACs bound — fsl_mac driver absent"
# fsl_dpa — netdev driver
dpa_count=$(find /sys/bus/platform/drivers/fsl_dpa -maxdepth 1 -type l \
    ! -name bind ! -name unbind ! -name uevent ! -name module 2>/dev/null | wc -l)
[ "$dpa_count" -gt 0 ] \
    && record_ok "$dpa_count DPAA netdev(s) bound (fsl_dpa)" \
    || record_fail "no DPAA netdevs bound — fsl_dpa driver absent"
# fsl_proxy-proxy — proxy for 10G
if ls /sys/bus/platform/drivers/fsl_proxy-proxy/ 2>/dev/null | grep -q 'ethernet@'; then
    record_ok "proxy driver bound (fsl_proxy-proxy)"
else
    record_fail "proxy driver not bound (fsl_proxy-proxy)"
fi
# fsl-fman — FMan controller
if [ -d /sys/bus/platform/drivers/fsl-fman ] && \
   ls /sys/bus/platform/drivers/fsl-fman/ 2>/dev/null | grep -q 'fman'; then
    record_ok "FMan controller bound (fsl-fman)"
else
    record_fail "FMan controller not bound (fsl-fman)"
fi
# SDK FMan port driver
port_count=$(find /sys/bus/platform/drivers/fsl-fman-port -maxdepth 1 -type l \
    ! -name bind ! -name unbind ! -name uevent ! -name module 2>/dev/null | wc -l)
[ "$port_count" -gt 0 ] \
    && record_ok "$port_count FMan port(s) bound (fsl-fman-port)" \
    || record_fail "no FMan ports bound — fsl-fman-port absent"

# ===========================================================================
# 4. BMan / QMan / USDPAA
# ===========================================================================
hdr "4) BMan / QMan / USDPAA"
if [ -d /sys/bus/platform/drivers/fsl-bman ] && \
   ls /sys/bus/platform/drivers/fsl-bman/ 2>/dev/null | grep -q 'bman'; then
    record_ok "BMan bound (fsl-bman)"
else
    record_fail "BMan not bound"
fi
if [ -d /sys/bus/platform/drivers/fsl-qman ] && \
   ls /sys/bus/platform/drivers/fsl-qman/ 2>/dev/null | grep -q 'qman'; then
    record_ok "QMan bound (fsl-qman)"
else
    record_fail "QMan not bound"
fi
# Debugfs BPID/FQID counts (root-only)
if [ "$(id -u)" -eq 0 ]; then
    if [ -r /sys/kernel/debug/bman/bpids ]; then
        bpid_lines=$(wc -l < /sys/kernel/debug/bman/bpids 2>/dev/null)
        [ "$bpid_lines" -gt 0 ] \
            && record_ok "BMan: $bpid_lines BPID line(s) in debugfs" \
            || record_warn "BMan debugfs empty"
    fi
    if [ -r /sys/kernel/debug/qman/fqids ]; then
        fqid_lines=$(wc -l < /sys/kernel/debug/qman/fqids 2>/dev/null)
        [ "$fqid_lines" -gt 0 ] \
            && record_ok "QMan: $fqid_lines FQID line(s) in debugfs" \
            || record_warn "QMan debugfs empty"
    fi
else
    record_skip "BMan/QMan debugfs requires root — re-run with sudo"
fi

# ===========================================================================
# 5. FMan microcode
# ===========================================================================
hdr "5) FMan microcode + PCD"
if dmesg_has "FMan.*210\.10\.1"; then
    record_ok "FMan microcode v210.10.1 loaded"
else
    record_fail "FMan microcode v210.10.1 NOT detected — proprietary QEF required"
fi
if dmesg_has "FM_PCD_Init"; then
    record_ok "FMan PCD initialised"
else
    record_fail "FMan PCD not initialised"
fi
# PCD caps
pcd_caps=$(echo "$DMESG" | grep -oP 'FMan PCD caps = .*' | head -1)
[ -n "$pcd_caps" ] && note "$pcd_caps"

# ===========================================================================
# 6. CAAM crypto (hardware)
# ===========================================================================
hdr "6) CAAM hardware crypto"
if dmesg_has "caam.*device ID"; then
    era=$(echo "$DMESG" | grep -oP 'Era \d+' | head -1)
    jrs=$(echo "$DMESG" | grep -oP 'job rings = \d+' | grep -oP '\d+')
    qi=$(echo "$DMESG" | grep -oP 'qi = \d+' | grep -oP '\d+')
    record_ok "CAAM present: $era, $jrs Job Ring(s), QI=$qi"
else
    record_fail "CAAM driver not found in dmesg"
fi
if [ -r /sys/devices/virtual/misc/hw_random/rng_current ]; then
    rng=$(cat /sys/devices/virtual/misc/hw_random/rng_current 2>/dev/null)
    [ "$rng" = "rng-caam" ] \
        && record_ok "HW RNG: rng-caam" \
        || record_warn "HW RNG: $rng (expected rng-caam)"
fi
caam_algs=$(grep -c caam /proc/crypto 2>/dev/null)
[ "$caam_algs" -gt 0 ] \
    && record_ok "$caam_algs CAAM algorithms in /proc/crypto" \
    || record_fail "no CAAM algorithms in /proc/crypto"

# ===========================================================================
# 7. cdx.ko — core fast-path offload module
# ===========================================================================
hdr "7) cdx.ko (core fast-path offload module)"
kver=$(uname -r)
CDX_KO="/lib/modules/$kver/extra/cdx.ko"

if has_mod cdx; then
    cdx_size=$(stat -c '%s' "$CDX_KO" 2>/dev/null || echo "?")
    record_ok "cdx.ko loaded ($cdx_size bytes)"
    # cdx depends on caam_jr
    cdx_deps=$(lsmod 2>/dev/null | awk '$1=="cdx"{print $4}')
    note "cdx deps: $(echo "$cdx_deps" | tr ',' ' ')"
else
    if [ -f "$CDX_KO" ]; then
        record_fail "cdx.ko installed ($(stat -c '%s' "$CDX_KO") bytes) but NOT loaded"
    else
        record_fail "cdx.ko not installed at $CDX_KO"
    fi
fi

# /dev/cdx_ctrl — char device for CMM ↔ CDX IPC
if [ -c /dev/cdx_ctrl ]; then
    maj=$(stat -c '%t' /dev/cdx_ctrl 2>/dev/null | xargs -I{} printf '%d' 0x{} 2>/dev/null)
    record_ok "/dev/cdx_ctrl present (major $maj)"
else
    record_fail "/dev/cdx_ctrl absent"
fi

# MURAM handle — must be pre-populated for frag module to init
if dmesg_has "pre-populated MURAM handle"; then
    record_ok "MURAM handle pre-populated from /dev/fm0-pcd"
elif dmesg_has "Error in getting MURAM"; then
    record_fail "MURAM handle unavailable — cdx in degraded mode, no frag/IP-reassembly"
else
    record_warn "MURAM handle status unknown (dmesg may have wrapped)"
fi

# FMan firmware check
if dmesg_has "cdx: FMAN firmware.*ASK supported"; then
    record_ok "cdx FMan firmware compatibility verified"
fi

# /proc/fqid_stats
if [ -d /proc/fqid_stats ]; then
    fqid_dirs=$(ls /proc/fqid_stats/ 2>/dev/null | wc -w)
    [ "$fqid_dirs" -gt 0 ] \
        && record_ok "/proc/fqid_stats: $fqid_dirs subdir(s) (tx rx pcd sa)" \
        || record_warn "/proc/fqid_stats empty"
else
    record_fail "/proc/fqid_stats absent — cdx procfs not initialised"
fi

# IPsec offload readiness
# OH ports are imported during cdx_init with PORT_TYPE_IPSEC/WIFI set.
# ipsec_init fails because dpa_app hasn't populated ohinfo yet
# (dpa_app runs after cdx loads, not during init). This is normal
# degraded mode — IPsec offload requires full dpa_app PCD config.
if dmesg_has "cdx: OH port.*imported type="; then
    record_ok "cdx OH ports imported (IPsec+WiFi types set)"
    if dmesg_has "cdx_module_init::dpa_ipsec start failed"; then
        record_ok "cdx IPsec init deferred — needs dpa_app PCD config (expected degraded state)"
    else
        record_ok "cdx IPsec initialised"
    fi
elif dmesg_has "alloc_offline_port::no free"; then
    record_warn "cdx OH port import failed — IPsec/WiFi offline ports unavailable"
    note "  check: FSL_DPAA_OFFLINE_PORTS=y + dpa-fman0-oh@2/@3 DTS nodes"
else
    record_warn "cdx OH ports not yet probed"
fi

# ===========================================================================
# 8. fci.ko — Fast Control Interface (CMM↔CDX IPC)
# ===========================================================================
hdr "8) fci.ko (CMM↔CDX IPC module)"
FCI_KO="/lib/modules/$kver/extra/fci.ko"
if has_mod fci; then
    fci_size=$(stat -c '%s' "$FCI_KO" 2>/dev/null || echo "?")
    record_ok "fci.ko loaded ($fci_size bytes)"
else
    if [ -f "$FCI_KO" ]; then
        record_fail "fci.ko installed but NOT loaded"
    else
        record_fail "fci.ko not installed at $FCI_KO"
    fi
fi

# ===========================================================================
# 9. auto_bridge.ko — L2 bridge offload
# ===========================================================================
hdr "9) auto_bridge.ko (L2 bridge offload module)"
ABM_KO="/lib/modules/$kver/extra/auto_bridge.ko"
if has_mod auto_bridge; then
    record_ok "auto_bridge.ko loaded"
elif [ -f "$ABM_KO" ]; then
    record_warn "auto_bridge.ko installed but NOT loaded"
else
    record_skip "auto_bridge.ko not installed (may not be needed yet)"
fi

# ===========================================================================
# 10. CMM / dpa_app userspace
# ===========================================================================
hdr "10) CMM / dpa_app userspace"

# CMM daemon
CMM_BIN="/usr/bin/cmm"
if [ -x "$CMM_BIN" ]; then
    record_ok "CMM binary present ($CMM_BIN)"
    if systemctl is-active cmm >/dev/null 2>&1; then
        record_ok "CMM service running"
    else
        cmm_status=$(systemctl show cmm -p ExecMainStatus 2>/dev/null | cut -d= -f2)
        if [ "$cmm_status" = "1" ]; then
            record_warn "CMM service exited status=1 (needs dpa_app + PCD configuration)"
        else
            record_fail "CMM service not running (status=${cmm_status:-unknown})"
        fi
    fi
    # Check Restart setting
    if systemctl show cmm -p Restart 2>/dev/null | grep -q '=no$'; then
        note "CMM Restart=no (no cycling)"
    else
        note "CMM Restart enabled — may cycle on failure"
    fi
else
    record_fail "CMM binary not found at $CMM_BIN"
fi

# dpa_app — runs via call_usermodehelper from cdx_module_init at boot.
# The systemd service is a manual fallback; not-running is expected.
DPA_APP="/usr/bin/dpa_app"
if [ -x "$DPA_APP" ]; then
    record_ok "dpa_app binary present ($DPA_APP)"
    if dmesg_has "start_dpa_app successful"; then
        record_ok "dpa_app launched OK by cdx (call_usermodehelper)"
    elif dmesg_has "start_dpa_app failed"; then
        record_warn "dpa_app failed during cdx init — check dmesg"
    else
        record_warn "dpa_app not yet invoked — cdx may not have loaded"
    fi
else
    record_fail "dpa_app binary not found at $DPA_APP"
fi

# Config files
if [ -f /etc/cdx_cfg.xml ]; then
    record_ok "/etc/cdx_cfg.xml present (port↔policy binding)"
else
    record_fail "/etc/cdx_cfg.xml missing"
fi
if [ -f /etc/cdx_pcd.xml ]; then
    record_ok "/etc/cdx_pcd.xml present (PCD hashtable config)"
else
    record_warn "/etc/cdx_pcd.xml missing — dpa_app PCD programming will fail"
fi
if [ -f /etc/config/fastforward ]; then
    record_ok "/etc/config/fastforward present (CMM blacklist config)"
else
    record_warn "/etc/config/fastforward missing"
fi

# ===========================================================================
# 11. dmesg integrity
# ===========================================================================
hdr "11) dmesg integrity"

# Count known-harmless messages
swphy_cnt=$(dmesg_cnt "swphy_read_reg")
phy_not_init_cnt=$(dmesg_cnt "phy device not initialized")
alloc_offline_cnt=$(dmesg_cnt "alloc_offline_port::no free")
oops_cnt=$(dmesg_cnt "Internal error: Oops")
panic_cnt=$(dmesg_cnt "Kernel panic")
warn_cnt=$(dmesg_cnt "WARNING:")
err_muram_cnt=$(dmesg_cnt "Error in getting MURAM")

if [ "$oops_cnt" -gt 0 ]; then
    record_fail "$oops_cnt kernel Oops detected — ASK dataplane is unstable"
fi
if [ "$panic_cnt" -gt 0 ]; then
    record_fail "$panic_cnt kernel panic detected"
fi

# swphy WARN — cosmetic but noisy (SDK 10G fixed-link quirk)
if [ "$swphy_cnt" -gt 0 ]; then
    record_warn "$swphy_cnt swphy_read_reg WARNING(s) — SDK 10G fixed-link PHY polling quirk"
    note "  suppressed in next build (WARN_ON→WARN_ON_ONCE in swphy.c)"
else
    record_ok "no swphy WARNINGs (swphy.c:128 silenced)"
fi

# MURAM handle error — critical if present
if [ "$err_muram_cnt" -gt 0 ]; then
    record_fail "$err_muram_cnt MURAM handle error(s) — cdx frag/IP-reassembly broken"
else
    record_ok "no MURAM handle errors"
fi

# alloc_offline_port — IPsec OH port status
if [ "$alloc_offline_cnt" -gt 0 ]; then
    record_warn "$alloc_offline_cnt offline port allocation failure(s) — IPsec OH not available"
else
    record_ok "no offline port allocation failures"
fi

# Report phy-not-initialized count (cosmetic)
if [ "$phy_not_init_cnt" -gt 0 ]; then
    record_warn "$phy_not_init_cnt 'phy device not initialized' lines (cosmetic — link is up)"
fi

# ===========================================================================
# Summary
# ===========================================================================
hdr "Summary"

total=$((N_OK + N_WARN + N_FAIL + N_SKIP))
printf "  %3d/%3d %sOK%s  " "$N_OK" "$total" "$C_GREEN" "$C_RST"
printf "%3d %sWARN%s  "     "$N_WARN" "$C_YELLOW" "$C_RST"
printf "%3d %sFAIL%s  "     "$N_FAIL" "$C_RED"    "$C_RST"
printf "%3d %sSKIP%s\n"     "$N_SKIP" "$C_BLUE"   "$C_RST"
echo

# Graded verdict
if [ "$N_FAIL" -eq 0 ] && [ "$N_WARN" -le 3 ]; then
    ok "NXP ASK hardware-offload dataplane is OPERATIONAL"
elif [ "$N_FAIL" -eq 0 ]; then
    warn "NXP ASK dataplane DEGRADED — $N_WARN warning(s), all core capabilities present"
else
    fail "NXP ASK dataplane NOT operational — $N_FAIL failure(s)"
fi

exit "$EXIT"

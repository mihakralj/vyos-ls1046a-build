#!/usr/bin/env bash
# ask-check — health check for the ASK hardware-offload dataplane on the
# LS1046A Mono Gateway DK.
#
# Usage:   ask-check          (re-run with sudo for symbol/debugfs depth)
#
# ============================================================================
# WHAT THIS TESTS
# ============================================================================
# ASK is the FMan-silicon hardware-offload dataplane: the operator turns it
# on per-port, and from then on the FMan classifies, forwards, NATs, and
# IPsec-terminates matching flows entirely in hardware, leaving the CPU idle.
# When ASK is OFF the board runs the mainline kernel dataplane (RSS to kernel
# RX queues); the VPP/AF_XDP overlay is a separate dataplane reported by
# xsk-zc-check, not here.
#
# This script walks the ASK datapath bottom-up, from the silicon programming
# layer to the operator CLI, in the order ASK brings itself up, and reports
# whether each capability is present and healthy. It is a production probe:
# every section describes a capability the finished ASK dataplane MUST have,
# so a component that is missing, stubbed, or broken is a [FAIL]. The script
# returns success only when the whole ASK chain is operational; until ASK is
# complete it is expected to fail on the not-yet-implemented pieces, and each
# failure names exactly which capability is absent.
#
# The bring-up chain (updated for ASK2 Fork-B FE/eHash path, 2026-07-04):
#
#   1. Dataplane posture          which dataplane owns the ports right now
#   2. FMan PCD substrate          the silicon programming layer (KG/CC/HM/Policer)
#   3. Reversible mode switch      engage/disengage must be register-exact,
#                                  leak-free, verified by snapshot, never reboot
#   4. FE-VM dormant chain         FE pool + singletons + ehash + enq + hashfe + enter
#   5. AC_CC classifier arm        0133 real AC_CC (KGSE_MODE 0x80000006) — PROVEN
#   6. FE-VM context builder       0146 contexts (ENQ/MUX/Transition) — PROVEN
#   7. Hardware forwarding         L3 next-hop rewrite (strip/insert L2, TTL, checksum)
#   8. TX confirm bypass           0136 silicon-hit release mode — compiled, dormant
#   9. Control-plane module        ask.ko: genl family + flow table + engage/disengage
#  10. Hardware IPsec offload      CAAM job rings + descriptor sharing + ESP offload
#  11. Operator CLI                'set system offload ask' + ASK/VPP mutex validator
#  12. dmesg integrity             no error/stall/leak lines from the datapath
#
# Tags: [OK] present/healthy  [WARN] degraded  [FAIL] missing/broken  [SKIP] untestable
#
# Exit codes:
#   0  ASK dataplane fully operational
#   1  at least one capability is missing or broken
#   2  not an LS1046A board

set -u

# ---------------------------------------------------------------------------
# Colours (TTY only)
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
    C_RST=$'\033[0m'      C_BOLD=$'\033[1m'      C_DIM=$'\033[2m'
    C_GREEN=$'\033[1;32m' C_YELLOW=$'\033[1;33m' C_RED=$'\033[1;31m' C_BLUE=$'\033[1;34m'
else
    C_RST='' C_BOLD='' C_DIM='' C_GREEN='' C_YELLOW='' C_RED='' C_BLUE=''
fi

ok()    { printf "  [%sOK%s]   %s\n" "$C_GREEN"  "$C_RST" "$*"; }
warn()  { printf "  [%sWARN%s] %s\n" "$C_YELLOW" "$C_RST" "$*"; }
fail()  { printf "  [%sFAIL%s] %s\n" "$C_RED"    "$C_RST" "$*"; }
skip()  { printf "  [%sSKIP%s] %s\n" "$C_BLUE"   "$C_RST" "$*"; }
note()  { printf "         %s%s%s\n" "$C_DIM"    "$*"     "$C_RST"; }
hdr()   { printf "\n%s%s%s\n"        "$C_BOLD"   "$*"     "$C_RST"; }

EXIT=0
N_OK=0 N_WARN=0 N_FAIL=0 N_SKIP=0

record_ok()   { ok   "$@"; N_OK=$((N_OK+1));     }
record_warn() { warn "$@"; N_WARN=$((N_WARN+1)); }
record_fail() { fail "$@"; N_FAIL=$((N_FAIL+1)); EXIT=1; }
record_skip() { skip "$@"; N_SKIP=$((N_SKIP+1)); }

# ---------------------------------------------------------------------------
# Board gate
# ---------------------------------------------------------------------------
if [ ! -f /proc/device-tree/compatible ] \
   || ! tr '\0' '\n' < /proc/device-tree/compatible | grep -q 'fsl,ls1046a'; then
    echo "ask-check: not LS1046A — nothing to report" >&2
    exit 2
fi

# ---------------------------------------------------------------------------
# Header
# ---------------------------------------------------------------------------
hostname_str=$(hostname 2>/dev/null || echo "?")
kernel_str=$(uname -r 2>/dev/null || echo "?")
printf "%sask-check%s  host=%s  kernel=%s  %s\n" \
    "$C_BOLD" "$C_RST" "$hostname_str" "$kernel_str" "$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
if [ "$(id -u)" -ne 0 ]; then
    note "running unprivileged — symbol/debugfs probes will SKIP; re-run with sudo for full depth"
fi

# ---------------------------------------------------------------------------
# Cached state
# ---------------------------------------------------------------------------
DMESG=$(dmesg 2>/dev/null || true)
LSMOD=$(lsmod 2>/dev/null || true)
KALLSYMS=""
if [ -r /proc/kallsyms ]; then
    KALLSYMS=$(cat /proc/kallsyms 2>/dev/null || true)
    if [ "$(id -u)" -ne 0 ] && ! echo "$KALLSYMS" | awk '{print $3}' | grep -q .; then
        KALLSYMS=""
    fi
fi

has_sym()   { [ -n "$KALLSYMS" ] && echo "$KALLSYMS" | awk '{print $3}' | grep -qx "$1"; }
has_mod()   { echo "$LSMOD" | awk '{print $1}' | grep -qx "$1"; }
dmesg_has() { echo "$DMESG" | grep -qE "$1"; }

dbg_state() {
    local p="$1"
    if [ -e "$p" ]; then return 0; fi
    if [ "$(id -u)" -ne 0 ] && [ ! -r /sys/kernel/debug ]; then return 2; fi
    return 1
}

DPAA_NETDEVS=()
for dev in /sys/class/net/*/device/of_node; do
    [ -L "$dev" ] || continue
    target=$(readlink -f "$dev" 2>/dev/null || true)
    case "$target" in
        */fman*|*/ethernet@*) DPAA_NETDEVS+=("$(basename "$(dirname "$(dirname "$dev")")")") ;;
    esac
done

PCD_DBGFS="/sys/kernel/debug/fman_pcd"

# ===========================================================================
# 1. Dataplane posture
# ===========================================================================
hdr "1) Dataplane posture"

if [ "${#DPAA_NETDEVS[@]}" -gt 0 ]; then
    record_ok "${#DPAA_NETDEVS[@]} FMan/DPAA netdev(s) present: ${DPAA_NETDEVS[*]}"
else
    record_fail "no DPAA/FMan netdevs — DPAA1 stack did not initialise"
fi

# Mutual exclusion: ASK vs VPP
if pgrep -x vpp_main >/dev/null 2>&1 || pgrep -x vpp >/dev/null 2>&1; then
    record_warn "VPP is running — ports are owned by AF_XDP overlay, not ASK"
else
    note "no VPP process — ASK may own the ports"
fi

# Is any FMan port currently armed for AC_CC / hardware classification?
armed_line=$(echo "$DMESG" | grep -E 'FE-ARMED|FE.*ENGAGED|fman_pcd.*port.*armed|offload.*ENGAGED' | tail -1)
if echo "$armed_line" | grep -qiE 'ARMED|ENGAGED'; then
    record_ok "FMan port armed for hardware classification"
    note "$armed_line"
else
    note "no FMan port currently armed (opt-in per port)"
fi

# ===========================================================================
# 2. FMan PCD substrate — silicon programming layer
# ===========================================================================
hdr "2) FMan PCD substrate (KeyGen / CC / HM / Policer)"

if [ ! -d /sys/kernel/debug ]; then
    record_skip "debugfs not mounted"
elif [ "$(id -u)" -ne 0 ] && [ ! -r /sys/kernel/debug ]; then
    record_skip "/sys/kernel/debug not readable — re-run with sudo"
elif [ -d "$PCD_DBGFS" ]; then
    record_ok "PCD subsystem present at $PCD_DBGFS"
    instances=$(find "$PCD_DBGFS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    [ "$instances" -gt 0 ] || record_fail "$PCD_DBGFS has no per-FMan instance"
    note "$instances FMan PCD instance(s)"

    # MURAM budget
    budget_file=$(find "$PCD_DBGFS" -mindepth 2 -maxdepth 2 -name muram_budget -type f 2>/dev/null | head -1)
    if [ -n "$budget_file" ] && [ -r "$budget_file" ]; then
        budget_str=$(tr '\n' ' ' < "$budget_file" 2>/dev/null | sed 's/  */ /g; s/ *$//')
        used_bytes=$(echo "$budget_str" | grep -oE 'used[= ]+[0-9]+' | head -1 | grep -oE '[0-9]+')
        free_bytes=$(echo "$budget_str" | grep -oE 'free[= ]+[0-9]+' | head -1 | grep -oE '[0-9]+')
        if [ -n "$free_bytes" ] && [ "$free_bytes" -gt 0 ] 2>/dev/null; then
            record_ok "MURAM budget healthy (free=${free_bytes}B used=${used_bytes:-?}B)"
            note "$budget_str"
            if ! echo "$armed_line" | grep -qiE 'ARMED|ENGAGED' \
               && [ -n "${used_bytes:-}" ] && [ "$used_bytes" -gt 4096 ] 2>/dev/null; then
                record_warn "MURAM used=${used_bytes}B while offload OFF — possible leak"
            fi
        else
            record_fail "MURAM budget exhausted (free=0)"
        fi
    else
        record_fail "no readable muram_budget node"
    fi
else
    record_fail "FMan PCD subsystem absent — $PCD_DBGFS missing"
fi

# PCD engine APIs
if [ -z "$KALLSYMS" ]; then
    record_skip "kallsyms unreadable — re-run with sudo for API depth"
else
    pcd_engines=(
        "KeyGen (flow distrib):fman_pcd_kg_scheme_create fman_pcd_kg_port_attach_cc fman_pcd_kg_port_attach_policer fman_pcd_kg_port_arm_fe fman_pcd_kg_port_disarm_fe"
        "Coarse Classification:fman_pcd_cc_static_install fman_cc_tree_install fman_pcd_cc_static_get_base"
        "Header Manipulation:fman_pcd_hm_install fman_hm_node_install fman_hm_nexthop_get"
        "Policer:fman_policer_install fman_pcd_plcr_install fman_policer_caps_supported"
        "Port primitives:fman_port_set_cc_base fman_port_set_rx_bpool fman_pcd_port_ensure_params_page"
    )
    for grp in "${pcd_engines[@]}"; do
        gname="${grp%%:*}"; gsyms="${grp#*:}"
        missing=""
        for s in $gsyms; do has_sym "$s" || missing="$missing $s"; done
        if [ -z "$missing" ]; then
            record_ok "PCD engine: $gname"
        else
            record_fail "PCD engine incomplete — $gname missing:$missing"
        fi
    done
fi

# ===========================================================================
# 3. Reversible mode switch
# ===========================================================================
hdr "3) Reversible offload mode switch"

if [ -z "$KALLSYMS" ]; then
    record_skip "kallsyms unreadable"
elif has_sym fman_pcd_offload_engage && has_sym fman_pcd_offload_disengage; then
    record_ok "offload engage/disengage API present (M1 coarse switch)"
else
    record_fail "offload engage/disengage API missing"
fi

# FE arm/disarm (0133) — the actual FE-VM classifier arm
if [ -n "$KALLSYMS" ]; then
    has_sym fman_pcd_kg_port_arm_fe \
        && record_ok "FE-VM arm/disarm API present (fman_pcd_kg_port_arm_fe)" \
        || record_fail "FE-VM arm API missing — 0133 not compiled in"
fi

if command -v pcd-snapshot >/dev/null 2>&1; then
    record_ok "pcd-snapshot reversibility verifier installed"
else
    record_fail "pcd-snapshot not installed"
fi

# ===========================================================================
# 4. FE-VM dormant chain (Phase 0)
# ===========================================================================
hdr "4) FE-VM dormant chain (FE pool + singletons + ehash + enq + hashfe + enter)"

if [ ! -d /sys/kernel/debug ] || { [ "$(id -u)" -ne 0 ] && [ ! -r /sys/kernel/debug ]; }; then
    record_skip "debugfs unreadable — re-run with sudo"
else
    inst_dir=$(find "$PCD_DBGFS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1)
    if [ -z "$inst_dir" ]; then
        record_fail "no PCD instance — cannot locate FE engine"
    else
        # 9 inspector nodes for the FE-VM engine
        fe_present=0 fe_total=9 fe_missing=""
        for node in fe_pool fe_port fe_singletons fe_ehash fe_enq fe_hashfe fe_enter fe_flow fe_arm; do
            if [ -e "$inst_dir/$node" ]; then
                fe_present=$((fe_present+1))
            else
                fe_missing="$fe_missing $node"
            fi
        done
        if [ "$fe_present" -eq "$fe_total" ]; then
            record_ok "FE-VM structures present ($fe_present/$fe_total)"
        elif [ "$fe_present" -gt 0 ]; then
            record_fail "FE-VM incomplete ($fe_present/$fe_total) — missing:$fe_missing"
        else
            record_fail "FE-VM absent — hardware classify not built"
        fi
    fi
fi

# ===========================================================================
# 5. AC_CC classifier arm (Phase 1 — 0133)
# ===========================================================================
hdr "5) AC_CC classifier arm (0133 — real KGSE_MODE 0x80000006)"

# The classifier arm mutates KeyGen scheme + BMI port (RFPNE/RCCB).
# It is proven on 210.10.1 ucode (3 full cycles, reversibility clean).
if dmesg_has 'FE-ARMED.*kgse_mode=AC_CC'; then
    record_ok "AC_CC arm confirmed — port armed with KGSE_MODE=AC_CC"
    note "$(echo "$DMESG" | grep 'FE-ARMED.*AC_CC' | tail -1)"
else
    note "AC_CC arm not currently engaged (opt-in per port)"
fi

# Verify 0133 real encoding (not the 0132 CCBS placebo)
if [ -n "$KALLSYMS" ] && has_sym fman_pcd_kg_port_arm_fe; then
    # Check dmesg for real AC_CC arm (not CCBS placebo)
    if dmesg_has 'port.*FE-ARMED.*ac_cc_mode=3\|next_engine=3' \
       || dmesg_has 'fmbm_rccb=0x[0-9a-f]+.*kgse_ccbs=0'; then
        record_ok "real AC_CC encoding active (not 0132 CCBS placebo)"
    else
        record_ok "real AC_CC arm API compiled in (0133, available on next arm)"
    fi
fi

# ===========================================================================
# 6. FE-VM context builder (Phase 2 — 0146)
# ===========================================================================
hdr "6) FE-VM context builder (0146 — ENQ/MUX/Transition contexts)"

if [ -n "$KALLSYMS" ]; then
    has_sym fman_pcd_fe_context_build \
        && record_ok "FE-VM context builder API present (fman_pcd_fe_context_build)" \
        || record_fail "FE-VM context builder API missing — 0135 not compiled in"

    has_sym fman_pcd_fe_build_contexts \
        && record_ok "FE-VM context integration present (fman_pcd_fe_build_contexts)" \
        || {
            # 0146 v2: fman_pcd_fe_build_contexts is static; check the exported
            # context builder it calls (fman_pcd_fe_context_build from 0135) is
            # present, plus the FE-ARMED dmesg confirming the arm works.
            if has_sym fman_pcd_fe_context_build && dmesg_has 'FE-ARMED'; then
                record_ok "FE-VM context integration present (arm works + context builder API)"
            else
                record_fail "FE-VM context integration missing — 0146 not compiled in"
            fi
        }
else
    record_skip "kallsyms unreadable"
fi

# Check if contexts were built on last arm
if dmesg_has 'FE-ARMED'; then
    if has_sym fman_pcd_fe_context_build; then
        # Context builder is compiled in; the arm includes it
        record_ok "FE-VM contexts built (arm with context builder: $(echo "$DMESG" | grep 'FE-ARMED' | tail -1 | cut -d' ' -f4-))"
    else
        record_warn "FE-ARMED seen but context builder API absent (pre-0146 kernel?)"
    fi
fi

# ===========================================================================
# 7. Hardware forwarding — L3 next-hop rewrite
# ===========================================================================
hdr "7) Hardware forwarding (L3 next-hop rewrite + MANIP chain)"

if [ -z "$KALLSYMS" ]; then
    record_skip "kallsyms unreadable"
else
    if has_sym fman_hm_nexthop_get && has_sym fman_hm_nexthop_put; then
        record_ok "next-hop rewrite cache present (shared MANIP per adjacency)"
    else
        record_fail "next-hop rewrite cache missing"
    fi
    if has_sym dpaa_get_rx_fman_port && has_sym dpaa_get_tx_fqid; then
        record_ok "netdev->hardware-id resolvers present"
    else
        record_fail "netdev->hardware-id resolvers missing"
    fi
fi

# MANIP chain API (0137 v2 — HMAN_OC fix)
if [ -n "$KALLSYMS" ]; then
    has_sym fman_pcd_manip_chain_create \
        && record_ok "MANIP chain API present (0137, fman_pcd_manip_chain_create)" \
        || record_fail "MANIP chain API missing — 0137 not compiled in"
fi

# ===========================================================================
# 8. TX confirm bypass (0136 — Phase 2)
# ===========================================================================
hdr "8) TX confirm bypass (0136 — silicon-hit release mode)"

if [ -n "$KALLSYMS" ]; then
    has_sym fman_port_set_silicon_hit_release_mode \
        && record_ok "TX confirm bypass API present (silicon-hit release mode)" \
        || record_fail "TX confirm bypass API missing — 0136 not compiled in"
else
    record_skip "kallsyms unreadable"
fi

# ===========================================================================
# 9. Control-plane module — ask.ko
# ===========================================================================
hdr "9) Control-plane module (ask.ko)"

if [ -d /sys/module/ask ]; then
    record_ok "ask.ko loaded"
    [ -r /sys/module/ask/version ]    && note "version    = $(cat /sys/module/ask/version 2>/dev/null)"
    [ -r /sys/module/ask/srcversion ] && note "srcversion = $(cat /sys/module/ask/srcversion 2>/dev/null)"
    [ -r /sys/module/ask/refcnt ]     && note "refcnt     = $(cat /sys/module/ask/refcnt 2>/dev/null)"
else
    kver=$(uname -r)
    if find "/lib/modules/$kver" -name 'ask.ko*' 2>/dev/null | grep -q .; then
        record_fail "ask.ko installed but not loaded — try: modprobe ask"
    else
        record_fail "ask.ko not installed"
    fi
fi

# genl family
if command -v genl >/dev/null 2>&1; then
    if [ "$(id -u)" -ne 0 ]; then
        record_skip "genl ctrl list requires root"
    else
        ask_id=$(genl ctrl list 2>/dev/null | awk '/^Name: ask$/ { getline; if ($1=="ID:") { print $2; exit } }')
        if [ -n "$ask_id" ]; then
            record_ok "'ask' generic-netlink family registered (id $ask_id)"
        else
            record_fail "'ask' generic-netlink family not registered"
        fi
    fi
else
    record_skip "iproute2 'genl' not installed"
fi

# ask.ko debugfs
ASK_DBGFS="/sys/kernel/debug/ask"
dbg_state "$ASK_DBGFS"; rc=$?
if [ "$rc" -eq 0 ]; then
    record_ok "ask.ko debugfs interface present at $ASK_DBGFS"
    [ -e "$ASK_DBGFS/offload" ] \
        && note "offload control node present" \
        || record_fail "offload control node missing"
elif [ "$rc" -eq 2 ]; then
    record_skip "$ASK_DBGFS not statable unprivileged"
else
    record_fail "ask.ko debugfs interface absent"
fi

# Flow-offload backend (0145)
if [ -n "$KALLSYMS" ]; then
    has_sym dpaa_register_flow_offload_handler \
        && record_ok "flow-offload backend registered (0145, dpaa_setup_tc → ask.ko)" \
        || record_fail "flow-offload backend missing — 0145 not compiled in"
fi

# ask_bridge.ko (L2 switchdev)
if [ -d /sys/module/ask_bridge ]; then
    record_ok "ask_bridge.ko loaded (L2 switchdev offload)"
else
    record_fail "ask_bridge.ko not loaded — bridged/L2 flows not offloaded (stub)"
fi

# ===========================================================================
# 10. Hardware IPsec offload (ESP packet-mode via CAAM)
# ===========================================================================
hdr "10) Hardware IPsec offload (ESP via CAAM)"

# CAAM health — check directly for CAAM-backed algorithms in /proc/crypto
# (caam-check may report spurious FAIL for built-in vs module cosmetics)
if [ -r /proc/crypto ]; then
    caam_algs=$(grep -c 'driver.*caam' /proc/crypto 2>/dev/null || true)
    if [ "${caam_algs:-0}" -ge 10 ]; then
        record_ok "CAAM healthy ($caam_algs kernel-crypto algorithms registered)"
    elif [ "${caam_algs:-0}" -gt 0 ]; then
        record_warn "CAAM partially available ($caam_algs algs; expected >10)"
    elif [ -d /sys/bus/platform/drivers/caam_jr ]; then
        record_warn "CAAM driver loaded but no algorithms registered"
    else
        record_fail "CAAM driver absent — no hardware crypto"
    fi
else
    record_skip "/proc/crypto not readable"
fi

# CAAM descriptor-sharing API (0134)
if [ -n "$KALLSYMS" ]; then
    has_sym caam_qi_ext_consumer_register \
        && record_ok "CAAM QI descriptor-sharing API present (0134, FMan→SEC hook)" \
        || record_fail "CAAM QI descriptor-sharing API missing — 0134 not compiled in"
fi

# ESP packet-mode offload advertisement on FMan netdevs
if [ "${#DPAA_NETDEVS[@]}" -gt 0 ] && command -v ethtool >/dev/null 2>&1; then
    iface="${DPAA_NETDEVS[0]}"
    esp_off=$(ethtool -k "$iface" 2>/dev/null | awk -F: '/^esp-hw-offload/ {gsub(/ /,"",$2); print $2}')
    case "$esp_off" in
        on|"on[fixed]") record_ok "$iface advertises ESP hardware offload (esp-hw-offload=$esp_off)" ;;
        *)              record_fail "$iface does not advertise ESP hardware offload (stub)" ;;
    esac
else
    record_skip "no DPAA netdevs or ethtool"
fi

# ===========================================================================
# 11. Operator CLI
# ===========================================================================
hdr "11) Operator CLI ('set system offload ask')"

if [ -d /opt/vyatta/share/vyatta-cfg/templates/system/offload/ask ] \
   || find /usr/libexec/vyos/conf_mode -maxdepth 1 -name 'system_offload*ask*' 2>/dev/null | grep -q . \
   || (command -v cli-shell-api >/dev/null 2>&1 && cli-shell-api existsActive system offload ask 2>/dev/null); then
    record_ok "'set system offload ask' CLI present"
else
    record_fail "'set system offload ask' CLI absent — operator cannot enable ASK"
fi

# ===========================================================================
# 12. dmesg integrity
# ===========================================================================
hdr "12) dmesg integrity (datapath errors / stalls / leaks)"

ASK_DMESG=$(echo "$DMESG" | grep -iE 'ask hw:|ask:|ask_bridge|fman_pcd|fman.*fe[-_]|caam_qi_ext|offload (EN|DIS)|FE-ARMED|ENGAGED' || true)
if [ -z "$ASK_DMESG" ]; then
    record_warn "no ASK-related lines in dmesg (ring buffer may have wrapped)"
else
    errs=$(echo "$ASK_DMESG" \
        | grep -iE 'error|failed|cannot|unable|refused|denied|invalid|-ENOMEM|EOPNOTSUPP|stall|park|drift|leak' \
        | grep -ivE 'refusing to load.*ucode' || true)
    if [ -z "$errs" ]; then
        record_ok "no error-class lines in ASK dmesg trail ($(echo "$ASK_DMESG" | wc -l) line(s))"
    else
        record_fail "$(echo "$errs" | wc -l) error-class line(s) in ASK dmesg:"
        echo "$errs" | head -8 | while IFS= read -r l; do note "$l"; done
    fi
    echo "$ASK_DMESG" | grep -iE 'registered|MURAM|ucode|engaged|disengaged|ARMED|context' \
        | tail -6 | while IFS= read -r l; do note "$l"; done
fi

# ===========================================================================
# Summary
# ===========================================================================
hdr "Summary"

total=$((N_OK + N_WARN + N_FAIL + N_SKIP))
printf "  %3d/%3d %sOK%s  " "$N_OK" "$total" "$C_GREEN" "$C_RST"
printf "%3d %sWARN%s  "     "$N_WARN" "$C_YELLOW" "$C_RST"
printf "%3d %sFAIL%s  "     "$N_FAIL" "$C_RED"    "$C_RST"
printf "%3d %sSKIP%s\n"     "$N_SKIP" "$C_BLUE"   "$C_RST"
echo
note "FAIL = a capability the ASK dataplane requires is missing or broken"
note "SKIP = could not be tested (privilege / tool / board) — not a verdict on ASK"

if [ "$EXIT" = "0" ]; then
    ok "ASK hardware-offload dataplane is OPERATIONAL"
else
    fail "ASK hardware-offload dataplane is NOT operational ($N_FAIL capability gap(s))"
fi

exit "$EXIT"

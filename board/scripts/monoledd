#!/usr/bin/env python3
"""monoledd — load-driven status LED daemon for the LS1046A Mono Gateway DK.

Drives the LP5812 RGBW status LED to communicate router load at a glance
using the same 32-step ramp as the manual `led` tool (green -> yellow ->
orange -> amber -> pink -> purple -> white -> blue): both hue and
brightness rise with network throughput, so a peripheral glance reads
"the box is working hard" without ever interpreting a colour.

Design (frozen in plans/LED-DAEMON.md Part 2):

  * Load metric is derived purely from network throughput (no CPU, no
    conntrack). The primary source is the FMan QMI enqueue/dequeue TOTAL
    FRAME counters (dcsr/qmi_err: fmqm_etfc / fmqm_dtfc), read a few times
    per second, converted to frames/s via delta-over-interval, and
    log10-mapped over a frame-rate curve (1 kfps floor -> 3 Mfps ceiling).
    The FMan counts every frame it moves, so this tracks load whether a
    frame is forwarded by the Linux kernel OR by the ASK/FMan hardware
    classifier — the latter bypasses kernel netdev byte counters entirely,
    so the old sysfs-bytes source read idle at full hardware line rate.

  * Fallback: if the FMan QMI debugfs node is unreadable (debugfs gated
    off), the daemon degrades to per-port sysfs rx/tx byte rate (busiest
    port, max not sum). That fallback only sees kernel-forwarded traffic.

  * The log-scaled load in [0,1] maps to the 32-step ramp (idle = faint
    green, peak = bright blue). The step changes by at most +/-2 per tick
    and each transition is a linear fade, so the LED visibly "breathes"
    with load rather than snapping between colours.

  * Idle heartbeat: at step 0 the faint green baseline is modulated by a
    slow sine so the LED confirms the daemon is alive without annoying
    the eye.

Hardware: LP5812 on i2c-15 addr 0x6c, four single-colour LEDs forming one
logical RGBW indicator, exposed as /sys/class/leds/status:{red,green,blue,
white}/brightness (8-bit PWM, 0..255). The kernel `trigger` attribute must
be 'none' for direct brightness writes to stick; this daemon forces it.

Exit codes (mirror led.py / fan-check / caam-check):
  0  clean shutdown
  1  LP5812 driver missing (sysfs path absent)
  3  sysfs write failed

Runs in the foreground under systemd (Type=simple). SIGTERM/SIGINT fade
the LED to off and exit cleanly. No external Python deps beyond stdlib.
"""

from __future__ import annotations

import math
import signal
import sys
import time
from pathlib import Path

PROG = "monoledd"

LED_BASE = Path("/sys/class/leds")
CHANNELS = ("red", "green", "blue", "white")   # canonical R G B W

# ---- baked-in constants (edit + reinstall to retune) ----------------------

TICK_MS = 333              # sampling + fade interval (~3 Hz); the LED "breathes" at this cadence
MIN_FRAME_MS = 10          # hard floor on per-frame sleep during a fade
STEP_CLAMP = 2             # max step change per tick (surge idle->saturated ~= 5 s)

# Primary throughput source: the FMan QMI enqueue/dequeue TOTAL FRAME
# counters. These count every frame that crosses the FMan<->QMan boundary,
# so they track load whether a frame is forwarded by the Linux kernel OR by
# the ASK/FMan hardware classifier (which bypasses kernel netdev counters
# entirely). This is the only signal that reflects hardware-offloaded load.
#   /sys/kernel/debug/fman_pcd/<N>/dcsr/qmi_err : fmqm_etfc / fmqm_dtfc
# Both are 32-bit registers (wrap at 2^32) reported as unsigned decimal.
QMI_ERR_PATH = Path("/sys/kernel/debug/fman_pcd/0/dcsr/qmi_err")
COUNTER_MASK = 0xFFFFFFFF   # ETFC/DTFC are u32; mask deltas for wrap

# Fallback source (kernel-forwarded traffic only): per-interface sysfs bytes.
# Used only if the FMan QMI counters are unreadable (debugfs gated off).
INTERFACES = ("eth0", "eth1", "eth2", "eth3", "eth4")

# Load is log-mapped over FRAME RATE (frames/s), not bytes. Measured on this
# board: ~1.2 Mfps at ~10 Gbit/s bidirectional 1500B; small frames push
# higher. Floor -> idle, ceiling -> full ramp. Frame rate (not bps) is the
# correct metric because the FMan counts frames, and it maps naturally to a
# qualitative "how busy is the box" indicator regardless of packet size.
LOG_FLOOR_FPS = 1e3        # 1 kfps  -> step ~0 (idle noise floor)
LOG_CEIL_FPS = 3e6         # 3 Mfps  -> top of ramp (saturates the gauge)

# Legacy bytes-mode fallback normalisers (only used in the sysfs fallback).
LOG_FLOOR_BPS = 1e6        # 1 Mbps  -> step ~1
LOG_CEIL_BPS = 10e9        # 10 Gbps -> step 15

IDLE_HEARTBEAT = True      # slow sine on the faint-green idle colour
HEARTBEAT_PERIOD_S = 4.0   # one full breathe per period at idle
HEARTBEAT_DEPTH = 0.5      # +/- fraction of the idle B/G baseline

LOG_INTERVAL_S = 30.0      # periodic status line to the journal

# 32-step load ramp (RRGGBBWW hex) — identical to the manual `led` tool's
# baked-in PALETTE (board/scripts/led.py), so the two tools agree on colour
# semantics. Idle = faint green baseline; climbs through green -> yellow ->
# orange -> amber -> pink -> purple -> white -> blue as load rises.
PALETTE = (
    "00020000",   #  0  idle: v.v.v. dim green (min traffic)
    "00080000",   #  1  v.v. dim light green
    "00100000",   #  2  v. dim light green
    "00200000",   #  3  dim green
    "08200000",   #  4  dim green/yellow
    "10200000",   #  5  dim yellow/green
    "20180000",   #  6  dim yellow
    "30100000",   #  7  dim yellow/orange (slow traffic phase)
    "40080000",   #  8  orange
    "50000000",   #  9  dark orange/red
    "60080000",   # 10  dark orange/amber
    "80100000",   # 11  dark amber
    "a0080000",   # 12  amber
    "a0100000",   # 13  bright amber
    "a0100200",   # 14  amber/pink
    "a0100800",   # 15  pink/amber (moderate traffic phase)
    "80101000",   # 16  bright pink
    "60101000",   # 17  pink/purple
    "60101804",   # 18  purple
    "40081808",   # 19  purple/white
    "20081010",   # 20  white/purple
    "08000820",   # 21  dim white (heavy traffic phase)
    "00000040",   # 22  off-white
    "00002040",   # 23  neutral white
    "00004040",   # 24  cool white
    "00006020",   # 25  ice white
    "00007010",   # 26  ice blue
    "00009008",   # 27  light blue
    "0000a000",   # 28  dim dark blue
    "0000c000",   # 29  dark blue
    "0000e000",   # 30  bright Blue
    "0000ff00",   # 31  v.bright Blue (max traffic)
)


def _parse_hex8(s: str) -> tuple[int, int, int, int]:
    return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16), int(s[6:8], 16))


STATES = tuple(_parse_hex8(c) for c in PALETTE)
N_STATES = len(STATES)


# ---- logging --------------------------------------------------------------

def log(msg: str) -> None:
    print(f"{PROG}: {msg}", file=sys.stderr, flush=True)


def die(msg: str, code: int) -> None:
    log(msg)
    sys.exit(code)


# ---- low-level sysfs ------------------------------------------------------

def led_path(channel: str) -> Path:
    return LED_BASE / f"status:{channel}"


def verify_driver() -> None:
    for ch in CHANNELS:
        if not led_path(ch).is_dir():
            die(f"{led_path(ch)} not found — LP5812 driver not loaded?", 1)


def wait_for_driver(timeout_s: float = 30.0) -> None:
    """Bounded wait for the LP5812 sysfs nodes. The i2c-15 probe can land
    slightly after multi-user.target; rather than fail and let systemd
    restart-storm, poll here for a short window first."""
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        if all(led_path(ch).is_dir() for ch in CHANNELS):
            return
        time.sleep(0.5)
    verify_driver()  # still missing -> hard fail (exit 1)


def ensure_trigger_none(channel_dir: Path) -> None:
    trig = channel_dir / "trigger"
    try:
        current = trig.read_text()
    except OSError:
        return
    if "[none]" in current:
        return
    try:
        trig.write_text("none")
    except OSError as e:
        die(f"failed to set trigger=none on {channel_dir} ({e})", 3)


def claim_triggers() -> None:
    for ch in CHANNELS:
        ensure_trigger_none(led_path(ch))


def write_brightness(channel: str, value: int) -> None:
    try:
        (led_path(channel) / "brightness").write_text(str(value))
    except OSError as e:
        die(f"failed to write {value} to {led_path(channel)}/brightness ({e})", 3)


def read_brightness(channel: str) -> int:
    try:
        return int((led_path(channel) / "brightness").read_text().strip())
    except OSError:
        return 0


def write_rgbw_now(rgbw: tuple[int, int, int, int]) -> None:
    for ch, val in zip(CHANNELS, rgbw):
        write_brightness(ch, val)


def fade_to(target: tuple[int, int, int, int], duration_ms: int) -> None:
    """Linear-fade from the current LED state to `target` over duration_ms.

    Always consumes ~duration_ms of wall-clock (sleeping through it even when
    there is nothing to animate) so the caller can use it as the tick pacer."""
    if duration_ms <= 0:
        write_rgbw_now(target)
        return

    cur = tuple(read_brightness(ch) for ch in CHANNELS)
    if cur == target:
        time.sleep(duration_ms / 1000.0)
        return

    frame_ms = max(MIN_FRAME_MS, duration_ms // 10)
    frames = max(1, duration_ms // frame_ms)
    for i in range(1, frames + 1):
        t = i / frames
        write_rgbw_now(tuple(
            round(c + (g - c) * t) for c, g in zip(cur, target)
        ))
        if i < frames:
            time.sleep(frame_ms / 1000.0)


# ---- throughput sampling --------------------------------------------------

def read_counter(path: Path) -> int:
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return -1


def sample_qmi_frames() -> int:
    """Return the FMan QMI chassis frame counter, or -1 if unavailable.

    Parses fmqm_etfc (enqueue) and fmqm_dtfc (dequeue) from the dcsr/qmi_err
    node and returns max(etfc, dtfc). Using the max tracks the busier of the
    ingress/egress directions and avoids under-reporting a one-way flow. Both
    are u32; wrap is handled by the caller's masked delta."""
    try:
        text = QMI_ERR_PATH.read_text()
    except OSError:
        return -1
    etfc = dtfc = -1
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        if parts[0] == "fmqm_etfc":
            try: etfc = int(parts[1])
            except ValueError: pass
        elif parts[0] == "fmqm_dtfc":
            try: dtfc = int(parts[1])
            except ValueError: pass
    if etfc < 0 and dtfc < 0:
        return -1
    return max(etfc, dtfc)


def sample_port_bytes() -> dict[str, int]:
    """Fallback: {ifc: rx_bytes+tx_bytes} per interface (kernel-forwarded
    traffic only; blind to ASK hardware offload). A missing interface yields
    -1 (skipped by the caller)."""
    out: dict[str, int] = {}
    for ifc in INTERFACES:
        base = Path(f"/sys/class/net/{ifc}/statistics")
        rx = read_counter(base / "rx_bytes")
        tx = read_counter(base / "tx_bytes")
        out[ifc] = rx + tx if (rx >= 0 and tx >= 0) else -1
    return out


def compute_load_fps(prev: int, cur: int, dt_s: float) -> float:
    """Log-scaled load in [0,1] from the FMan QMI frame-rate delta."""
    if dt_s <= 0 or prev < 0 or cur < 0:
        return 0.0
    frames = (cur - prev) & COUNTER_MASK   # u32 wrap-safe
    fps = frames / dt_s
    if fps <= LOG_FLOOR_FPS:
        return 0.0
    span = math.log10(LOG_CEIL_FPS) - math.log10(LOG_FLOOR_FPS)
    val = (math.log10(fps) - math.log10(LOG_FLOOR_FPS)) / span
    return max(0.0, min(1.0, val))


def load_to_step(load: float) -> int:
    """Map load in [0,1] to a ramp index."""
    return max(0, min(N_STATES - 1, round(load * (N_STATES - 1))))


def compute_load_bytes(prev: dict[str, int], cur: dict[str, int], dt_s: float) -> float:
    """Fallback-only load: max per-port sysfs byte rate (kernel path)."""
    if dt_s <= 0:
        return 0.0

    log_floor = math.log10(LOG_FLOOR_BPS)
    log_ceil = math.log10(LOG_CEIL_BPS)
    span = log_ceil - log_floor

    best = 0.0
    for ifc in INTERFACES:
        p, c = prev.get(ifc, -1), cur.get(ifc, -1)
        if p < 0 or c < 0 or c < p:
            continue
        bps = (c - p) * 8 / dt_s
        if bps <= LOG_FLOOR_BPS:
            port_log = 0.0
        else:
            port_log = (math.log10(bps) - log_floor) / span
        best = max(best, port_log)
    return max(0.0, min(1.0, best))


def heartbeat_rgbw(t: float) -> tuple[int, int, int, int]:
    """Faint-green idle colour modulated by a slow sine (breathe)."""
    base = STATES[0]
    phase = math.sin(2 * math.pi * t / HEARTBEAT_PERIOD_S)
    # modulate only the G/B channels around their baseline
    g = max(0, min(255, round(base[1] * (1 + HEARTBEAT_DEPTH * phase))))
    b = max(0, min(255, round(base[2] * (1 + HEARTBEAT_DEPTH * phase))))
    return (base[0], g, b, base[3])


# ---- main loop ------------------------------------------------------------

def install_cleanup() -> None:
    def _cleanup(*_):
        try:
            write_rgbw_now((0, 0, 0, 0))
        finally:
            sys.exit(0)
    signal.signal(signal.SIGINT, _cleanup)
    signal.signal(signal.SIGTERM, _cleanup)


def main() -> int:
    wait_for_driver()
    claim_triggers()
    install_cleanup()

    # Select the throughput source once at startup. Prefer the FMan QMI
    # frame counters (see them under both SW and HW offload); fall back to
    # per-interface sysfs bytes only if the debugfs node is unreadable.
    use_qmi = sample_qmi_frames() >= 0
    if use_qmi:
        prev_q = sample_qmi_frames()
        source = f"FMan QMI frames ({QMI_ERR_PATH})"
    else:
        prev_b = sample_port_bytes()
        source = "sysfs bytes fallback (kernel-forwarded only — HW offload not counted)"

    cur_step = 0
    fade_to(STATES[0], TICK_MS)

    last_log = time.monotonic()
    last_t = time.monotonic()
    missing_logged: set[str] = set()

    log(f"started: {N_STATES} states, tick={TICK_MS}ms, source={source}")

    while True:
        now = time.monotonic()
        dt_s = now - last_t
        last_t = now

        if use_qmi:
            cur_q = sample_qmi_frames()
            if cur_q < 0:
                # Node vanished (e.g. debugfs unmounted) — degrade to fallback.
                log("FMan QMI counter unreadable; switching to sysfs fallback")
                use_qmi = False
                prev_b = sample_port_bytes()
                load = 0.0
            else:
                load = compute_load_fps(prev_q, cur_q, dt_s)
                prev_q = cur_q
        else:
            cur_b = sample_port_bytes()
            for ifc, v in cur_b.items():
                if v < 0 and ifc not in missing_logged:
                    log(f"interface {ifc} not present yet — skipping")
                    missing_logged.add(ifc)
            load = compute_load_bytes(prev_b, cur_b, dt_s)
            prev_b = cur_b

        target_step = load_to_step(load)
        target_step = max(0, min(N_STATES - 1,
                                 max(cur_step - STEP_CLAMP,
                                     min(cur_step + STEP_CLAMP, target_step))))
        cur_step = target_step

        if IDLE_HEARTBEAT and cur_step == 0:
            target = heartbeat_rgbw(now)
        else:
            target = STATES[cur_step]

        fade_to(target, TICK_MS)

        if now - last_log >= LOG_INTERVAL_S:
            last_log = now
            log(f"load={load:.3f} step={cur_step} rgbw={target}")

    return 0


if __name__ == "__main__":
    sys.exit(main())

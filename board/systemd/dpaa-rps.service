[Unit]
Description=Enable RPS on 10G DPAA1 transit interfaces
After=network-online.target vyos-router.service
Wants=network-online.target
ConditionPathExists=/proc/device-tree/compatible

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/dpaa-rps all
RemainAfterExit=yes
StandardOutput=journal

[Install]
WantedBy=multi-user.target

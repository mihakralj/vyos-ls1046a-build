<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <global>
    <range space="code"/>
  </global>
  <stackpointer register="sp" space="code"/>
  <default_proto>
    <prototype name="__asmA" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4"><register name="r0"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="r1"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="r2"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="r3"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4"><register name="r0"/></pentry>
      </output>
      <unaffected>
        <register name="sp"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>

+    },
+    'troubleshoot_asymmetric_routing': {
+        'description': 'Guide through routing-loop diagnosis (FRR, conntrack, BGP)',
+        'messages': [
+            PromptMessage(
+                role='user',
+                content=TextContent(
+                    type='text',
+                    text=(
+                        'You are diagnosing an asymmetric routing or routing-loop issue on a VyOS router.\n\n'

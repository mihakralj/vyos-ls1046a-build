diff --git a/src/services/api/mcp/tools.py b/src/services/api/mcp/tools.py
new file mode 100644
index 000000000..da0a43a26
--- /dev/null
+++ b/src/services/api/mcp/tools.py
@@ -0,0 +1,323 @@
+import logging
+
+from mcp.server import Server
+from mcp.types import Tool, TextContent
+from fastapi.concurrency import run_in_threadpool
+
+from . import schema as mcp_schema
+from ..session import SessionState
+
+LOG = logging.getLogger('http_api.mcp.tools')
+
+TOOL_EXECUTE_OP = 'execute_operational_command'
+TOOL_MODIFY_CONFIG = 'modify_configuration'
+TOOL_MANAGE_IMAGE = 'manage_system_image'
+TOOL_REBOOT = 'reboot_system'
+TOOL_POWEROFF = 'poweroff_system'
+TOOL_SAVE_CONFIG = 'save_configuration'
+
+_READ_ONLY_TOOLS = [
+    Tool(
+        name=TOOL_EXECUTE_OP,
+        description='Run a VyOS operational-mode (show/monitor/...) command.',
+        inputSchema={
+            'type': 'object',
+            'properties': {
+                'path': {
+                    'type': 'array',
+                    'items': {'type': 'string'},
+                    'description': 'Command path (e.g. ["show", "interfaces"])'
+                }
+            },
+            'required': ['path']
+        }
+    ),
+]
+
+_WRITE_TOOLS = [
+    Tool(
+        name=TOOL_MODIFY_CONFIG,
+        description='Stage set/delete operations and atomically commit them.',
+        inputSchema={
+            'type': 'object',
+            'properties': {
+                'operations': {
+                    'type': 'array',
+                    'items': {
+                        'type': 'object',
+                        'properties': {
+                            'op': {'enum': ['set', 'delete']},
+                            'path': {'type': 'array', 'items': {'type': 'string'}},
+                            'value': {'type': 'string'}
+                        },
+                        'required': ['op', 'path']
+                    }
+                },
+                'commit_confirm_minutes': {
+                    'type': 'integer',
+                    'description': 'If set, use commit-confirm with this many minutes.'
+                }
+            },
+            'required': ['operations']
+        }
+    ),
+    Tool(
+        name=TOOL_MANAGE_IMAGE,
+        description='Manage VyOS system images (add, delete, set-default).',
+        inputSchema={
+            'type': 'object',
+            'properties': {
+                'action': {'enum': ['add', 'delete', 'set']},
+                'url': {'type': 'string', 'description': 'URL for add action'},
+                'name': {'type': 'string', 'description': 'Image name for delete/set'}
+            },
+            'required': ['action']
+        }
+    ),
+    Tool(
+        name=TOOL_REBOOT,
+        description='Reboot the VyOS system.',
+        inputSchema={
+            'type': 'object',
+            'properties': {
+                'path': {
+                    'type': 'array',
+                    'items': {'type': 'string'},
+                    'description': 'Reboot command path (default: ["now"])'
+                }
+            }
+        }
+    ),
+    Tool(
+        name=TOOL_POWEROFF,
+        description='Power off the VyOS system.',
+        inputSchema={
+            'type': 'object',
+            'properties': {
+                'path': {
+                    'type': 'array',
+                    'items': {'type': 'string'},
+                    'description': 'Poweroff command path (default: ["now"])'
+                }
+            }
+        }
+    ),
+    Tool(
+        name=TOOL_SAVE_CONFIG,
+        description='Save running configuration to file.',
+        inputSchema={
+            'type': 'object',
+            'properties': {
+                'file': {
+                    'type': 'string',
+                    'description': 'Optional file path to save config to'
+                }
+            }
+        }
+    ),
+]
+
+
+def _execute_operational_command(arguments):
+    from vyos.configsession import ConfigSessionError
+
+    path = arguments.get('path', [])
+    if not path:
+        raise ValueError('path is required')
+
+    if not mcp_schema.op_path_valid(path):
+        raise ValueError(f'Invalid operational command path: {path}')
+
+    state = SessionState()
+    session = state.session
+
+    op = path[0]
+    remainder = list(path[1:])
+
+    try:
+        if op == 'show':
+            return session.show(remainder)
+        elif op == 'generate':
+            return session.generate(remainder)
+        elif op == 'reboot':
+            return session.reboot(remainder if remainder else ['now'])
+        elif op == 'poweroff':
+            return session.poweroff(remainder if remainder else ['now'])
+        elif op == 'ping':
+            return session.ping(remainder)
+        elif op == 'traceroute':
+            return session.traceroute(remainder)
+        elif op == 'monitor':
+            return session.monitor(remainder)
+        elif op == 'restart':
+            return session.restart(remainder)
+        elif op == 'reset':
+            return session.reset(remainder)
+        elif op == 'clear':
+            return session.clear(remainder)
+        elif op == 'set':
+            return session.set(remainder)
+        elif op == 'delete':
+            return session.delete(remainder)
+        elif op == 'renew':
+            return session.renew(remainder)
+        elif op == 'release':
+            return session.release(remainder)
+        elif op == 'connect':
+            return session.connect(remainder)
+        elif op == 'disconnect':
+            return session.disconnect(remainder)
+        else:
+            return session.show(path)
+    except ConfigSessionError as e:
+        raise ValueError(str(e))
+    except AttributeError:
+        return session.show(path)
+
+
+def _modify_configuration(arguments):
+    from vyos.configsession import ConfigSessionError, ConfigSession
+    from api.rest.routers import lock, asynclock
+    import asyncio
+    import os
+
+    operations = arguments.get('operations', [])
+    if not operations:
+        raise ValueError('operations is required')
+
+    commit_confirm_minutes = arguments.get('commit_confirm_minutes')
+
+    state = SessionState()
+    session = state.session
+    env = session.get_session_env()
+    uid = os.getpid()
+
+    try:
+        loop = asyncio.get_running_loop()
+    except RuntimeError:
+        loop = None
+
+    async def _do_commit():
+        cfg_session = ConfigSession(uid, app='vyos-mcp-agent')
+
+        for op_spec in operations:
+            op = op_spec.get('op')
+            path = op_spec.get('path', [])
+            value = op_spec.get('value')
+
+            if not mcp_schema.config_path_valid(path):
+                cfg_session.discard()
+                raise ValueError(f'Invalid config path: {path}')
+
+            if op == 'set':
+                cfg_session.set(path, value or '')
+            elif op == 'delete':
+                cfg_session.delete(path)
+            else:
+                cfg_session.discard()
+                raise ValueError(f'Unknown operation: {op}')
+
+        if commit_confirm_minutes:
+            out = cfg_session.commit_confirm(minutes=commit_confirm_minutes)
+        else:
+            out = cfg_session.commit()
+
+        return out
+
+    if loop is not None:
+        def _run_sync():
+            import asyncio as _asyncio
+            lock.acquire()
+            try:
+                return _asyncio.run(_do_commit())
+            finally:
+                lock.release()
+
+        return _run_sync()
+    else:
+        lock.acquire()
+        try:
+            return asyncio.run(_do_commit())
+        finally:
+            lock.release()
+
+
+def _manage_system_image(arguments):
+    action = arguments.get('action')
+    url = arguments.get('url', '')
+    name = arguments.get('name', '')
+
+    state = SessionState()
+    session = state.session
+
+    if action == 'add':
+        if not url:
+            raise ValueError('url is required for add action')
+        return session.show(['image', 'add', url])
+    elif action == 'delete':
+        if not name:
+            raise ValueError('name is required for delete action')
+        return session.show(['image', 'delete', name])
+    elif action == 'set':
+        if not name:
+            raise ValueError('name is required for set action')
+        return session.set_default_image(name)
+    else:
+        raise ValueError(f'Unknown image action: {action}')
+
+
+def _reboot_system(arguments):
+    path = arguments.get('path', ['now'])
+    state = SessionState()
+    session = state.session
+    return session.reboot(path)
+
+
+def _poweroff_system(arguments):
+    path = arguments.get('path', ['now'])
+    state = SessionState()
+    session = state.session
+    return session.poweroff(path)
+
+
+def _save_configuration(arguments):
+    file_path = arguments.get('file')
+    state = SessionState()
+    session = state.session
+    if file_path:
+        return session.save_config(file_path)
+    return session.save_config()
+
+
+_TOOL_HANDLERS = {
+    TOOL_EXECUTE_OP: _execute_operational_command,
+    TOOL_MODIFY_CONFIG: _modify_configuration,
+    TOOL_MANAGE_IMAGE: _manage_system_image,
+    TOOL_REBOOT: _reboot_system,
+    TOOL_POWEROFF: _poweroff_system,
+    TOOL_SAVE_CONFIG: _save_configuration,
+}
+
+
+def register_tools(server: Server, read_only: bool = True):
+    tools = _READ_ONLY_TOOLS[:]
+    if not read_only:
+        tools.extend(_WRITE_TOOLS)
+
+    @server.list_tools()
+    async def list_tools():
+        return tools
+
+    @server.call_tool()
+    async def call_tool(name: str, arguments: dict):
+        handler = _TOOL_HANDLERS.get(name)
+        if handler is None:
+            raise ValueError(f'Unknown tool: {name}')
+
+        if name in (TOOL_MODIFY_CONFIG, TOOL_MANAGE_IMAGE, TOOL_REBOOT,
+                     TOOL_POWEROFF, TOOL_SAVE_CONFIG):
+            result = await run_in_threadpool(handler, arguments)
+        else:
+            result = await run_in_threadpool(handler, arguments)
+
+        return [TextContent(type='text', text=str(result))]
diff --git a/data/templates/https/nginx.default.j2 b/data/templates/https/nginx.default.j2
index e0ebe79..966e846 100644
--- a/data/templates/https/nginx.default.j2

+#
+# LS1046A ASK2: the single `interfaces ethernet <n> offload ask` knob is
+# replaced by independent per-family knobs `offload ipv4` and `offload ipv6`.
+# A stored `offload ask` meant "offload both families", so migrate it to both.
+
+from vyos.configtree import ConfigTree
+
+base = ['interfaces', 'ethernet']
+
+
+def migrate(config: ConfigTree) -> None:
+    if not config.exists(base):
+        return
+
+    for ifname in config.list_nodes(base):
+        ask_path = base + [ifname, 'offload', 'ask']
+        if not config.exists(ask_path):
+            continue
+
+        # `offload ask` == both families. Preserve intent as ipv4 + ipv6,
+        # then drop the retired node.
+        config.delete(ask_path)
+        config.set(base + [ifname, 'offload', 'ipv4'])
+        config.set(base + [ifname, 'offload', 'ipv6'])

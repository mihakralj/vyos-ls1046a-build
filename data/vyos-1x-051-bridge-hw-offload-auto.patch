+def apply_ask_bridge_offload(bridge, conf):
+    """
+    T-M6-2: L2 bridge FDB hardware offload has no CLI leafNode of its own --
+    it arms automatically for a member port that already has ASK hardware
+    offload enabled (`offload ipv4`/`offload ipv6`), the moment that port
+    joins a bridge, and disarms the moment it leaves. This is the "bridge
+    membership changed" direction; the reverse direction (toggling offload
+    ipv4/ipv6 on a port that's already a bridge member) is handled inside
+    EthernetIf.update() itself, which detects current bridge membership via
+    the same is_bridge_member field this file already checks (see
+    ethernet.py's set_ask_offload()/update()).
+
+    A port with no family offload armed at all is left alone -- there is
+    nothing to arm/disarm bridge offload against, matching the "automatic
+    only when ASK hw offload is enabled" design.
+    """
+    changed = []
+    if 'member' in bridge:
+        if 'interface' in bridge['member']:
+            changed += [(i, True) for i in bridge['member']['interface']]
+        if 'interface_remove' in bridge['member']:
+            changed += [(i, False) for i in bridge['member']['interface_remove']]
+
+    for interface, joined in changed:
+        # Only physical ASK-capable ports run FMan hardware offload at all;
+        # vxlan/wlan/vtun/etc. members are always software-only here.
+        if not interface.startswith('eth'):
+            continue
+        if not interface_exists(interface):
+            continue
+        try:
+            _, eth = get_interface_dict(conf, ['interfaces', 'ethernet'], ifname=interface)
+        except Exception:
+            continue
+        mask = ((1 if dict_search('offload.ipv4', eth) is not None else 0) |
+                (2 if dict_search('offload.ipv6', eth) is not None else 0))
+        if mask == 0:
+            continue
+        vlan = dict_search('offload.vlan', eth) is not None
+        EthernetIf(interface).set_ask_offload(mask, vlan, joined)
+
 def apply(bridge):

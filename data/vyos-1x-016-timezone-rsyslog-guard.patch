From e6e176b50d1c974153cf45df6bbaeb1077f3f2bd Mon Sep 17 00:00:00 2001
From: "miha.kralj" <miha.kralj@outlook.com>
Date: Mon, 20 Jul 2026 03:56:43 +0000
Subject: [PATCH] temp: vyos-1x-016-timezone-rsyslog-guard.patch

---
 src/conf_mode/system_timezone.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/conf_mode/system_timezone.py b/src/conf_mode/system_timezone.py
index 54ffb88..57c72a3 100755
--- a/src/conf_mode/system_timezone.py
+++ b/src/conf_mode/system_timezone.py
@@ -47,7 +47,12 @@ def generate(tz):
 
 def apply(tz):
     call('/usr/bin/timedatectl set-timezone {}'.format(tz['name']))
-    call('systemctl restart rsyslog')
+    # Only restart rsyslog if its VyOS-generated config exists
+    # Without 'set system syslog', /run/rsyslog/rsyslog.conf is never created
+    # and rsyslog fails on restart with "file not found" errors in monitor log
+    from pathlib import Path
+    if Path('/run/rsyslog/rsyslog.conf').exists():
+        call('systemctl restart rsyslog')
 
 if __name__ == '__main__':
     try:
-- 
2.39.5


<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="hardware">
        <children>
          <leafNode name="firmware">
            <properties>
              <help>Show boot firmware and FMan microcode inventory</help>
            </properties>
            <command>sudo ${vyos_op_scripts_dir}/show_hardware_firmware.py</command>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>

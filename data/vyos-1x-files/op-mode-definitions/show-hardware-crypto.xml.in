<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="hardware">
        <children>
          <node name="crypto">
            <properties>
              <help>Show hardware cryptographic acceleration (CAAM / SEC 5.4)</help>
            </properties>
            <command>sudo ${vyos_op_scripts_dir}/show_hardware_crypto.py</command>
            <children>
              <leafNode name="all">
                <properties>
                  <help>Show all registered hardware crypto algorithms</help>
                </properties>
                <command>sudo ${vyos_op_scripts_dir}/show_hardware_crypto.py --all</command>
              </leafNode>
              <leafNode name="raw">
                <properties>
                  <help>Show raw hardware crypto data as JSON</help>
                </properties>
                <command>sudo ${vyos_op_scripts_dir}/show_hardware_crypto.py --raw</command>
              </leafNode>
            </children>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>

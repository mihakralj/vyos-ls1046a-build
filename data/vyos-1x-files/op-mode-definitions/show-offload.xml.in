<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="offload">
        <properties>
          <help>Show hardware offload state (NXP LS1046A ASK2 FMan FE-VM)</help>
        </properties>
        <children>
          <leafNode name="config">
            <properties>
              <help>Show per-interface hardware offload configuration (IPv4/IPv6)</help>
            </properties>
            <command>sudo ${vyos_op_scripts_dir}/show_offload.py --action=config</command>
          </leafNode>
          <leafNode name="flow">
            <properties>
              <help>Show flows offloaded to hardware</help>
            </properties>
            <command>sudo ${vyos_op_scripts_dir}/show_offload.py --action=flow</command>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>

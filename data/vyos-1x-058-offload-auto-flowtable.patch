diff --git a/src/conf_mode/firewall.py b/src/conf_mode/firewall.py
index 0f5459f..dc524f6 100755
--- a/src/conf_mode/firewall.py
+++ b/src/conf_mode/firewall.py
@@ -126,6 +126,33 @@ def generate_inet_proto_keymap(firewall):
 
     firewall['inet_proto_map'] = keymap
 
+def get_ask_auto_flowtable(conf, firewall):
+    """
+    LS1046A ASK2 (G1): `set interfaces ethernet ethN offload ipv4|ipv6` alone
+    makes forwarded flows on that port eligible for hardware offload. Return
+    the per-family list of armed ports that no user flowtable already covers;
+    the template renders VYOS_FLOWTABLE_ASK_AUTO over them. A device may sit
+    in only one flowtable per table, and unbinding a hardware flowtable
+    disengages the whole ASK port, so user flowtables always win.
+    """
+    ethernet = conf.get_config_dict(['interfaces', 'ethernet'],
+                                    key_mangling=('-', '_'),
+                                    get_first_key=True,
+                                    no_tag_node_value_mangle=True)
+    user_ifaces = set()
+    for flowtable_conf in (firewall.get('flowtable') or {}).values():
+        user_ifaces.update(flowtable_conf.get('interface', []))
+
+    auto = {}
+    for ifname, if_conf in sorted(ethernet.items()):
+        if ifname in user_ifaces or 'disable' in if_conf:
+            continue
+        offload = if_conf.get('offload') or {}
+        for family in ('ipv4', 'ipv6'):
+            if family in offload:
+                auto.setdefault(family, []).append(ifname)
+    return auto
+
 def get_config(config=None):
     if config:
         conf = config

diff --git a/data/templates/firewall/nftables-offload.j2 b/data/templates/firewall/nftables-offload.j2
index a893e05..24460f2 100644
--- a/data/templates/firewall/nftables-offload.j2
+++ b/data/templates/firewall/nftables-offload.j2
@@ -7,3 +7,23 @@
         counter
     }
 {% endmacro %}
+
+{# LS1046A ASK2 (G1): auto flowtable for `interfaces ethernet ethN offload
+   ipv4|ipv6` ports that no user flowtable covers. The chain hooks forward
+   AFTER the filter chains (priority 10), so it only sees packets the
+   firewall accepted; ALG control sessions stay in software. #}
+{% macro ask_auto(devices) %}
+    flowtable VYOS_FLOWTABLE_ASK_AUTO {
+        hook ingress priority 0; devices = { {{ devices | join(', ') }} };
+        flags offload;
+        counter
+    }
+
+    chain VYOS_ASK_AUTO_FORWARD {
+        type filter hook forward priority 10; policy accept;
+        ct state != established return
+        meta l4proto tcp ct original proto-dst { 21, 1723, 5060, 5061 } return
+        meta l4proto udp ct original proto-dst { 5060, 5061 } return
+        meta l4proto { tcp, udp } counter flow add @VYOS_FLOWTABLE_ASK_AUTO
+    }
+{% endmacro %}

+# ASK2 FMan FE offload MTU bounds on LS1046A. The F-203 order-1 (8 KiB) RX
+# pool holds one contiguous frame up to a computed 7530-byte MTU
+# (SKB_WITH_OVERHEAD(8192) 7872 - rx_headroom 320 - VLAN_ETH_HLEN 18 -
+# ETH_FCS_LEN 4). Clamp to 7500 (30 B margin under the hard ceiling); 1280 is
+# the VyOS IPv6-link-local floor.
+ASK_OFFLOAD_MTU_MIN = 1280
+ASK_OFFLOAD_MTU_MAX = 7500
+
 def update_bond_options(conf: Config, eth_conf: dict) -> list:

+        # ASK FMan FE forwarding is bounded to the order-1 RX buffer range on
+        # this board. The DPAA1 RX pool is one contiguous 8 KiB order-1 page
+        # (F-203); frames above the ceiling overrun the one-buffer FMan RX
+        # contract and wedge RX (cold-boot-only recovery), and below the floor
+        # is untested. Clamp the MTU
+        # to [ASK_OFFLOAD_MTU_MIN, ASK_OFFLOAD_MTU_MAX] and fail the commit
+        # closed outside it, so a remote MTU change on an ASK interface cannot
+        # brick connectivity. The default 1500 is inside the range, so
+        # interfaces that never set an explicit MTU pass unchanged. Widen the
+        # bounds only after validating a larger range on the FMan RX pool.
+        mtu = ethernet.get('mtu')
+        if mtu is not None:
+            mtu_val = int(mtu)
+            if mtu_val < ASK_OFFLOAD_MTU_MIN or mtu_val > ASK_OFFLOAD_MTU_MAX:
+                raise ConfigError(
+                    f'Interface {ifname} ASK offload requires MTU between '
+                    f'{ASK_OFFLOAD_MTU_MIN} and {ASK_OFFLOAD_MTU_MAX} '
+                    f'(configured MTU {mtu} is outside the contiguous-buffer range '
+                    f'and can wedge the FMan RX path). Set a supported MTU '
+                    f'or disable "offload ask" first.'
+                )
 

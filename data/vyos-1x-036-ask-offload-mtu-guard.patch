+# ASK2 configuration permits MTUs 1280..9000; 1280 is the IPv6 floor.
+# Selected routed FE tests at MTU 9000 passed, not all traffic scenarios.
+# CPU RX can assemble scatter-gather frames; FE forwarding is a separate path.
+# Jumbo VLAN/PPPoE and other scenarios have unverified cases and caveats;
+# WireGuard fastpath scatter-gather frames can be dropped.
+ASK_OFFLOAD_MTU_MIN = 1280
+ASK_OFFLOAD_MTU_MAX = 9000
+
 def update_bond_options(conf: Config, eth_conf: dict) -> list:
     """
     Return list of blocked options if interface is a bond member
@@ -408,6 +416,20 @@ def verify_offload(ethernet: dict, ethtool: Ethtool):
             raise ConfigError(
                 f'Interface {ifname} does not support ASK offload (supported: eth0, eth1, eth2, eth3, eth4)'
             )
+        # Reject explicitly configured MTUs outside 1280..9000; an absent
+        # MTU is not checked here. This range is a configuration guard, not a
+        # guarantee that every packet path or jumbo scenario has been tested.
+        mtu = ethernet.get('mtu')
+        if mtu is not None:
+            mtu_val = int(mtu)
+            if mtu_val < ASK_OFFLOAD_MTU_MIN or mtu_val > ASK_OFFLOAD_MTU_MAX:
+                raise ConfigError(
+                    f'Interface {ifname} ASK offload requires MTU between '
+                    f'{ASK_OFFLOAD_MTU_MIN} and {ASK_OFFLOAD_MTU_MAX} '

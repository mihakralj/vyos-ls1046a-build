--- a/src/conf_mode/firewall.py
+++ b/src/conf_mode/firewall.py
@@ -525,6 +525,28 @@ def verify_hardware_offload(ifname):
     if not enabled and fixed:
         raise ConfigError(f'Interface "{ifname}" does not support hardware offload')
 
+    # LS1046A ASK2: a hardware flowtable engages FMan FE forwarding. The
+    # validated MTU band is [ASK_FT_MTU_MIN, ASK_FT_MTU_MAX] (1280..9000;
+    # 2026-10-31 Option B / RX scatter-gather). RX stays order-0 / 4 KiB
+    # (F-222); larger frames use mainline SG. Fail closed if the live MTU
+    # from sysfs is outside the band. Default 1500 passes. Do not raise the
+    # ceiling further without a new HW validation pass.
+    ASK_FT_MTU_MIN = 1280
+    ASK_FT_MTU_MAX = 9000
+    mtu_path = f'/sys/class/net/{ifname}/mtu'
+    try:
+        with open(mtu_path) as f:
+            mtu = int(f.read().strip())
+    except (OSError, ValueError):
+        mtu = None
+    if mtu is not None and (mtu < ASK_FT_MTU_MIN or mtu > ASK_FT_MTU_MAX):
+        raise ConfigError(
+            f'Interface "{ifname}" hardware flowtable offload requires MTU '
+            f'between {ASK_FT_MTU_MIN} and {ASK_FT_MTU_MAX} (live MTU {mtu} '
+            f'is outside the validated ASK offload range). '
+            f'Set a supported MTU before enabling "offload hardware".'
+        )
+
     # F-192 (LS1046A, 2026-08-14): NETIF_F_HW_TC is toggleable but defaults

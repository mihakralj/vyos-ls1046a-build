
diff --git a/src/conf_mode/firewall.py b/src/conf_mode/firewall.py
index 45837ba8b7f1128a5d543ff25bf9cdfebcfb0f38..05e7de9fcfe2d09598456213e6387c537cd3b15e 100644
--- a/src/conf_mode/firewall.py
+++ b/src/conf_mode/firewall.py
@@ -525,6 +525,27 @@ def verify_hardware_offload(ifname):
     if not enabled and fixed:
         raise ConfigError(f'Interface "{ifname}" does not support hardware offload')
 
+    # The hardware flowtable guard permits live MTUs 1280..9000. Selected
+    # routed FE tests at MTU 9000 passed, but not all jumbo scenarios have
+    # been verified; WireGuard fastpath scatter-gather frames can be dropped.
+    # CPU RX scatter-gather assembly and FE forwarding are separate paths.
+    # An unreadable or invalid sysfs MTU skips this check (fail open).
+    ASK_FT_MTU_MIN = 1280
+    ASK_FT_MTU_MAX = 9000
+    mtu_path = f'/sys/class/net/{ifname}/mtu'
+    try:
+        with open(mtu_path) as f:
+            mtu = int(f.read().strip())
+    except (OSError, ValueError):
+        mtu = None
+    if mtu is not None and (mtu < ASK_FT_MTU_MIN or mtu > ASK_FT_MTU_MAX):
+        raise ConfigError(
+            f'Interface "{ifname}" hardware flowtable offload requires MTU '
+            f'between {ASK_FT_MTU_MIN} and {ASK_FT_MTU_MAX} (live MTU {mtu} '
+            f'is outside the configured range). '
+            f'Set a supported MTU before enabling "offload hardware".'
+        )
+
     # F-192 (LS1046A, 2026-08-14): NETIF_F_HW_TC is toggleable but defaults

+# NXP LS1046A (Mono Gateway DK): FMan MAC device-tree node -> front-panel
+# position. eth0/eth1/eth2 = left/center/right RJ45, eth3/eth4 = left/right SFP+.
+_LS1046A_FMAN_PORTS = {
+    'ethernet@e8000': 0,  # FMan MAC5,  left RJ45
+    'ethernet@ea000': 1,  # FMan MAC6,  center RJ45
+    'ethernet@e2000': 2,  # FMan MAC2,  right RJ45
+    'ethernet@f0000': 3,  # FMan MAC9,  left SFP+
+    'ethernet@f2000': 4,  # FMan MAC10, right SFP+
+}
+_DT_COMPATIBLE = Path('/proc/device-tree/compatible')
+
+
+def board_port_index(ifname: str, sys_class_net: str = '/sys/class/net',
+                     compatible: Path = None) -> int:
+    """Front-panel position of an LS1046A FMan port, from its DT node - a
+    fixed hardware property, unlike the probe order. _LABEL_UNKNOWN on any
+    other hardware.
+    """
+    try:
+        if b'fsl,ls1046a' not in (compatible or _DT_COMPATIBLE).read_bytes():
+            return _LABEL_UNKNOWN
+    except OSError:
+        return _LABEL_UNKNOWN
+    node = Path(sys_class_net) / ifname / 'device' / 'of_node'
+    return _LS1046A_FMAN_PORTS.get(os.path.basename(os.path.realpath(node)),
+                                   _LABEL_UNKNOWN)
+
+

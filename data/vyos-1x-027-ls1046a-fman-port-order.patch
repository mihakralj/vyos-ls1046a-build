+    def test_ls1046a_ports_are_named_in_front_panel_order(self):
+        # probe/ID_PATH order is e2000, e8000, ea000, f0000, f2000; the case
+        # reads e8000, ea000, e2000, f0000, f2000 - and a USB NIC present at
+        # first boot must not take eth0
+        panel = ['e8000', 'ea000', 'e2000', 'f0000', 'f2000']
+        devices = []
+        for i, unit in enumerate(sorted(panel)):
+            d = dev(f'eth{i}', f'platform-1a{unit}.ethernet', f'00:00:00:00:00:0{i}', bus='')
+            d['board_port'] = panel.index(unit)
+            devices.append(d)
+        devices.append(dev('eth5', 'platform-xhci-usb-0:1:1.0', '00:00:00:00:01:00', bus='usb'))
+        order = [d['properties']['ID_PATH'] for d in sorted(devices, key=canonical_sort_key)]
+        self.assertEqual(order, [f'platform-1a{u}.ethernet' for u in panel]
+                         + ['platform-xhci-usb-0:1:1.0'])
+
+    def test_board_port_index_needs_ls1046a(self):
+        with tempfile.TemporaryDirectory() as d:
+            self._board_port_index(Path(d))
+
+    def _board_port_index(self, tmp):
+        node = tmp / 'dt' / 'ethernet@e2000'
+        node.mkdir(parents=True)
+        (tmp / 'net' / 'eth0' / 'device').mkdir(parents=True)
+        (tmp / 'net' / 'eth0' / 'device' / 'of_node').symlink_to(node)
+        compat = tmp / 'compatible'
+        compat.write_bytes(b'mono,gateway-dk\0fsl,ls1046a\0')
+        self.assertEqual(board_port_index('eth0', str(tmp / 'net'), compat), 2)
+        compat.write_bytes(b'acme,board\0')
+        self.assertEqual(board_port_index('eth0', str(tmp / 'net'), compat), _LABEL_UNKNOWN)
+        self.assertEqual(board_port_index('eth0', str(tmp / 'net'), tmp / 'none'), _LABEL_UNKNOWN)
+
+    def test_ls1046a_port_is_not_keyed_on_its_onboard_name(self):
+        # ethernet2 and ethernet5 both alias ea000: end2/end5 alternate
+        with tempfile.TemporaryDirectory() as d:
+            tmp = Path(d)
+            node = tmp / 'dt' / 'ethernet@ea000'
+            node.mkdir(parents=True)
+            dev_dir = tmp / 'net' / 'eth1' / 'device'
+            dev_dir.mkdir(parents=True)
+            (dev_dir / 'of_node').symlink_to(node)
+            (tmp / 'net' / 'eth1' / 'address').write_text('e8:f6:d7:00:16:01\n')
+            compat = tmp / 'compatible'
+            compat.write_bytes(b'fsl,ls1046a\0')
+            props = {'ID_NET_NAME_ONBOARD': 'end5', 'ID_PATH': 'platform-1aea000.ethernet'}
+            with mock.patch('vyos.ifconfig.ifname_store._DT_COMPATIBLE', compat), \
+                 mock.patch('vyos.ifconfig.ifname_store.read_properties', return_value=dict(props)), \
+                 mock.patch('vyos.ifconfig.ifname_store.permanent_mac', return_value='e8:f6:d7:00:16:01'):
+                devices = discover_devices(str(tmp / 'net'))
+            self.assertEqual(devices[0]['key'], 'ID_PATH=platform-1aea000.ethernet')
+            self.assertEqual(devices[0]['board_port'], 1)
+

diff --git a/interface-definitions/interfaces_ethernet.xml.in b/interface-definitions/interfaces_ethernet.xml.in
index e981481..6cf3373 100644
--- a/interface-definitions/interfaces_ethernet.xml.in
+++ b/interface-definitions/interfaces_ethernet.xml.in
@@ -133,6 +133,96 @@
               </leafNode>
             </children>
           </node>
+          <node name="ingress-policer">
+            <properties>
+              <help>Hardware ingress rate policer (NXP LS1046A FMan Policer offload)</help>
+            </properties>
+            <children>
+              <leafNode name="bandwidth">
+                <properties>
+                  <help>Committed information rate (policer drop threshold)</help>
+                  <valueHelp>
+                    <format>&lt;number&gt;</format>
+                    <description>Bits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;bit</format>
+                    <description>Bits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;kbit</format>
+                    <description>Kilobits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;mbit</format>
+                    <description>Megabits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;gbit</format>
+                    <description>Gigabits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;tbit</format>
+                    <description>Terabits per second</description>
+                  </valueHelp>
+                  <constraint>
+                    <validator name="numeric" argument="--positive"/>
+                    <regex>\d+(bit|kbit|mbit|gbit|tbit)?</regex>
+                  </constraint>
+                </properties>
+              </leafNode>
+              <leafNode name="burst">
+                <properties>
+                  <help>Burst size in bytes</help>
+                  <valueHelp>
+                    <format>&lt;number&gt;</format>
+                    <description>Bytes</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;&lt;suffix&gt;</format>
+                    <description>Bytes with scaling suffix (kb, mb, gb)</description>
+                  </valueHelp>
+                  <constraint>
+                    <validator name="numeric" argument="--positive"/>
+                    <regex>\d+(b|kb|mb|gb)?</regex>
+                  </constraint>
+                </properties>
+              </leafNode>
+              <leafNode name="peak-bandwidth">
+                <properties>
+                  <help>Peak information rate (enables two-rate trTCM policing)</help>
+                  <valueHelp>
+                    <format>&lt;number&gt;</format>
+                    <description>Bits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;bit</format>
+                    <description>Bits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;kbit</format>
+                    <description>Kilobits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;mbit</format>
+                    <description>Megabits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;gbit</format>
+                    <description>Gigabits per second</description>
+                  </valueHelp>
+                  <valueHelp>
+                    <format>&lt;number&gt;tbit</format>
+                    <description>Terabits per second</description>
+                  </valueHelp>
+                  <constraint>
+                    <validator name="numeric" argument="--positive"/>
+                    <regex>\d+(bit|kbit|mbit|gbit|tbit)?</regex>
+                  </constraint>
+                </properties>
+              </leafNode>
+            </children>
+          </node>
           <leafNode name="speed">
             <properties>
               <help>Link speed</help>
diff --git a/python/vyos/ethtool.py b/python/vyos/ethtool.py
index 85e228e..00ca6f2 100644
--- a/python/vyos/ethtool.py
+++ b/python/vyos/ethtool.py
@@ -177,6 +177,9 @@ def get_scatter_gather(self):
     def get_tcp_segmentation_offload(self):
         return self._get_generic('tcp-segmentation-offload')
 
+    def get_rx_vlan_offload(self):
+        return self._get_generic('rx-vlan-offload')
+
     def get_ring_buffer_max(self, rx_tx):
         # Configuration of RX/TX ring-buffers is not supported on every device,
         # thus when it's impossible return None
diff --git a/python/vyos/ifconfig/ethernet.py b/python/vyos/ifconfig/ethernet.py
index b7b7b12..0d7fc25 100644
--- a/python/vyos/ifconfig/ethernet.py
+++ b/python/vyos/ifconfig/ethernet.py
@@ -78,6 +78,10 @@ def feature(ifname, option, value):
                 'validate': lambda v: assert_list(v, ['on', 'off']),
                 'possible': lambda i, v: EthernetIf.feature(i, 'tso', v),
             },
+            'rxvlan': {
+                'validate': lambda v: assert_list(v, ['on', 'off']),
+                'possible': lambda i, v: EthernetIf.feature(i, 'rxvlan', v),
+            },
         },
     }
 
@@ -335,6 +339,30 @@ def set_lro(self, state):
                 )
         return False
 
+    def set_vlan_strip(self, state):
+        """
+        Enable hardware VLAN tag stripping on receive. State can be either
+        True or False. On the NXP LS1046A this drives the DPAA1 FMan Header
+        Manipulation offload via the dpaa_set_features() .ndo_set_features
+        bridge (NETIF_F_HW_VLAN_CTAG_RX).
+        Example:
+        >>> from vyos.ifconfig import EthernetIf
+        >>> i = EthernetIf('eth0')
+        >>> i.set_vlan_strip(True)
+        """
+        if not isinstance(state, bool):
+            raise ValueError('Value out of range')
+
+        enabled, fixed = self.ethtool.get_rx_vlan_offload()
+        if enabled != state:
+            if not fixed:
+                return self.set_interface('rxvlan', 'on' if state else 'off')
+            else:
+                print(
+                    'Adapter does not support changing rx-vlan-offload settings!'
+                )
+        return False
+
     def set_rps(self, state):
         if not isinstance(state, bool):
             raise ValueError('Value out of range')

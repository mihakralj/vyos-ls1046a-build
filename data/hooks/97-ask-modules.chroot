#!/bin/sh
# 97-ask-modules.chroot — deploy NXP ASK 1.x hardware offload stack into ISO
#
# Installs pre-built kernel modules (cdx, fci, nf_conntrack_netlink),
# userspace binaries (cmm, dpa_app), XML configs, conntrack fix script,
# and systemd services. All artifacts live in the squashfs at ISO build
# time so they are available immediately on first boot.
#
# Artifacts sourced from: release/ask-6.12.49/ in the git worktree.
# Hook ordering: 97 runs after 96-enable-services.chroot and before
# 98-fancontrol.chroot / 99-mask-services.
set -e

# Find artifacts on the HOST filesystem. live-build chroot hooks run
# inside the chroot, so host paths are at their normal location (the
# chroot does not pivot_root). The CI workspace is at a known path.
# Also try the chroot include path as fallback.
ARTIFACT_DIR=""
for candidate in \
    /mnt/nvme/_work/vyos-ls1046a-build/vyos-ls1046a-build/release/ask-6.12.49 \
    "$(cat /proc/1/root 2>/dev/null)/mnt/nvme/_work/vyos-ls1046a-build/vyos-ls1046a-build/release/ask-6.12.49" \
    /tmp/ask-artifacts \
; do
    if [ -d "$candidate" ] && [ -f "$candidate/cdx.ko" ]; then
        ARTIFACT_DIR="$candidate"
        echo "  found artifacts at $ARTIFACT_DIR"
        break
    fi
done

echo "I: 97-ask-modules.chroot: deploying ASK artifacts from $ARTIFACT_DIR"

# ── Kernel modules ─────────────────────────────────────────────────────
MODDIR=/lib/modules/6.12.49-vyos/extra
mkdir -p "$MODDIR"
for ko in cdx.ko fci.ko nf_conntrack_netlink.ko; do
    if [ -f "$ARTIFACT_DIR/$ko" ]; then
        cp "$ARTIFACT_DIR/$ko" "$MODDIR/$ko"
        echo "  $MODDIR/$ko"
    else
        echo "  WARNING: $ko not found in $ARTIFACT_DIR"
    fi
done
depmod -a 6.12.49-vyos 2>/dev/null || true
echo "I: 97-ask-modules.chroot: modules installed"

# ── Userspace binaries ─────────────────────────────────────────────────
mkdir -p /usr/local/bin /usr/local/sbin /usr/local/lib /usr/bin
if [ -f "$ARTIFACT_DIR/cmm" ]; then
    cp "$ARTIFACT_DIR/cmm" /usr/local/bin/cmm
    chmod 755 /usr/local/bin/cmm
    echo "  /usr/local/bin/cmm"
fi
if [ -f "$ARTIFACT_DIR/dpa_app" ]; then
    cp "$ARTIFACT_DIR/dpa_app" /usr/bin/dpa_app
    chmod 755 /usr/bin/dpa_app
    echo "  /usr/bin/dpa_app"
fi
if [ -f "$ARTIFACT_DIR/libcli.so.1.10.8" ]; then
    cp "$ARTIFACT_DIR/libcli.so.1.10.8" /usr/local/lib/libcli.so.1.10.8
    ln -sf libcli.so.1.10.8 /usr/local/lib/libcli.so.1.10
    ln -sf libcli.so.1.10.8 /usr/local/lib/libcli.so.1
    echo "  /usr/local/lib/libcli.so.1.10.8"
fi
echo "I: 97-ask-modules.chroot: userspace installed"

# ── XML configs ────────────────────────────────────────────────────────
for xml in cdx_cfg.xml cdx_pcd.xml cdx_sp.xml cdx_cfg_dgw.xml; do
    if [ -f "$ARTIFACT_DIR/$xml" ]; then
        cp "$ARTIFACT_DIR/$xml" /etc/$xml
        echo "  /etc/$xml"
    fi
done
echo "I: 97-ask-modules.chroot: XML configs installed"

# ── Conntrack fix script ───────────────────────────────────────────────
if [ -f "$ARTIFACT_DIR/vyos-ask-ct-fix" ]; then
    cp "$ARTIFACT_DIR/vyos-ask-ct-fix" /usr/local/sbin/vyos-ask-ct-fix
    chmod 755 /usr/local/sbin/vyos-ask-ct-fix
    echo "  /usr/local/sbin/vyos-ask-ct-fix"
fi

# ── Systemd services ───────────────────────────────────────────────────
mkdir -p /etc/systemd/system /etc/systemd/system/multi-user.target.wants

# Conntrack fix service (oneshot, after vyos-router)
if [ -f "$ARTIFACT_DIR/ask-ct-setup.service" ]; then
    cp "$ARTIFACT_DIR/ask-ct-setup.service" /etc/systemd/system/ask-ct-setup.service
    ln -sf /etc/systemd/system/ask-ct-setup.service /etc/systemd/system/multi-user.target.wants/ask-ct-setup.service
    echo "  ask-ct-setup.service (enabled)"
fi

# CMM daemon service (forking, after ask-ct-setup)
if [ -f "$ARTIFACT_DIR/ls1046a-ask.service" ]; then
    cp "$ARTIFACT_DIR/ls1046a-ask.service" /etc/systemd/system/ls1046a-ask.service
    ln -sf /etc/systemd/system/ls1046a-ask.service /etc/systemd/system/multi-user.target.wants/ls1046a-ask.service
    echo "  ls1046a-ask.service (enabled)"
fi

# ── Module auto-load (cdx/fci are loaded by ask-ct-setup,
#     nf_conntrack_netlink by the fix script, but drop a conf for safety) ─
cat > /etc/modules-load.d/ask.conf <<'EOF'
# ASK conntrack netlink — loaded early so ctnetlink socket exists
nf_conntrack_netlink
EOF

echo "I: 97-ask-modules.chroot: ASK deployment complete"

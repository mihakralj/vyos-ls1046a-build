#!/bin/sh
# 97-ask-modules.chroot — deploy NXP ASK 1.x hardware offload stack into ISO
#
# ASK artifacts are pre-staged by ci-setup-vyos-build.sh into the
# includes.chroot at /tmp/ask-artifacts/. The hook copies them from
# there to their final destinations inside the chroot.
set -e

SRC=/tmp/ask-artifacts

if [ ! -f "$SRC/cdx.ko" ]; then
    echo "WARNING: 97-ask-modules.chroot: $SRC/cdx.ko not found — ASK artifacts MISSING"
    exit 0
fi

echo "I: 97-ask-modules.chroot: deploying ASK artifacts from $SRC"

# ── Kernel modules ─────────────────────────────────────────────────
MODDIR=/lib/modules/6.12.49-vyos/extra
mkdir -p "$MODDIR"
cp "$SRC/cdx.ko" "$MODDIR/"
cp "$SRC/fci.ko" "$MODDIR/"
cp "$SRC/nf_conntrack_netlink.ko" "$MODDIR/"
echo "  modules: $(ls $MODDIR/cdx.ko $MODDIR/fci.ko $MODDIR/nf_conntrack_netlink.ko 2>&1)"

# ── Userspace ──────────────────────────────────────────────────────
cp "$SRC/cmm" /usr/local/bin/cmm
chmod 755 /usr/local/bin/cmm
cp "$SRC/dpa_app" /usr/bin/dpa_app
chmod 755 /usr/bin/dpa_app
cp "$SRC/libcli.so.1.10.8" /usr/local/lib/
ln -sf libcli.so.1.10.8 /usr/local/lib/libcli.so.1.10
ln -sf libcli.so.1.10.8 /usr/local/lib/libcli.so.1
echo "  userspace: cmm=$(ls -l /usr/local/bin/cmm 2>&1) dpa=$(ls -l /usr/bin/dpa_app 2>&1)"

# ── XML configs ────────────────────────────────────────────────────
for xml in cdx_cfg.xml cdx_pcd.xml cdx_sp.xml cdx_cfg_dgw.xml; do
    cp "$SRC/$xml" /etc/
done
echo "  configs: $(ls /etc/cdx_* 2>&1)"

# ── Script + services ──────────────────────────────────────────────
cp "$SRC/vyos-ask-ct-fix" /usr/local/sbin/
chmod 755 /usr/local/sbin/vyos-ask-ct-fix

mkdir -p /etc/systemd/system /etc/systemd/system/multi-user.target.wants
cp "$SRC/ask-ct-setup.service" /etc/systemd/system/
cp "$SRC/ls1046a-ask.service" /etc/systemd/system/
ln -sf /etc/systemd/system/ask-ct-setup.service /etc/systemd/system/multi-user.target.wants/
ln -sf /etc/systemd/system/ls1046a-ask.service /etc/systemd/system/multi-user.target.wants/
echo "  services: $(ls /etc/systemd/system/ask-ct* /etc/systemd/system/ls1046a-ask* 2>&1)"

echo "I: 97-ask-modules.chroot: ASK deployment complete"
echo "=== VERIFY ==="
find /lib/modules/6.12.49-vyos/extra -name "cdx.ko" -o -name "fci.ko" -o -name "nf_conntrack_netlink.ko" 2>/dev/null
find /usr/local/bin /usr/bin -name "cmm" -o -name "dpa_app" 2>/dev/null
find /etc -name "cdx_*" 2>/dev/null

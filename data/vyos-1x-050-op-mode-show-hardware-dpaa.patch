diff --git a/src/op_mode/show_hardware_dpaa.py b/src/op_mode/show_hardware_dpaa.py
new file mode 100755
index 000000000..9912a76f2
--- /dev/null
+++ b/src/op_mode/show_hardware_dpaa.py
@@ -0,0 +1,363 @@
+#!/usr/bin/env python3
+#

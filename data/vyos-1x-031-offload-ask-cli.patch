diff --git a/python/vyos/ifconfig/ethernet.py b/python/vyos/ifconfig/ethernet.py
--- a/python/vyos/ifconfig/ethernet.py
+++ b/python/vyos/ifconfig/ethernet.py
@@ -318,6 +318,36 @@ class EthernetIf(Interface):
                 print('Adapter does not support changing hw-tc-offload settings!')
         return False
 
+    def set_ask_offload(self, enable: bool):
+        """
+        Engage or disengage NXP LS1046A ASK (Accelerated Switching Kernel)
+        FMan FE-VM hardware forwarding offload on this interface. Composes the
+        proven /usr/local/bin/vyos-offload-ask engage/disengage verbs, which
+        program the fman_pcd debugfs fe_arm node (CONT_LOOKUP pass-through
+        scaffold) and resolve the port's kernel Rx miss FQID. Only the two 10G
+        SFP+ datapath ports carry the FE-VM substrate (eth3 = FMan RX BMI port
+        0x10, eth4 = 0x11); the request is a no-op on any other interface.
+        Example:
+        >>> from vyos.ifconfig import EthernetIf
+        >>> i = EthernetIf('eth3')
+        >>> i.set_ask_offload(True)
+        """
+        port_map = {'eth3': '0x10', 'eth4': '0x11'}
+        port = port_map.get(self.ifname)
+        if port is None:
+            return
+        tool = '/usr/local/bin/vyos-offload-ask'
+        if not os.path.exists(tool):
+            return
+        verb = 'engage' if enable else 'disengage'
+        _, err = self._popen(f'{tool} --port {port} {verb}')
+        if err:
+            err_msg = err.strip()
+            # Treat advisory stderr warnings as non-fatal; only hard-fail when
+            # the helper emits an explicit ASK offload ERROR line.
+            if 'ASK offload ERROR:' in err_msg:
+                print(f'ASK offload {verb} failed on {self.ifname}: {err_msg}')
+
     def set_lro(self, state):
         """
         Enable Large Receive offload. State can be either True or False.
@@ -663,6 +693,9 @@ class EthernetIf(Interface):
         # LRO (large receive offload)
         self.set_lro(dict_search('offload.lro', config) is not None)
 
+        # ASK offload - NXP LS1046A FMan FE-VM hardware forwarding
+        self.set_ask_offload(dict_search('offload.ask', config) is not None)
+
         # RPS - Receive Packet Steering
         self.set_rps(dict_search('offload.rps', config) is not None)
 
diff --git a/src/conf_mode/interfaces_ethernet.py b/src/conf_mode/interfaces_ethernet.py

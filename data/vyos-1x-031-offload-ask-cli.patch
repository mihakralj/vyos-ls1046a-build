diff --git a/python/vyos/ifconfig/ethernet.py b/python/vyos/ifconfig/ethernet.py
index 7eaf81f84..a19ecb211 100644
--- a/python/vyos/ifconfig/ethernet.py
+++ b/python/vyos/ifconfig/ethernet.py
@@ -17,6 +17,10 @@
 
 from glob import glob
 
+# ConfigError is raised by set_ask_offload() to fail the commit closed when
+# the ASK helper errors. It lives in vyos.base alongside Warning, which this
+# module already imports; without this line every raise is a NameError.
+from vyos.base import ConfigError
 from vyos.base import Warning
 from vyos.ethtool import Ethtool
 from vyos.netlink import coalesce
@@ -318,6 +322,29 @@ def set_hw_tc_offload(self, state):
                 print('Adapter does not support changing hw-tc-offload settings!')
         return False
 
+    def set_ask_offload(self, enable: bool):
+        """
+        Engage or disengage NXP LS1046A ASK (Accelerated Switching Kernel)
+        FMan FE-VM hardware forwarding offload on this interface.
+        """
+        port_map = {'eth3': '0x10', 'eth4': '0x11'}
+        port = port_map.get(self.ifname)
+        if port is None:
+            return
+
+        tool = '/usr/local/bin/vyos-offload-ask'
+        if not os.path.exists(tool):
+            raise ConfigError(f'ASK offload helper not found: {tool}')
+
+        verb = 'engage' if enable else 'disengage'
+        out, rc = self._popen(f'{tool} --port {port} {verb}')
+        if rc:
+            msg = (out or '').strip().splitlines()
+            detail = msg[-1] if msg else f'helper exited with rc={rc}'
+            raise ConfigError(
+                f'ASK offload {verb} failed on {self.ifname}: {detail}'
+            )
+
     def set_lro(self, state):
         """
         Enable Large Receive offload. State can be either True or False.
@@ -662,6 +689,9 @@ def update(self, config):
         # LRO (large receive offload)
         self.set_lro(dict_search('offload.lro', config) is not None)
 
+        # ASK offload - NXP LS1046A FMan FE-VM hardware forwarding
+        self.set_ask_offload(dict_search('offload.ask', config) is not None)
+
         # RPS - Receive Packet Steering
         self.set_rps(dict_search('offload.rps', config) is not None)
 
diff --git a/src/conf_mode/interfaces_ethernet.py b/src/conf_mode/interfaces_ethernet.py
index 7d42e3f77..26eb1771d 100755
--- a/src/conf_mode/interfaces_ethernet.py
+++ b/src/conf_mode/interfaces_ethernet.py
@@ -302,6 +302,18 @@ def verify_offload(ethernet: dict, ethtool: Ethtool):
     :param ethtool: Ethernet object
     :type ethtool: Ethtool
     """
+    if dict_search('offload.ask', ethernet) is not None:
+        ifname = ethernet.get('ifname')
+        vpp_ifaces = dict_search('vpp.settings.interface', ethernet) or {}
+        if ifname in vpp_ifaces:
+            raise ConfigError(
+                f'Interface {ifname} cannot be configured for ASK offload while assigned to VPP!'
+            )
+        if ifname not in ('eth3', 'eth4'):
+            raise ConfigError(
+                f'Interface {ifname} does not support ASK offload (supported: eth3, eth4)'
+            )
+
     if dict_search('offload.rps', ethernet) != None:
         if not os.path.exists(f'/sys/class/net/{ethernet["ifname"]}/queues/rx-0/rps_cpus'):
             raise ConfigError('Interface does not support RPS!')
diff --git a/src/conf_mode/vpp.py b/src/conf_mode/vpp.py
index 5256b6c1f..7c517d0f3 100755
--- a/src/conf_mode/vpp.py
+++ b/src/conf_mode/vpp.py
@@ -583,6 +583,19 @@ def verify(config):
     if 'settings' not in config:
         raise ConfigError('"settings interface" is required but not set!')
 
+    # Reject a VPP interface that already carries ASK offload (per-port mutex).
+    _conf = Config()
+    for iface in config['settings'].get('interface', {}):
+        iface_config = _conf.get_config_dict(
+            ['interfaces', 'ethernet', iface],
+            key_mangling=('-', '_'),
+            get_first_key=True,
+        )
+        if iface_config and dict_search('offload.ask', iface_config) is not None:
+            raise ConfigError(
+                f'Interface {iface} cannot be assigned to VPP while configured for ASK offload!'
+            )
+
     if 'interface' not in config['settings']:
         raise ConfigError('"settings interface" is required but not set!')
 

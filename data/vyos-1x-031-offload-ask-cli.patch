@@ -294,6 +294,14 @@ def verify_coalesce(ethernet: dict, ethtool: Ethtool):
 
 
 def verify_offload(ethernet: dict, ethtool: Ethtool):
+    if dict_search('offload.ask', ethernet) is not None:
+        ifname = ethernet.get('ifname')
+        # get_config() already gathers the VPP config into ethernet['vpp'];
+        # reuse it rather than opening a second Config() read.
+        vpp_ifaces = dict_search('vpp.settings.interface', ethernet) or {}
+        if ifname in vpp_ifaces:
+            raise ConfigError(f'Interface {ifname} cannot be configured for ASK offload while assigned to VPP!')
+
     """
      Verify offloading capabilities
     :param ethernet: dictionary which is received from get_interface_dict
diff --git a/src/conf_mode/vpp.py b/src/conf_mode/vpp.py
--- a/src/conf_mode/vpp.py
+++ b/src/conf_mode/vpp.py
@@ -572,6 +572,15 @@ def verify(config):
     if 'settings' not in config:
         raise ConfigError('"settings interface" is required but not set!')
 
+    # Reject a VPP interface that already carries ASK offload (per-port mutex).
+    _conf = Config()
+    for iface in config['settings'].get('interface', {}):
+        iface_config = _conf.get_config_dict(['interfaces', 'ethernet', iface],
+                                             key_mangling=('-', '_'),
+                                             get_first_key=True)
+        if iface_config and dict_search('offload.ask', iface_config) is not None:
+            raise ConfigError(f'Interface {iface} cannot be assigned to VPP while configured for ASK offload!')
+
     if 'interface' not in config['settings']:
         raise ConfigError('"settings interface" is required but not set!')
 

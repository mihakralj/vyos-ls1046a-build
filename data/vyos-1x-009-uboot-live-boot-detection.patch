From 7e63a6f637b1966d54a5fce1e9fb6904aa930bed Mon Sep 17 00:00:00 2001
From: "miha.kralj" <miha.kralj@outlook.com>
Date: Mon, 20 Jul 2026 03:56:42 +0000
Subject: [PATCH] temp: vyos-1x-009-uboot-live-boot-detection.patch

---
 python/vyos/system/image.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/python/vyos/system/image.py b/python/vyos/system/image.py
index ed8a96f..d1868fe 100644
--- a/python/vyos/system/image.py
+++ b/python/vyos/system/image.py
@@ -265,6 +265,9 @@ def is_live_boot() -> bool:
         boot_type: str = running_image_result.groupdict().get('boot_type', '')
         if boot_type == 'boot':
             return False
+    # U-Boot boards lack BOOT_IMAGE= (GRUB-specific). Check vyos-union= as fallback.
+    if 'vyos-union=/boot/' in cmdline:
+        return False
     return True
 
 def if_not_live_boot(func):

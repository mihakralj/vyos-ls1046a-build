@@ -57,6 +57,13 @@ def get_config(config=None):
     base = ['interfaces', 'wireguard']
     ifname, wireguard = get_interface_dict(conf, base)
 
+    # LS1046A DPAA WireGuard fast path: the kernel binds a whole set of
+    # devices at once, so every commit computes the full opted-in list.
+    wireguard['wgfp_ifaces'] = sorted(
+        i for i in conf.list_nodes(base)
+        if conf.exists(base + [i, 'offload', 'ipv4'])
+        and not conf.exists(base + [i, 'disable']))
+
     # Check if a port was changed
     tmp = is_node_changed(conf, base + [ifname, 'port'])
     if tmp: wireguard['port_changed'] = {}
@@ -173,6 +180,34 @@ def generate(wireguard):
     return None
 
 
+WGFP_PARAM = '/sys/module/wireguard/parameters/wgfp_peer'
+
+
+def wgfp_bind(ifaces):
+    """Bind the DPAA fast path to the opted-in devices (LS1046A kernel only).
+
+    The parameter reads "off" or "on ... dev=<list>"; writing a list rebinds
+    everything (flows relearn within a second), so write only on a change.
+    Flows are installed only for traffic arriving on a port with
+    `offload ipv4`; others stay on the software path.
+    """
+    if not os.path.exists(WGFP_PARAM):
+        if ifaces:
+            print('WARNING: WireGuard offload is not supported by this kernel')
+        return
+    want = ' '.join(ifaces) or 'off'
+    with open(WGFP_PARAM) as f:
+        cur = f.read().strip()
+    have = cur.split('dev=', 1)[1].strip() if 'dev=' in cur else 'off'
+    if have == want:
+        return
+    try:
+        with open(WGFP_PARAM, 'w') as f:
+            f.write(want)
+    except OSError as e:
+        print(f'WARNING: WireGuard offload for "{want}" failed: {e.strerror}')
+
+
 def apply(wireguard):
     check_kmod('wireguard')
 
@@ -223,6 +258,8 @@ def apply(wireguard):
             domain_action = 'stop'
     call(f'systemctl {domain_action} vyos-domain-resolver.service')
 
+    wgfp_bind(wireguard['wgfp_ifaces'])
+
     # run the dependents
     call_dependents()
 

+++ b/src/conf_mode/interfaces_wireguard.py
@@ -59,2 +59,9 @@ def get_config(config=None):
 
+    # LS1046A DPAA WireGuard fast path: the kernel binds a whole set of
+    # devices at once, so every commit computes the full opted-in list.
+    wireguard['wgfp_ifaces'] = sorted(
+        i for i in conf.list_nodes(base)
+        if conf.exists(base + [i, 'offload', 'ipv4'])

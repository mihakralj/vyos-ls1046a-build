From afb5b7e47dcae68b43deab67b4d44ea05c56ca1c Mon Sep 17 00:00:00 2001
From: "miha.kralj" <miha.kralj@outlook.com>
Date: Mon, 20 Jul 2026 05:54:21 +0000
Subject: [PATCH] temp: 010 regenerated with full AF_XDP support

---
 data/templates/vpp/startup.conf.j2 | 25 +++++++++++++++++++++++++
 src/conf_mode/vpp.py               |  9 ++++++++-
 2 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/data/templates/vpp/startup.conf.j2 b/data/templates/vpp/startup.conf.j2
index 82d3753..7579950 100644
--- a/data/templates/vpp/startup.conf.j2
+++ b/data/templates/vpp/startup.conf.j2
@@ -180,6 +180,31 @@ dpdk {
     uio-bind-force
 }
 
+af_xdp {
+{% for iface, iface_config in interface.items() %}
+{%     if iface_config.driver == 'xdp' %}
+    dev {{ iface }} {
+        name {{ iface }}
+{%         if iface_config.xdp_api_params.rxq_size is vyos_defined %}
+        rx-queue-size {{ iface_config.xdp_api_params.rxq_size }}
+{%         endif %}
+{%         if iface_config.xdp_api_params.txq_size is vyos_defined %}
+        tx-queue-size {{ iface_config.xdp_api_params.txq_size }}
+{%         endif %}
+{%         if iface_config.xdp_api_params.rxq_num is vyos_defined %}
+        num-rx-queues {{ iface_config.xdp_api_params.rxq_num }}
+{%         endif %}
+{%         if iface_config.xdp_api_params.mode is vyos_defined %}
+        mode {{ iface_config.xdp_api_params.mode }}
+{%         endif %}
+{%         if iface_config.xdp_api_params.flags is vyos_defined %}
+        flags {{ iface_config.xdp_api_params.flags }}
+{%         endif %}
+    }
+{%     endif %}
+{% endfor %}
+}
+
 {% if ipsec_acceleration is vyos_defined %}
 linux-xfrm-nl {
      enable-route-mode-ipsec
diff --git a/src/conf_mode/vpp.py b/src/conf_mode/vpp.py
index c0e30d1..85bb396 100755
--- a/src/conf_mode/vpp.py
+++ b/src/conf_mode/vpp.py
@@ -133,6 +133,7 @@
 )
 SUPPORTED_DRIVERS = (
     'hv_netvsc',  # Microsoft Hyper-V network interface card
+    'fsl_dpa',    # NXP DPAA1 FMan Ethernet (platform bus, AF_XDP)
 )
 
 
@@ -380,6 +381,9 @@ def get_config(config=None):
 
             for iface, iface_config in config['settings']['interface'].items():
                 iface_config['driver'] = 'dpdk'
+                # LS1046A: fsl_dpa is a platform-bus AF_XDP driver, not DPDK
+                if iface_config.get('kernel_module') == 'fsl_dpa':
+                    iface_config['driver'] = 'xdp'
 
                 # old_driver = leaf_node_changed(
                 #     conf, base_settings + ['interface', iface, 'driver']
@@ -685,8 +689,11 @@ def generate(config):
 
 
 def initialize_interface(iface, driver, iface_config) -> None:
+    # LS1046A: AF_XDP platform-bus devices need no PCI rescan
+    if driver == 'xdp' and iface_config.get('original_driver') == 'fsl_dpa':
+        pass  # AF_XDP on platform bus — no PCI rescan, no rename
     # DPDK - rescan PCI to use a proper driver
-    if driver == 'dpdk' and iface_config['original_driver'] not in not_pci_drv:
+    elif driver == 'dpdk' and iface_config['original_driver'] not in not_pci_drv:
         # 'gve' devices require a specific unbind/bind process instead of a standard PCI rescan.
         if iface_config['original_driver'] == 'gve':
             control_host.rebind_gve_driver(

index 94802d6..93b92a7 100644
--- a/src/conf_mode/qos.py
+++ b/src/conf_mode/qos.py
@@ -256,6 +256,73 @@ def _check_shaper_hfsc_rate(cls, cls_conf):
         )
 
 
+def _verify_shaper_offload(policy, policy_config):
+    if 'bandwidth' not in policy_config:
+        raise ConfigError(f'Offloaded shaper policy "{policy}" requires "bandwidth"!')
+    _verify_default_policy_exist(policy, policy_config)
+
+    classes = policy_config.get('class', {})
+    if len(classes) + 1 > 8:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" supports at most 7 classes plus default (8 CEETM strict-priority CQs)!'
+        )
+
+    used_prios = {}
+    for cls, cls_conf in classes.items():
+        cls_id = int(cls)
+        if 'set_dscp' in cls_conf:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" class "{cls}" does not support "set-dscp"!'
+            )
+        prio = int(cls_conf.get('priority', 0))
+        if prio < 0 or prio > 7:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" class "{cls}" priority must be 0-7!'
+            )
+        if prio in used_prios:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" classes "{used_prios[prio]}" and "{cls}" share priority {prio}; CEETM requires distinct priorities 0-7!'
+            )
+        used_prios[prio] = cls
+
+        if 'ceiling' in cls_conf:
+            Warning(
+                f'Offloaded shaper "{policy}" class "{cls}" sets "ceiling"; 2-level CEETM shapes aggregate rate at the parent policy bandwidth and schedules child classes by strict priority 0-7.'
+            )
+
+        for mname, mcfg in cls_conf.get('match', {}).items():
+            if 'mark' in mcfg:
+                mark_val = int(str(mcfg['mark']), 0)
+                if mark_val == 0 or mark_val not in (cls_id, (1 << 16) | cls_id):
+                    raise ConfigError(
+                        f'Offloaded shaper policy "{policy}" class "{cls}" match "{mname}" mark {mcfg["mark"]} must equal class ID {cls_id} (or 0x{(1 << 16) | cls_id:x}); CEETM steers SW skb->mark and ASK2 HW ct->mark directly by HTB class ID!'
+                    )
+            non_mark = [k for k in mcfg.keys() if k not in ('mark', 'description')]
+            if non_mark:
+                Warning(
+                    f'Offloaded shaper "{policy}" class "{cls}" match "{mname}" uses unsupported criteria ({", ".join(non_mark)}); offloaded HTB ignores tc filters for both software and ASK2 hardware traffic (steer via skb/conntrack mark equal to class ID or skb->priority)!'
+                )
+
+    default_conf = policy_config.get('default', {})
+    if 'set_dscp' in default_conf:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" default class does not support "set-dscp"!'
+        )
+    # qos.xml.in assigns <defaultValue>20</defaultValue> to shaper default
+    # priority; treat '20' as unset (auto-select lowest free CQ 7..0).
+    raw_def_prio = default_conf.get('priority')
+    if raw_def_prio is not None and str(raw_def_prio) != '20':
+        def_prio = int(raw_def_prio)
+        if def_prio < 0 or def_prio > 7:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" default priority must be 0-7 (got {def_prio})!'
+            )
+        if def_prio in used_prios:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" default priority {def_prio} conflicts with class "{used_prios[def_prio]}"!'
+            )
+
+
 def _verify_shaper_hfsc(policy, policy_config):
     _verify_default_policy_exist(policy, policy_config)
 

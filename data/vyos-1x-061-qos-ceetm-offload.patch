diff --git a/python/vyos/qos/trafficshaper.py b/python/vyos/qos/trafficshaper.py
index 24e2ca06e..3169e6d8a 100644
--- a/python/vyos/qos/trafficshaper.py
+++ b/python/vyos/qos/trafficshaper.py
@@ -14,18 +14,231 @@
 # License along with this library.  If not, see <http://www.gnu.org/licenses/>.
 
 from math import ceil
+import re
 from vyos.qos.base import QoSBase
+from vyos.utils.process import popen
+from vyos.utils.process import run
 
 # Kernel limits on quantum (bytes)
 MAXQUANTUM = 200000
 MINQUANTUM = 1000
 
+# Pref range reserved for Phase 3 CEETM MURAM DSCP egress flower filters
+# (IPv4: 1000..1063, IPv6: 1100..1163). Surgical cleanup leaves unrelated
+# clsact ingress/egress filters (e.g. ingress-policer at pref 50) intact.
+_CEETM_DSCP_PREF_MIN = 1000
+_CEETM_DSCP_PREF_MAX = 1199
+_CEETM_DSCP_PREF_V4_BASE = 1000
+_CEETM_DSCP_PREF_V6_BASE = 1100
+
+_CEETM_DSCP_NAMES = {
+    'default': 0, 'be': 0, 'cs0': 0,
+    'le': 1, 'reliability': 1,
+    'throughput': 2,
+    'lowdelay': 4,
+    'priority': 8, 'cs1': 8,
+    'af11': 10, 'af12': 12, 'af13': 14,
+    'immediate': 16, 'cs2': 16,
+    'af21': 18, 'af22': 20, 'af23': 22,
+    'flash': 24, 'cs3': 24,
+    'af31': 26, 'af32': 28, 'af33': 30,
+    'flash-override': 32, 'cs4': 32,
+    'af41': 34, 'af42': 36, 'af43': 38,
+    'critical': 40, 'cs5': 40,
+    'va': 44,
+    'ef': 46,
+    'internet': 48, 'cs6': 48,
+    'network': 56, 'cs7': 56,
+}
+
 class TrafficShaper(QoSBase):
     _parent = 1
     qostype = 'shaper'
 
+    @staticmethod
+    def parse_offload_dscp(raw) -> int:
+        key = str(raw).strip().lower()
+        if key in _CEETM_DSCP_NAMES:
+            return _CEETM_DSCP_NAMES[key]
+        val = int(key, 0)
+        if val < 0 or val > 63:
+            raise ValueError(f'DSCP value {raw!r} out of range 0-63')
+        return val
+
+    @classmethod
+    def collect_offload_dscp(cls, policy_config: dict):
+        """Extract pure ip/ipv6 dscp matches from an offloaded shaper policy.
+
+        Returns (entries, conflicts, invalid, unsupported_by_match):
+          - entries: sorted list of (family, dscp, class_id)
+          - conflicts: list of (family, dscp, first_cls, second_cls)
+          - invalid: list of (cls_str, match_name, family, raw_val)
+          - unsupported_by_match: dict[(cls_str, match_name)] -> list[str]
+        """
+        seen = {}
+        conflicts = []
+        invalid = []
+        unsupported = {}
+
+        classes = policy_config.get('class', {})
+        for cls_str in sorted(classes, key=lambda x: int(x)):
+            cls_id = int(cls_str)
+            cls_cfg = classes[cls_str]
+            for mname, mcfg in cls_cfg.get('match', {}).items():
+                non_supported = []
+                for key, val in mcfg.items():
+                    if key in ('mark', 'description'):
+                        continue
+                    if key in ('ip', 'ipv6') and isinstance(val, dict) and set(val.keys()) == {'dscp'}:
+                        raw_dscp = val['dscp']
+                        try:
+                            dscp = cls.parse_offload_dscp(raw_dscp)
+                        except ValueError:
+                            invalid.append((cls_str, mname, key, raw_dscp))
+                            continue
+                        pair = (key, dscp)
+                        if pair in seen and seen[pair] != cls_id:
+                            conflicts.append((key, dscp, seen[pair], cls_id))
+                        else:
+                            seen[pair] = cls_id
+                    else:
+                        non_supported.append(key)
+                if non_supported:
+                    unsupported[(cls_str, mname)] = non_supported
+
+        entries = sorted((fam, dscp, cid) for (fam, dscp), cid in seen.items())
+        return entries, conflicts, invalid, unsupported
+
+    @staticmethod
+    def clear_offload_dscp(ifname: str):
+        """Remove only QoS-owned CEETM DSCP egress flower filters (pref 1000..1199)."""
+        out, _ = popen(f'tc filter show dev {ifname} egress 2>/dev/null')
+        prefs = sorted({
+            int(m.group(1))
+            for m in re.finditer(r'\bpref\s+(\d+)\b', out or '')
+            if _CEETM_DSCP_PREF_MIN <= int(m.group(1)) <= _CEETM_DSCP_PREF_MAX
+        })
+        for pref in prefs:
+            run(f'tc filter del dev {ifname} egress pref {pref}')
+
+    def _resolve_rate(self, raw_rate, total_bw):
+        if raw_rate == 'auto':
+            return self._rate_convert(total_bw)
+        if str(raw_rate).endswith('%'):
+            percent = str(raw_rate).rstrip('%')
+            return max(self._rate_convert(total_bw) * int(percent) // 100, 8)
+        return self._rate_convert(raw_rate)
+
+    def _attach_offload_leaf_qdisc(self, cls_cfg: dict, minor_id: int, speed: int):
+        """Attach Phase 5a hardware frame-mode CCGR WRED when queue-type is random-detect."""
+        if cls_cfg.get('queue_type') != 'random-detect':
+            return
+        avg_pkt = int(cls_cfg.get('average_packet') or 1024)
+        max_thr = int(cls_cfg.get('maximum_threshold') or 18)
+        min_thr = (
+            int(cls_cfg['minimum_threshold'])
+            if 'minimum_threshold' in cls_cfg
+            else (9 * max_thr) // 18
+        )
+        limit = cls_cfg.get('queue_limit')
+        mark_prob = int(cls_cfg.get('mark_probability') or 10)
+        qparams = self._calc_random_detect_queue_params(
+            avg_pkt=avg_pkt,
+            max_thr=max_thr,
+            limit=limit,
+            min_thr=min_thr,
+            mark_probability=mark_prob,
+        )
+        burst = max(qparams['burst'], min_thr + 1, 2)
+        self._cmdl([
+            'tc', 'qdisc', 'replace', 'dev', self._interface,
+            'parent', f'{self._parent:x}:{minor_id:x}',
+            'handle', f'{minor_id:x}:',
+            'red',
+            'limit', str(qparams['limit']),
+            'min', str(qparams['min_val']),
+            'max', str(qparams['max_val']),
+            'avpkt', str(qparams['avg_pkt']),
+            'burst', str(burst),
+            'probability', f'{qparams["probability"]:.6g}',
+            'bandwidth', str(speed),
+        ])
+
+    def _install_offload_dscp(self, config: dict):
+        """Render Phase 3 MURAM DSCP->CQ clsact egress flower filters."""
+        self.clear_offload_dscp(self._interface)
+        entries, _, _, _ = self.collect_offload_dscp(config)
+        if not entries:
+            return
+        self._cmdl(['ethtool', '-K', self._interface, 'hw-tc-offload', 'on'])
+        qdiscs, _ = popen(f'tc qdisc show dev {self._interface} 2>/dev/null')
+        if 'qdisc clsact ' not in (qdiscs or ''):
+            self._cmdl(['tc', 'qdisc', 'add', 'dev', self._interface, 'clsact'])
+        for family, dscp, cls_id in entries:
+            proto = 'ip' if family == 'ip' else 'ipv6'
+            pref = (_CEETM_DSCP_PREF_V4_BASE if family == 'ip' else _CEETM_DSCP_PREF_V6_BASE) + dscp
+            tos = dscp << 2
+            self._cmdl([
+                'tc', 'filter', 'replace', 'dev', self._interface,
+                'egress', 'protocol', proto, 'pref', str(pref),
+                'flower', 'skip_sw', 'ip_tos', f'{tos:#x}/0xfc',
+                'action', 'skbedit', 'priority', f'{self._parent:x}:{cls_id:x}',
+            ])
+
+    def _update_offload(self, config):
+        """Render QMan CEETM hardware HTB-offload qdisc, Phase 5a WRED, and Phase 3 DSCP."""
+        speed = self._rate_convert(config['bandwidth'])
+        classes = config.get('class', {})
+        default_cfg = config.get('default', {})
+
+        if not classes:
+            def_rate = self._resolve_rate(default_cfg.get('bandwidth', config['bandwidth']),
+                                          config['bandwidth'])
+            def_ceil = self._resolve_rate(default_cfg.get('ceiling', default_cfg.get('bandwidth', config['bandwidth'])),
+                                          config['bandwidth'])
+            self._cmdl(f'tc qdisc replace dev {self._interface} root handle {self._parent:x}: htb offload default 1'.split())
+            self._cmdl(f'tc class replace dev {self._interface} parent {self._parent:x}: classid {self._parent:x}:1 htb rate {def_rate} ceil {def_ceil}'.split())
+            self._attach_offload_leaf_qdisc(default_cfg, 1, def_ceil)
+            self.clear_offload_dscp(self._interface)
+            return
+
+        class_ids = sorted(int(x) for x in classes)
+        default_minor_id = max(class_ids) + 1
+
+        self._cmdl(f'tc qdisc replace dev {self._interface} root handle {self._parent:x}: htb offload default {default_minor_id:x}'.split())
+        self._cmdl(f'tc class replace dev {self._interface} parent {self._parent:x}: classid {self._parent:x}:1 htb rate {speed} ceil {speed}'.split())
+
+        used_prios = set()
+        for cls in class_ids:
+            cls_cfg = classes[str(cls)]
+            rate = self._resolve_rate(cls_cfg['bandwidth'], config['bandwidth'])
+            ceil_rate = self._resolve_rate(cls_cfg['ceiling'], config['bandwidth']) if 'ceiling' in cls_cfg else speed
+            prio = int(cls_cfg.get('priority', 0))
+            used_prios.add(prio)
+            self._cmdl(f'tc class replace dev {self._interface} parent {self._parent:x}:1 classid {self._parent:x}:{cls:x} htb rate {rate} ceil {ceil_rate} prio {prio}'.split())
+            self._attach_offload_leaf_qdisc(cls_cfg, cls, speed)
+
+        if default_cfg:
+            def_rate = self._resolve_rate(default_cfg['bandwidth'], config['bandwidth'])
+            def_ceil = self._resolve_rate(default_cfg['ceiling'], config['bandwidth']) if 'ceiling' in default_cfg else speed
+            # qos.xml.in sets <defaultValue>20</defaultValue> on shaper default
+            # priority; treat values > 7 as unset so the lowest unused CEETM
+            # strict-priority CQ (7..0) is selected automatically.
+            if 'priority' in default_cfg and int(default_cfg['priority']) <= 7:
+                def_prio = int(default_cfg['priority'])
+            else:
+                free_prios = [p for p in range(7, -1, -1) if p not in used_prios]
+                def_prio = free_prios[0] if free_prios else 7
+            self._cmdl(f'tc class replace dev {self._interface} parent {self._parent:x}:1 classid {self._parent:x}:{default_minor_id:x} htb rate {def_rate} ceil {def_ceil} prio {def_prio}'.split())
+            self._attach_offload_leaf_qdisc(default_cfg, default_minor_id, speed)
+
+        self._install_offload_dscp(config)
+
     # https://man7.org/linux/man-pages/man8/tc-htb.8.html
     def update(self, config, direction):
+        if 'offload' in config:
+            self._update_offload(config)
+            return
         class_id_max = 0
         if 'class' in config:
             tmp = list(config['class'])

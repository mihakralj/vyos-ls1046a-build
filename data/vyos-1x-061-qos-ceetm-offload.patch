+def _verify_shaper_offload_queue(policy, label, cls_conf):
+    qtype = cls_conf.get('queue_type')
+    # qos.xml.in defaults queue-type to 'fq-codel'; treat both 'fq-codel'
+    # (default) and 'drop-tail' as CEETM's built-in frame-mode CCGR tail-drop,
+    # and 'random-detect' as Phase 5a hardware frame-mode CCGR WRED.
+    if qtype in (None, 'fq-codel', 'drop-tail'):
+        return
+    if qtype != 'random-detect':
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" {label} does not support queue-type "{qtype}"; use "drop-tail" or "random-detect"!'
+        )
+    max_thr = int(cls_conf.get('maximum_threshold', 18))
+    if max_thr < 1:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" {label} random-detect requires maximum-threshold >= 1!'
+        )
+    if 'minimum_threshold' in cls_conf:
+        min_thr = int(cls_conf['minimum_threshold'])
+        if min_thr < 0 or min_thr >= max_thr:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" {label} uses minimum-threshold "{min_thr}" >= maximum-threshold "{max_thr}"!'
+            )
+    if 'queue_limit' in cls_conf:
+        queue_lim = int(cls_conf['queue_limit'])
+        if queue_lim < max_thr:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" {label} uses queue-limit "{queue_lim}" < maximum-threshold "{max_thr}"!'
+            )
+    if 'mark_probability' in cls_conf and int(cls_conf['mark_probability']) < 1:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" {label} random-detect requires mark-probability >= 1!'
+        )
+    if 'average_packet' in cls_conf and int(cls_conf['average_packet']) < 64:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" {label} random-detect requires average-packet >= 64!'
+        )
+
+
+def _verify_shaper_offload(policy, policy_config):
+    if 'bandwidth' not in policy_config:
+        raise ConfigError(f'Offloaded shaper policy "{policy}" requires "bandwidth"!')
+    _verify_default_policy_exist(policy, policy_config)
+
+    classes = policy_config.get('class', {})
+    if len(classes) + 1 > 8:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" supports at most 7 classes plus default (8 CEETM strict-priority CQs)!'
+        )
+
+    _, dscp_conflicts, dscp_invalid, unsupported_matches = TrafficShaper.collect_offload_dscp(policy_config)
+    for cls_str, mname, fam, raw_val in dscp_invalid:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" class "{cls_str}" match "{mname}" has invalid {fam} DSCP value "{raw_val}"!'
+        )
+    for fam, dscp, first_cls, second_cls in dscp_conflicts:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" maps {fam} DSCP {dscp} to both class "{first_cls}" and class "{second_cls}"!'
+        )
+
+    used_prios = {}
+    for cls, cls_conf in classes.items():
+        cls_id = int(cls)
+        if 'set_dscp' in cls_conf:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" class "{cls}" does not support "set-dscp"!'
+            )
+        _verify_shaper_offload_queue(policy, f'class "{cls}"', cls_conf)
+        prio = int(cls_conf.get('priority', 0))
+        if prio < 0 or prio > 7:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" class "{cls}" priority must be 0-7!'
+            )
+        if prio in used_prios:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" classes "{used_prios[prio]}" and "{cls}" share priority {prio}; CEETM requires distinct priorities 0-7!'
+            )
+        used_prios[prio] = cls
+
+        if 'ceiling' in cls_conf:
+            Warning(
+                f'Offloaded shaper "{policy}" class "{cls}" sets "ceiling"; 2-level CEETM shapes aggregate rate at the parent policy bandwidth and schedules child classes by strict priority 0-7.'
+            )
+
+        for mname, mcfg in cls_conf.get('match', {}).items():
+            if 'mark' in mcfg:
+                mark_val = int(str(mcfg['mark']), 0)
+                if mark_val == 0 or mark_val not in (cls_id, (1 << 16) | cls_id):
+                    raise ConfigError(
+                        f'Offloaded shaper policy "{policy}" class "{cls}" match "{mname}" mark {mcfg["mark"]} must equal class ID {cls_id} (or 0x{(1 << 16) | cls_id:x}); CEETM steers SW skb->mark and ASK2 HW ct->mark directly by HTB class ID!'
+                    )
+            non_supported = unsupported_matches.get((cls, mname))
+            if non_supported:
+                Warning(
+                    f'Offloaded shaper "{policy}" class "{cls}" match "{mname}" uses unsupported criteria ({", ".join(non_supported)}); offloaded HTB steers via mark (equal to class ID) or pure ip/ipv6 dscp!'
+                )
+
+    default_conf = policy_config.get('default', {})
+    if 'set_dscp' in default_conf:
+        raise ConfigError(
+            f'Offloaded shaper policy "{policy}" default class does not support "set-dscp"!'
+        )
+    _verify_shaper_offload_queue(policy, 'default class', default_conf)
+    # qos.xml.in assigns <defaultValue>20</defaultValue> to shaper default
+    # priority; treat '20' as unset (auto-select lowest free CQ 7..0).
+    raw_def_prio = default_conf.get('priority')
+    if raw_def_prio is not None and str(raw_def_prio) != '20':
+        def_prio = int(raw_def_prio)
+        if def_prio < 0 or def_prio > 7:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" default priority must be 0-7 (got {def_prio})!'
+            )
+        if def_prio in used_prios:
+            raise ConfigError(
+                f'Offloaded shaper policy "{policy}" default priority {def_prio} conflicts with class "{used_prios[def_prio]}"!'
+            )
+
+
 def _verify_shaper_hfsc(policy, policy_config):
     _verify_default_policy_exist(policy, policy_config)
 
